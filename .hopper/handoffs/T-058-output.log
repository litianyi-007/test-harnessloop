    27	      another document's typo verbatim) rather than a real reference. This
    28	      is the escape hatch for cases the heuristics above cannot resolve
    29	      mechanically; it does not require a project-level opt-out.
    30	
    31	  Existence is checked against the project root, the round's goal
    32	  directory, the round directory itself, the project's own `.harnessloop/`
    33	  directory (so a citation using one of the PATHISH_PREFIXES verbatim,
    34	  e.g. `setup/data-sources.md` or `state/self-check.md`, resolves against
    35	  where those directories actually live), and the root of every
    36	  first-level git submodule declared in the project's .gitmodules (so a
    37	  citation written relative to a submodule's own root, e.g. `plugins/foo/`
    38	  when `foo` is checked out as a submodule at <project>/foo, resolves
    39	  correctly instead of being flagged as dangling).
    40	
    41	Exit codes: 0 = pass, 1 = violations found, 2 = usage error.
    42	"""
    43	
    44	from __future__ import annotations
    45	
    46	import argparse
    47	import json
    48	import os
    49	import re
    50	import sys
    51	from pathlib import Path
    52	
    53	CODE_SPAN = re.compile(r"`([^`]+)`")
    54	PATHISH_PREFIXES = (
    55	    ".harnessloop/",
    56	    "rounds/",
    57	    "evidence/",
    58	    "reviews/",
    59	    "goals/",
    60	    "state/",
    61	    "setup/",
    62	    "meta/",
    63	    "evals/",
    64	    "intake/",
    65	)
    66	
    67	# Explicit per-line opt-out for Rule B: a review line that carries this
    68	# marker (or is immediately preceded by a line that does) has every
    69	# citation on it skipped. See module docstring for when to use it.
    70	IGNORE_MARKER = "<!-- verify:ignore -->"
    71	
    72	# Regex/glob metacharacters. A backtick span containing any of these is a
    73	# quoted pattern (regex alternation, anchors, glob wildcards, ...), not a
    74	# literal path, so it is never treated as a citation.
    75	PATH_META_CHARS = frozenset("^$*?|(){}[]\\+")
    76	
    77	# A bare (schemeless) domain: at least two dot-separated alnum/hyphen
    78	# labels, e.g. "docs.python.org" or "github.com". Anchored so it must
    79	# consume the whole first path segment — this deliberately does not match
    80	# a plain filename with an extension (e.g. "package.json" has no `/`
    81	# after it, and is never even offered to this check; see
    82	# _looks_like_bare_domain).
    83	BARE_DOMAIN_RE = re.compile(
    84	    r"^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
    85	    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
    86	)
    87	
    88	
    89	def norm(path: Path) -> str:
    90	    return os.path.normcase(os.path.normpath(str(path)))
    91	
    92	
    93	def is_under(child: Path, parent: Path) -> bool:
    94	    child_s, parent_s = norm(child), norm(parent)
    95	    return child_s == parent_s or child_s.startswith(parent_s + os.sep)
    96	
    97	
    98	def extract_allowed_spans(scope_lock_text: str) -> list[str]:
    99	    """Collect allowed paths from the '## Allowed Changes' section.
   100	
   101	    Accepts both formats in the wild: backtick path spans in prose/bullets,
   102	    and the scope-lock-template.md table whose first column is the path.
   103	    """
   104	    spans: list[str] = []
   105	    in_section = False
   106	    for line in scope_lock_text.splitlines():
   107	        stripped = line.strip()
   108	        if stripped.startswith("## "):
   109	            in_section = stripped.lower() == "## allowed changes"
   110	            continue
   111	        if not in_section:
   112	            continue
   113	        spans.extend(CODE_SPAN.findall(line))
   114	        if stripped.startswith("|"):
   115	            cells = [c.strip() for c in stripped.strip("|").split("|")]
   116	            if not cells:
   117	                continue
   118	            first = cells[0].strip("`").strip()
   119	            if (
   120	                first
   121	                and not set(first) <= {"-", ":", " "}
   122	                and first.lower() not in {"path/data/tool", "path", "file", "target"}
   123	                and " " not in first
   124	            ):
   125	                spans.append(first)
   126	    return sorted({s.strip().replace("\\", "/") for s in spans if s.strip()})
   127	
   128	
   129	def _looks_like_pattern(cleaned: str) -> bool:
   130	    """True if the span contains a regex/glob metacharacter.
   131	
   132	    A quoted regex (e.g. ``^_?\\s*(no|none)\\b.*declared.*_?$``) or a shell
   133	    glob (e.g. ``__pycache__/*.pyc``) is not a literal path reference, even
   134	    though it may contain slashes and look pathish otherwise.
   135	    """
   136	    return any(ch in PATH_META_CHARS for ch in cleaned)
   137	
   138	
   139	def _looks_like_bare_domain(cleaned: str) -> bool:
   140	    """True if the span opens with a schemeless domain followed by a path.
   141	
   142	    Matches things like ``docs.python.org/3/library/os.html`` or
   143	    ``github.com/org/repo/blob/main/src/foo.py``. Requires a `/` after the
   144	    domain-looking head so plain filenames with an extension (e.g.
   145	    ``package.json``, which has no trailing path segment) are never
   146	    considered here.
   147	    """
   148	    if "/" not in cleaned:
   149	        return False
   150	    head = cleaned.split("/", 1)[0]
   151	    return bool(BARE_DOMAIN_RE.match(head))
   152	
   153	
   154	def _looks_like_placeholder(cleaned: str) -> bool:
   155	    """True if the span contains an angle-bracket placeholder anywhere.
   156	
   157	    Templated paths such as ``goals/<id>/data-contract.md`` describe a
   158	    *shape* of path, not a literal reference — the leading-character check
   159	    below only catches a span that *starts* with `<`; a placeholder in the
   160	    middle of an otherwise pathish span (e.g. after a real prefix like
   161	    `goals/`) needs its own check.
   162	    """
   163	    return "<" in cleaned or ">" in cleaned
   164	
   165	
   166	def pathish_citations(markdown_text: str) -> list[str]:
   167	    """Extract citation spans that look like file paths.
   168	
   169	    Beyond the protocol prefixes, any slash-containing span with a file
   170	    extension, a trailing slash, or a `..` segment is treated as a path so
   171	    that citations of source/test files (e.g. `src/app.py`) are verified too.
   172	    Spans with spaces, URLs, flags, and variables are ignored, as are
   173	    regex/glob patterns (`_looks_like_pattern`), bare-domain URLs
   174	    (`_looks_like_bare_domain`), and templated paths containing an
   175	    angle-bracket placeholder (`_looks_like_placeholder`, e.g.
   176	    `goals/<id>/data-contract.md`). A line carrying (or immediately
   177	    following a line that carries) the `<!-- verify:ignore -->` marker has
   178	    all of its citations skipped — see module docstring.
   179	    """
   180	    cited: list[str] = []
   181	    lines = markdown_text.splitlines()
   182	    for i, line in enumerate(lines):
   183	        if IGNORE_MARKER in line or (i > 0 and IGNORE_MARKER in lines[i - 1]):
   184	            continue
   185	        for span in CODE_SPAN.findall(line):
   186	            cleaned = span.strip().replace("\\", "/")
   187	            if not cleaned or " " in cleaned or "://" in cleaned:
   188	                continue
   189	            if cleaned.startswith(("-", "$", "<")):
   190	                continue
   191	            if _looks_like_pattern(cleaned):
   192	                continue
   193	            if _looks_like_bare_domain(cleaned):
   194	                continue
   195	            if _looks_like_placeholder(cleaned):
   196	                continue
   197	            if cleaned.startswith(PATHISH_PREFIXES):
   198	                cited.append(cleaned)
   199	                continue
   200	            if "/" in cleaned:
   201	                tail = cleaned.rsplit("/", 1)[-1]
   202	                if Path(tail).suffix or cleaned.endswith("/") or ".." in cleaned:
   203	                    cited.append(cleaned)
   204	    return cited
   205	
   206	
   207	def submodule_roots(project: Path) -> list[Path]:
   208	    """First-level git submodule directories declared in .gitmodules.
   209	
   210	    Used as extra resolution bases for Rule B citation existence (not for
   211	    Rule A scope-lock containment). A review may cite a path relative to a
   212	    submodule's own root (e.g. `plugins/harnessloop/` when `harnessloop` is
   213	    checked out as a submodule at <project>/harnessloop) rather than
   214	    relative to the outer project root; without this, such citations are
   215	    dangling relative to every existing base even though the file exists.
   216	
   217	    Only top-level entries (no nested path segments) are honored — this is
   218	    a minimal fix for the common case, not full recursive submodule
   219	    resolution. Projects without a .gitmodules file get an empty list and
   220	    behavior is unchanged.
   221	    """
   222	    gitmodules = project / ".gitmodules"
   223	    if not gitmodules.is_file():
   224	        return []
   225	    path_re = re.compile(r"^\s*path\s*=\s*(.+?)\s*$")
   226	    roots: list[Path] = []
   227	    for line in gitmodules.read_text(encoding="utf-8", errors="replace").splitlines():
   228	        match = path_re.match(line)
   229	        if not match:
   230	            continue
   231	        rel = match.group(1).strip().replace("\\", "/")
   232	        if not rel or "/" in rel:
   233	            continue
   234	        candidate = project / rel
   235	        if candidate.is_dir():
   236	            roots.append(candidate)
   237	    return roots
   238	
   239	
   240	def verify_round(project: Path, round_dir: Path) -> list[dict]:
   241	    violations: list[dict] = []
   242	    goal_dir = round_dir.parent.parent
   243	    bases = [project, goal_dir, round_dir]
   244	    # Rule B only: extra resolution bases for (1) citations that use one of
   245	    # the PATHISH_PREFIXES verbatim (setup/, state/, goals/, ...) — those
   246	    # directories actually live under <project>/.harnessloop/, which none of
   247	    # `bases` covers on their own — and (2) citations written relative to a
   248	    # submodule's own root. Kept separate from `bases` so Rule A's
   249	    # scope-lock containment check is not loosened by either addition.
   250	    citation_bases = bases + [project / ".harnessloop"] + submodule_roots(project)
   251	
   252	    checked_files = [
   253	        path
   254	        for sub in ("evidence", "reviews")
   255	        for path in sorted((round_dir / sub).rglob("*"))
   256	        if path.is_file()
   257	    ]
   258	
   259	    scope_lock = round_dir / "scope-lock.md"
   260	    if checked_files:
   261	        if not scope_lock.exists():
   262	            violations.append(
   263	                {
   264	                    "round": str(round_dir),
   265	                    "kind": "missing-scope-lock",
   266	                    "detail": f"{scope_lock} does not exist but evidence/review files do",
   267	                }
   268	            )
   269	        else:
   270	            spans = extract_allowed_spans(scope_lock.read_text(encoding="utf-8"))
   271	            if not spans:
   272	                violations.append(
   273	                    {
   274	                        "round": str(round_dir),
   275	                        "kind": "unparseable-allowed-changes",
   276	                        "detail": f"no backtick path spans found under '## Allowed Changes' in {scope_lock}",
   277	                    }
   278	                )
   279	            else:
   280	                for file_path in checked_files:
   281	                    allowed = any(
   282	                        is_under(file_path, base / span)
   283	                        for base in bases
   284	                        for span in spans
   285	                    )
   286	                    if not allowed:
   287	                        violations.append(
   288	                            {
   289	                                "round": str(round_dir),
   290	                                "kind": "scope-lock-violation",
   291	                                "detail": f"{file_path} is outside every allowed path in {scope_lock}",
   292	                            }
   293	                        )
   294	
   295	    reviews_dir = round_dir / "reviews"
   296	    if reviews_dir.is_dir():
   297	        for review in sorted(reviews_dir.rglob("*.md")):
   298	            for cited in pathish_citations(review.read_text(encoding="utf-8")):
   299	                if not any((base / cited).exists() for base in citation_bases):
   300	                    violations.append(
   301	                        {
   302	                            "round": str(round_dir),
   303	                            "kind": "dangling-citation",
   304	                            "detail": f"{review} cites `{cited}` which does not exist",
   305	                        }
   306	                    )
   307	
   308	    return violations
   309	
   310	
   311	def verify_project(project: Path) -> list[dict]:
   312	    goals_dir = project / ".harnessloop" / "goals"
   313	    if not goals_dir.is_dir():
   314	        return []
   315	    violations: list[dict] = []
   316	    for round_dir in sorted(goals_dir.glob("*/rounds/*")):
   317	        if round_dir.is_dir():
   318	            violations.extend(verify_round(project, round_dir))
   319	    return violations
   320	
   321	
   322	def main() -> int:
   323	    parser = argparse.ArgumentParser(
   324	        description=(
   325	            "Verify mechanical Harnessloop protocol gates (scope-lock containment "
   326	            "and citation existence). Citation spans that are regex/glob patterns, "
   327	            "bare-domain URLs (docs.python.org/..., github.com/...), or templated "
   328	            "paths with an angle-bracket placeholder (goals/<id>/...) are exempt "
   329	            "automatically; a citation known to be intentional prose rather than a "
   330	            "real reference can be exempted explicitly by putting "
   331	            "'<!-- verify:ignore -->' on the same line or the line before it. "
   332	            "Citations are resolved against the project root, the round's goal and "
   333	            "round directories, the project's own .harnessloop/ directory (for "
   334	            "citations using a PATHISH_PREFIXES prefix verbatim, e.g. "
   335	            "setup/data-sources.md), and the root of every first-level git "
   336	            "submodule declared in the project's .gitmodules."
   337	        )
   338	    )
   339	    parser.add_argument("--project", "-p", default=".", help="Target project directory. Defaults to current directory.")
   340	    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON output.")
   341	    args = parser.parse_args()
   342	
   343	    project = Path(args.project).resolve()
   344	    if not project.is_dir():
   345	        print(f"Project directory not found: {project}", file=sys.stderr)
   346	        return 2
   347	
   348	    violations = verify_project(project)
   349	    if args.json:
   350	        print(json.dumps({"project": str(project), "violations": violations}, indent=2, ensure_ascii=False))
   351	    else:
   352	        print(f"Harnessloop verify: {project}")
   353	        if violations:
   354	            for violation in violations:
   355	                print(f"  [{violation['kind']}] {violation['detail']}")
   356	            print(f"{len(violations)} violation(s) found.")
   357	        else:
   358	            print("All mechanical protocol gates passed.")
   359	    return 1 if violations else 0
   360	

