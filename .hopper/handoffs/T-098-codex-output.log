  3212	    /// `readChatHistoryPage`/`resolveChatHistoryNextOffset` 用 `offset` 数值游标；
  3213	    /// `session-history-state.ts` 的 `paginateSessionMessages` 用不透明的 `seq:` 前缀字符串
  3214	    /// cursor），字段名不能跨两条通路混用、也不能直接照抄 reconcile-history.py 的字段名。这里的循环
  3215	    /// 结构——翻页直到 `hasMore` 非真；游标不推进（重复 `nextOffset`）则拒绝继续、如实抛错，不静默
  3216	    /// 死循环；迭代次数设硬上限防止服务端分页缺陷造成无限循环——在**精神上**照抄
  3217	    /// reconcile-history.py 的 `resolve_online_history`/`MAX_HISTORY_PAGES`（任务书要求参考的翻页
  3218	    /// 逻辑），但字段名按这条 RPC 的真实契约改写。
  3219	    public func fetchFullHistory(kernelKey: String, pageLimit: Int) async throws -> [HistoryRecord] {
  3220	        var collected: [HistoryRecord] = []
  3221	        var offset: Int?
  3222	        var seenOffsets = Set<Int>()
  3223	        var pageCount = 0
  3224	
  3225	        while true {
  3226	            pageCount += 1
  3227	            guard pageCount <= Self.maxHistoryFetchPages else {
  3228	                throw KernelClientError.protocolMismatch(
  3229	                    "fetchFullHistory: exceeded \(Self.maxHistoryFetchPages) page(s) for kernelKey " +
  3230	                    "\(kernelKey) without hasMore:false — refusing to page forever " +
  3231	                    "(mirrors reconcile-history.py's MAX_HISTORY_PAGES guard)"
  3232	                )
  3233	            }
  3234	
  3235	            var params: JSONObject = ["sessionKey": kernelKey, "limit": pageLimit]
  3236	            if let offset { params["offset"] = offset }
  3237	            let result = try await request(method: "chat.history", params: params)
  3238	            prettyPrint("RECV chat.history result (page \(pageCount))", result)
  3239	
  3240	            guard let rawMessages = result["messages"] as? [Any] else {
  3241	                throw KernelClientError.protocolMismatch("chat.history result missing 'messages' array (page \(pageCount))")
  3242	            }
  3243	            collected.append(contentsOf: rawMessages.compactMap(parseHistoryRecord))
  3244	
  3245	            guard jsonBool(result["hasMore"]) == true else { break }
  3246	            guard let nextOffset = jsonInt(result["nextOffset"]) else {
  3247	                throw KernelClientError.protocolMismatch(
  3248	                    "chat.history result has hasMore:true but is missing an integer 'nextOffset' " +
  3249	                    "(page \(pageCount)) — refusing to guess a cursor, that would risk silently " +
  3250	                    "truncating history"
  3251	                )
  3252	            }
  3253	            guard !seenOffsets.contains(nextOffset) else {
  3254	                throw KernelClientError.protocolMismatch(
  3255	                    "chat.history pagination returned a repeated nextOffset=\(nextOffset) " +
  3256	                    "(page \(pageCount)) — cursor is not advancing, refusing to loop forever"
  3257	                )
  3258	            }
  3259	            seenOffsets.insert(nextOffset)
  3260	            offset = nextOffset
  3261	        }
  3262	
  3263	        // 多页翻页得到的顺序是"从新到旧"（每一页的 offset 往更早的消息移动，见上面协议文档注释），
  3264	        // 必须重新按 seq 升序排才是聊天界面期望的"从旧到新"阅读顺序。seq 缺失的记录（不应该发生——
  3265	        // openclaw `__openclaw.seq` 理应总是存在，但解析层已经诚实允许缺失，见
  3266	        // EventMapping.swift `parseHistoryRecord`）在比较时视为与任何一侧都不构成"更早"关系，
  3267	        // Swift 5 保证 `sorted(by:)` 稳定，因此这类记录只是保留其原始相对顺序，不会被强行拖到
  3268	        // 结果的开头或结尾。
