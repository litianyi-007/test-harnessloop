  5108	def _kleene_and(*conditions: "bool | None") -> "bool | None":
  5109	    """Three-valued (Kleene) AND: a known `False` wins over an unknown
  5110	    (`None`), which wins over `True`.
  5111	
  5112	    `check_loop_autocontinue_anomaly` uses this so a condition that is
  5113	    *definitively* False (e.g. this project's evidence health legitimately
  5114	    not all `valid`) produces a definitive "no anomaly" even when some
  5115	    *other* condition is separately unparsable (e.g. `control-contract.md`
  5116	    has no `- Profile:` field at all) -- the non-trigger is reported as an
  5117	    intentional, explicable "no", not folded into
  5118	    `loop_anomaly_skipped_unparsable`, which is reserved for the case where
  5119	    *no* condition is known False and at least one cannot be determined at
  5120	    all. This is the standard 3-valued semantics for "should we raise an
  5121	    alarm" under partial information, and is exactly why this project's own
  5122	    real run (Profile: unwritten, unparsable; evidence health: determinately
  5123	    not all valid because of E4) reports zero anomalies attributed to the
  5124	    evidence-health reason, not to the unparsable Profile field.
  5125	    """
  5126	    if any(c is False for c in conditions):
  5127	        return False
  5128	    if any(c is None for c in conditions):
  5129	        return None
  5130	    return True
