   303	        private static string ResolveSendMessageText(Input input)
   304	        {
   305	            if (input.Kind == InputKind.Text) return input.Text ?? "";
   306	            var texts = (input.Parts ?? Array.Empty<Part>())
   307	                .Where(p => p.Kind == PartKind.Text)
   308	                .Select(p => p.Text)
   309	                .Where(t => t != null)
   310	                .Select(t => t!);
   311	            return string.Join("\n", texts);
   312	        }
