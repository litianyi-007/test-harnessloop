   660	        public static void CheckExpectOutbound(TimelineOp op, RunnerContext ctx)
   661	        {
   662	            if (op.Matches is not { } matches)
   663	                throw new RunnerException($"expect_outbound 缺少 matches（t={op.T}）");
   664	            var patternAny = FixtureJson.ToActualObject(op.Pattern);
   665	            if (!(patternAny.TryGetValue("type", out var typeObj) && typeObj is string expectedType))
   666	                throw new RunnerException($"expect_outbound({matches}) 的 pattern 缺少 'type'");
   667	
   668	            if (!ExpectOutboundMethodTable.TryGetValue(expectedType, out var expectedMethod))
   669	            {
   670	                ctx.AppendMismatch(
   671	                    $"expect_outbound({matches}): csharp-runner 未登记『{expectedType}』对应的 openclaw RPC 方法名" +
   672	                    "（该 D2 方法本轮 SG-5 未实现，或超出 Stage A/B 翻译范围）");
   673	                return;
   674	            }
   675	
   676	            var captured = ctx.CapturedOutboundMethod(matches);
   677	            if (captured != expectedMethod)
   678	            {
   679	                ctx.AppendMismatch(
   680	                    $"expect_outbound({matches}): 期望真实 client 调用底层 openclaw RPC 方法『{expectedMethod}』" +
   681	                    $"（对应 D2『{expectedType}』），实际捕获到『{captured ?? "<none>"}』");
   682	                return;
   683	            }
   684	
   685	            // T-050 REWORK #1 治根：规范化对象从 `CapturedParams`——真实捕获的原生 `params`——现算，
   686	            // 不是把 timeline `args`/fixture 声明值抄回去验证自己。
   687	            var parameters = ctx.CapturedParams(matches) ?? new JSONObject();
   688	            var normalized = NormalizeNativeParams(expectedMethod, parameters, expectedType, ctx);
   689	            var diff = PartialMatch.Match(normalized, patternAny, $"expect_outbound({matches})");
   690	            foreach (var d in diff) ctx.AppendMismatch(d);
   691	        }
