   645	        private static Dictionary<string, object?> NormalizeNativeParams(string method, JSONObject parameters, string expectedType, RunnerContext ctx)
   646	        {
   647	            var payload = new JSONObject(parameters);
   648	            var outp = new Dictionary<string, object?> { ["type"] = expectedType };
   649	            if (payload.Remove("key", out var keyVal) && keyVal is string key)
   650	            {
