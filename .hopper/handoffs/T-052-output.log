   627	func checkExpectOutbound(_ op: TimelineOp, ctx: RunnerContext) async throws {
   628	    guard let matches = op.matches else {
   629	        throw RunnerError.malformed("expect_outbound 缺少 matches（t=\(op.t)）")
   630	    }
   631	    let patternAny = (op.pattern?.value as? [String: Any]) ?? [:]
   632	    guard let expectedType = patternAny["type"] as? String else {
   633	        throw RunnerError.malformed("expect_outbound(\(matches)) 的 pattern 缺少 'type'")
   634	    }
   635	    guard let expectedMethod = expectOutboundMethodTable[expectedType] else {
   636	        await ctx.appendMismatch(
   637	            "expect_outbound(\(matches)): swift-runner 未登记『\(expectedType)』对应的 openclaw RPC 方法名" +
   638	            "（该 D2 方法本轮 SG-5 未实现，或超出 Stage A 翻译范围）"
   639	        )
   640	        return
   641	    }
   642	    let captured = await ctx.capturedOutboundMethod(for: matches)
   643	    guard captured == expectedMethod else {
   644	        await ctx.appendMismatch(
   645	            "expect_outbound(\(matches)): 期望真实 client 调用底层 openclaw RPC 方法『\(expectedMethod)』" +
   646	            "（对应 D2『\(expectedType)』），实际捕获到『\(captured ?? "<none>")』"
   647	        )
   648	        return
   649	    }
   650	    // T-048 REWORK #4 / T-050 REWORK #1（治根）：方法名匹配之后，不再到此为止——继续对一个『规范化
   651	    // 请求』做与 `ts-runner/runner.ts` 的 `partialMatch` 等价的完整子集深度匹配，让 pattern 里
   652	    // `type` 之外的字段（如 basic fixture 的 `sessionId`、interrupt 的 `payload.mode`）也真正生效。
   653	    // **T-050 治根**：规范化对象改从 `capturedParams(for:)`——真实捕获的原生 `params`——现算
   654	    // （`normalizeNativeParams`），不再是 T-048 REWORK #4 那版『捕获时顺手拿 timeline 的 args 拼一份』
   655	    // 的规范化请求（那份验证的是 fixture 自己声明的东西，不是真实发出的东西）。
   656	    let params = await ctx.capturedParams(for: matches) ?? [:]
   657	    let normalized = await normalizeNativeParams(method: expectedMethod, params: params, expectedType: expectedType, ctx: ctx)
   658	    let diff = partialMatch(actual: normalized, expected: patternAny, path: "expect_outbound(\(matches))")
   659	    for d in diff { await ctx.appendMismatch(d) }
   660	}
