   630	        /// <summary>
   631	        /// 把真实捕获到的 openclaw 原生 RPC `params`（`PerformClientCallAsync` 的 `TestSupportStubRpc`
   632	        /// 闭包同步收到的原始入参，真实 client 传的，不是 fixture 声明值）规范化成一个可与
   633	        /// `expect_outbound` 的 `pattern` 做完整深度匹配的『规范化请求』——逐字镜像
   634	        /// `SwiftFixtureRunner.swift` 的 `normalizeNativeParams`（T-050 REWORK #1 治根方案）：
   635	        ///   - `sessionId`：从捕获到的原生 `key` 反查『哪个已声明 session 拥有这个 kernelKey』。`key`
   636	        ///     不存在于 `params`（如 createSession，session 尚不存在）就不设置这个字段；`key` 存在但
   637	        ///     查不到对应的已声明 session（真实 client 把 `key` 发错，或发了一个从未声明过的 key）就
   638	        ///     显式置 <see cref="JsonNullMarker.Instance"/>——不 fallback 到任何 fixture 声明值，让
   639	        ///     pattern 里的 `sessionId` 断言在这种情况下真的失败。
   640	        ///   - `payload`：`params` 去掉 `key`（原生寻址字段，不是 D2 payload 概念）之后剩下的全部
   641	        ///     字段，原样保留原生字段名——仅 `sessions.send` 一项例外：把原生 `message` 反向映射回
   642	        ///     D1 `Input.text` 概念，只为了让这个字段能与 TS/Swift 端 `payload.text` 做跨语言一致的
   643	        ///     深度匹配；其余字段不改名，如实反映原生协议。
   644	        /// </summary>
   645	        private static Dictionary<string, object?> NormalizeNativeParams(string method, JSONObject parameters, string expectedType, RunnerContext ctx)
   646	        {
   647	            var payload = new JSONObject(parameters);
   648	            var outp = new Dictionary<string, object?> { ["type"] = expectedType };
   649	            if (payload.Remove("key", out var keyVal) && keyVal is string key)
   650	            {
   651	                var declared = ctx.DeclaredSessionId(key);
   652	                outp["sessionId"] = declared != null ? declared : JsonNullMarker.Instance;
   653	            }
   654	            if (method == "sessions.send" && payload.Remove("message", out var message))
   655	                payload["text"] = message;
   656	            outp["payload"] = payload;
   657	            return outp;
   658	        }
