   135	        }
   136	
   137	        /// <summary>`expected`/`actual` 均已从各自来源解出为『统一 object? 值域』（见文件头注释）。</summary>
   138	        public static List<string> Match(object? actual, object? expected, string path)
   139	        {
   140	            var mismatches = new List<string>();
   141	
   142	            // C# `null` == TS `expected === undefined` / Swift `Optional.none`（调用方没有提供这个
   143	            // 断言字段）——跳过，不产生任何 mismatch。**区别于**下面的显式 JSON null 分支。
   144	            if (expected is null) return mismatches;
   145	
   146	            if (IsExplicitNull(expected))
   147	            {
   148	                if (actual is null || !IsExplicitNull(actual))
   149	                    mismatches.Add($"{path}: 期望 null，实际 {Stringify(actual)}");
   150	                return mismatches;
   151	            }
   152	
   153	            if (expected is Dictionary<string, object?> expDict)
   154	            {
   155	                if (actual is not Dictionary<string, object?> actDict)
   156	                {
   157	                    mismatches.Add($"{path}: 期望对象 {Stringify(expected)}，实际 {Stringify(actual)}");
   158	                    return mismatches;
   159	                }
   160	                foreach (var (key, value) in expDict)
   161	                {
   162	                    var actualValue = actDict.TryGetValue(key, out var v) ? v : null;
   163	                    mismatches.AddRange(Match(actualValue, value, $"{path}.{key}"));
   164	                }
   165	                return mismatches;
   166	            }
   167	
   168	            if (expected is List<object?> expArr)
   169	            {
   170	                if (actual is not List<object?> actArr)
   171	                {
   172	                    mismatches.Add($"{path}: 期望数组，实际 {Stringify(actual)}");
   173	                    return mismatches;
   174	                }
   175	                if (actArr.Count != expArr.Count)
   176	                {
   177	                    mismatches.Add($"{path}: 期望长度 {expArr.Count}，实际长度 {actArr.Count}");
   178	                    return mismatches;
   179	                }
   180	                for (var i = 0; i < expArr.Count; i++)
   181	                    mismatches.AddRange(Match(actArr[i], expArr[i], $"{path}[{i}]"));
   182	                return mismatches;
   183	            }
   184	
   185	            // 标量：actual 缺失（C# null）或本身是显式 null，都不能满足『expected 是某个具体标量』的
   186	            // 比较——TS `actual === expected` 对 undefined/null 与任何非 null/undefined 标量比较恒为
   187	            // false。
   188	            if (actual is null || IsExplicitNull(actual))
   189	            {
   190	                mismatches.Add($"{path}: 期望 {Stringify(expected)}，实际 {Stringify(actual)}");
   191	                return mismatches;
   192	            }
   193	            if (!ScalarsEqual(actual, expected))
   194	                mismatches.Add($"{path}: 期望 {Stringify(expected)}，实际 {Stringify(actual)}");
   195	            return mismatches;
   196	        }
   197	    }
   198	}
