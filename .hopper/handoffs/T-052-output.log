   138	        public static object? ToActual(JsonElement value)
   139	        {
   140	            switch (value.ValueKind)
   141	            {
   142	                case JsonValueKind.Null:
   143	                case JsonValueKind.Undefined:
   144	                    return JsonNullMarker.Instance;
   145	                case JsonValueKind.True:
   146	                    return true;
   147	                case JsonValueKind.False:
   148	                    return false;
   149	                case JsonValueKind.String:
   150	                    return value.GetString();
   151	                case JsonValueKind.Number:
   152	                    return value.TryGetInt64(out var l) ? (object)l : value.GetDouble();
   153	                case JsonValueKind.Array:
   154	                {
   155	                    var list = new List<object?>();
   156	                    foreach (var item in value.EnumerateArray()) list.Add(ToActual(item));
   157	                    return list;
   158	                }
   159	                case JsonValueKind.Object:
   160	                {
   161	                    var dict = new Dictionary<string, object?>();
   162	                    foreach (var prop in value.EnumerateObject()) dict[prop.Name] = ToActual(prop.Value);
   163	                    return dict;
   164	                }
   165	                default:
   166	                    return null;
   167	            }
   168	        }
