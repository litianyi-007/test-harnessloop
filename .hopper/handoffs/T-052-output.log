   318	                    entry.TryGetValue("payload", out var p) && p is Dictionary<string, object?> payload &&
   319	                    payload.TryGetValue("outcome", out var o) && o is string outcome)
   320	                {
   321	                    return outcome;
   322	                }
   323	            }
   324	            return null;
   325	        }
