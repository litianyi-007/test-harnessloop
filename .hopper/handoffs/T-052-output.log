   121	        private static bool ScalarsEqual(object actual, object expected)
   122	        {
   123	            if (actual is string sa && expected is string sb) return sa == sb;
   124	
   125	            // Bool 必须两侧都是 bool 才能比较——C# 装箱运行时类型精确（不像 Swift 需要 objCType
   126	            // workaround，见文件头注释），`is bool` 足够可靠。
   127	            var actualIsBool = actual is bool;
   128	            var expectedIsBool = expected is bool;
   129	            if (actualIsBool || expectedIsBool)
   130	                return actualIsBool && expectedIsBool && (bool)actual == (bool)expected;
   131	
   132	            if (TryIntegerValue(actual, out var ia) && TryIntegerValue(expected, out var ib)) return ia == ib;
   133	            if (TryNumericValue(actual, out var na) && TryNumericValue(expected, out var nb)) return na == nb;
   134	            return false;
   135	        }
