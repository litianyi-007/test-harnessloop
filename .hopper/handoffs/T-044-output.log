     1	import {
     2	  enableSessionSuspensionTimersForGatewayStart,
     3	  getCleanupSuspendedLaneIdsForGatewayPublication,
     4	} from "../agents/session-suspension.js";
     5	// Gateway command-lane concurrency applier.
     6	// Pushes config-derived agent/cron limits into the process command queue.
     7	import { resolveAgentMaxConcurrent, resolveSubagentMaxConcurrent } from "../config/agent-limits.js";
     8	import { resolveCronMaxConcurrentRuns } from "../config/cron-limits.js";
     9	import type { OpenClawConfig } from "../config/types.openclaw.js";
    10	import { setCommandLaneConcurrency } from "../process/command-queue.js";
    11	import { CommandLane } from "../process/lanes.js";
    12	
    13	type GatewayLaneConcurrency = {
    14	  cron: number;
    15	  main: number;
    16	  subagent: number;
    17	};
    18	
    19	export function resolveGatewayLaneConcurrency(cfg: OpenClawConfig): GatewayLaneConcurrency {
    20	  return {
    21	    cron: resolveCronMaxConcurrentRuns(),
    22	    main: resolveAgentMaxConcurrent(cfg),
    23	    subagent: resolveSubagentMaxConcurrent(cfg),
    24	  };
    25	}
    26	
    27	export function applyGatewayLaneConcurrency(
    28	  concurrency: GatewayLaneConcurrency,
    29	  opts: { gatewayStart?: boolean } = {},
    30	): void {
    31	  // Lane ids are open strings (plugins mint their own); narrow once so the
    32	  // gateway-managed cases compare within the enum.
    33	  const suspendedLaneIds: ReadonlySet<string> = opts.gatewayStart
    34	    ? enableSessionSuspensionTimersForGatewayStart((laneId, savedResumeConcurrency) => {
    35	        switch (laneId as CommandLane) {
    36	          case CommandLane.Cron:
    37	          case CommandLane.CronNested:
    38	            return concurrency.cron;
    39	          case CommandLane.Main:
    40	            return concurrency.main;
    41	          case CommandLane.Nested:
    42	            return 1;
    43	          case CommandLane.Subagent:
    44	            return concurrency.subagent;
    45	          default:
    46	            return savedResumeConcurrency;
    47	        }
    48	      })
    49	    : getCleanupSuspendedLaneIdsForGatewayPublication();
    50	  // Resolution is deliberately separate: this commit-edge applier only updates
    51	  // live queue state and cannot reject a config midway through publication.
    52	  if (!suspendedLaneIds.has(CommandLane.Cron)) {
    53	    setCommandLaneConcurrency(CommandLane.Cron, concurrency.cron);
    54	  }
    55	  // Cron isolated agent turns remap inner LLM work to this lane.
    56	  if (!suspendedLaneIds.has(CommandLane.CronNested)) {
    57	    setCommandLaneConcurrency(CommandLane.CronNested, concurrency.cron);
    58	  }
    59	  if (!suspendedLaneIds.has(CommandLane.Main)) {
    60	    setCommandLaneConcurrency(CommandLane.Main, concurrency.main);
    61	  }
    62	  if (opts.gatewayStart) {
    63	    // sessions.send work uses a shared nested lane with no config knob; live
    64	    // reload must not resume a currently suspended nested lane before its TTL.
    65	    if (!suspendedLaneIds.has(CommandLane.Nested)) {
    66	      setCommandLaneConcurrency(CommandLane.Nested, 1);
    67	    }
    68	  }
    69	  if (!suspendedLaneIds.has(CommandLane.Subagent)) {
    70	    setCommandLaneConcurrency(CommandLane.Subagent, concurrency.subagent);
    71	  }
    72	}

