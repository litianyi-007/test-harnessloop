   144	/** Runs one execution with immutable ownership inherited by every emitted stream event. */
   145	export function withAgentRunLifecycleGeneration<T>(lifecycleGeneration: string, run: () => T): T {
   146	  const storage = getAgentEventExecutionContext();
   147	  const parent = storage.getStore();
   148	  const onceByRun =
   149	    parent?.lifecycleGeneration === lifecycleGeneration ? parent.onceByRun : new Map();
   150	  return storage.run({ lifecycleGeneration, onceByRun }, run);
   151	}
