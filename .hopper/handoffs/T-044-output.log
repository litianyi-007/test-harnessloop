   206	/** Starts a new ownership generation before an in-process gateway restart. */
   207	export function rotateAgentEventLifecycleGeneration(): string {
   208	  const state = getAgentEventState();
   209	  state.lifecycleGeneration = randomUUID();
   210	  // Rotation is the liveness choke point: after it returns, no prior-generation
   211	  // owner is operationally reachable. Recovery and runtime consumers therefore
   212	  // agree that only current-generation owners can drive or receive work.
   213	  const errors: unknown[] = [];
   214	  notifyListeners(
   215	    state.lifecycleRotationHandlers?.values() ?? [],
   216	    state.lifecycleGeneration,
   217	    (error) => errors.push(error),
   218	  );
   219	  if (errors.length > 0) {
   220	    throw new AggregateError(errors, "Failed to retire stale agent lifecycle owners");
   221	  }
   222	  return state.lifecycleGeneration;
   223	}
