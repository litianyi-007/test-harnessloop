   333	    private func receiveLoop() async {
   334	        guard let task = task else { return }
   335	        while !Task.isCancelled {
   336	            do {
   337	                let message = try await task.receive()
   338	                switch message {
   339	                case .data(let data):
   340	                    handleIncoming(data)
   341	                case .string(let text):
   342	                    if let data = text.data(using: .utf8) {
