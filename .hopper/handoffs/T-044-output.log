   301	    private func request(method: String, params: JSONObject) async throws -> JSONObject {
   302	        guard let task = task else { throw KernelClientError.notConnected }
   303	        nextReqID += 1
   304	        let id = "r\(nextReqID)"
   305	        let frame: JSONObject = ["type": "req", "id": id, "method": method, "params": params]
   306	        prettyPrint("SEND req \(method)", frame)
