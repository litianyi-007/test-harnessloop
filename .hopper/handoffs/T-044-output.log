   379	    private func handleIncoming(_ data: Data) {
   380	        guard let frame = try? decodeFrame(data) else { return }
   381	        guard let type = frame["type"] as? String else { return }
   382	
   383	        switch type {
   384	        case "res":
   385	            guard let id = frame["id"] as? String else { return }
   386	            guard let continuation = pending.removeValue(forKey: id) else { return }
   387	            let ok = (frame["ok"] as? Bool) ?? false
   388	            if ok {
   389	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   390	                continuation.resume(returning: payload)
   391	            } else {
   392	                let err = (frame["error"] as? JSONObject) ?? [:]
   393	                let code = (err["code"] as? String) ?? "unknown"
   394	                let message = err["message"] as? String
   395	                continuation.resume(throwing: KernelClientError.rpcRejected(code: code, message: message))
   396	            }
   397	
   398	        case "event":
   399	            guard let eventName = frame["event"] as? String else { return }
   400	            if let waiter = oneShotEventWaiters.removeValue(forKey: eventName) {
   401	                let payload = (frame["payload"] as? JSONObject) ?? [:]
