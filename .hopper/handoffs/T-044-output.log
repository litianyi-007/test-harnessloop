    50	// MARK: - JSON 取值小工具（JSONSerialization 产物的 [String: Any] 上做安全取值）
    51	
    52	func jsonInt(_ any: Any?) -> Int? {
    53	    if let i = any as? Int { return i }
    54	    if let n = any as? NSNumber { return n.intValue }
    55	    if let d = any as? Double { return Int(d) }
    56	    return nil
    57	}
    58	
    59	func jsonString(_ any: Any?) -> String? {
    60	    any as? String
    61	}
    62	
    63	func jsonBool(_ any: Any?) -> Bool? {
    64	    if let b = any as? Bool { return b }
    65	    if let n = any as? NSNumber { return n.boolValue }
    66	    return nil
    67	}
    68	
    69	func jsonObject(_ any: Any?) -> JSONObject? {
    70	    any as? JSONObject
    71	}
    72	
    73	func jsonArray(_ any: Any?) -> [Any]? {
    74	    any as? [Any]
    75	}
    76	
    77	/// 把一个内存里的 `Any`（来自 JSONSerialization 解出的 JSON 值）包成 D2 codegen 的 `JSONAny`。
    78	/// `JSONAny` 只暴露 `init(from: Decoder)`（Decodable 要求），没有直接take `Any` 的构造器——这里借道
    79	/// `JSONSerialization` + `JSONDecoder` 往返一次：包一层 `{"v": value}` 再解出来，是因为
    80	/// `JSONSerialization.data(withJSONObject:)` 在顶层只接受 Array/Dictionary，标量值（纯字符串/数字/
    81	/// 布尔）必须先包一层才能序列化。
    82	func makeJSONAny(_ value: Any) -> JSONAny {
    83	    let wrapper: JSONObject = ["v": value]
    84	    guard JSONSerialization.isValidJSONObject(wrapper),
    85	          let data = try? JSONSerialization.data(withJSONObject: wrapper, options: []),
    86	          let decoded = try? JSONDecoder().decode([String: JSONAny].self, from: data),
    87	          let result = decoded["v"] else {
    88	        // "null" 恒可解码（走 JSONAny.init(from:) 的 singleValueContainer + decodeNil 分支），
    89	        // 用作不可序列化输入（例如非 JSON 兼容的 Swift 值）时的诚实兜底，不是伪造业务数据。
    90	        return try! JSONDecoder().decode(JSONAny.self, from: Data("null".utf8))
    91	    }
    92	    return result
    93	}
