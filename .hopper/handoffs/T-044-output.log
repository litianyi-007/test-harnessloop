   292	  return (event: SessionLifecycleEvent): void => {
   293	    const swarmEvent = event as SessionLifecycleEvent & {
   294	      swarmGroupId?: string;
   295	      kind?: "phase" | "log";
   296	      text?: string;
   297	    };
   298	    const connIds = params.sessionEventSubscribers.getAll();
   299	    if (connIds.size === 0) {
   300	      return;
   301	    }
   302	    const sessionRow = loadGatewaySessionRow(event.sessionKey);
   303	    const activeRunState = sessionRow
   304	      ? resolveVisibleActiveSessionRunState({
   305	          context: params,
   306	          requestedKey: event.sessionKey,
   307	          canonicalKey: sessionRow.key,
   308	          sessionId: sessionRow.sessionId,
   309	          defaultAgentId: normalizeAgentId(resolveDefaultAgentId(getRuntimeConfig())),
   310	        })
   311	      : null;
   312	    params.broadcastToConnIds(
   313	      "sessions.changed",
   314	      {
   315	        sessionKey: event.sessionKey,
   316	        reason: event.reason,
   317	        parentSessionKey: event.parentSessionKey,
   318	        label: event.label,
   319	        displayName: event.displayName,
   320	        ts: Date.now(),
   321	        ...buildGatewaySessionSnapshot({
   322	          sessionRow,
   323	          label: event.label,
   324	          displayName: event.displayName,
   325	          parentSessionKey: event.parentSessionKey,
   326	          hasActiveRun: activeRunState?.active,
   327	          activeRunIds: activeRunState?.runIds,
   328	        }),
   329	        ...(swarmEvent.swarmGroupId
   330	          ? {
   331	              swarmGroupId: swarmEvent.swarmGroupId,
   332	              kind: swarmEvent.kind,
   333	              text: swarmEvent.text,
   334	            }
   335	          : {}),
   336	      },
   337	      connIds,
   338	      { dropIfSlow: true },
   339	    );
   340	  };
   341	}
