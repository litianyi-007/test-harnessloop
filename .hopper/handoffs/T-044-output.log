   408	            // operation_completed/approval_request/session_end）都不是从 session.message 来的，
   409	            // 见 EventMapping.swift 头注释①~⑤ 的现场 grounding。
   410	            switch eventName {
   411	            case "session.message":
   412	                handleSessionMessageEvent(frame)
   413	            case "agent":
   414	                handleAgentEvent(frame)
   415	            case "session.approval":
