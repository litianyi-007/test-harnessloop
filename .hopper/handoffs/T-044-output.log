   122	func mapOpenclawSessionMessageToKernelEvents(
   123	    _ payload: JSONObject,
   124	    ourSessionID: String,
   125	    runIDHint: String?
   126	) -> [EventMessageUnion] {
   127	    guard let message = jsonObject(payload["message"]) else { return [] }
   128	    guard jsonString(message["role"]) == "assistant" else {
   129	        // role=="user"：回显，无 D2 对应事件。role=="toolResult" 从未在 session.message 里现场
   130	        // 观察到（见头注释①），如果未来 openclaw 版本改变了这一点、这里会静默丢弃——保留在这里
   131	        // 一并说明，而不是假装处理了一个从未见过的分支。
   132	        return []
   133	    }
   134	
   135	    let seq = jsonInt(payload["messageSeq"]) ?? 0
   136	    let sentAt = Date()
   137	    var events: [EventMessageUnion] = []
   138	
   139	    // 顶层字段（usage/stopReason/timestamp）是 assistant 消息自己的，不是某个 content block 的——
   140	    // 供 turnComplete 之类的调用方缓存 usage 用，这里只按 content block 逐个产出事件。
   141	    let content = message["content"]
   142	    let blocks: [JSONObject]
   143	    if let arr = jsonArray(content) {
   144	        blocks = arr.compactMap { jsonObject($0) }
   145	    } else if let text = jsonString(content) {
   146	        // 纯字符串 content——SG-4 唯一覆盖过的形状，保留兼容。
   147	        blocks = [["type": "text", "text": text]]
   148	    } else {
   149	        blocks = []
   150	    }
   151	
   152	    for (index, block) in blocks.enumerated() {
   153	        guard let type = jsonString(block["type"]) else { continue }
   154	        switch type {
   155	        case "text":
   156	            guard let text = jsonString(block["text"]) else { continue }
   157	            let deltaPayload = MessageDeltaEventMessagePayload(delta: text, index: index, role: .assistant)
   158	            events.append(.messageDelta(MessageDeltaEventMessage(
   159	                direction: .event, payload: deltaPayload, runID: runIDHint,
   160	                sentAt: sentAt, seq: seq, sessionID: ourSessionID, ts: sentAt, type: .evtMessageDelta
   161	            )))
   162	
   163	        case "thinking", "reasoning", "redacted_thinking":
   164	            // grounding：源码——kernels/openclaw/src/gateway/chat-display-projection.ts
   165	            // `isAssistantInternalReasoningContentType` 把 "thinking"/"reasoning"/
   166	            // "redacted_thinking" 三个字面量识别为推理类 block（真实存在的类型判别逻辑，本轮
   167	            // 未能现场触发一次真实带 thinking block 的响应——已实测 kimi-for-coding 这个 provider
   168	            // 目录项声明 reasoning:false，sessions.patch 设 thinkingLevel:"high" 被服务端同步拒绝
   169	            // "not supported for d3proxy/kimi-for-coding (use off)"，结构性验证了"当前现场配置下
   170	            // thinking 不可达"，而不是模拟或猜测）。delta 取 text 字段，取不到则退化取
   171	            // openclaw "thinking" 字段名本身（两种拼法都在真实上游 provider 里出现过，源码里
   172	            // sanitizeChatHistoryContentBlock 同时处理 entry.text 与 entry.thinking 两个字段名）。
   173	            let delta = jsonString(block["text"]) ?? jsonString(block["thinking"]) ?? ""
   174	            let visibility: Visibility = type == "redacted_thinking" ? .summary : .raw
   175	            let thinkingPayload = ThinkingEventMessagePayload(delta: delta, visibility: visibility)
   176	            events.append(.thinking(ThinkingEventMessage(
   177	                direction: .event, payload: thinkingPayload, runID: runIDHint,
   178	                sentAt: sentAt, seq: seq, sessionID: ourSessionID, ts: sentAt, type: .evtThinking
   179	            )))
   180	
   181	        case "toolCall", "tool_call", "toolUse", "tool_use":
   182	            guard let toolCallID = jsonString(block["id"]), let name = jsonString(block["name"]) else { continue }
   183	            let input = makeJSONAny(block["arguments"] ?? block["input"] ?? [:] as JSONObject)
   184	            let toolCallPayload = ToolCallEventMessagePayload(input: input, name: name, status: .started, toolCallID: toolCallID)
   185	            events.append(.toolCall(ToolCallEventMessage(
   186	                direction: .event, payload: toolCallPayload, runID: runIDHint,
   187	                sentAt: sentAt, seq: seq, sessionID: ourSessionID, ts: sentAt, type: .evtToolCall
   188	            )))
   189	
   190	        default:
   191	            // 未识别的 content block type——如实跳过，不臆造映射。
   192	            continue
   193	        }
   194	    }
   195	
   196	    return events
   197	}
   219	func mapOpenclawAgentCommandOutputToToolResult(
   220	    _ data: JSONObject,
   221	    ourSessionID: String,
   222	    runIDHint: String?,
   223	    seq: Int
   224	) -> EventMessageUnion? {
   225	    guard jsonString(data["phase"]) == "end" else { return nil }
   226	    guard let toolCallID = jsonString(data["toolCallId"]) else { return nil }
   227	
   228	    let status = jsonString(data["status"])
   229	    let exitCode = jsonInt(data["exitCode"])
   230	    let isError = (status == "failed") || ((exitCode ?? 0) != 0)
   231	    let output = makeJSONAny(data["output"] ?? "")
   232	    let durationMS = jsonInt(data["durationMs"])
   233	
   234	    let resultPayload = ToolResultEventMessagePayload(
   235	        durationMS: durationMS, isError: isError, output: output, toolCallID: toolCallID
   236	    )
   237	    let now = Date()
   238	    return .toolResult(ToolResultEventMessage(
   239	        direction: .event, payload: resultPayload, runID: runIDHint,
   240	        sentAt: now, seq: seq, sessionID: ourSessionID, ts: now, type: .evtToolResult
   241	    ))
   242	}
   243	
   244	// MARK: - ③ agent(stream:"lifecycle") -> turnComplete / operationCompleted（现场实测样本 grounding）
   245	
   246	/// `aborted` 是判别键——两条真实样本：
   247	///  - 正常回合结束：`{"phase":"end","stopReason":"stop","aborted":false,...}` -> turnComplete。
   248	///  - 对一个进行中的 exec 调用发 `sessions.abort` 后：先是
   249	///    `{"phase":"end","status":"cancelled","aborted":true,"stopReason":"rpc",...}`，随后
   250	///    `{"phase":"error","aborted":true,"stopReason":"aborted","error":"This operation was
   251	///    aborted",...}` -> 均归为 operationCompleted（本轮 interrupt() 未实现，凡是 aborted:true
   252	///    观察到的操作一律记 operationKind:.stop，因为触发路径是 KernelClient.stop() 调用的
   253	///    sessions.abort）。
   254	/// usage 参数是调用方（OpenclawGatewayKernelClient）按 session 缓存的"最近一次 assistant
   255	/// session.message.usage"，因为 lifecycle 事件本身不带 input/output token 数（只有一个独立的
   256	/// `agent`/`stream:"usage"` 事件只报 outputTokens 累计值，字段集不对齐 D2 Usage{inputTokens,
   257	/// outputTokens} 的语义，不采用）。
   258	func mapOpenclawAgentLifecycleToKernelEvent(
   259	    _ data: JSONObject,
   260	    ourSessionID: String,
   261	    runIDHint: String?,
   262	    seq: Int,
   263	    cachedUsage: (input: Int, output: Int)?
   264	) -> EventMessageUnion? {
   265	    let phase = jsonString(data["phase"])
   266	    guard phase == "end" || phase == "error" else { return nil }
   267	    let aborted = jsonBool(data["aborted"]) ?? false
   268	    let rawStopReason = jsonString(data["stopReason"])
   269	    let now = Date()
   270	
   271	    guard let runID = runIDHint else {
   272	        // turnComplete/operationCompleted 的 runID 字段在 D2 里是必填——lifecycle 事件本身携带
   273	        // 真实 runId（payload.runId，由调用方通过 runIDHint 传入），理论上不会缺失；一旦真的缺失
   274	        // 就诚实跳过，不拿一个编造值填充必填字段。
   275	        return nil
   276	    }
   277	
   278	    if !aborted {
   279	        let stopReason: StopReason
   280	        switch rawStopReason {
   281	        case "stop": stopReason = .completed
   282	        case "max_turns", "maxTurns": stopReason = .maxTurns // 推断：本轮未现场观察到这个取值
   283	        default: stopReason = .error // 推断兜底：非 aborted 且不是已知"正常结束"字样时，保守记 error
   284	        }
   285	        let usage = cachedUsage.map { Usage(inputTokens: $0.input, outputTokens: $0.output) }
   286	        let turnPayload = TurnCompleteEventMessagePayload(
   287	            degraded: nil, forceResolvedApprovals: nil, stopReason: stopReason, usage: usage
   288	        )
   289	        return .turnComplete(TurnCompleteEventMessage(
   290	            direction: .event, payload: turnPayload, runID: runID,
   291	            sentAt: now, seq: seq, sessionID: ourSessionID, ts: now, type: .evtTurnComplete
   292	        ))
   293	    }
   294	
   295	    // aborted == true -> operationCompleted。outcome 判别：真实样本里 phase=="end" 时
   296	    // status=="cancelled"（sessions.abort 的 RPC 结果本身也确认了 outcome:"aborted"）记
   297	    // succeeded（"这次 abort 操作成功执行了"，不是"这次 run 成功完成"——两者是不同维度）；
   298	    // phase=="error" 那条后续帧语义不够确定（可能是 abort 生效后的收尾错误，也可能是别的失败），
   299	    // 保守记 abortedEffectUnknown，不假装知道更多。
   300	    let outcome: PayloadOutcome = phase == "end" ? .succeeded : .abortedEffectUnknown
   301	    let operationID = "\(ourSessionID)-abort-\(runID)"
   302	    let detail = jsonString(data["error"])
   303	    let opPayload = OperationCompletedEventMessagePayload(
   304	        affectedRunID: runID, detail: detail, newRunID: nil,
   305	        operationID: operationID, operationKind: .stop, outcome: outcome
   306	    )
   307	    return .operationCompleted(OperationCompletedEventMessage(
   308	        direction: .event, payload: opPayload, runID: runID,
   309	        sentAt: now, seq: seq, sessionID: ourSessionID, ts: now, type: .evtOperationCompleted
   310	    ))
   311	}
   356	func mapOpenclawSessionApprovalToKernelEvent(
   357	    _ payload: JSONObject,
   358	    ourSessionID: String,
   359	    runIDHint: String?,
   360	    lastToolCallIDHint: String?,
   361	    seq: Int
   362	) -> EventMessageUnion? {
   363	    guard jsonString(payload["phase"]) == "pending" else {
   364	        // terminal 分支：见上方文档注释，D1 11 变体里没有它的对应位置。
   365	        return nil
   366	    }
   367	    guard let approval = jsonObject(payload["approval"]) else { return nil }
   368	    guard let reqID = jsonString(approval["id"]) else { return nil }
   369	    guard let toolCallID = lastToolCallIDHint else {
   370	        // 没有任何 toolCall 关联线索——诚实跳过，不拿占位符填必填字段。
   371	        return nil
   372	    }
   373	    guard let runID = runIDHint else {
   374	        // ApprovalRequestEventMessage.runID 是必填字段——lifecycle/session.message 事件本应已经
   375	        // 让调用方缓存到当前 session 的 runId；真缺失时诚实跳过，不拿 reqID/toolCallID 顶替一个
   376	        // 语义完全不同的字段。
   377	        return nil
   378	    }
   379	
   380	    let presentation = jsonObject(approval["presentation"]) ?? [:]
   381	    let openclawKind = jsonString(presentation["kind"])
   382	    let kind: KindElement = openclawKind == "exec" ? .exec : .tool // 见上方文档注释，非 exec 未验证
   383	
   384	    let createdAtMs = jsonInt(approval["createdAtMs"])
   385	    let expiresAtMs = jsonInt(approval["expiresAtMs"])
   386	    let timeoutMS = (createdAtMs != nil && expiresAtMs != nil) ? (expiresAtMs! - createdAtMs!) : 0
   387	
   388	    let approvalPayload = ApprovalRequestEventMessagePayload(
   389	        kind: kind,
   390	        payload: makeJSONAny(presentation),
   391	        proposedDecision: nil,
   392	        reqID: reqID,
   393	        timeoutAuthority: .documented,
   394	        timeoutMS: timeoutMS,
   395	        toolCallID: toolCallID
   396	    )
   397	    let now = msEpochToDate(jsonInt(payload["updatedAtMs"]))
   398	    return .approvalRequest(ApprovalRequestEventMessage(
   399	        direction: .event, payload: approvalPayload, runID: runID,
   400	        sentAt: now, seq: seq, sessionID: ourSessionID, ts: now, type: .evtApprovalRequest
   401	    ))
   402	}

