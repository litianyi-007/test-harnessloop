   153	/** Shares one operation across fallback attempts that belong to the same admitted run. */
   154	export function runOncePerAgentRun<T>(runId: string, operation: string, run: () => Promise<T>) {
   155	  const context = getAgentEventExecutionContext().getStore();
   156	  if (!context) {
   157	    return run();
   158	  }
   159	  const key = `${operation}:${runId}`;
   160	  const existing = context.onceByRun.get(key);
   161	  if (existing) {
   162	    return existing as Promise<T>;
   163	  }
   164	  const pending = Promise.resolve().then(run);
   165	  context.onceByRun.set(key, pending);
   166	  return pending;
   167	}
