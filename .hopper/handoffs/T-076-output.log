  2005	def parse_review_fields(decision_text: str) -> dict[str, str | None]:
  2006	    """Extract the four B2a review-declaration fields from a decision.md.
  2007	
  2008	    Same narrow convention as the existing Verdict/Residuals (E4) check:
  2009	    a case-insensitive `- <label>:` line prefix, matched against
  2010	    `.strip().lower()`, first occurrence wins, no prose parsing anywhere
  2011	    else in the file is consulted. A key's value is `None` when the field
  2012	    was never written at all — this is how `check_review_declaration`
  2013	    tells "field absent" (a `review-declaration-missing` violation) apart
  2014	    from "field present but its value turns out to be invalid" (a
  2015	    different, more specific violation kind).
  2016	
  2017	    `- Review verdict:` and `- Review digest:` are checked before
  2018	    `- Review:` for readability, but the ordering does not affect
  2019	    correctness: `"- review verdict:".startswith("- review:")` and
  2020	    `"- review digest:".startswith("- review:")` are both false (the
  2021	    character right after "review" differs: a space, not a colon), so
  2022	    none of these four prefixes can ever shadow another.
  2023	    """
  2024	    fields: dict[str, str | None] = {
  2025	        "review": None,
  2026	        "reviewer": None,
  2027	        "review_verdict": None,
  2028	        "review_digest": None,
  2029	    }
  2030	    for line in decision_text.splitlines():
  2031	        stripped = line.strip()
  2032	        low = stripped.lower()
  2033	        if fields["review_verdict"] is None and low.startswith("- review verdict:"):
  2034	            fields["review_verdict"] = stripped.split(":", 1)[1].strip()
  2035	        elif fields["review_digest"] is None and low.startswith("- review digest:"):
  2036	            fields["review_digest"] = stripped.split(":", 1)[1].strip()
  2037	        elif fields["reviewer"] is None and low.startswith("- reviewer:"):
  2038	            fields["reviewer"] = stripped.split(":", 1)[1].strip()
  2039	        elif fields["review"] is None and low.startswith("- review:"):
  2040	            fields["review"] = stripped.split(":", 1)[1].strip()
  2041	    return fields
