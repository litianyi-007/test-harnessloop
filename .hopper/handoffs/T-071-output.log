   317	IGNORE_MARKER = "<!-- verify:ignore -->"
   318	
   319	# Regex/glob metacharacters. A backtick span containing any of these is a
   320	# quoted pattern (regex alternation, anchors, glob wildcards, ...), not a
   321	# literal path, so it is never treated as a citation.
   322	PATH_META_CHARS = frozenset("^$*?|(){}[]\\+")
   323	
   324	# A bare (schemeless) domain: at least two dot-separated alnum/hyphen
   325	# labels, e.g. "docs.python.org" or "github.com". Anchored so it must
   326	# consume the whole first path segment — this deliberately does not match
   327	# a plain filename with an extension (e.g. "package.json" has no `/`
   328	# after it, and is never even offered to this check; see
   329	# _looks_like_bare_domain).
   330	BARE_DOMAIN_RE = re.compile(
   331	    r"^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
   332	    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
   333	)
   334	
   335	# A Windows drive-letter absolute path, e.g. `C:/Users/x` -- checked after
