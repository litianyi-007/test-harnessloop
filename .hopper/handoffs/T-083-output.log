   136	    /// EventMessageUnion 十一个变体（app/generated/swift/DiscriminatedUnions.swift:104-116）里，
   137	    /// L1 只据此驱动两类 UI 效果：
   138	    ///   - evt.message.delta（.messageDelta）：assistant 文本的唯一来源，见
   139	    ///     appendAssistantDelta 的文档注释。
   140	    ///   - evt.turn_complete / evt.error / evt.session_end：不渲染成消息气泡本身（除了 error/
   141	    ///     sessionEnd 额外插入一条系统行用于"失败可见"），但驱动"是否在等回复"这个状态位——
   142	    ///     UI 最低要求里"有没有在等回复"这一条需要它们。
   143	    /// 其余 7 个变体（thinking/toolCall/toolResult/approvalRequest/capabilityChanged/
   144	    /// operationCompleted/approvalBufferResolved）按 D5.1（~/.llm-wiki/agent-app-design/product/
   145	    /// d5-1-message-flow.md §1 分工表）本就分属其它子面（如 approvalRequest 的完整呈现是 D5.3
   146	    /// 审批五态 UI，L1 任务书明确排除），也不在任务书列出的"UI 最低要求"范围内（该范围字面写的是
   147	    /// "用户发出的消息 + 从 subscribe 事件流里解析出的 assistant 文本"）——L1 故意不渲染，这是
   148	    /// scope 决定，不是漏做。
   149	    private func handle(_ event: EventMessageUnion, for session: ChatSessionViewModel) {
   150	        switch event {
   151	        case .messageDelta(let e):
   152	            appendAssistantDelta(e, to: session)
   153	        case .turnComplete:
   154	            session.isWaitingForReply = false
   155	        case .error(let e):
   156	            // ErrorEventMessagePayload.recoverable 是三态（none/run/session，D2.swift:2517-2521），
   157	            // 不是简单布尔；L1 采用保守简化：任何 evt.error 都先把"等待中"状态收掉，宁可指示提前
   158	            // 消失（后续如果真的还有 turnComplete 到达，会被再次置 false，幂等无害），也不要让
   159	            // composer 因为一次不会再有后续 turnComplete 的错误而永久卡在"等待中"。这是一处已知
   160	            // 简化，未按 recoverable 三态精细区分恢复行为（那属于 L2 审批/恢复 UI 的范畴）。
   161	            session.isWaitingForReply = false
   162	            session.messages.append(ChatMessage(role: .system, text: "[错误] \(e.payload.message)"))
   163	        case .sessionEnd(let e):
   164	            session.isWaitingForReply = false
   165	            session.messages.append(ChatMessage(role: .system, text: "[会话结束] reason=\(e.payload.reason.rawValue)"))
   166	        case .thinking, .toolCall, .toolResult, .approvalRequest, .capabilityChanged, .operationCompleted, .approvalBufferResolved:
   167	            break
   168	        }
   169	    }
   170	
   171	    /// evt.message.delta 的 payload 形状是 {delta: String, index: Int, messageID: String?, role: Role}
   172	    /// （app/generated/swift/D2.swift:1642-1667，`messageID` 是 rounds/0012 新增的可选字段）；role
   173	    /// 字段类型 `Role` 目前只有一个合法取值 `.assistant`（D2.swift 同结构体，没有 user/system 枚举
   174	    /// 成员，解码到其它取值会直接抛 DecodingError）——也就是说这个事件类型从协议层面就只可能携带
   175	    /// assistant 的流式文本，这正是任务书里"assistant 文本"的唯一取用点，本壳没有从其它变体里取过
   176	    /// assistant 文本。
   177	    ///
   178	    /// **rounds/0012 ①' C 方案——分组键与追加语义均已改写，取代上一轮按 (runId,index) 分组 + `+=`
   179	    /// 追加的实现**（旧实现见 git 历史）：
   180	    ///
   181	    /// - **分组键改为 `messageID`**（wire `session.message` 事件 payload.messageId 经 EventMapping
   182	    ///   透传而来，见 EventMapping.swift `mapOpenclawSessionMessageToKernelEvents` 的 text 分支）。
   183	    ///   旧键 `(runID, index)` 已被实测坐实为错误：`index` 只是单条 assistant 消息内的
   184	    ///   content-block 下标，每条新消息都从 0 重新计数；同一个 run 产出两条不同的 assistant 消息时
   185	    ///   二者 `(runID, index)` 相同（均为 `(runID, 0)`），旧键因此撞车、被误判成"同一条消息的后续
   186	    ///   分段"（rounds/0012 evidence/instrumented-run-findings.md §1.2 实测：两条不同 messageId 的
   187	    ///   帧被拼进同一个气泡，文本重复）。`messageID` 每帧互异（同上 evidence §1.3 实测），是协议层
   188	    ///   面唯一能可靠标识"这是不是同一条消息"的字段。
   189	    /// - **`+=` 追加改为 `=` 覆盖**：rounds/0012 实测坐实（同上 evidence §1.1）`session.message` 层
   190	    ///   不做增量投递——一条 assistant 消息 = 一条帧 = 一个 evt.message.delta，`delta` 携带的是
   191	    ///   **完整全文**，不是相对上一条的增量。因此"同一 messageID 再次到达"（例如未来协议改动带来的
   192	    ///   重放/补发）该用最新全文覆盖旧文本，`+=` 会把全文错误地拼接两遍——那正是本轮要修的重复
   193	    ///   bug 本身（旧 (runId,index) 键撞车时表现出的错误现象）。
   194	    /// - **`messageID` 缺失时的回退**：不复用任何既有分组键，直接开一条新气泡，且不写回
   195	    ///   `inProgressDeltaMessageID`（反正不会再被同一个 nil 命中）。缺失只会发生在旧版协议/未来
   196	    ///   协议变化未提供该字段的场景，本壳没有能力判断"这条没有 messageID 的 delta 是否该并入某条
   197	    ///   已有气泡"——瞎猜一个键去分组，正是本轮要修的原始缺陷的同构重演（拿一个不能唯一标识消息的
   198	    ///   键去分组，两条不同消息撞键、互相污染）。"缺 identity 时宁可多开一条气泡"严格安全于
   199	    ///   "缺 identity 时瞎猜一个键"：前者最坏情况是多一条冗余气泡，后者最坏情况是内容被错误合并/
   200	    ///   覆盖。
   201	    private func appendAssistantDelta(_ event: MessageDeltaEventMessage, to session: ChatSessionViewModel) {
   202	        session.isWaitingForReply = true
   203	        if let messageID = event.payload.messageID,
   204	           let existingID = session.inProgressDeltaMessageID[messageID],
   205	           let idx = session.messages.firstIndex(where: { $0.id == existingID }) {
   206	            session.messages[idx].text = event.payload.delta
   207	        } else {
   208	            let message = ChatMessage(role: .assistant, text: event.payload.delta)
   209	            session.messages.append(message)
   210	            if let messageID = event.payload.messageID {
   211	                session.inProgressDeltaMessageID[messageID] = message.id
   212	            }
   213	        }
   214	    }
   215	
   216	    private var connectionStatusSummary: String {
   217	        switch connectionStatus {
   218	        case .notConnected: return "未连接"
   219	        case .connecting: return "连接中，请稍候再试一次"
   220	        case .connected: return "已连接"
   221	        case .failed(let message): return "连接失败：\(message)"
   222	        }
   223	    }
   224	
   225	    private func describeError(_ error: Error) -> String {
   226	        if let kernelError = error as? KernelClientError {
   227	            return kernelError.description
   228	        }
   229	        return "\(error)"
   230	    }
   231	}
