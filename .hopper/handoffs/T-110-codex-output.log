   267	/// **测试 7（核心）**：混合事件序列（message -> toolCall -> thinking -> toolResult(配对) ->
   268	/// message）经 `session.timeline` 合并后，**保持真实到达顺序**——这是"让 agent 看起来像
   269	/// agent"这条改动的核心承诺：工具调用/思考必须出现在它们真实发生的时间点，而不是被甩到消息列表
   270	/// 末尾或按类型分组。toolResult 因为配对到已有的 toolCall 上，不产生新的 timeline 条目
   271	/// （5 个事件 -> 4 个 timeline 条目）。
   272	@MainActor
   273	func testSessionStoreTimelineInterleavesEventsInArrivalOrder() -> Bool {
   274	    let name = "rounds/0017 Change 1 (核心): session.timeline interleaves message/toolCall/thinking in true arrival order, not grouped by type"
   275	    let (store, session) = freshToolRenderingSession(id: "sess-timeline-order-1")
   276	
   277	    store.handle(.messageDelta(MessageDeltaEventMessage(
   278	        direction: .event,
   279	        payload: MessageDeltaEventMessagePayload(delta: "我先看看目录", index: 0, messageID: "msg-order-1", role: .assistant),
   280	        runID: "run-order-1", sentAt: Date(), seq: 1, sessionID: session.id, ts: Date(), type: .evtMessageDelta
   281	    )), for: session)
   282	    store.handle(toolCallEvent(toolCallID: "tool_order1", name: "exec", argumentsJSON: #"{"command":"ls"}"#, sessionID: session.id), for: session)
   283	    store.handle(thinkingEvent(delta: "目录看起来是空的", visibility: .raw, sessionID: session.id), for: session)
   284	    store.handle(toolResultEvent(toolCallID: "tool_order1", isError: false, durationMS: 3, output: "", sessionID: session.id), for: session)
   285	    store.handle(.messageDelta(MessageDeltaEventMessage(
   286	        direction: .event,
   287	        payload: MessageDeltaEventMessagePayload(delta: "目录是空的，我先创建一个文件", index: 0, messageID: "msg-order-2", role: .assistant),
   288	        runID: "run-order-1", sentAt: Date(), seq: 2, sessionID: session.id, ts: Date(), type: .evtMessageDelta
   289	    )), for: session)
   290	
   291	    let items = session.timeline
   292	    guard items.count == 4 else {
   293	        return fail(name, "expected 4 timeline items (2 messages + 1 toolCall(paired) + 1 thinking; the tool_result should NOT add a 5th), got \(items.count)")
   294	    }
   295	
   296	    func describe(_ item: ConversationItem) -> String {
   297	        switch item {
   298	        case .message: return "message"
   299	        case .toolCall: return "toolCall"
   300	        case .thinking: return "thinking"
   301	        }
   302	    }
   303	    let kinds = items.map(describe)
   304	    guard kinds == ["message", "toolCall", "thinking", "message"] else {
   305	        return fail(name, "expected arrival-order sequence [message, toolCall, thinking, message], got \(kinds) — tool calls/thinking must appear where they actually happened, not grouped or reordered")
   306	    }
   307	
   308	    guard case .toolCall(let toolItem) = items[1] else {
   309	        return fail(name, "expected items[1] to be the toolCall entry")
   310	    }
   311	    guard toolItem.result != nil else {
   312	        return fail(name, "expected the toolCall entry to already carry its paired result (tool_result arrived before the second message), got nil")
   313	    }
   314	    guard case .message(let firstMessage) = items[0], firstMessage.text == "我先看看目录" else {
   315	        return fail(name, "expected items[0] to be the first assistant message with its original text")
   316	    }
   317	    guard case .message(let secondMessage) = items[3], secondMessage.text == "目录是空的，我先创建一个文件" else {
   318	        return fail(name, "expected items[3] to be the second assistant message with its original text")
   319	    }
   320	
   321	    return pass(name, "5 个事件（message/toolCall/thinking/toolResult/message）经 timeline 合并后产出 4 条、顺序为 [message,toolCall(已配对结果),thinking,message]——与真实到达顺序一致")
   322	}
