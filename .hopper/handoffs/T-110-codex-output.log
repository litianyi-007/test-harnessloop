   100	/// **测试 1**：单独一条 evt.tool_call -> `session.toolCalls` 恰好一条，字段透传正确，`result`
   101	/// 尚未到达时为 nil（"进行中"态，SessionDetailView.ToolCallRow 据此显示 ProgressView）。
   102	@MainActor
   103	func testSessionStoreHandleToolCallProducesToolCallItem() -> Bool {
   104	    let name = "rounds/0017 Change 1: SessionStore.handle() with evt.tool_call produces a ToolCallItem in session.toolCalls"
   105	    let (store, session) = freshToolRenderingSession(id: "sess-tool-call-1")
   106	
   107	    store.handle(
   108	        toolCallEvent(toolCallID: "tool_abc123", name: "exec", argumentsJSON: #"{"command":"ls -la"}"#, sessionID: session.id),
   109	        for: session
   110	    )
   111	
   112	    guard session.toolCalls.count == 1 else {
   113	        return fail(name, "expected 1 ToolCallItem, got \(session.toolCalls.count)")
   114	    }
   115	    let item = session.toolCalls[0]
   116	    guard item.id == "tool_abc123" else {
   117	        return fail(name, "expected ToolCallItem.id == toolCallId 'tool_abc123', got '\(item.id)'")
   118	    }
   119	    guard item.name == "exec" else {
   120	        return fail(name, "expected ToolCallItem.name == 'exec', got '\(item.name)'")
   121	    }
   122	    guard item.argumentSummary.contains("ls -la") else {
   123	        return fail(name, "expected argumentSummary to surface the input JSON, got '\(item.argumentSummary)'")
   124	    }
   125	    guard item.result == nil else {
   126	        return fail(name, "expected result == nil before any evt.tool_result arrives (in-flight state), got \(String(describing: item.result))")
   127	    }
   128	    return pass(name, "evt.tool_call{toolCallId:tool_abc123,name:exec} 经 handle() 后 session.toolCalls 恰好一条，字段透传正确，result 为 nil（进行中态）")
   129	}
