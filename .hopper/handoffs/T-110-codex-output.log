   133	@MainActor
   134	func testSessionStoreHandleToolResultPairsWithMatchingToolCall() -> Bool {
   135	    let name = "rounds/0017 Change 1: evt.tool_result with matching toolCallId pairs onto the existing ToolCallItem (not a new row)"
