    54	private func toolCallEvent(
    55	    toolCallID: String, name: String, argumentsJSON: String, runID: String = "run-tool-1", sessionID: String
    56	) -> EventMessageUnion {
    57	    .toolCall(ToolCallEventMessage(
    58	        direction: .event,
    59	        payload: ToolCallEventMessagePayload(input: testJSONAny(argumentsJSON), name: name, status: .started, toolCallID: toolCallID),
    60	        runID: runID, sentAt: Date(), seq: 1, sessionID: sessionID, ts: Date(), type: .evtToolCall
    61	    ))
    62	}
    63	
    64	/// `output` 是工具的**原始输出文本**（例如 exec 的 stdout）——和真实映射代码
    65	/// （`EventMapping.swift` `mapOpenclawAgentCommandOutputToToolResult`：
    66	/// `let output = makeJSONAny(data["output"] ?? "")`）一致地把它当一个纯字符串值编码，不是预先
    67	/// 拼好的 JSON 文本，调用方不需要关心转义。
    68	private func toolResultEvent(
    69	    toolCallID: String, isError: Bool, durationMS: Int?, output: String, runID: String = "run-tool-1", sessionID: String
    70	) -> EventMessageUnion {
    71	    .toolResult(ToolResultEventMessage(
    72	        direction: .event,
    73	        payload: ToolResultEventMessagePayload(durationMS: durationMS, isError: isError, output: testJSONAnyString(output), toolCallID: toolCallID),
    74	        runID: runID, sentAt: Date(), seq: 2, sessionID: sessionID, ts: Date(), type: .evtToolResult
    75	    ))
    76	}
    77	
    78	private func thinkingEvent(delta: String, visibility: Visibility, runID: String = "run-tool-1", sessionID: String) -> EventMessageUnion {
    79	    .thinking(ThinkingEventMessage(
    80	        direction: .event,
    81	        payload: ThinkingEventMessagePayload(delta: delta, visibility: visibility),
    82	        runID: runID, sentAt: Date(), seq: 1, sessionID: sessionID, ts: Date(), type: .evtThinking
    83	    ))
    84	}
