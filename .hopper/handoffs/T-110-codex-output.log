   165	/// **测试 3**：failure 路径——tool_result 的 isError=true 时正确透传，且 preview 是 full 的可读
   166	/// 截断/压平（折叠态展示），不是原样多行文本。
   167	@MainActor
   168	func testSessionStoreHandleToolResultSurfacesFailureAndPreview() -> Bool {
   169	    let name = "rounds/0017 Change 1: evt.tool_result with isError=true surfaces failure; preview is a flattened/truncated view of full"
   170	    let (store, session) = freshToolRenderingSession(id: "sess-tool-fail-1")
   171	
   172	    store.handle(
   173	        toolCallEvent(toolCallID: "tool_fail1", name: "exec", argumentsJSON: #"{"command":"false"}"#, sessionID: session.id),
   174	        for: session
   175	    )
   176	    let longOutput = "line1\nline2\n" + String(repeating: "x", count: 200)
   177	    store.handle(
   178	        toolResultEvent(toolCallID: "tool_fail1", isError: true, durationMS: nil, output: longOutput, sessionID: session.id),
   179	        for: session
   180	    )
   181	
   182	    guard let result = session.toolCalls.first(where: { $0.id == "tool_fail1" })?.result else {
   183	        return fail(name, "expected a paired result for tool_fail1, found none")
   184	    }
   185	    guard result.isError else {
   186	        return fail(name, "expected isError == true, got false")
   187	    }
   188	    guard result.durationMS == nil else {
   189	        return fail(name, "expected durationMS == nil (payload carried none), got \(String(describing: result.durationMS))")
   190	    }
   191	    guard !result.preview.contains("\n") else {
   192	        return fail(name, "expected preview to be flattened (no raw newlines, for a single-line collapsed row), got '\(result.preview)'")
   193	    }
   194	    guard result.preview.count <= 130 else {
   195	        return fail(name, "expected preview to be truncated to a short summary, got \(result.preview.count) chars: '\(result.preview)'")
   196	    }
   197	    guard result.full == longOutput else {
   198	        return fail(name, "expected full (expanded view) to preserve the untruncated output including newlines, got '\(result.full)'")
   199	    }
   200	    return pass(name, "isError=true 正确透传；preview 已压平/截断（\(result.preview.count) chars，无换行）供折叠态展示，full 保留原始多行文本（\(result.full.count) chars）供展开态展示")
   201	}
