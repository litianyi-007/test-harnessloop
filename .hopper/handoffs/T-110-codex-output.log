   249	    ///      `fetchFullHistory`（OpenclawGatewayKernelClient.swift）内部的翻页/异常处理照抄
   250	    ///      reconcile-history.py 已经两轮对抗评审加固过的纪律（游标不推进即拒绝继续、`hasMore`
   251	    ///      语义拿到就当真、迭代次数硬上限），把"这条 RPC 没有 live 跑过"限定成一个明确、有限的
   252	    ///      残留风险（字段名/响应形状可能与源码判断有出入），而不是让这个假设静默传播成"翻页逻辑
   253	    ///      抄过来了应该没事"。这个风险原样记在交回报告里，不掩盖。
   254	    ///   4. **失败处理**：`fetchFullHistory` 抛错时只把这一个会话标成 `streamError`（复用既有的
   255	    ///      "事件流出错"展示通道，见 `SessionDetailView` 的红色横幅），不影响其它会话的恢复、也不
   256	    ///      影响这个会话本身继续接收新的实时消息（B/D 已经独立完成，不依赖 C 是否成功）。
   257	    private func backfillHistory(for session: ChatSessionViewModel, kernelKey: String) async {
   258	        do {
   259	            let records = try await client.fetchFullHistory(kernelKey: kernelKey, pageLimit: Self.historyPageLimit)
   260	            guard !records.isEmpty else { return }
   261	            // rounds/0017 Change 1：批量取一段恒排在这个会话所有实时项之前的 timelineSeq 区间——
   262	            // 理由见 ChatSessionViewModel.allocateHistoryTimelineSeqs(count:) 的文档注释。下标 0
   263	            // （records 里最早的记录）配 seqs[0]（区间里最小的键），保持批内相对顺序与 seqs 严格
   264	            // 递增一致。
   265	            let seqs = session.allocateHistoryTimelineSeqs(count: records.count)
   266	            let restored = zip(records, seqs).map { record, seq in
   267	                Self.historyChatMessage(from: record, timelineSeq: seq)
   268	            }
   269	            session.messages.insert(contentsOf: restored, at: 0)
   270	        } catch {
   271	            session.streamError = "历史回填失败：\(describeError(error))"
   272	        }
   273	    }
   274	
   275	    /// 历史消息的 role 字符串（openclaw 原始取值，见 `HistoryRecord.role` 文档注释）映射到 UI 的
   276	    /// 三态 `ChatRole`。"user"/"assistant" 是仅有的两个已知、有把握的取值；其它任何取值（包括
   277	    /// `HistoryRecord` 解析层在 role 缺失时填的 "unknown"）一律归入 `.system`，且把原始 role 字面
   278	    /// 值前缀进文本——不是把未知内容悄悄吞掉，也不是错误地冒充成 user/assistant 说的话，呼应本壳
   279	    /// "失败/异常可诊断"的既有原则（`ChatModels.swift` 对 `.system` 角色的定位）。
   280	    private static func historyChatMessage(from record: HistoryRecord, timelineSeq: Int) -> ChatMessage {
   281	        switch record.role {
   282	        case "user": return ChatMessage(role: .user, text: record.text, timelineSeq: timelineSeq)
   283	        case "assistant": return ChatMessage(role: .assistant, text: record.text, timelineSeq: timelineSeq)
   284	        default: return ChatMessage(role: .system, text: "[\(record.role)] \(record.text)", timelineSeq: timelineSeq)
   285	        }
   286	    }
   287	
   288	    /// 对应 UI 最低要求「输入框 + 发送动作：调 send」。真正的回复文本不从这里的返回值来——
   289	    /// send() 只回一个 runId 确认 RPC 已受理（OpenclawGatewayKernelClient.swift send() 文档注释：
   290	    /// "不是模型的最终输出"），内容全部走 consumeEvents() 里已经在跑的事件流异步到达。
   291	    public func sendMessage(_ text: String, in sessionID: String) async {
   292	        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
   293	        guard !trimmed.isEmpty, let session = session(for: sessionID) else { return }
   294	
   295	        session.messages.append(ChatMessage(role: .user, text: trimmed, timelineSeq: session.allocateLiveTimelineSeq()))
   296	        session.isWaitingForReply = true
   297	        do {
   298	            _ = try await client.send(session: session.handle, input: Input(kind: .text, text: trimmed, parts: nil))
   299	        } catch {
   300	            session.isWaitingForReply = false
   301	            session.messages.append(ChatMessage(
   302	                role: .system, text: "[发送失败] \(describeError(error))", timelineSeq: session.allocateLiveTimelineSeq()
   303	            ))
   304	        }
   305	    }
   306	
   307	    /// rounds/0012 ②：`subscribe()` 已经在 `createNewSession()` 里 await 过（见那里的文档注释），
   308	    /// 这里只负责消费拿到手的 `stream`，不再自己调用 `subscribe()`。这段 `for try await` 才是真正
   309	    /// "没有天然终点"、必须留在背景 Task 里的部分。
   310	    private func consumeEvents(for session: ChatSessionViewModel, stream: AsyncThrowingStream<EventMessageUnion, Error>) async {
   311	        do {
   312	            for try await event in stream {
   313	                handle(event, for: session)
   314	            }
   315	        } catch {
   316	            session.streamError = describeError(error)
   317	        }
   318	    }
   319	
   320	    /// EventMessageUnion 十一个变体（app/generated/swift/DiscriminatedUnions.swift:104-116）的
   321	    /// 分工（**rounds/0017 Change 1 更新**——上一版这里写"L1 只据此驱动两类 UI 效果……其余 7 个
   322	    /// 变体……L1 故意不渲染"，那是 L1 任务书字面范围下的 scope 决定；本轮任务书明确要求把
   323	    /// thinking/toolCall/toolResult 也渲染出来，理由是"用户看不到 agent 实际做了什么，只看得到
   324	    /// 一问一答"，如实更新这条分工说明，不留一份和代码不符的旧描述）：
   325	    ///   - evt.message.delta（.messageDelta）：assistant 文本的唯一来源，见
   326	    ///     appendAssistantDelta 的文档注释。
   327	    ///   - evt.tool_call / evt.tool_result / evt.thinking：分别见 `handleToolCall`/
   328	    ///     `handleToolResult`/`handleThinking`——写入 `session.toolCalls`/`session.thinkingItems`，
   329	    ///     由 `ChatSessionViewModel.timeline` 与 `session.messages` 合并成统一的呈现顺序。
   330	    ///   - evt.turn_complete / evt.error / evt.session_end / evt.operation_completed：不渲染成
   331	    ///     消息气泡本身（除了 error/sessionEnd/operationCompleted 额外插入一条系统行用于"失败/
   332	    ///     操作可见"），turn_complete/error 还驱动"是否在等回复"这个状态位——UI 最低要求里"有没有
   333	    ///     在等回复"这一条需要它们。
   334	    ///   - evt.approval_request / evt.approval_buffer_resolved：分属 D5.3 审批五态 UI 子面
   335	    ///     （rounds/0015/0016 已实现，见下方对应 case），不是本轮改动范围。
   336	    ///   - evt.capability_changed：仍然故意不渲染——不是 scope 裁剪，是这个变体本轮在 kernel-client
   337	    ///     适配器层结构性地没有任何真实触发路径（该 case 分支上方有单独的文档注释，不在此重复）。
   338	    ///
   339	    /// **可见性变更（rounds/0013 B2，最小化放宽）**：原为 `private`，本轮改为 internal（去掉
   340	    /// `private`，不是加 `public`/`open`）——唯一理由是让 `frame-replay-tests` target 能通过
   341	    /// `@testable import AgentShellCore` 直接驱动这个方法，喂真实 `EventMessageUnion` 事件、断言
   342	    /// `session.messages` 的分组结果（见 SessionStoreGroupingTests.swift）。这是本轮任务书明确
   343	    /// 建议的测试打点位置——比直接测 `appendAssistantDelta` 更忠实，因为它走的是
   344	    /// `consumeEvents()` 实际分发事件时经过的同一个入口，不是绕过 `handle` 的 switch-case 直接
   345	    /// 摆一个已知会命中 `.messageDelta` 分支的调用。没有放宽 `appendAssistantDelta`/
   346	    /// `consumeEvents`——这两个仍是 `private`，只放宽了 `handle` 这一处（`SessionStore` 类本身
   347	    /// 也从 internal 改成了 public，但那是模块拆分本身的必需后果，不是为测试做的，理由见本类型
   348	    /// 上方的头注释，和这里的"最小化"是两回事——两者的放宽幅度独立评估）。`@testable import`
   349	    /// 本身也不会把 `handle` 暴露成模块外可见（不加 `-enable-testing` 编译的调用方看不到它，
   350	    /// 仍然是"事实上的 private，仅测试可达"）。
   351	    func handle(_ event: EventMessageUnion, for session: ChatSessionViewModel) {
   352	        switch event {
   353	        case .messageDelta(let e):
   354	            appendAssistantDelta(e, to: session)
   355	        case .turnComplete(let e):
   356	            session.isWaitingForReply = false
   357	            // rounds/0015 C：`stop()` 在 abort 之前强制 deny 掉的审批，其 reqId 由 D1 §6.2 M3 要求
   358	            // 列在这里（`forceResolvedApprovals`，见 OpenclawGatewayKernelClient
   359	            // `forceDenyPendingApprovalsBeforeStop`）——这是壳能**契约性地**得知"这条审批已经被
   360	            // 终态化、不必再等用户裁决"的唯一推送通道（openclaw 的 session.approval(phase:terminal)
   361	            // 在 D2 十一变体里没有对应位置，收不到）。据此清掉卡片，避免留下永远点不动的僵尸审批。
   362	            if let forceResolved = e.payload.forceResolvedApprovals, !forceResolved.isEmpty {
   363	                let resolved = Set(forceResolved)
   364	                session.pendingApprovals.removeAll { resolved.contains($0.reqID) }
   365	            }
   366	        case .approvalRequest(let e):
   367	            // ---- rounds/0016（T-096 第 4 项）：**先清除旧卡片，再呈现这一条** ----
   368	            //
   369	            // 修前是无条件 `append`。在 D1 §6.2 的 FSM 下，一条新的 `approval_request` 到达**只能**
   370	            // 意味着"上一条 active 已经终态化、这一条是被提升上来的 #2"（适配器保证同一 session 同一
   371	            // 时刻只暴露一个 active pending）。而 UI 只渲染队头（SessionDetailView 的串行呈现）——
   372	            // append 的后果是：**用户看到的仍然是那张已经死掉的旧卡，提升项被挤在它后面，在界面上
   373	            // 根本不浮现**。这正是 T-096 第 4 项点名的失败态。
   374	            //
   375	            // 两条语句的**顺序就是要求本身**：先移除所有 reqId 不同的旧卡（清），再让这一条落位
   376	            // （呈现）。被清掉的旧卡在会话流里留一条系统行——不能让一张卡片无声消失，用户需要知道
   377	            // "刚才那条我还没来得及点的审批，已经不在了"。
   378	            let staleReqIDs = session.pendingApprovals.filter { $0.reqID != e.payload.reqID }.map(\.reqID)
   379	            session.pendingApprovals.removeAll { $0.reqID != e.payload.reqID }
   380	            if !staleReqIDs.isEmpty {
   381	                session.messages.append(ChatMessage(
   382	                    role: .system,
   383	                    text: "[审批] 上一条审批已在内核侧终态化，卡片已清除（reqId=\(staleReqIDs.joined(separator: ", "))）；"
   384	                        + "下面呈现的是队列中提升上来的下一条",
   385	                    timelineSeq: session.allocateLiveTimelineSeq()
   386	                ))
   387	            }
   388	            // 同一个 reqId 重复到达（例如断线重连后 subscribe 响应里的 approvalReplay 重放了一条
   389	            // 我们已经在显示的审批）不重复插卡片——按 reqId 去重，保留先到的那条（它的
   390	            // requestedAt 才是真正的产出时刻，重放帧的时间戳没有更权威）。
   391	            if !session.pendingApprovals.contains(where: { $0.reqID == e.payload.reqID }) {
   392	                session.pendingApprovals.append(PendingApprovalItem(event: e))
   393	            }
   394	        case .error(let e):
   395	            // ErrorEventMessagePayload.recoverable 是三态（none/run/session，D2.swift:2517-2521），
   396	            // 不是简单布尔；L1 采用保守简化：任何 evt.error 都先把"等待中"状态收掉，宁可指示提前
   397	            // 消失（后续如果真的还有 turnComplete 到达，会被再次置 false，幂等无害），也不要让
   398	            // composer 因为一次不会再有后续 turnComplete 的错误而永久卡在"等待中"。这是一处已知
   399	            // 简化，未按 recoverable 三态精细区分恢复行为（那属于 L2 审批/恢复 UI 的范畴）。
   400	            session.isWaitingForReply = false
   401	            session.messages.append(ChatMessage(
   402	                role: .system, text: "[错误] \(e.payload.message)", timelineSeq: session.allocateLiveTimelineSeq()
   403	            ))
   404	            // rounds/0016（T-096 第 4 项）：`approval_timeout` 是 D2 `KernelErrorCode` 里**字面
   405	            // 对应**"审批被内核判超时"的那个取值（common/errors.schema.json:10-18），适配器在
   406	            // active pending 被内核终态化时产出它（`handleApprovalTerminalSignal`）。它就是"先
   407	            // 清旧卡"的那一步——**必须在提升项的 approval_request 之前处理**，而事件流上它确实
   408	            // 排在前面（适配器先 yield error 再 yield 提升项，顺序是可观察的）。
   409	            //
   410	            // **为什么可以清整张列表而不是按 reqId 定点清**：`ErrorEventMessagePayload` 只有
   411	            // code/message/nativeCode/recoverable 四个字段，**没有 reqId 承载位**，而 `nativeCode`
   412	            // 按 D2 的字段注释"非契约稳定，UI 不得对其分支判断"——从消息文本里抠 reqId 更是不能做。
   413	            // 依据是 D1 §6.2 的**单 active 不变量**：同一时刻这个 session 至多有一张卡片，所以
   414	            // "清掉当前这张"与"按 reqId 清掉超时的那张"在这里是同一件事。这是不变量推出的结论，
   415	            // 不是"差不多就这样"的近似。
   416	            if e.payload.code == .approvalTimeout, !session.pendingApprovals.isEmpty {
   417	                let cleared = session.pendingApprovals.map(\.reqID)
   418	                session.pendingApprovals.removeAll()
   419	                session.messages.append(ChatMessage(
   420	                    role: .system,
   421	                    text: "[审批] 该请求已被内核判定超时（fail-closed 拒绝），卡片已清除（reqId=\(cleared.joined(separator: ", "))）",
   422	                    timelineSeq: session.allocateLiveTimelineSeq()
   423	                ))
   424	            }
   425	        case .sessionEnd(let e):
   426	            session.isWaitingForReply = false
   427	            session.messages.append(ChatMessage(
   428	                role: .system, text: "[会话结束] reason=\(e.payload.reason.rawValue)",
   429	                timelineSeq: session.allocateLiveTimelineSeq()
   430	            ))
   431	        case .approvalBufferResolved(let e):
   432	            // rounds/0015 返工①（D1 §6.2「缓冲生命周期的独立可见性」）：一条**从未被呈现给用户**的
   433	            // 审批请求，因为排在 FIFO 缓冲队列里超时、或因为队列溢出被适配器 fail-closed 拒绝，而
   434	            // 直接进了终态。D1 原文要求"不得让一条从未被看见的请求静默消失"——壳这边唯一诚实的落点
   435	            // 就是在会话流里留一条系统行：卡片是不可能有的（它从来没被 yield 成 approval_request），
   436	            // 但"这台机器上有一次操作被自动拒绝了"这件事必须能被用户看到。
   437	            //
   438	            // **刻意不弹模态、也不并进红色横幅**：沿用本壳既有的"错误必须可见但不打断"原则（同
   439	            // ApprovalModels.swift 对审批卡片行内错误的定位）。这不是错误，是一次 fail-closed 的
   440	            // 自动决策，系统行是它合适的分量。
   441	            let bufferReason: String
   442	            switch e.payload.reason {
   443	            case .bufferedTimeout: bufferReason = "在等待队列中超时（内核侧计时器不因排队而暂停）"
   444	            case .queueOverflow: bufferReason = "等待队列已满，按 fail-closed 策略自动拒绝"
   445	            }
   446	            session.messages.append(ChatMessage(
   447	                role: .system,
   448	                text: "[审批] 一条未及呈现的请求已被自动拒绝：\(bufferReason)（reqId=\(e.payload.reqID)）",
   449	                timelineSeq: session.allocateLiveTimelineSeq()
   450	            ))
   451	            // 防御性：这条 reqId 结构性地不该出现在卡片列表里（缓冲期的请求从未产出过
   452	            // approval_request），万一因为将来的改动出现了，也要跟着清掉，不留点不动的僵尸卡片。
   453	            session.pendingApprovals.removeAll { $0.reqID == e.payload.reqID }
   454	
   455	        // ---- rounds/0017 Change 1："让 agent 看起来像 agent" ----
   456	        //
   457	        // 以下三个变体此前一律 `break`——UI 只看得到"用户说一句、assistant 答一句"，agent 实际做了
   458	        // 什么（调了哪个工具、传了什么参数、跑出什么结果、有没有在推理）全部不可见，除非恰好触发一
   459	        // 张审批卡片。三个 handle* 私有方法把它们变成 `session.toolCalls`/`session.thinkingItems`
   460	        // 里的呈现条目，`ChatSessionViewModel.timeline` 负责把它们和 `session.messages` 按到达顺序
   461	        // 合并渲染（SessionDetailView 消费 `timeline`，不再只消费 `messages`）。
   462	        case .toolCall(let e):
   463	            handleToolCall(e, for: session)
   464	        case .toolResult(let e):
   465	            handleToolResult(e, for: session)
   466	        case .thinking(let e):
   467	            handleThinking(e, for: session)
   468	
   469	        // evt.operation_completed：只由 stop()/interrupt() 触发的终态镜像事件产生
   470	        // （OpenclawGatewayKernelClient.emitOperationCompletedMirror 的调用点全部在 stop() 的执行
   471	        // 路径上；mapOpenclawAgentLifecycleToAbortTerminalEvents 同样只在 stop() 发起的
   472	        // sessions.abort 收到 aborted 回执后触发）。本文件头注释已经记录 L1 明确不调用 stop()/
   473	        // interrupt()（respondApproval 例外，rounds/0015 已实现），本壳自身的操作序列结构性地不会
   474	        // 产生这个事件——但事件流是这个 session 的完整流，不是"只包含本壳发起的操作"的过滤流：
   475	        // 如果这个 session 被同一内核连接上的其它路径影响（诊断/未来的 L2 stop 按钮…），用户也不该
   476	        // 在事件流上看到这个操作发生过、却在 UI 上一声不吭。渲染成一行系统消息，代价只有这几行代码，
   477	        // 呼应本轮改动"agent 做的每件事都应该可见"的出发点——不算过度设计。
   478	        case .operationCompleted(let e):
   479	            handleOperationCompleted(e, for: session)
   480	
   481	        // evt.capability_changed：诚实标注 unsupported，不是遗漏。EventMapping.swift 头注释③原文：
   482	        // "evt.capability_changed 本轮仍未接入任何真实触发路径"——不是"L1 选择不调用触发它的方法"
   483	        // （像 operationCompleted 那样，理论上仍可能被外部路径触发），而是 kernel-client 适配器本身
   484	        // 这一轮就没有任何代码路径会产出这个 D2 变体（D1 INV-4：能力变更的感知路径是"内核 RPC
   485	        // 报错"+"我方 Server 能力开关 override"，从来不是内核主动 push 的事件）。渲染一个结构性上
   486	        // 从未会被喂入真实数据的分支，只会是死代码,不会增加任何用户能看到的价值。
   487	        case .capabilityChanged:
   488	            break
   489	        }
   490	    }
   491	
   492	    /// evt.tool_call -> 消息流里一张"进行中"的工具调用卡片。toolCallId 天然唯一（同一次调用只会
   493	    /// 有一个 evt.tool_call），直接当 `ToolCallItem.id`；参数摘要用 `JSONPreview.summarize(_:)` 从
   494	    /// payload.input（JSONAny）提炼出单行文本，供折叠态展示，展开态由视图层自己按需调
   495	    /// `JSONPreview.describe(_:)`——这里不预先计算未压缩的全文，避免为一个可能永远不会被展开的
   496	    /// 参数多存一份字符串。
