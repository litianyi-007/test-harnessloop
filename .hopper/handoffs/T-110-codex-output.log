     1	// rounds/0017 Change 1 —— 把 D2Generated.JSONAny.value（`Any`，quicktype 解码规则见
     2	// app/generated/swift/D2.swift 该类型定义：叶子值只可能是 Bool/Int64/Double/String/JSONNull，
     3	// 容器只可能是 [Any]/[String: Any]，与 JSON 语法完全对应）转成 UI 可以直接渲染的字符串。
     4	//
     5	// 不能复用 kernel-client 的 jsonString/jsonObject 等小工具（EventMapping.swift 头部）——那些是
     6	// `KernelClient` target 的 internal 符号，`AgentShellCore` 是独立 SwiftPM target，跨 target 看
     7	// 不到 internal 符号；任务硬约束又不允许改 app/kernel-client/swift/ 把它们放宽成 public。这里
     8	// 独立写一份最小实现，只服务"渲染预览"这一件事，不追求通用 JSON 序列化保真度（转义规则、数字
     9	// 精度往返等）——那是 kernel-client 层 wire 往返的职责，与此处"人能看懂个大概"的目标不同。
    10	import Foundation
    11	import D2Generated
    12	
    13	enum JSONPreview {
    14	    /// 折叠态用的单行摘要：先取完整描述，压平换行/制表符成空格（避免摘要把一行 UI 撑成好几行），
    15	    /// 再截断到 `maxLength`。
    16	    static func summarize(_ value: Any, maxLength: Int = 120) -> String {
    17	        let collapsed = describe(value)
    18	            .split(whereSeparator: { $0.isNewline || $0 == "\t" })
    19	            .joined(separator: " ")
    20	        guard collapsed.count > maxLength else { return collapsed }
    21	        return "\(collapsed.prefix(maxLength))…"
    22	    }
    23	
    24	    /// 展开态用的完整文本——不截断、不压平换行（多行输出，例如 exec 工具的 stdout，展开后应该
    25	    /// 保留原始换行,方便阅读)。字符串类型的叶子值直接原样返回(exec 工具的 output 本身就是一整段
    26	    /// 已经是人类可读文本的 stdout，不应该再包一层引号")；其余类型按 JSON 字面量形状描述。
    27	    static func describe(_ value: Any) -> String {
    28	        switch value {
    29	        case is JSONNull:
    30	            return "null"
    31	        case let string as String:
    32	            return string
    33	        case let bool as Bool:
    34	            return bool ? "true" : "false"
    35	        case let int as Int64:
    36	            return String(int)
    37	        case let int as Int:
    38	            return String(int)
    39	        case let double as Double:
    40	            return describeDouble(double)
    41	        case let array as [Any]:
    42	            return "[" + array.map(describe).joined(separator: ", ") + "]"
    43	        case let dict as [String: Any]:
    44	            let entries = dict.keys.sorted().map { key in "\(key): \(describe(dict[key] as Any))" }
    45	            return "{" + entries.joined(separator: ", ") + "}"
    46	        default:
    47	            // JSONAny.value 的解码规则不应该产出这个分支（见文件头注释），保留是防御性的——真出现
    48	            // 未识别类型时如实用 String(describing:) 兜底，而不是崩溃或吞掉这条数据。
    49	            return String(describing: value)
    50	        }
    51	    }
    52	
    53	    private static func describeDouble(_ value: Double) -> String {
    54	        guard value.isFinite, value == value.rounded(), abs(value) < 1e15 else {
    55	            return String(value)
    56	        }
    57	        return String(Int64(value))
    58	    }
    59	}
