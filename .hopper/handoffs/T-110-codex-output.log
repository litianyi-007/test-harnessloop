   660	    private func describeError(_ error: Error) -> String {
   661	        if let kernelError = error as? KernelClientError {
   662	            return kernelError.description
   663	        }
   664	        // rounds/0015：审批决策层自己的错误（决策档位不被内核支持 / 不在这条请求的 allowedDecisions
   665	        // 内 / 内核未兑现决策……）同样有可读的 description，不要落到下面的 `"\(error)"` 去打印一个
   666	        // 枚举 case 的原始拼写——审批错误正是最需要用户看懂的一类。
   667	        if let approvalError = error as? ApprovalDecisionError {
   668	            return approvalError.description
   669	        }
   670	        return "\(error)"
   671	    }
