    86	private func operationCompletedEvent(
    87	    operationID: String, operationKind: OperationKind, outcome: PayloadOutcome, detail: String?,
    88	    runID: String = "run-op-1", sessionID: String
    89	) -> EventMessageUnion {
    90	    .operationCompleted(OperationCompletedEventMessage(
    91	        direction: .event,
    92	        payload: OperationCompletedEventMessagePayload(
    93	            affectedRunID: runID, detail: detail, newRunID: nil,
    94	            operationID: operationID, operationKind: operationKind, outcome: outcome
    95	        ),
    96	        runID: runID, sentAt: Date(), seq: 1, sessionID: sessionID, ts: Date(), type: .evtOperationCompleted
    97	    ))
    98	}
