    34	/// token 的 Keychain 读写封装——本壳唯一允许落盘凭证的地方（其余一律环境变量/内存，尤其是
    35	/// **绝不**经由 `UserDefaults`/plist，见 `KernelEndpointDefaultsStore` 的分工边界与本仓根
    36	/// CLAUDE.md 凭证守门纪律：本仓 PUBLIC，且已有过一次真实凭证泄漏事件）。
    37	///
    38	/// 五条 Keychain 选型决策（任务书逐条点名要求说明理由）：
    39	///
    40	/// 1. **`kSecClassGenericPassword`**——token 是这个 app 私有的共享密钥，不对应任何互联网域名/协议
    41	///    （不适用 `kSecClassInternetPassword`），generic password 是 Apple 对"app 自己的密钥/token"
    42	///    这一类数据的标准分类。
    43	/// 2. **显式、稳定的 service/account 命名**——`service` 复用 `SessionPersistenceStore
    44	///    .bundleIdentifier` 这同一个命名空间前缀（不是巧合：两者都以"这是 AgentShell 这个具体 app
    45	///    的数据"为准绳，同一个前缀便于人工用 `security`/`defaults` 工具核对时一眼认出归属）；
    46	///    `account` 用固定字面量——当前只有一个 token 需要存，不需要按内核实例分账户，未来若要支持
    47	///    多 profile，account 是天然的扩展点，不需要改 service 命名方案。
    48	/// 3. **`kSecAttrAccessibleWhenUnlocked`（不是 `Always`/`AfterFirstUnlock`）**——token 只在用户
    49	///    主动使用这个 app 时才需要被读取，此时设备必然已解锁；没有任何后台/锁屏场景需要访问它。
    50	///    `Always`/`AfterFirstUnlock` 会把凭证暴露在"设备已开机但未解锁"的窗口期，对一个不需要这种
    51	///    可用性的场景是不必要的风险敞口，选最窄的那个。
    52	/// 4. **不设 `kSecAttrSynchronizable`**（即不启用 iCloud 钥匙串同步，留空=系统默认不同步）——
    53	///    这是本机开发用的临时 token，跟随用户 iCloud 账户同步到其它设备既无必要，也是任务书明确
    54	///    划定的红线；这里刻意不写 `kCFBooleanFalse` 之类的"看起来像特意关闭"的样板代码，因为那会
    55	///    掩盖"这本来就是默认值、不是这里做了什么特殊处理"这件事的真相。
    56	/// 5. **add-vs-update 两段式**——`SecItemAdd` 在条目已存在时返回 `errSecDuplicateItem`（不是
    57	///    覆盖写入），必须显式退回 `SecItemUpdate`；这是任务书明确点名的一处常见易错点，见 `save()`。
    58	///
    59	/// **实测过的经验风险（未在此代码里"修复"，因为没有通用修法——只能靠实测）**：本 app 用
    60	/// `codesign --force --deep --sign -` 做 ad-hoc 签名（`build-app-bundle.sh`），每次重新构建
    61	/// 产出的代码身份都不同；如果未来某次 Keychain 读取在真机上表现为访问被拒绝/弹出确认框，这正是
    62	/// ad-hoc 签名跨构建身份漂移的已知代价，而不是这段代码逻辑写错了。本轮任务报告里有一节专门记录
    63	/// 针对**已构建的 `.app` bundle 本身**（不是这段代码在测试里跑）做的实测结果。
    64	public struct KernelTokenKeychainStore: Sendable {
    65	    public static let defaultService = "\(SessionPersistenceStore.bundleIdentifier).kernel-token"
    66	    public static let defaultAccount = "kernel-token"
    67	
    68	    public let service: String
    69	    public let account: String
    70	
    71	    /// - Parameters:
    72	    ///   - service/account：默认指向生产用的固定命名；测试传入按 UUID 隔离的独立 service，
    73	    ///     避免污染开发者本机真实登录钥匙串里的这一条目、也避免测试之间互相干扰——同
    74	    ///     `SessionPersistenceStore.directoryOverride` 的隔离哲学，只是把"隔离维度"从文件系统
    75	    ///     目录换成了 Keychain 的 service 命名空间（Keychain 没有"临时目录"这个概念可用）。
    76	    public init(service: String = defaultService, account: String = defaultAccount) {
    77	        self.service = service
    78	        self.account = account
    79	    }
    80	
    81	    private func baseQuery() -> [String: Any] {
    82	        [
    83	            kSecClass as String: kSecClassGenericPassword,
    84	            kSecAttrService as String: service,
    85	            kSecAttrAccount as String: account,
    86	        ]
    87	    }
