    22	/// Keychain 读写的错误类型——不吞掉底层 `OSStatus`，逐字交给调用方（Settings UI）展示
    23	/// （任务书明确要求："surface Keychain errors to the UI rather than silently swallowing them"）。
    24	public struct KeychainStoreError: Error, CustomStringConvertible, Sendable {
    25	    public let status: OSStatus
    26	    public let operation: String
    27	
    28	    public var description: String {
    29	        let message = (SecCopyErrorMessageString(status, nil) as String?) ?? "OSStatus \(status)"
    30	        return "\(operation)失败：\(message)（OSStatus \(status)）"
    31	    }
    32	}
