   237	// MARK: - fromEnvironment() 行为未变回归锁
   238	
   239	/// **任务书硬要求的直接证据**："KernelShellConfig.fromEnvironment()'s behavior when the env vars
   240	/// are set must not change at all"——这条测试把两个 env 变量都设成自定义值，断言 endpoint/token/
   241	/// configWarning 三个字段与"这两个字段加入 source 标注之前"的历史行为逐字节一致（configWarning
   242	/// 为 nil，token/endpoint 直接取 env 值），只多断言两个新 source 字段确实被正确标成
   243	/// `.environmentVariable`（新增能力，不影响前三者）。
   244	func testFromEnvironmentBehaviorUnchangedWhenBothEnvVarsSet() -> Bool {
   245	    let name = "Settings UI 回归锁: fromEnvironment() 在两个 env 变量都设置时，endpoint/token/configWarning 与加入 source 标注之前逐字节一致"
   246	    // 用真实 setenv/unsetenv（不是 resolved() 的可注入 environment 参数——fromEnvironment() 本身
   247	    // 一直读的就是 ProcessInfo.processInfo.environment，要测它就必须测这条真实路径）。
   248	    setenv("AGENT_SHELL_KERNEL_URL", "ws://regression-lock-host:9999", 1)
   249	    setenv("AGENT_SHELL_KERNEL_TOKEN", "regression-lock-token", 1)
   250	    defer {
   251	        unsetenv("AGENT_SHELL_KERNEL_URL")
   252	        unsetenv("AGENT_SHELL_KERNEL_TOKEN")
   253	    }
   254	
   255	    let config = KernelShellConfig.fromEnvironment()
   256	
   257	    guard config.endpoint.absoluteString == "ws://regression-lock-host:9999" else {
   258	        return fail(name, "endpoint changed: got \(config.endpoint.absoluteString)")
   259	    }
   260	    guard config.token == "regression-lock-token" else {
   261	        return fail(name, "token changed: got \(config.token)")
   262	    }
   263	    guard config.configWarning == nil else {
   264	        return fail(name, "configWarning changed: expected nil, got \(config.configWarning ?? "")")
   265	    }
   266	    guard config.endpointSource == .environmentVariable, config.tokenSource == .environmentVariable else {
   267	        return fail(name, "expected both sources == .environmentVariable, got endpoint=\(config.endpointSource) token=\(config.tokenSource)")
   268	    }
   269	    return pass(name, "endpoint/token/configWarning 三个既有字段逐字节未变；新增的两个 source 字段正确标为 .environmentVariable")
   270	}
