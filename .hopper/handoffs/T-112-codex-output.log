    34	enum SelfTestHooks {
    35	    static func runIfRequestedAndExit() {
    36	        let env = ProcessInfo.processInfo.environment
    37	        var handled = false
    38	
    39	        if let token = env["AGENT_SHELL_SELFTEST_SAVE_TOKEN"] {
    40	            handled = true
    41	            runSaveToken(token)
    42	        }
    43	        if env["AGENT_SHELL_SELFTEST_READ_TOKEN"] != nil {
    44	            handled = true
    45	            runReadToken()
    46	        }
    47	        if env["AGENT_SHELL_SELFTEST_DELETE_TOKEN"] != nil {
    48	            handled = true
    49	            runDeleteToken()
    50	        }
    51	        if let endpoint = env["AGENT_SHELL_SELFTEST_SAVE_ENDPOINT"] {
    52	            handled = true
    53	            runSaveEndpoint(endpoint)
    54	        }
    55	
    56	        if handled {
    57	            exit(0)
    58	        }
    59	    }
    60	
    61	    private static func runSaveToken(_ token: String) {
    62	        let store = KernelTokenKeychainStore()
    63	        do {
    64	            try store.save(token: token)
    65	            let readBack = try store.read()
    66	            if readBack == token {
    67	                print("AGENT_SHELL_SELFTEST save-token: OK readback=match value=\(token)")
    68	            } else {
    69	                print("AGENT_SHELL_SELFTEST save-token: MISMATCH saved=\(token) readback=\(readBack ?? "nil")")
    70	                exit(1)
    71	            }
    72	        } catch {
    73	            print("AGENT_SHELL_SELFTEST save-token: ERROR \(error)")
    74	            exit(1)
    75	        }
    76	    }
    77	
    78	    private static func runReadToken() {
    79	        let store = KernelTokenKeychainStore()
    80	        do {
    81	            if let value = try store.read() {
