   182	func testEndpointAndTokenSourcesResolveIndependently() -> Bool {
   183	    let name = "Settings UI: KernelShellConfig.resolved() 的 endpoint/token 精度链彼此独立解析（一个来自已保存设置、另一个来自 env，互不影响）"
