   100	    public func session(for id: String) -> ChatSessionViewModel? {
   101	        sessions.first { $0.id == id }
   102	    }
   103	
   104	    /// Settings 面板"保存并重连"动作的落点——针对新的 `config`（调用方已经把用户刚保存的
   105	    /// endpoint/token 揉进 `KernelShellConfig.resolved()` 的结果）重建底层连接，让用户不需要
   106	    /// 重启整个 app 就能应用新设置。调用序列复用 `connectIfNeeded()`/
   107	    /// `restorePersistedSessionsIfNeeded()`——与应用冷启动时 `ContentView.task` 走的完全同一套
   108	    /// 逻辑，不另发明一套"重连专用"的连接/恢复实现。
   109	    ///
   110	    /// **为什么清空 `sessions`/`selectedSessionID`/`persistedKernelKeyBySessionID`**：这三者是
   111	    /// 绑定在*旧* `client`（旧 endpoint/token 所指向的那个内核连接）上的状态——旧内核可能压根不是
   112	    /// 同一个进程，继续用旧 `SessionHandle` 发消息/收流没有意义。持久化文件本身**不删**（这不是
   113	    /// 破坏性操作）：`restorePersistedSessionsIfNeeded()` 会在清空后的空列表上重新尝试按盘上记录
   114	    /// 找回会话——如果新目标其实是同一个内核（最常见场景：用户只是把打错的 token 改对），会话能
   115	    /// 找回来；如果新目标是真正不同的内核，每条记录按既有的失败路径独立标 `streamError`，不会让
   116	    /// 整个 app crash 或卡死（与本文件一贯的"失败可见、不致命"原则一致）。
   117	    public func reconnect(with config: KernelShellConfig) async {
   118	        client = OpenclawGatewayKernelClient(endpoint: config.endpoint, token: config.token)
   119	        connectionStatus = .notConnected
   120	        globalErrorMessage = nil
   121	        configWarning = config.configWarning
   122	        effectiveEndpointDisplay = config.endpoint.absoluteString
   123	        endpointSource = config.endpointSource
   124	        tokenSource = config.tokenSource
   125	        isTokenPlaceholder = config.isTokenPlaceholder
   126	        sessions = []
   127	        selectedSessionID = nil
   128	        persistedKernelKeyBySessionID = [:]
   129	        await connectIfNeeded()
   130	        await restorePersistedSessionsIfNeeded()
   131	    }
   132	
   133	    /// 应用启动时（ContentView 的 .task）调用一次；已连接或正在连接时直接返回，不重复握手。
   134	    public func connectIfNeeded() async {
   135	        switch connectionStatus {
   136	        case .connected, .connecting:
   137	            return
   138	        case .notConnected, .failed:
   139	            break
   140	        }
   141	        connectionStatus = .connecting
   142	        do {
   143	            let scopes = try await client.connect()
   144	            connectionStatus = .connected(scopes: scopes)
   145	        } catch {
   146	            connectionStatus = .failed(describeError(error))
   147	        }
   148	    }
