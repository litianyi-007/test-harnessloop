    36	    public let endpointSource: KernelConfigValueSource
    37	    public let tokenSource: KernelConfigValueSource
    38	
    39	    static let defaultEndpointString = "ws://127.0.0.1:18889"
    40	    static let defaultToken = "agentshell-local-placeholder-token"
    41	
    42	    /// 显式 init——**实测坐实**（不是靠读文档猜的）：Swift 对"带默认值表达式的 `let` 存储属性"
    43	    /// 的逐成员初始化器合成规则是**整个排除在参数列表之外**（不是"排除但仍可传"，也不是"included
    44	    /// with that default"）——同 `ChatMessage.swift` 里 `id`/`createdAt` 的先例（那两个字段同样是
    45	    /// 带默认值的 `let`，该文件文档注释原话："本就不进逐成员初始化器的参数列表"）。`endpointSource`/
    46	    /// `tokenSource` 需要在 `fromEnvironment()`/`resolved()` 里被显式传参覆盖默认值，所以不能指望
    47	    /// 编译器合成的隐式 init——手写一个，参数默认值直接写在参数列表上（`= .builtInDefault`），效果
    48	    /// 上等价于"没传就用默认值、传了就用传入值"，只是不再依赖那条被证伪的合成规则。访问级别不标
    49	    /// `public`（沿用原本合成 init 的 internal 级别）——`frame-replay-tests` 一直是通过
    50	    /// `@testable import AgentShellCore` 拿到 internal 级别的可见性，不是靠这个 init 本身 public。
    51	    init(
    52	        endpoint: URL, token: String, configWarning: String?,
    53	        endpointSource: KernelConfigValueSource = .builtInDefault,
    54	        tokenSource: KernelConfigValueSource = .builtInDefault
    55	    ) {
    56	        self.endpoint = endpoint
    57	        self.token = token
    58	        self.configWarning = configWarning
    59	        self.endpointSource = endpointSource
    60	        self.tokenSource = tokenSource
    61	    }
    62	
    63	    /// **任务书硬要求**：这个函数在 env 变量已设置时的行为不得有任何变化——下面前 6 行（到
    64	    /// `token` 那一行为止）与新增的两个 source 局部变量互不干扰，`endpoint`/`token`/
    65	    /// `configWarning` 三个字段的取值逻辑与新增 source 字段之前逐字节相同，只是把"这一次到底
    66	    /// 是不是从环境变量拿到的"这个已经算出来的事实也带进返回值里，不影响前者。
    67	    public static func fromEnvironment() -> KernelShellConfig {
    68	        let env = ProcessInfo.processInfo.environment
    69	        let urlString = env["AGENT_SHELL_KERNEL_URL"] ?? defaultEndpointString
    70	        let token = env["AGENT_SHELL_KERNEL_TOKEN"] ?? defaultToken
    71	        let endpointSource: KernelConfigValueSource =
    72	            env["AGENT_SHELL_KERNEL_URL"] != nil ? .environmentVariable : .builtInDefault
    73	        let tokenSource: KernelConfigValueSource =
    74	            env["AGENT_SHELL_KERNEL_TOKEN"] != nil ? .environmentVariable : .builtInDefault
    75	
    76	        if let url = URL(string: urlString) {
    77	            return KernelShellConfig(
    78	                endpoint: url, token: token, configWarning: nil,
    79	                endpointSource: endpointSource, tokenSource: tokenSource
    80	            )
    81	        }
    82	        // URL(string:) 只有在字符串本身不是合法 URL 语法时才会返回 nil——force unwrap 这个
    83	        // 编译期已知合法的字面量默认值是安全的，不是绕过错误处理。
    84	        let fallback = URL(string: defaultEndpointString)!
    85	        return KernelShellConfig(
    86	            endpoint: fallback,
    87	            token: token,
    88	            configWarning: "AGENT_SHELL_KERNEL_URL 不是合法 URL（\(urlString)），已回退到 \(defaultEndpointString)",
    89	            endpointSource: endpointSource,
    90	            tokenSource: tokenSource
    91	        )
    92	    }
    93	}
