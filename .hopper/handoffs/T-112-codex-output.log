   209	func testIsTokenPlaceholderTrueForDefaultTokenAndFalseForRealToken() -> Bool {
   210	    let name = "Settings UI: KernelShellConfig.isTokenPlaceholder 精确匹配内建占位符字符串，真实 token 与空字符串均判 false"
