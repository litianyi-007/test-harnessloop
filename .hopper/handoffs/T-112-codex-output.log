    89	    /// 读取。找不到条目返回 `nil`——这是正常态（全新安装、从未保存过），不是错误。其它任何
    90	    /// `OSStatus`（含数据无法解码成 UTF-8 字符串这种不该发生但仍需处理的形状）一律 `throw`。
    91	    public func read() throws -> String? {
    92	        var query = baseQuery()
    93	        query[kSecReturnData as String] = true
    94	        query[kSecMatchLimit as String] = kSecMatchLimitOne
    95	
    96	        var result: AnyObject?
    97	        let status = SecItemCopyMatching(query as CFDictionary, &result)
    98	        switch status {
    99	        case errSecSuccess:
   100	            guard let data = result as? Data, let token = String(data: data, encoding: .utf8) else {
   101	                throw KeychainStoreError(status: status, operation: "读取 token（数据解码）")
   102	            }
   103	            return token
   104	        case errSecItemNotFound:
   105	            return nil
   106	        default:
   107	            throw KeychainStoreError(status: status, operation: "读取 token")
   108	        }
   109	    }
   110	
   111	    /// 写入。先尝试 `SecItemAdd`；条目已存在（`errSecDuplicateItem`）则改走 `SecItemUpdate`——
   112	    /// Keychain 的标准 add-vs-update 两段式，见本类型文档注释第 5 条。
   113	    public func save(token: String) throws {
   114	        guard let data = token.data(using: .utf8) else {
   115	            throw KeychainStoreError(status: errSecParam, operation: "写入 token（字符串编码）")
   116	        }
   117	
   118	        var addQuery = baseQuery()
   119	        addQuery[kSecValueData as String] = data
   120	        addQuery[kSecAttrAccessible as String] = kSecAttrAccessibleWhenUnlocked
   121	
   122	        let addStatus = SecItemAdd(addQuery as CFDictionary, nil)
   123	        if addStatus == errSecSuccess {
   124	            return
   125	        }
   126	        guard addStatus == errSecDuplicateItem else {
   127	            throw KeychainStoreError(status: addStatus, operation: "写入 token（新增）")
   128	        }
   129	        // 已存在——SecItemUpdate 的 query 只需定位条目本身（不带 kSecValueData），待更新的字段放
   130	        // 在第二个参数（attributesToUpdate）。
   131	        let updateStatus = SecItemUpdate(baseQuery() as CFDictionary, [kSecValueData as String: data] as CFDictionary)
   132	        guard updateStatus == errSecSuccess else {
   133	            throw KeychainStoreError(status: updateStatus, operation: "写入 token（更新）")
   134	        }
   135	    }
   136	
   137	    /// 删除。找不到条目视为成功（幂等）——"清除已保存 token"这个操作不应该因为本来就没有条目
   138	    /// 而报错给用户看。
   139	    public func delete() throws {
   140	        let status = SecItemDelete(baseQuery() as CFDictionary)
   141	        guard status == errSecSuccess || status == errSecItemNotFound else {
   142	            throw KeychainStoreError(status: status, operation: "删除 token")
   143	        }
   144	    }
   145	}
   146	
   147	/// endpoint 的 UserDefaults 读写封装——endpoint **不是凭证**，UserDefaults/plist 明文落盘对它是
   148	/// 安全的（凭证只走上面的 `KernelTokenKeychainStore`，两个类型物理上分开，方便审计时一眼确认
   149	/// "写 UserDefaults 的代码路径里从没出现过 token 这个词"）。
   150	public enum KernelEndpointDefaultsStore {
   151	    /// 带 bundle id 前缀，避免与其它潜在 key 撞名（即便目前是这个 app 唯一的 UserDefaults 键）。
   152	    public static let userDefaultsKey = "\(SessionPersistenceStore.bundleIdentifier).kernelEndpoint"
   153	
   154	    /// - Parameter userDefaults：默认 `.standard`；测试传入 `UserDefaults(suiteName:)` 构造的
   155	    ///   独立 suite，不触碰开发者机器上真实的 `defaults` 数据库（同 Keychain store 的隔离哲学）。
   156	    public static func save(_ urlString: String, userDefaults: UserDefaults = .standard) {
   157	        userDefaults.set(urlString, forKey: userDefaultsKey)
   158	        // `synchronize()` 在现代 UserDefaults 文档里标注"通常不需要手动调用"——但那句话描述的是
   159	        // "进程继续正常运行，系统有机会在后台完成落盘同步"这个场景。Settings 面板保存后用户可能
   160	        // 立刻退出整个 app（本轮验证脚本甚至会立刻用外部 `defaults read` 命令核对落盘），不覆盖
   161	        // "写完几乎立刻整进程退出"这个边界情形；显式调用的成本只是几毫秒，换来"确定已落盘"这个
   162	        // 更强的保证，这里选择保守。
   163	        userDefaults.synchronize()
   164	    }
   165	
   166	    public static func clear(userDefaults: UserDefaults = .standard) {
   167	        userDefaults.removeObject(forKey: userDefaultsKey)
   168	        userDefaults.synchronize()
   169	    }
   170	
   171	    /// 空字符串按"未设置"处理（和 `nil` 同等对待）——防御性地对齐 Settings UI 里"不允许保存空
   172	    /// endpoint"的输入校验，即便未来出现绕过校验的写入路径，读取侧也不会把空字符串当成一个
   173	    /// "已保存"的有效来源。
   174	    public static func load(userDefaults: UserDefaults = .standard) -> String? {
   175	        guard let value = userDefaults.string(forKey: userDefaultsKey), !value.isEmpty else { return nil }
   176	        return value
   177	    }
   178	}
   179	
   180	extension KernelShellConfig {
   181	    /// Settings UI 的生效值解析入口——**env > 已保存设置 > 内建默认值**。`AgentShellApp.swift`
   182	    /// 用它（不是 `fromEnvironment()`）构造壳启动时的 `SessionStore`；`fromEnvironment()` 本身
   183	    /// 保持"只读环境变量、不知道 UserDefaults/Keychain 存在"的原始行为完全不变（任务书硬要求：
   184	    /// env 变量已设置时 `fromEnvironment()` 的行为不得有任何变化）——两个函数并存、互不调用、
   185	    /// 互不影响，`resolved()` 是新增的更完整入口，不是 `fromEnvironment()` 的替换实现。
   186	    ///
   187	    /// 三个参数均可注入（`environment`/`userDefaults`/`tokenKeychain`）——不是生产代码需要换
   188	    /// 实现，是让 `frame-replay-tests` 能在不碰真实进程环境变量、不碰开发者机器真实
   189	    /// UserDefaults/登录钥匙串的前提下，驱动 env×已保存设置×默认值的全部精度组合并保持测试互相
   190	    /// 隔离（同 `SessionPersistenceStore.directoryOverride`/`KernelTokenKeychainStore.service`
   191	    /// 的隔离哲学）。
   192	    public static func resolved(
   193	        environment: [String: String] = ProcessInfo.processInfo.environment,
   194	        userDefaults: UserDefaults = .standard,
   195	        tokenKeychain: KernelTokenKeychainStore = KernelTokenKeychainStore()
   196	    ) -> KernelShellConfig {
   197	        var warnings: [String] = []
   198	
   199	        // ---- endpoint：env > 已保存设置 > 内建默认值 ----
   200	        let endpointURL: URL
   201	        let endpointSource: KernelConfigValueSource
   202	        if let envURLString = environment["AGENT_SHELL_KERNEL_URL"] {
   203	            endpointSource = .environmentVariable
   204	            if let url = URL(string: envURLString) {
   205	                endpointURL = url
   206	            } else {
   207	                endpointURL = URL(string: defaultEndpointString)!
   208	                warnings.append(
   209	                    "AGENT_SHELL_KERNEL_URL 不是合法 URL（\(envURLString)），已回退到默认值 \(defaultEndpointString)"
   210	                )
   211	            }
   212	        } else if let storedURLString = KernelEndpointDefaultsStore.load(userDefaults: userDefaults) {
   213	            if let url = URL(string: storedURLString) {
   214	                endpointURL = url
   215	                endpointSource = .savedSetting
   216	            } else {
   217	                // 正常 Settings UI 写入前会校验 URL 合法性，这里不该发生；防御性覆盖仍然给出
   218	                // 明确回退与警示，而不是让一条脏数据卡死连接（呼应 SessionPersistenceStore.load()
   219	                // "坏数据不得永久卡死壳"的同一条项目级原则）。
   220	                endpointURL = URL(string: defaultEndpointString)!
   221	                endpointSource = .builtInDefault
   222	                warnings.append(
   223	                    "已保存的 endpoint 设置不是合法 URL（\(storedURLString)），已忽略并回退到默认值 \(defaultEndpointString)"
   224	                )
   225	            }
   226	        } else {
   227	            endpointURL = URL(string: defaultEndpointString)!
   228	            endpointSource = .builtInDefault
   229	        }
   230	
   231	        // ---- token：env > 已保存设置（Keychain） > 内建默认值 ----
   232	        let token: String
   233	        let tokenSource: KernelConfigValueSource
   234	        if let envToken = environment["AGENT_SHELL_KERNEL_TOKEN"] {
   235	            token = envToken
   236	            tokenSource = .environmentVariable
   237	        } else {
   238	            do {
   239	                if let stored = try tokenKeychain.read(), !stored.isEmpty {
   240	                    token = stored
   241	                    tokenSource = .savedSetting
   242	                } else {
   243	                    token = defaultToken
   244	                    tokenSource = .builtInDefault
   245	                }
   246	            } catch {
   247	                // Keychain 读取失败（不是"没找到"，是真错误——比如 ad-hoc 签名跨构建身份漂移
   248	                // 导致访问被拒）：不让这个错误直接掀翻整个 app 的启动路径，回退到占位符，但通过
   249	                // 既有的 configWarning 通道把原因带到侧栏——这正是任务书"surface Keychain errors
   250	                // to the UI rather than silently swallowing them"在启动路径上的落地方式。
   251	                token = defaultToken
   252	                tokenSource = .builtInDefault
   253	                warnings.append("读取已保存 token 失败，已回退到内建占位符：\(error)")
   254	            }
   255	        }
   256	
   257	        return KernelShellConfig(
   258	            endpoint: endpointURL,
   259	            token: token,
   260	            configWarning: warnings.isEmpty ? nil : warnings.joined(separator: "\n"),
   261	            endpointSource: endpointSource,
   262	            tokenSource: tokenSource
   263	        )
   264	    }
   265	
   266	    /// token 是否仍是内建占位符（`defaultToken` 字面量）——精确匹配这一个已知字符串，不是"token
   267	    /// 看起来是否可疑"的通用启发式（空字符串等其它"看起来也不像真 token"的取值不在这个判据的
   268	    /// 覆盖范围内，正常解析链路本就不会产出空字符串 token，见 `resolved()` 对空 Keychain 值的
   269	    /// 处理）。Settings 面板与侧栏据此判断要不要展示"请配置 token"提示。
   270	    public var isTokenPlaceholder: Bool { token == Self.defaultToken }
   271	}
     1	// Settings 面板——⌘, 唤出，标准 macOS `Settings` scene（注册见 AgentShellApp.swift）。
     2	//
     3	// 三条既定决策在这里的落地：
     4	//   1) token 只写 Keychain，永不落 UserDefaults/plist——本文件对 token 字段只调用
     5	//      `KernelTokenKeychainStore`，endpoint 字段只调用 `KernelEndpointDefaultsStore`，两条代码
     6	//      路径物理上分开（见 KernelShellSettingsStorage.swift 的分工注释），方便审计时一眼确认。
     7	//   2) 生效值来源（环境变量/已保存设置/内建默认值）显式展示在两个字段下方，而不是"存起来就当
     8	//      用户看得到"——尤其是来源为环境变量时，额外提示"这里保存的值当前不会生效"，抢在用户困惑
     9	//      之前把原因说清楚。
    10	//   3) 占位符 token 的主动提示在侧栏（SessionListView.tokenPlaceholderHint），本面板只负责
    11	//      "把它换掉"这个动作本身，不重复渲染同一条提示。
    12	//
    13	// 全程不用 `.alert()`/`.sheet()`——沿用本壳一贯的"错误内嵌可见、不模态打断"原则（SessionListView
    14	// 头注释）。
    15	
    16	import SwiftUI
    17	import AgentShellCore
    18	
    19	struct SettingsView: View {
    20	    @Environment(SessionStore.self) private var store
    21	
    22	    @State private var endpointText: String = ""
    23	    @State private var tokenText: String = ""
    24	    @State private var isTokenRevealed = false
    25	    @State private var isBusy = false
    26	    @State private var statusMessage: String?
    27	    @State private var errorMessage: String?
    28	    @State private var hasStoredToken = false
    29	
    30	    var body: some View {
    31	        Form {
    32	            Section {
    33	                TextField("ws://127.0.0.1:18889", text: $endpointText)
    34	                    .textFieldStyle(.roundedBorder)
    35	                sourceCaption(for: store.endpointSource, envVarName: "AGENT_SHELL_KERNEL_URL")
    36	            } header: {
    37	                Text("内核 Endpoint")
    38	            }
    39	
    40	            Section {
    41	                HStack {
    42	                    Group {
    43	                        if isTokenRevealed {
    44	                            TextField("输入新 token 以保存…", text: $tokenText)
    45	                        } else {
    46	                            SecureField("输入新 token 以保存…", text: $tokenText)
    47	                        }
    48	                    }
    49	                    .textFieldStyle(.roundedBorder)
    50	                    Button {
    51	                        isTokenRevealed.toggle()
    52	                    } label: {
    53	                        Image(systemName: isTokenRevealed ? "eye.slash" : "eye")
    54	                    }
    55	                    .buttonStyle(.plain)
    56	                    .help(isTokenRevealed ? "隐藏" : "显示")
    57	                }
    58	                Text(tokenStatusText)
    59	                    .font(.caption)
    60	                    .foregroundStyle(store.isTokenPlaceholder ? .orange : .secondary)
    61	                sourceCaption(for: store.tokenSource, envVarName: "AGENT_SHELL_KERNEL_TOKEN")
    62	                Text("留空并保存 = 不修改已保存的 token（不会清空 Keychain 里已有的值）。")
    63	                    .font(.caption2)
    64	                    .foregroundStyle(.secondary)
    65	                HStack {
    66	                    Spacer()
    67	                    Button("清除已保存 token", role: .destructive) {
    68	                        Task { await clearSavedToken() }
    69	                    }
    70	                    .disabled(isBusy || !hasStoredToken)
    71	                }
    72	            } header: {
    73	                Text("内核 Token（存入 Keychain，从不写入 UserDefaults/plist）")
    74	            }
    75	
    76	            Section {
    77	                HStack(spacing: 8) {
    78	                    Circle().fill(connectionColor).frame(width: 8, height: 8)
    79	                    Text(connectionText)
    80	                        .font(.caption)
    81	                        .foregroundStyle(.secondary)
    82	                }
    83	                if let statusMessage {
    84	                    Text(statusMessage).font(.caption).foregroundStyle(.green)
    85	                }
    86	                if let errorMessage {
    87	                    Text(errorMessage).font(.caption).foregroundStyle(.red)
    88	                }
    89	                HStack {
    90	                    Spacer()
    91	                    if isBusy {
    92	                        ProgressView().controlSize(.small)
    93	                    }
    94	                    Button("保存并重连") {
    95	                        Task { await saveAndReconnect() }
    96	                    }
    97	                    .keyboardShortcut(.defaultAction)
    98	                    .disabled(isBusy)
    99	                }
   100	            }
   101	        }
   102	        .padding(20)
   103	        .frame(width: 480)
   104	        .task { refreshFromStore() }
   105	    }
   106	
   107	    private var tokenStatusText: String {
   108	        if store.isTokenPlaceholder {
   109	            return "当前生效 token 仍是内建占位符——无法完成真实内核鉴权。"
   110	        }
   111	        return hasStoredToken
   112	            ? "Keychain 中已保存 token（当前生效值并非占位符）。"
   113	            : "当前生效 token 并非占位符（来自环境变量，Keychain 中未保存）。"
   114	    }
   115	
   116	    @ViewBuilder
   117	    private func sourceCaption(for source: KernelConfigValueSource, envVarName: String) -> some View {
   118	        switch source {
   119	        case .environmentVariable:
   120	            Text("生效值来自环境变量 \(envVarName)——在此保存的值要等该环境变量被取消设置后才会生效。")
   121	                .font(.caption2)
   122	                .foregroundStyle(.orange)
   123	        case .savedSetting:
   124	            Text("生效值来自已保存的设置。")
   125	                .font(.caption2)
   126	                .foregroundStyle(.secondary)
   127	        case .builtInDefault:
   128	            Text("生效值为内建默认值（尚未保存过设置）。")
   129	                .font(.caption2)
   130	                .foregroundStyle(.secondary)
   131	        }
   132	    }
   133	
   134	    private var connectionColor: Color {
   135	        switch store.connectionStatus {
   136	        case .notConnected: return .gray
   137	        case .connecting: return .yellow
   138	        case .connected: return .green
   139	        case .failed: return .red
   140	        }
   141	    }
   142	
   143	    private var connectionText: String {
   144	        switch store.connectionStatus {
   145	        case .notConnected: return "未连接"
   146	        case .connecting: return "连接中…"
   147	        case .connected(let scopes): return "已连接（scopes: \(scopes.joined(separator: ", "))）"
   148	        case .failed(let message): return "连接失败：\(message)"
   149	        }
   150	    }
   151	
   152	    private func refreshFromStore() {
   153	        endpointText = store.effectiveEndpointDisplay
   154	        hasStoredToken = (try? KernelTokenKeychainStore().read()) != nil
   155	    }
   156	
   157	    private func saveAndReconnect() async {
   158	        isBusy = true
   159	        errorMessage = nil
   160	        statusMessage = nil
   161	        defer { isBusy = false }
   162	
   163	        let trimmedEndpoint = endpointText.trimmingCharacters(in: .whitespacesAndNewlines)
   164	        if !trimmedEndpoint.isEmpty {
   165	            guard URL(string: trimmedEndpoint) != nil else {
   166	                errorMessage = "Endpoint 不是合法 URL：\(trimmedEndpoint)"
   167	                return
   168	            }
   169	            KernelEndpointDefaultsStore.save(trimmedEndpoint)
   170	        }
   171	
   172	        let trimmedToken = tokenText.trimmingCharacters(in: .whitespacesAndNewlines)
   173	        if !trimmedToken.isEmpty {
   174	            do {
   175	                try KernelTokenKeychainStore().save(token: trimmedToken)
   176	                tokenText = ""
   177	            } catch {
   178	                // 任务书要求："surface Keychain errors to the UI rather than silently
   179	                // swallowing them"——直接把 KeychainStoreError.description（内含 OSStatus 与系统
   180	                // 错误文案）原样展示，不改写成一句更"友好"但丢信息的通用提示。
   181	                errorMessage = "Keychain 保存失败：\(error)"
   182	                return
   183	            }
   184	        }
   185	
   186	        let resolved = KernelShellConfig.resolved()
   187	        await store.reconnect(with: resolved)
   188	        refreshFromStore()
   189	        statusMessage = "已保存，正在按新设置重连。"
   190	    }
   191	
   192	    private func clearSavedToken() async {
   193	        isBusy = true
   194	        errorMessage = nil
   195	        statusMessage = nil
   196	        defer { isBusy = false }
   197	        do {
   198	            try KernelTokenKeychainStore().delete()
   199	            let resolved = KernelShellConfig.resolved()
   200	            await store.reconnect(with: resolved)
   201	            refreshFromStore()
   202	            statusMessage = "已清除 Keychain 中保存的 token。"
   203	        } catch {
   204	            errorMessage = "清除失败：\(error)"
   205	        }
   206	    }
   207	}
     1	// Settings UI 实证测试钩子——**不是产品功能**。
     2	//
     3	// 任务书对 Keychain 持久化提出了一条明确的实证要求："this app is ad-hoc signed... which can
     4	// invalidate keychain item ACLs... Build the bundle, run it, save a token, quit, relaunch, and
     5	// confirm the token is still readable"——即必须针对**已经用 build-app-bundle.sh 组装、ad-hoc
     6	// 签名过的那个 .app 二进制本身**做实测，而不是靠推理，也不能靠跑在另一个不同签名身份的可执行文件
     7	// （比如 frame-replay-tests，它是另一个 SwiftPM target、另一份签名）里的单元测试替代——那验证的是
     8	// "这段 Keychain 代码逻辑对不对"，验证不到"这个具体 ad-hoc 签名身份下，Keychain 条目能不能跨进程
     9	// 重启存活"这件事本身。
    10	//
    11	// 这个沙箱环境没有可用的 macOS GUI 自动化工具（无法真的点开 Settings 面板、往输入框里打字、点
    12	// "保存并重连"按钮）。这几个环境变量让我们可以**直接运行 .app bundle 里那个二进制本身**
    13	// （`Contents/MacOS/AgentShell`，与双击打开 .app 启动的是同一份签名、同一份 Mach-O），走一遍
    14	// Settings 面板保存/清除 token 时会调用的**同一段** `KernelTokenKeychainStore`/
    15	// `KernelEndpointDefaultsStore` 代码，在真正的 `.app` 进程身份下验证读写是否真的跨重启存活——不
    16	// 需要 GUI，也不是另开一套验证专用的 mock 实现。
    17	//
    18	// 用法（均在读完对应操作后立即打印结果、`exit()`，不会展示任何窗口——只要有任意一个这类变量被设
    19	// 置就会短路掉正常的 UI 启动路径）：
    20	//
    21	//   AGENT_SHELL_SELFTEST_SAVE_TOKEN=<value>      保存到 Keychain，立即读回校验一致性，打印结果
    22	//   AGENT_SHELL_SELFTEST_READ_TOKEN=1            只读 Keychain（不写），打印读到的值
    23	//   AGENT_SHELL_SELFTEST_DELETE_TOKEN=1          删除 Keychain 条目，打印结果
    24	//   AGENT_SHELL_SELFTEST_SAVE_ENDPOINT=<value>   保存到 UserDefaults，立即读回校验一致性，打印结果
    25	//
    26	// 这里直接把读到的 token 打印到 stdout（不脱敏）——这是本轮验证脚本用来做"实际读到的值是否与
    27	// 保存时一致"人工核对的唯一途径，且验证时使用的都是本轮临时生成的假测试值，不是任何真实凭证；
    28	// 与 `reconcile-history.py` 那种处理真实 gateway token 的脚本"任何时候都不打印 token"的纪律不冲突
    29	// ——那是对真实凭证的规则，这里从头到尾都不涉及真实凭证。
