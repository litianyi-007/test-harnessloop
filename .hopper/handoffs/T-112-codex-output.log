    83	            } else {
    84	                print("AGENT_SHELL_SELFTEST read-token: NOT_FOUND")
    85	            }
    86	        } catch {
    87	            print("AGENT_SHELL_SELFTEST read-token: ERROR \(error)")
    88	            exit(1)
    89	        }
    90	    }
    91	
    92	    private static func runDeleteToken() {
    93	        do {
    94	            try KernelTokenKeychainStore().delete()
    95	            print("AGENT_SHELL_SELFTEST delete-token: OK")
    96	        } catch {
    97	            print("AGENT_SHELL_SELFTEST delete-token: ERROR \(error)")
    98	            exit(1)
    99	        }
   100	    }
   101	
   102	    private static func runSaveEndpoint(_ endpoint: String) {
   103	        KernelEndpointDefaultsStore.save(endpoint)
   104	        let readBack = KernelEndpointDefaultsStore.load()
   105	        if readBack == endpoint {
