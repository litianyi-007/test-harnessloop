    86	    /// `AgentShellCore` 也够不到——见 `currentKernelKey` 的存在理由，KernelClient.swift
    87	    /// `SessionRestoring` 协议文档注释）。
    88	    private var persistedKernelKeyBySessionID: [String: String] = [:]
    89	
    90	    public init(config: KernelShellConfig, persistence: SessionPersistenceStore = SessionPersistenceStore()) {
    91	        self.configWarning = config.configWarning
    92	        self.client = OpenclawGatewayKernelClient(endpoint: config.endpoint, token: config.token)
    93	        self.persistence = persistence
    94	        self.effectiveEndpointDisplay = config.endpoint.absoluteString
    95	        self.endpointSource = config.endpointSource
    96	        self.tokenSource = config.tokenSource
    97	        self.isTokenPlaceholder = config.isTokenPlaceholder
    98	    }
