   325	
   326	/// add-vs-update 两段式的直接证据：先 save() 一个值（走 SecItemAdd），再 save() 一个不同的值
   327	/// （必须走 errSecDuplicateItem -> SecItemUpdate 分支，而不是抛错或悄悄失败）。
   328	func testKeychainTokenStoreSavesReadsUpdatesAndDeletes() -> Bool {
   329	    let name = "Settings UI: KernelTokenKeychainStore 完整往返——save（新增）-> read -> save（更新，走 add-vs-update 的 update 分支）-> read -> delete -> read"
   330	    let store = freshSettingsTestKeychain("roundtrip")
   331	    defer { try? store.delete() }
   332	
   333	    do {
   334	        try store.save(token: "first-token-value")
   335	        guard try store.read() == "first-token-value" else {
   336	            return fail(name, "expected 'first-token-value' after first save (add path)")
   337	        }
   338	
   339	        // 第二次 save()：条目已存在，必须走 update 分支（SecItemAdd 会返回 errSecDuplicateItem）。
   340	        try store.save(token: "second-token-value-after-update")
   341	        guard try store.read() == "second-token-value-after-update" else {
   342	            return fail(name, "expected 'second-token-value-after-update' after second save (update path)")
   343	        }
   344	
   345	        try store.delete()
   346	        guard try store.read() == nil else {
   347	            return fail(name, "expected nil after delete()")
   348	        }
   349	    } catch {
   350	        return fail(name, "unexpected throw: \(error)")
   351	    }
   352	    return pass(name, "新增 -> 读回一致 -> 更新（覆盖同一 service/account）-> 读回新值 -> 删除 -> 读回 nil，全部符合预期")
   353	}
