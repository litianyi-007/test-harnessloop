   958	
   959	def _resolve_in_root(root: Path, rel: str) -> Path | None:
   960	    """PR-3 §2.5's two orthogonal containment defenses, applied to an
   961	    external reference root: `root` must already be canonical (this is the
   962	    same "pinned domain" `_is_contained_pinned` requires — see its
   963	    docstring).
   964	
   965	    Defense 1 — literal traversal rejection, applied to the raw text before
   966	    any join: an empty `rel`, or one starting with `/` or `~`, a Windows
   967	    drive-absolute form, or containing a `..` segment, is rejected before
   968	    ever touching the filesystem (mirrors `_looks_like_out_of_project` /
   969	    the project-domain `..` rejection in `_resolve_in_project` — the same
   970	    escape shapes are just as real against an external root as against the
   971	    project).
   972	
   973	    Defense 2 — unfolded raw join + pinned canonical containment: the
   974	    candidate is `root / rel`, never a pre-folded
   975	    `Path(os.path.normpath(root / rel))` copy of it (T-064 MUST-FIX C,
   976	    reapplied to the new domain: folding `link/../escape.md` lexically
   977	    *before* resolving would erase the very symlink hop containment exists
   978	    to catch). `_is_contained_pinned` resolves the raw join and checks it
   979	    against the domain pinned at load time.
   980	    """
   981	    if (
   982	        not rel
   983	        or rel.startswith(("/", "~"))
   984	        or WINDOWS_DRIVE_ABS_RE.match(rel)
   985	        or any(seg == ".." for seg in rel.split("/"))
   986	    ):
   987	        return None
   988	    candidate = root / rel
   989	    if not _is_contained_pinned(candidate, root):
   990	        return None
   991	    return candidate
   992	
   993	
   994	def _resolve_case_exact(root: Path, rel: str) -> Path | None:
   995	    """Walk `rel`'s segments under `root` one directory entry at a time via
   996	    `os.scandir`, matching each segment name *exactly* (byte-for-byte
   997	    string comparison), never through `Path.exists()`/`Path.is_dir()` --
   998	    G10: those two delegate to the host filesystem's own comparison, which
   999	    is case-*insensitive* (but case-preserving) on a default macOS or
  1000	    Windows filesystem, so a citation with the wrong case for a real file
  1001	    would otherwise resolve there (measured directly against this project's
  1002	    own external root: `@@wiki/KERNEL/FACTS.MD` resolves via `.exists()` on
  1003	    macOS even though the real file is `kernel/facts.md`).
  1004	
  1005	    Deliberately host-independent and never delegated to `resolve()`: this
  1006	    function's whole job is to disagree with the host filesystem's own
  1007	    case-folding when they differ, so it cannot reuse anything that follows
  1008	    that folding.
  1009	
  1010	    Returns the real, exact-case path if every segment matched exactly, or
  1011	    `None` the moment any segment does not (missing entry, or `root`/an
  1012	    intermediate segment is not actually a directory). A caller still owns
  1013	    the final existence/directory-semantics decision (`_exists_as`, called
  1014	    by `resolve_external_citation`) — this function only proves "an entry
  1015	    with this exact name exists at this level", not "the whole path is
  1016	    usable the way the citation implies" (e.g. a broken symlink's final
  1017	    segment is still found here; `resolve_external_citation` is what turns
  1018	    that into `not_found`, exactly as `_exists_as` does for the project
  1019	    domain).
  1020	    """
  1021	    current = root
  1022	    for seg in (s for s in rel.split("/") if s):
  1023	        if not current.is_dir():
  1024	            return None
  1025	        try:
  1026	            with os.scandir(current) as it:
  1027	                match = next((e for e in it if e.name == seg), None)
  1028	        except OSError:
  1029	            return None
  1030	        if match is None:
  1031	            return None
  1032	        current = current / seg
  1033	    return current
  1034	
