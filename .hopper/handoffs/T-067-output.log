   576	# ---------------------------------------------------------------------------
   577	# PR-3 fixture helpers (external-citation-base-spec-20260727.md §2-3). Every
   578	# fixture root these build is a fresh `tempfile.mkdtemp()` directory -- never
   579	# `~`, never a hardcoded real host directory (the one deliberate exception is
   580	# G4's own use of the live `Path.home()` value, which the forbidden-root rule
   581	# itself is defined against and must be tested with).
   582	# ---------------------------------------------------------------------------
   583	
   584	
   585	def _pr3_project(tmp_root: Path) -> Path:
   586	    """A minimal project fixture: one round with `evidence/`/`reviews/`
   587	    ready and a parseable `scope-lock.md`."""
   588	    project = tmp_root / "project"
   589	    round_dir = project / ".harnessloop" / "goals" / "20260101-001-pr3" / "rounds" / "0001"
   590	    (round_dir / "evidence").mkdir(parents=True)
   591	    (round_dir / "reviews").mkdir(parents=True)
   592	    (round_dir / "scope-lock.md").write_text(
   593	        "# Scope Lock\n\n## Allowed Changes\n\n"
   594	        "- Write reviews under `rounds/0001/reviews/`.\n",
   595	        encoding="utf-8",
   596	    )
   597	    return project
   598	
   599	
   600	def _pr3_round_dir(project: Path) -> Path:
   601	    return project / ".harnessloop" / "goals" / "20260101-001-pr3" / "rounds" / "0001"
   602	
   603	
   604	def _pr3_write_review(project: Path, text: str, name: str = "review.md") -> None:
   605	    (_pr3_round_dir(project) / "reviews" / name).write_text(text, encoding="utf-8")
   606	
   607	
   608	def _pr3_declare(project: Path, roots_obj: dict) -> None:
   609	    setup_dir = project / ".harnessloop" / "setup"
   610	    setup_dir.mkdir(parents=True, exist_ok=True)
   611	    (setup_dir / "reference-roots.json").write_text(json.dumps(roots_obj), encoding="utf-8")
   612	
   613	
   614	def _pr3_bind(project: Path, bindings_obj: dict) -> None:
   615	    local_dir = project / ".harnessloop" / "local"
   616	    local_dir.mkdir(parents=True, exist_ok=True)
   617	    (local_dir / "reference-roots.local.json").write_text(json.dumps(bindings_obj), encoding="utf-8")
   618	
   619	
   620	def _pr3_wiki_root(tmp_root: Path) -> Path:
   621	    """A representative external root: `SCHEMA.md` at the top (regression
   622	    guard for the single-`@` / `alias:` sigils this syntax replaced -- both
   623	    silently dropped a bare top-level filename), `kernel/` and `research/`
   624	    subdirectories.
   625	
   626	    Returns the *canonical* (`resolve()`d) path, not the raw
   627	    `tmp_root / "wiki"` join: `tempfile.mkdtemp()` on macOS returns a path
   628	    under `/var/...`, and `/var` is itself a symlink to `/private/var` --
   629	    `_load_one_root` always canonicalizes a declared root before using it
   630	    (§2.5), so any fixture that later calls a PR-3 internal expecting an
   631	    already-canonical domain (`_is_contained_pinned`), or compares a
   632	    real resolved path against this fixture's own path, must use the same
   633	    canonical form or the comparison spuriously fails on such platforms.
   634	    """
   635	    wiki = tmp_root / "wiki"
   636	    (wiki / "kernel").mkdir(parents=True)
   637	    (wiki / "research").mkdir(parents=True)
   638	    (wiki / "SCHEMA.md").write_text("schema\n", encoding="utf-8")
   639	    (wiki / "kernel" / "facts.md").write_text("facts\n", encoding="utf-8")
   640	    return wiki.resolve()
   641	
