   574	def _looks_like_out_of_project(cleaned: str) -> bool:
   575	    """True if the span is home-relative (``~/...``), POSIX filesystem-
   576	    absolute (``/...``, which also covers a UNC path once
   577	    `pathish_citations` has normalized its backslashes to slashes, e.g.
   578	    ``//server/share/...``), or Windows drive-absolute (``C:/...``).
