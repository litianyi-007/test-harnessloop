   797	def _load_versioned_roots(path: Path) -> tuple[list[dict], str | None]:
   798	    """Parse and fully validate `.harnessloop/setup/reference-roots.json`.
   799	
   800	    Returns `(entries, None)` on success (`entries` is a list of plain dicts,
   801	    one per declared root, with keys already normalized to
   802	    `tuple[str, ...]` where the schema calls for a list) or `([], message)`
   803	    on ANY structural problem (G1): a single bad root entry invalidates the
   804	    *entire* file — "整份作废、加载零个 root" (§2.2) — deliberately not a
   805	    partial load, so a project can never end up in an ambiguous "some of my
   806	    declared roots loaded, which ones?" state.
   807	    """
   808	    try:
   809	        size = path.stat().st_size
   810	    except OSError as exc:
   811	        return [], f"{path}: cannot stat ({exc})"
   812	    if size > REFERENCE_ROOTS_MAX_BYTES:
   813	        return [], f"{path}: exceeds {REFERENCE_ROOTS_MAX_BYTES} bytes"
   814	    try:
   815	        text = path.read_text(encoding="utf-8")
   816	    except OSError as exc:
   817	        return [], f"{path}: cannot read ({exc})"
   818	    try:
   819	        data = json.loads(text)
   820	    except json.JSONDecodeError as exc:
   821	        return [], f"{path}: invalid JSON ({exc})"
   822	    if not isinstance(data, dict):
   823	        return [], f"{path}: top level must be a JSON object"
   824	    unknown_top = set(data) - {"version", "roots"}
   825	    if unknown_top:
   826	        return [], f"{path}: unknown top-level key(s) {sorted(unknown_top)}"
   827	    if data.get("version") != 1:
   828	        return [], f"{path}: 'version' must be 1"
   829	    raw_roots = data.get("roots", [])
   830	    if not isinstance(raw_roots, list):
   831	        return [], f"{path}: 'roots' must be a list"
   832	    if len(raw_roots) > REFERENCE_ROOTS_MAX_COUNT:
   833	        return [], f"{path}: more than {REFERENCE_ROOTS_MAX_COUNT} roots declared"
   834	
   835	    # G1: an alias may not collide with a protocol PATHISH_PREFIXES token
   836	    # (e.g. an alias literally named "setup" or "state"), computed from the
   837	    # same module-level constant Rule B's own base resolution uses so the
   838	    # two lists can never drift apart.
   839	    pathish_tokens = {p.strip("./").rstrip("/") for p in PATHISH_PREFIXES}
   840	
   841	    seen_alias: set[str] = set()
   842	    entries: list[dict] = []
   843	    for i, raw in enumerate(raw_roots):
   844	        if not isinstance(raw, dict):
   845	            return [], f"{path}: roots[{i}] must be an object"
   846	        unknown = set(raw) - _VERSIONED_ROOT_ALLOWED_KEYS
   847	        if unknown:
   848	            return [], f"{path}: roots[{i}] has unknown key(s) {sorted(unknown)}"
   849	
   850	        alias = raw.get("alias")
   851	        if not isinstance(alias, str) or not ALIAS_RE.match(alias):
   852	            return [], f"{path}: roots[{i}].alias is missing or does not match {ALIAS_RE.pattern}"
   853	        if alias in pathish_tokens:
   854	            return [], f"{path}: roots[{i}].alias {alias!r} collides with a PATHISH_PREFIXES token"
   855	        if alias in seen_alias:
   856	            return [], f"{path}: duplicate alias {alias!r}"
   857	        seen_alias.add(alias)
   858	
   859	        purpose = raw.get("purpose")
   860	        if not isinstance(purpose, str) or not purpose.strip():
   861	            return [], f"{path}: roots[{i}].purpose must be a non-empty string"
   862	
   863	        expect_present = raw.get("expect_present")
   864	        if (
   865	            not isinstance(expect_present, list)
   866	            or not (1 <= len(expect_present) <= 8)
   867	            or not all(isinstance(p, str) and p.strip() for p in expect_present)
   868	        ):
   869	            return [], f"{path}: roots[{i}].expect_present must be 1-8 non-empty strings"
   870	
   871	        subpaths = raw.get("subpaths")
   872	        if subpaths is not None and (
   873	            not isinstance(subpaths, list)
   874	            or not all(isinstance(p, str) and p.strip() and "/" not in p for p in subpaths)
   875	        ):
   876	            return [], f"{path}: roots[{i}].subpaths, if present, must be single-segment names"
   877	
   878	        approved_by = raw.get("approved_by")
   879	        if not isinstance(approved_by, str) or not approved_by.strip():
   880	            return [], f"{path}: roots[{i}].approved_by must be a non-empty string"
   881	
   882	        entries.append(
   883	            {
   884	                "alias": alias,
   885	                "purpose": purpose,
   886	                "expect_present": tuple(expect_present),
   887	                "subpaths": tuple(subpaths) if subpaths is not None else None,
   888	                "approved_by": approved_by,
   889	            }
   890	        )
   891	    return entries, None
   892	
