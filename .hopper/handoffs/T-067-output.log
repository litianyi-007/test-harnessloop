   894	def _load_local_bindings(path: Path) -> tuple[dict[str, str], str | None]:
   895	    """Parse and validate `.harnessloop/local/reference-roots.local.json`.
   896	
   897	    Returns `(bindings, None)` where `bindings` maps alias -> raw (not yet
   898	    expanded or resolved) declared path string, or `({}, message)` on any
   899	    structural problem (G2/G3). A binding entry declaring any of
   900	    `_LOCAL_BINDING_FORBIDDEN_KEYS` (`identity`/`available`/`optional`/
   901	    `expect_present`) is rejected specifically because those keys would let
   902	    the low-trust local side answer a high-trust question ("is this the
   903	    right tree") that only the project-committed sentinel check
   904	    (`expect_present`, verified server-side by `_load_one_root`) is allowed
   905	    to answer (§2.2: "低信任半边不得影响可用性判定").
   906	
   907	    A missing file is not an error — every declared alias is simply
   908	    `"unbound"` (see `_load_one_root`), which is the correct default: a
   909	    fresh clone or a new machine has bound nothing yet.
   910	    """
   911	    if not path.is_file():
   912	        return {}, None
   913	    try:
   914	        size = path.stat().st_size
   915	    except OSError as exc:
   916	        return {}, f"{path}: cannot stat ({exc})"
   917	    if size > REFERENCE_ROOTS_MAX_BYTES:
   918	        return {}, f"{path}: exceeds {REFERENCE_ROOTS_MAX_BYTES} bytes"
   919	    try:
   920	        text = path.read_text(encoding="utf-8")
   921	    except OSError as exc:
   922	        return {}, f"{path}: cannot read ({exc})"
   923	    try:
   924	        data = json.loads(text)
   925	    except json.JSONDecodeError as exc:
   926	        return {}, f"{path}: invalid JSON ({exc})"
   927	    if not isinstance(data, dict):
   928	        return {}, f"{path}: top level must be a JSON object"
   929	    unknown_top = set(data) - {"version", "bindings"}
   930	    if unknown_top:
   931	        return {}, f"{path}: unknown top-level key(s) {sorted(unknown_top)}"
   932	    if data.get("version") != 1:
   933	        return {}, f"{path}: 'version' must be 1"
   934	    raw_bindings = data.get("bindings", {})
   935	    if not isinstance(raw_bindings, dict):
   936	        return {}, f"{path}: 'bindings' must be an object"
   937	
   938	    bindings: dict[str, str] = {}
   939	    for alias, binding in raw_bindings.items():
   940	        if not isinstance(binding, dict):
   941	            return {}, f"{path}: bindings[{alias!r}] must be an object"
   942	        forbidden = _LOCAL_BINDING_FORBIDDEN_KEYS & set(binding)
   943	        if forbidden:
   944	            return {}, (
   945	                f"{path}: bindings[{alias!r}] declares low-trust identity "
   946	                f"key(s) {sorted(forbidden)} -- the local binding file may "
   947	                "only ever answer 'where', never 'is this the right tree'"
   948	            )
   949	        unknown = set(binding) - _LOCAL_BINDING_ALLOWED_KEYS
   950	        if unknown:
   951	            return {}, f"{path}: bindings[{alias!r}] has unknown key(s) {sorted(unknown)}"
   952	        raw_path = binding.get("path")
   953	        if not isinstance(raw_path, str) or not raw_path.strip():
   954	            return {}, f"{path}: bindings[{alias!r}].path must be a non-empty string"
   955	        bindings[alias] = raw_path
   956	    return bindings, None
