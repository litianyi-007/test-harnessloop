  1927	        return {
  1928	            "round": str(round_label),
  1929	            "kind": "round-container-escapes-project",
  1930	            "detail": (
  1931	                f"{container} is itself a symlink, or resolves outside the project "
  1932	                "under canonical containment — its contents were never read"
  1933	            ),
  1934	        }
  1935	    return None
