   787	        self.alias = alias
   788	        self.purpose = purpose
   789	        self.expect_present = expect_present
   790	        self.subpaths = subpaths
   791	        self.approved_by = approved_by
   792	        self.canonical = canonical
   793	        self.available = available
   794	        self.unavailable_reason = unavailable_reason
