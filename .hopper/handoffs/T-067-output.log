  1036	def resolve_external_citation(root: ReferenceRoot, rel: str) -> tuple[str, Path | None]:
  1037	    """Resolve `rel` (the text after `@@<alias>/`, one attempt — the caller
  1038	    tries the as-written form and, on failure, a locator-stripped retry, the
  1039	    same order Rule B's project-domain resolution uses) against
  1040	    `root.canonical`.
  1041	
  1042	    Returns `("resolved" | "not_found" | "rejected", path-or-None)`.
  1043	    `root` must already be `available` — callers check that separately and
  1044	    report `external-citation-unverifiable` instead of ever calling this
  1045	    (G7); this function has no "unavailable" outcome of its own.
  1046	
  1047	    Order: (1) `_resolve_in_root` — G8's literal-traversal defense and G9's
  1048	    unfolded-join pinned containment; a rejection here is final and never
  1049	    falls through to the existence check below (a rejected `candidate` is
  1050	    not something `_resolve_case_exact` should ever be asked about). (2)
  1051	    `_resolve_case_exact` — G10's exact-case segment walk; `None` here is
  1052	    `not_found`. (3) directory-semantics existence (G11): `is_dir()` when
  1053	    `rel` ends in `/`, `exists()` otherwise (`exists()` follows symlinks, so
  1054	    a broken symlink's dangling target is `not_found`, not `resolved`,
  1055	    exactly like the project domain's `_exists_as`). (4) `subpaths`
  1056	    whitelist (G12), checked against the *canonical* path relative to the
  1057	    canonical root, not the literal `rel` — a `kernel/link -> <root>/raw`
  1058	    symlink cited as `kernel/link/x.md` must be judged by where it actually
  1059	    lands (`raw`), not by the literal first segment it was typed with.
  1060	    """
  1061	    candidate = _resolve_in_root(root.canonical, rel)
  1062	    if candidate is None:
  1063	        return "rejected", None
  1064	
  1065	    want_dir = rel.endswith("/")
  1066	    real = _resolve_case_exact(root.canonical, rel)
  1067	    if real is None:
  1068	        return "not_found", None
  1069	    if not _exists_as(real, want_dir):
  1070	        return "not_found", None
  1071	
  1072	    if root.subpaths:
  1073	        canon_real = _canonical(real)
  1074	        try:
  1075	            rel_canon = canon_real.relative_to(root.canonical)
  1076	        except ValueError:
  1077	            return "rejected", None
  1078	        first_seg = rel_canon.parts[0] if rel_canon.parts else None
  1079	        if first_seg not in root.subpaths:
  1080	            return "rejected", None
  1081	
  1082	    return "resolved", real
