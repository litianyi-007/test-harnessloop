  1938	def _scan_round_artifacts(
  1939	    container: Path, project: Path, round_dir: Path
  1940	) -> tuple[list[Path], list[dict]]:
  1941	    """G17 item 2 (external-citation-base-spec-20260727.md §3.1): walk a
  1942	    round-container directory (`evidence/` or `reviews/`, already confirmed
  1943	    clean by `_container_escape_violation`) and split its raw `rglob("*")`
  1944	    entries into real files versus symlinks — checked *before* any
  1945	    `is_file()` filtering, and using `is_symlink()` (an `lstat`, never
  1946	    following the link) rather than `is_file()` or `.exists()`.
  1947	
  1948	    This ordering matters: a dangling symlink's `is_file()` is `False` for
  1949	    exactly the same reason a genuine absence is — the target does not
  1950	    exist — so a filter built on `is_file()` alone drops a broken symlink
  1951	    silently, with zero signal that anything was ever there (T-062
  1952	    `broken_symlink`, reproduced identically on the artifact side: a
  1953	    checker built on `checked_files` after an `is_file()` filter would miss
  1954	    the single most classic escape shape). `is_symlink()` sees it either
  1955	    way, so every symlinked entry — file, directory, or dangling — is
  1956	    reported as `round-artifact-is-symlink` and excluded from the returned
  1957	    file list, never silently dropped.
  1958	
  1959	    A symlinked *directory* entry is covered the same way: its own entry is
  1960	    a symlink and is flagged. As of this module's tested Python versions,
  1961	    `rglob`'s recursive descent does not open a symlinked directory node to
  1962	    yield further entries from beneath it (verified directly: see G17
  1963	    fixture B's teeth in `validate.py`, which asserts the `dlink` entry
  1964	    itself carries the kind — not merely "zero files found under it", which
  1965	    would hold trivially either way and prove nothing). This function flags
  1966	    the symlinked directory node itself regardless of that; it does not
  1967	    depend on it.
  1968	    """
  1969	    files: list[Path] = []
  1970	    violations: list[dict] = []
  1971	    for entry in sorted(container.rglob("*")):
  1972	        if os.path.lexists(entry) and entry.is_symlink():
  1973	            violations.append(
  1974	                {
  1975	                    "round": str(round_dir),
  1976	                    "kind": "round-artifact-is-symlink",
  1977	                    "detail": f"{entry} is a symlink; its target is never read",
  1978	                }
  1979	            )
  1980	            continue
  1981	        if entry.is_file():
  1982	            files.append(entry)
  1983	    return files, violations
