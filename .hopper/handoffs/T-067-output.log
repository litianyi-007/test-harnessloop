   438	def _canonical(path: Path) -> Path:
   439	    """Resolve `path` to its canonical (symlink-following) form.
   440	
   441	    `strict=False` normalizes past a broken symlink or a nonexistent
   442	    component instead of raising — existence is a separate concern, owned
   443	    by `_exists_as` at the point a match is actually accepted, not by this
   444	    resolution step (T-063 MUST-FIX 2: canonical containment and match-time
   445	    existence re-verification must not be conflated with each other).
   446	    """
   447	    return path.resolve(strict=False)
