  1085	def _resolve_external_with_locator(root: ReferenceRoot, rel: str, full_cited: str) -> str:
  1086	    """Try `rel` as written; on failure, retry with `full_cited`'s own
  1087	    trailing locator suffix stripped (mirrors Rule B's project-domain
  1088	    "original, then locator-stripped" order — see `strip_locator_suffix`,
  1089	    unchanged by PR-3 and already verified to work unmodified against
  1090	    `@@alias/...` spans).
  1091	
  1092	    Returns only the outcome string (`"resolved" | "not_found" |
  1093	    "rejected"`) since the specific resolved path is not needed by the
  1094	    citation-existence caller (unlike the sentinel/subpaths checks, which do
  1095	    need it). If neither attempt resolves, `"rejected"` wins over
  1096	    `"not_found"` so a genuinely malformed or escaping relpath is never
  1097	    silently downgraded to a plain "no such file" just because a
  1098	    locator-stripped retry also failed to find anything.
  1099	    """
  1100	    outcome, _ = resolve_external_citation(root, rel)
  1101	    if outcome == "resolved":
  1102	        return outcome
  1103	    stripped_full = strip_locator_suffix(full_cited)
  1104	    if stripped_full != full_cited:
  1105	        m = ALIAS_CITATION_RE.match(stripped_full)
  1106	        if m and m.group(2) != rel:
  1107	            outcome2, _ = resolve_external_citation(root, m.group(2))
  1108	            if outcome2 == "resolved":
  1109	                return outcome2
  1110	            if outcome2 == "rejected":
  1111	                outcome = "rejected"
  1112	    return outcome
