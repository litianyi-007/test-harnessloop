   779	        purpose: str,
   780	        expect_present: tuple[str, ...],
   781	        subpaths: tuple[str, ...] | None,
   782	        approved_by: str,
   783	        canonical: Path | None,
   784	        available: bool,
   785	        unavailable_reason: str | None,
