   598	def strip_locator_suffix(cleaned: str) -> str:
   599	    """Strip a trailing `::<anchor>`, `:<line>`, `:<start>-<end>`, or
   600	    comma-separated multi-range (`:<start>-<end>,<start>-<end>,...`) locator.
