   506	def extract_allowed_spans(scope_lock_text: str) -> list[str]:
   507	    """Collect allowed paths from the '## Allowed Changes' section.
   508	
   509	    Accepts both formats in the wild: backtick path spans in prose/bullets,
   510	    and the scope-lock-template.md table whose first column is the path.
   511	    """
   512	    spans: list[str] = []
   513	    in_section = False
   514	    for line in scope_lock_text.splitlines():
   515	        stripped = line.strip()
   516	        if stripped.startswith("## "):
   517	            in_section = stripped.lower() == "## allowed changes"
   518	            continue
   519	        if not in_section:
   520	            continue
   521	        spans.extend(CODE_SPAN.findall(line))
   522	        if stripped.startswith("|"):
   523	            cells = [c.strip() for c in stripped.strip("|").split("|")]
   524	            if not cells:
   525	                continue
   526	            first = cells[0].strip("`").strip()
   527	            if (
   528	                first
   529	                and not set(first) <= {"-", ":", " "}
   530	                and first.lower() not in {"path/data/tool", "path", "file", "target"}
   531	                and " " not in first
   532	            ):
   533	                spans.append(first)
   534	    return sorted({s.strip().replace("\\", "/") for s in spans if s.strip()})
