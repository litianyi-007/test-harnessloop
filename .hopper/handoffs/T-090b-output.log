    40	private func groupingTestMessageDeltaEvent(
    41	    messageID: String, runID: String, sessionID: String, delta: String
    42	) -> EventMessageUnion {
    43	    .messageDelta(MessageDeltaEventMessage(
    44	        direction: .event,
    45	        payload: MessageDeltaEventMessagePayload(delta: delta, index: 0, messageID: messageID, role: .assistant),
    46	        runID: runID,
    47	        sentAt: Date(),
    48	        seq: 1,
    49	        sessionID: sessionID,
    50	        ts: Date(),
    51	        type: .evtMessageDelta
    52	    ))
