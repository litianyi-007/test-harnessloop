   298	export function collectExecPolicyScopeSnapshots(params: {
   299	  cfg: OpenClawConfig;
   300	  approvals: ExecApprovalsFile;
   301	  hostPath?: string;
   302	  hostDefaults?: ExecPolicyHostDefaults;
   303	  hostDefaultSource?: string;
   304	}): ExecPolicyScopeSnapshot[] {
   305	  const snapshots = [
   306	    resolveExecPolicyScopeSnapshot({
   307	      approvals: params.approvals,
   308	      scopeExecConfig: params.cfg.tools?.exec,
   309	      configPath: "tools.exec",
   310	      hostPath: params.hostPath,
   311	      hostDefaults: params.hostDefaults,
   312	      hostDefaultSource: params.hostDefaultSource,
   313	      scopeLabel: "tools.exec",
   314	    }),
   315	  ];
   316	  const globalExecConfig = params.cfg.tools?.exec;
   317	  const configAgentIds = new Set(
   318	    (params.cfg.agents?.list ?? [])
   319	      .filter((agent) => agent.id !== DEFAULT_AGENT_ID || agent.tools?.exec !== undefined)
   320	      .map((agent) => agent.id),
   321	  );
   322	  const approvalAgentIds = Object.keys(params.approvals.agents ?? {}).filter(
   323	    (agentId) => agentId !== "*" && agentId !== "default" && agentId !== DEFAULT_AGENT_ID,
   324	  );
   325	  const agentIds = sortUniqueStrings([...configAgentIds, ...approvalAgentIds]);
   326	  for (const agentId of agentIds) {
   327	    const agentConfig = params.cfg.agents?.list?.find((agent) => agent.id === agentId);
   328	    snapshots.push(
   329	      resolveExecPolicyScopeSnapshot({
   330	        approvals: params.approvals,
   331	        scopeExecConfig: agentConfig?.tools?.exec,
   332	        globalExecConfig,
   333	        configPath: `agents.list.${agentId}.tools.exec`,
   334	        hostPath: params.hostPath,
   335	        hostDefaults: params.hostDefaults,
   336	        hostDefaultSource: params.hostDefaultSource,
   337	        scopeLabel: `agent:${agentId}`,
   338	        agentId,
   339	      }),
   340	    );
   341	  }
   342	  return snapshots;
   343	}
   344	
   345	export function resolveExecPolicyScopeSnapshot(params: {
   346	  approvals: ExecApprovalsFile;
   347	  scopeExecConfig?: ExecPolicyConfig | undefined;
   348	  globalExecConfig?: ExecPolicyConfig | undefined;
   349	  configPath: string;
   350	  scopeLabel: string;
   351	  agentId?: string;
   352	  hostPath?: string;
   353	  hostDefaults?: ExecPolicyHostDefaults;
   354	  hostDefaultSource?: string;
   355	}): ExecPolicyScopeSnapshot {
   356	  const requestedHost = resolveRequestedHost({
   357	    scopeExecConfig: params.scopeExecConfig,
   358	    globalExecConfig: params.globalExecConfig,
   359	  });
   360	  const requestedPolicy = resolveRequestedPolicy({
   361	    scopeExecConfig: params.scopeExecConfig,
   362	    globalExecConfig: params.globalExecConfig,
   363	    configPath: params.configPath,
   364	  });
   365	  const resolved = resolveExecApprovalsFromFile({
   366	    file: params.approvals,
   367	    agentId: params.agentId,
   368	    overrides: {
   369	      security: params.hostDefaults?.security ?? requestedPolicy.security,
   370	      ask: params.hostDefaults?.ask ?? requestedPolicy.ask,
   371	      ...(params.hostDefaults ? { askFallback: params.hostDefaults.askFallback } : {}),
   372	    },
   373	  });
   374	  const hostPath = params.hostPath ?? resolveExecApprovalsDisplayPath();
   375	  const effectiveSecurity = minSecurity(requestedPolicy.security, resolved.agent.security);
   376	  const effectiveAsk = maxAsk(requestedPolicy.ask, resolved.agent.ask);
   377	  const effectiveAskFallback = minSecurity(effectiveSecurity, resolved.agent.askFallback);
   378	  const effectiveMode =
   379	    effectiveSecurity === requestedPolicy.security && effectiveAsk === requestedPolicy.ask
   380	      ? requestedPolicy.mode
   381	      : resolveExecModeFromPolicy({
   382	          security: effectiveSecurity,
   383	          ask: effectiveAsk,
   384	        });
   385	  return {
   386	    scopeLabel: params.scopeLabel,
   387	    configPath: params.configPath,
   388	    ...(params.agentId ? { agentId: params.agentId } : {}),
   389	    host: {
   390	      requested: requestedHost.value,
   391	      requestedSource:
   392	        requestedHost.sourcePath === "__default__"
   393	          ? "OpenClaw default (auto)"
   394	          : `${requestedHost.sourcePath === "scope" ? params.configPath : requestedHost.sourcePath}.host`,
   395	    },
   396	    mode: {
   397	      requested: requestedPolicy.mode,
   398	      requestedSource: requestedPolicy.modeSource,
   399	      effective: effectiveMode,
   400	      note:
   401	        effectiveMode === requestedPolicy.mode
   402	          ? "requested mode applies"
   403	          : "host policy changes effective mode",
   404	    },
   405	    security: {
   406	      requested: requestedPolicy.security,
   407	      requestedSource: requestedPolicy.securitySource,
   408	      host: resolved.agent.security,
   409	      hostSource: formatHostFieldSource({
   410	        hostPath,
   411	        field: "security",
   412	        sourceSuffix: resolved.agentSources.security,
   413	        hostDefaultSource: params.hostDefaultSource,
   414	      }),
   415	      effective: effectiveSecurity,
   416	      note:
   417	        effectiveSecurity === requestedPolicy.security
   418	          ? "requested security applies"
   419	          : "stricter host security wins",
   420	    },
   421	    ask: {
   422	      requested: requestedPolicy.ask,
   423	      requestedSource: requestedPolicy.askSource,
   424	      host: resolved.agent.ask,
   425	      hostSource: formatHostFieldSource({
   426	        hostPath,
   427	        field: "ask",
   428	        sourceSuffix: resolved.agentSources.ask,
   429	        hostDefaultSource: params.hostDefaultSource,
   430	      }),
   431	      effective: effectiveAsk,
   432	      note: resolveAskNote({
   433	        requestedAsk: requestedPolicy.ask,
   434	        hostAsk: resolved.agent.ask,
   435	        effectiveAsk,
   436	      }),
   437	    },
   438	    askFallback: {
   439	      effective: effectiveAskFallback,
   440	      source: formatHostFieldSource({
   441	        hostPath,
   442	        field: "askFallback",
   443	        sourceSuffix: resolved.agentSources.askFallback,
   444	        hostDefaultSource: params.hostDefaultSource,
   445	      }),
   446	    },
   447	    allowedDecisions: resolveExecApprovalAllowedDecisions({ ask: effectiveAsk }),
   448	  };
   449	}

