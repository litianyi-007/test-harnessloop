    71	/**
    72	 * Detect cursor key mode from PTY output chunk.
    73	 * Uses lastIndexOf to find the *last* toggle in the chunk.
    74	 * Returns "application" if smkx is the last toggle, "normal" if rmkx is last,
    75	 * or null if no toggle is found.
    76	 */
    77	function detectCursorKeyMode(raw: string): "application" | "normal" | null {
    78	  const lastSmkx = raw.lastIndexOf(SMKX);
    79	  const lastRmkx = raw.lastIndexOf(RMKX);
    80	  if (lastSmkx === -1 && lastRmkx === -1) {
    81	    return null;
    82	  }
    83	  // Whichever appears later in the chunk wins.
    84	  return lastSmkx > lastRmkx ? "application" : "normal";
    85	}
