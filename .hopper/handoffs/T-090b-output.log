   258	  appendInlineMessage(update: {
   259	    message: unknown;
   260	    messageId?: string;
   261	    messageSeq?: number;
   262	  }): InlineSessionHistoryAppend | null {
   263	    if (this.limit !== undefined || this.cursor !== undefined) {
