   150	export function resolveExecPolicyForMode(mode: ExecMode): {
   151	  security: ExecSecurity;
   152	  ask: ExecAsk;
   153	  autoReview: boolean;
   154	} {
   155	  switch (mode) {
   156	    case "deny":
   157	      return { security: "deny", ask: "off", autoReview: false };
   158	    case "allowlist":
   159	      return { security: "allowlist", ask: "off", autoReview: false };
   160	    case "ask":
   161	      return { security: "allowlist", ask: "on-miss", autoReview: false };
   162	    case "auto":
   163	      return { security: "allowlist", ask: "on-miss", autoReview: true };
   164	    case "full":
   165	      return { security: "full", ask: "off", autoReview: false };
   166	  }
   167	  const exhaustiveMode: never = mode;
   168	  throw new Error(`Unsupported exec mode: ${String(exhaustiveMode)}`);
   169	}
