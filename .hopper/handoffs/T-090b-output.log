   154	function resolveRequestedPolicy(params: {
   155	  scopeExecConfig?: ExecPolicyConfig;
   156	  globalExecConfig?: ExecPolicyConfig;
   157	  configPath: string;
   158	}): {
   159	  mode: ExecMode;
