    28	private func groupingTestSessionHandle(sessionID: String) -> SessionHandle {
    29	    SessionHandle(
    30	        billing: Billing(tokenRef: "test"), createdAt: Date(), kernel: .openclaw,
    31	        kernelSessionID: "kernel-key-\(sessionID)", sessionID: sessionID
    32	    )
