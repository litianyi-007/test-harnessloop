    97	  OPENCLAW_SKIP_CHANNELS=1 \
    98	  node scripts/run-node.mjs gateway --port "$PORT" --allow-unconfigured --token "$TOKEN" --no-color \
    99	    > "$ISO/logs/gateway-stdout.log" 2>&1 & echo $! > "$ISO/gateway.pid" )
   100	
   101	for _ in $(seq 1 60); do
   102	  grep -q '\[gateway\] ready' "$ISO/logs/gateway-stdout.log" 2>/dev/null && break
   103	  sleep 1
   104	done
   105	if ! grep -q '\[gateway\] ready' "$ISO/logs/gateway-stdout.log" 2>/dev/null; then
   106	  echo "gateway 未在 60s 内就绪，日志尾部：" >&2; tail -20 "$ISO/logs/gateway-stdout.log" >&2; exit 1
   107	fi
   108	
   109	# 隔离自检：实例自报的日志落点必须在隔离目录内，不能是全局 /tmp/openclaw
   110	if ! grep -m1 'log file:' "$ISO/logs/gateway-stdout.log" | grep -q "$ISO"; then
   111	  echo "隔离检查失败：日志未落在 $ISO —— logging.file 没生效" >&2
   112	  grep -m1 'log file:' "$ISO/logs/gateway-stdout.log" >&2; exit 1
   113	fi
   114	
   115	# 记录**真正监听端口的那个 PID**。不能只记 wrapper：
   116	# `node scripts/run-node.mjs gateway` 起的 wrapper 会先退出，真正监听的子进程被 reparent 到 1，
   117	# PPID 链因此追不回 wrapper（rounds/0012 实测：wrapper 56076 已退出，监听者 56313 的父进程也已 reparent）。
   118	# 所以 stop 脚本的归属判定以**这个记录下来的 PID** 为准。
   119	LISTENER_PID="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)"
   120	if [ -z "$LISTENER_PID" ]; then
   121	  echo "gateway 报告 ready 但端口 $PORT 无监听者——异常" >&2; exit 1
   122	fi
   123	echo "$LISTENER_PID" > "$ISO/listener.pid"
   124	
   125	cat > "$ISO/conn.env" <<ENV
   126	export ISO="$ISO"
   127	export PORT="$PORT"
   128	export TOKEN="$TOKEN"
   129	export AGENT_SHELL_KERNEL_URL="ws://127.0.0.1:$PORT"
   130	export AGENT_SHELL_KERNEL_TOKEN="$TOKEN"
   131	ENV
   132	
   133	echo "gateway ready (pid $(cat "$ISO/gateway.pid")), port $PORT"
   134	echo "隔离目录 ${ISO}；日志已确认落在隔离目录内"
   135	echo "下一步： source $ISO/conn.env"

