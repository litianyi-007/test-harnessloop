    67	/// 形态：分组键 `messageID` + `=` 覆盖）pass**——这是本轮任务书要求的破坏性反证，实际红/绿两次
    68	/// 输出记在任务报告，不在此文件重复（本文件落笔时是"分组键 messageID"的绿态最终版本）。
    69	@MainActor
    70	func testSessionStoreHandleGroupsDistinctMessageIDsAsSeparateMessages() -> Bool {
    71	    let name = "rounds/0013 B2: SessionStore.handle() with two DIFFERENT messageId sharing (runId, index=0) — the rounds/0011 collision shape — produces TWO separate session.messages, not one merged bubble"
    72	
    73	    let store = SessionStore(config: KernelShellConfig(
    74	        endpoint: URL(string: "ws://127.0.0.1:1")!,
    75	        token: "dummy-test-token",
    76	        configWarning: nil
    77	    ))
