    94	    }
    95	    guard session.messages[0].role == .assistant, session.messages[1].role == .assistant else {
    96	        return fail(name, "expected both messages role == .assistant, got \(session.messages[0].role)/\(session.messages[1].role)")
    97	    }
    98	    guard session.messages[0].text == "first reply text" else {
    99	        return fail(name, "expected first message text == \"first reply text\" (not concatenated with the second), got \"\(session.messages[0].text)\"")
   100	    }
   101	    guard session.messages[1].text == "second reply text" else {
   102	        return fail(name, "expected second message text == \"second reply text\" (a fresh bubble, not appended onto the first), got \"\(session.messages[1].text)\"")
