   247	export function parseToolsBySenderTypedKey(
   248	  rawKey: string,
   249	): { type: ToolsBySenderKeyType; value: string } | undefined {
   250	  const trimmed = rawKey.trim();
   251	  if (!trimmed) {
   252	    return undefined;
   253	  }
   254	  const lowered = normalizeLowercaseStringOrEmpty(trimmed);
   255	  for (const type of TOOLS_BY_SENDER_KEY_TYPES) {
   256	    const prefix = `${type}:`;
   257	    if (!lowered.startsWith(prefix)) {
   258	      continue;
   259	    }
   260	    // Preserve the original value casing after the typed prefix; usernames and
   261	    // display names can be case-sensitive in channel-specific matching code.
   262	    return {
   263	      type,
   264	      value: trimmed.slice(prefix.length),
   265	    };
   266	  }
   267	  return undefined;
   268	}
