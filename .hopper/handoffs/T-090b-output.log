   251	/// SG-5 rework：codex 对抗审 T-044 指出上一轮 CLIRunner 只打印 `event.wireType`，看不到
   252	/// `runId/seq/ts/toolCallId/output/usage/stopReason` 这些真正能暴露字段级缺陷（seq 倒退、approval
   253	/// 串号、正常 end 误报 error、重复 operation terminal 等）的关键字段——本函数按事件种类逐一取出
   254	/// 这些字段格式化，让 e2e 输出本身就足以肉眼核验映射正确性，不再只证明"有事件流过"。
   255	func describeEventFields(_ event: EventMessageUnion) -> String {
   256	    switch event {
   257	    case .messageDelta(let e):
   258	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) delta=\(String(e.payload.delta.prefix(60)).debugDescription)"
   259	    case .thinking(let e):
   260	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) visibility=\(e.payload.visibility.rawValue) delta=\(String(e.payload.delta.prefix(60)).debugDescription)"
   261	    case .toolCall(let e):
   262	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) toolCallId=\(e.payload.toolCallID) name=\(e.payload.name) status=\(e.payload.status.rawValue)"
   263	    case .toolResult(let e):
   264	        let outputPreview = String(describing: e.payload.output.value)
   265	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) toolCallId=\(e.payload.toolCallID) isError=\(e.payload.isError) durationMs=\(e.payload.durationMS.map(String.init) ?? "-") output=\(String(outputPreview.prefix(80)))"
   266	    case .approvalRequest(let e):
   267	        return "runId=\(e.runID) seq=\(e.seq) ts=\(e.ts) reqId=\(e.payload.reqID) toolCallId=\(e.payload.toolCallID) kind=\(e.payload.kind.rawValue) timeoutMs=\(e.payload.timeoutMS) timeoutAuthority=\(e.payload.timeoutAuthority.rawValue) proposedDecision=\(e.payload.proposedDecision?.rawValue ?? "-")"
   268	    case .error(let e):
   269	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) code=\(e.payload.code.rawValue) message=\(e.payload.message.debugDescription) recoverable=\(e.payload.recoverable.rawValue) nativeCode=\(e.payload.nativeCode ?? "-")"
   270	    case .turnComplete(let e):
   271	        return "runId=\(e.runID) seq=\(e.seq) ts=\(e.ts) stopReason=\(e.payload.stopReason.rawValue) usage=\(e.payload.usage.map { "in=\($0.inputTokens ?? -1),out=\($0.outputTokens ?? -1)" } ?? "-") degraded=\(e.payload.degraded?.kind.rawValue ?? "-") forceResolvedApprovals=\(e.payload.forceResolvedApprovals?.joined(separator: ",") ?? "-")"
   272	    case .sessionEnd(let e):
   273	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) reason=\(e.payload.reason.rawValue)"
   274	    case .capabilityChanged(let e):
   275	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) source=\(e.payload.source.rawValue)"
   276	    case .operationCompleted(let e):
   277	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) operationId=\(e.payload.operationID) operationKind=\(e.payload.operationKind.rawValue) outcome=\(e.payload.outcome.rawValue) affectedRunId=\(e.payload.affectedRunID ?? "-") newRunId=\(e.payload.newRunID ?? "-") detail=\(e.payload.detail ?? "-")"
   278	    case .approvalBufferResolved(let e):
   279	        return "runId=\(e.runID ?? "-") seq=\(e.seq) ts=\(e.ts) reqId=\(e.payload.reqID) reason=\(e.payload.reason.rawValue)"
   280	    }
   281	}
