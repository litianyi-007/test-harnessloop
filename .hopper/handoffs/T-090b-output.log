   310	function maybeNotifyOnExit(session: ProcessSession, status: "completed" | "failed") {
   311	  if (!session.backgrounded || !session.notifyOnExit || session.exitNotified) {
   312	    return;
   313	  }
   314	  const sessionKey = session.sessionKey?.trim();
   315	  if (!sessionKey) {
   316	    return;
   317	  }
   318	  session.exitNotified = true;
   319	  const exitLabel = session.exitSignal
   320	    ? `signal ${session.exitSignal}`
   321	    : `code ${session.exitCode ?? 0}`;
   322	  const output = compactNotifyOutput(
   323	    tail(session.tail || session.aggregated || "", DEFAULT_NOTIFY_TAIL_CHARS),
   324	  );
   325	  if (status === "failed" && session.exitReason === "manual-cancel" && !output) {
   326	    return;
   327	  }
   328	  if (status === "completed" && !output && session.notifyOnExitEmptySuccess !== true) {
   329	    return;
   330	  }
   331	  const summary = output
   332	    ? `Exec ${status} (${session.id.slice(0, 8)}, ${exitLabel}) :: ${output}`
   333	    : `Exec ${status} (${session.id.slice(0, 8)}, ${exitLabel})`;
   334	  const eventText = appendExecTimeoutRetryGuidance(summary, session.exitReason);
   335	  const eventRouting = session.eventRouting ?? {
   336	    mainKey: session.mainKey,
   337	    sessionScope: session.sessionScope,
   338	  };
   339	  enqueueSystemEvent(eventText, {
   340	    sessionKey: resolveEventSessionKeyForPolicy(sessionKey, eventRouting),
   341	    deliveryContext: session.notifyDeliveryContext,
   342	  });
   343	  // Subagent sessions receive exec results via process poll and announce flow;
   344	  // the heartbeat would fall back to the main session and cause spurious wakes.
   345	  if (!isSubagentSessionKey(sessionKey)) {
   346	    requestHeartbeat(
   347	      scopedHeartbeatWakeOptionsForPolicy(
   348	        sessionKey,
   349	        {
   350	          source: "exec-event",
   351	          intent: "event",
   352	          reason: "exec-event",
   353	          coalesceMs: 0,
   354	        },
   355	        eventRouting,
   356	      ),
   357	    );
   358	  }
   359	}
