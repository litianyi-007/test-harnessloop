    64	function resolveExecTimeoutMs(timeoutSec: number | null | undefined): number | undefined {
    65	  if (typeof timeoutSec !== "number" || !Number.isFinite(timeoutSec) || timeoutSec <= 0) {
    66	    return undefined;
    67	  }
