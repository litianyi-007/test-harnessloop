   294	/** Merges shell-discovered PATH entries into an exec environment. */
   295	export function applyShellPath(env: Record<string, string>, shellPath?: string | null) {
   296	  if (!shellPath) {
   297	    return;
   298	  }
   299	  const entries = normalizeStringEntries(shellPath.split(path.delimiter));
   300	  if (entries.length === 0) {
   301	    return;
   302	  }
   303	  const pathKey = findPathKey(env);
   304	  const merged = mergePathPrepend(env[pathKey], entries);
   305	  if (merged) {
   306	    env[pathKey] = merged;
   307	  }
   308	}
