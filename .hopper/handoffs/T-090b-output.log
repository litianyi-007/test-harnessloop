   133	    return "id=%r seq=%r" % (key[0], key[1])
   134	
   135	
   136	def kv(label: str, value: Any) -> None:
   137	    print("  %-38s: %s" % (label, value))
   138	
   139	
   140	def sub(label: str, values: List[Any]) -> None:
   141	    if values:
   142	        print("      %-34s: %s" % (label, values))
   143	
   144	
   145	def fatal(msg: str, code: int = EXIT_USAGE_ERROR) -> None:
   146	    print("[FATAL] %s" % msg, file=sys.stderr)
   147	    sys.exit(code)
   148	
   149	
   150	# ---------------------------------------------------------------------------
   151	# source A: wire trace (local JSONL)
   152	# ---------------------------------------------------------------------------
   153	
   154	def parse_wire_trace(path: str) -> Tuple[Dict[Key, str], Dict[str, Any]]:
   155	    stats: Dict[str, Any] = {
   156	        "total_lines": 0,
   157	        "blank_lines": 0,
   158	        "parse_error_lines": 0,
   159	        "parse_error_line_numbers": [],
   160	        "unexpected_shape_lines": 0,
   161	        "unexpected_shape_line_numbers": [],
   162	        "no_delta_lines": 0,
   163	        "non_assistant_delta_lines": 0,
   164	        "malformed_candidate_lines": 0,
   165	        "malformed_line_numbers": [],
   166	        "matched_frames": 0,
   167	        "duplicate_keys": 0,
   168	    }
   169	    recs: Dict[Key, str] = {}
   170	
   171	    with open(path, "r", encoding="utf-8") as fh:
   172	        for lineno, raw_line in enumerate(fh, start=1):
   173	            stats["total_lines"] += 1
   174	            line = raw_line.strip()
   175	            if not line:
   176	                stats["blank_lines"] += 1
   177	                continue
   178	
   179	            try:
   180	                obj = json.loads(line)
   181	            except json.JSONDecodeError:
   182	                stats["parse_error_lines"] += 1
   183	                stats["parse_error_line_numbers"].append(lineno)
   184	                continue
   185	
   186	            if not isinstance(obj, dict):
   187	                stats["unexpected_shape_lines"] += 1
   188	                stats["unexpected_shape_line_numbers"].append(lineno)
   189	                continue
   190	
   191	            produced = obj.get("producedEvents")
   192	            has_delta = isinstance(produced, list) and any(
   193	                isinstance(e, dict) and e.get("wireType") == "evt.message.delta"
   194	                for e in produced
   195	            )
   196	            if not has_delta:
   197	                stats["no_delta_lines"] += 1
   198	                continue
   199	
   200	            role = dig(obj, "wireFrame", "payload", "message", "role")
   201	            if role != "assistant":
   202	                stats["non_assistant_delta_lines"] += 1
   203	                continue
   204	
   205	            message_id = dig(obj, "wireFrame", "payload", "messageId")
   206	            message_seq = dig(obj, "wireFrame", "payload", "messageSeq")
   207	            message_obj = dig(obj, "wireFrame", "payload", "message") or {}
   208	
   209	            if message_id is None or message_seq is None:
   210	                stats["malformed_candidate_lines"] += 1
   211	                stats["malformed_line_numbers"].append(lineno)
   212	                continue
   213	
   214	            key = (str(message_id), normalize_seq(message_seq))
   215	            if key in recs:
   216	                stats["duplicate_keys"] += 1
   217	            stats["matched_frames"] += 1
   218	            # Later frames for the same key (streaming growth) presumably carry the
   219	            # fuller content, so last-writer-wins.
   220	            recs[key] = extract_assistant_text(message_obj)
   221	
   222	    return recs, stats
   223	
   224	
   225	# ---------------------------------------------------------------------------
   226	# source B: authoritative history snapshot (HTTP or local file)
   227	# ---------------------------------------------------------------------------
   228	
   229	def fetch_history_http(base: str, session_key: str, limit: int, token: str, timeout: float) -> Any:
   230	    base_clean = base.rstrip("/")
   231	    key_seg = urllib.parse.quote(session_key, safe=":")
   232	    query = urllib.parse.urlencode({"limit": limit})
   233	    url = "%s/sessions/%s/history?%s" % (base_clean, key_seg, query)
   234	
   235	    req = urllib.request.Request(url, method="GET")
   236	    req.add_header("Authorization", "Bearer %s" % token)
   237	    req.add_header("Accept", "application/json")
   238	
   239	    try:
   240	        with urllib.request.urlopen(req, timeout=timeout) as resp:
   241	            raw = resp.read()
   242	            status = resp.getcode()
   243	    except urllib.error.HTTPError as e:
   244	        body = ""
   245	        try:
   246	            body = e.read().decode("utf-8", errors="replace")[:500]
   247	        except Exception:
   248	            pass
   249	        # NOTE: url intentionally excludes the token (it only ever lives in the
   250	        # Authorization header, never in the URL), so it's safe to print.
   251	        raise ReconcileError(
   252	            "history HTTP 请求失败：HTTP %s %s | url=%s | body(截断500字符)=%r"
   253	            % (e.code, e.reason, url, body)
   254	        )
   255	    except urllib.error.URLError as e:
   256	        raise ReconcileError("history HTTP 请求失败：无法连接 %s（%s）" % (url, e.reason))
   257	    except OSError as e:
   258	        raise ReconcileError("history HTTP 请求失败：%s（url=%s）" % (e, url))
   259	
   260	    try:
   261	        return json.loads(raw.decode("utf-8"))
   262	    except (json.JSONDecodeError, UnicodeDecodeError) as e:
   263	        raise ReconcileError("history 响应（HTTP %s）不是合法 JSON：%s" % (status, e))
   264	
   265	
   266	def load_history_file(path: str) -> Any:
   267	    try:
   268	        with open(path, "r", encoding="utf-8") as fh:
   269	            return json.load(fh)
   270	    except FileNotFoundError:
   271	        raise ReconcileError("--history-file 不存在：%s" % path)
   272	    except json.JSONDecodeError as e:
   273	        raise ReconcileError("--history-file 不是合法 JSON（%s）：%s" % (path, e))
   274	
   275	
   276	def extract_history_records(history_obj: Any) -> Tuple[Dict[Key, str], Dict[str, Any]]:
   277	    stats: Dict[str, Any] = {
   278	        "total_messages": 0,
   279	        "non_assistant_messages": 0,
   280	        "malformed_messages": 0,
   281	        "malformed_indices": [],
   282	        "duplicate_keys": 0,
   283	    }
   284	    recs: Dict[Key, str] = {}
   285	
   286	    messages = history_obj.get("messages") if isinstance(history_obj, dict) else None
   287	    if not isinstance(messages, list):
   288	        raise ReconcileError(
   289	            "history 响应缺少合法的 'messages' 数组，无法对账（顶层类型：%s）"
   290	            % (type(history_obj).__name__,)
   291	        )
   292	
   293	    for idx, msg in enumerate(messages):
   294	        stats["total_messages"] += 1
   295	        if not isinstance(msg, dict):
   296	            stats["malformed_messages"] += 1
   297	            stats["malformed_indices"].append(idx)
   298	            continue
   299	
   300	        role = msg.get("role")
   301	        if role != "assistant":
   302	            stats["non_assistant_messages"] += 1
   303	            continue
   304	
   305	        mid = dig(msg, "__openclaw", "id")
   306	        mseq = dig(msg, "__openclaw", "seq")
   307	        if mid is None or mseq is None:
   308	            stats["malformed_messages"] += 1
   309	            stats["malformed_indices"].append(idx)
   310	            continue
   311	
   312	        key = (str(mid), normalize_seq(mseq))
   313	        if key in recs:
   314	            stats["duplicate_keys"] += 1
   315	        recs[key] = extract_assistant_text(msg)
   316	
   317	    return recs, stats
   318	
   319	
   320	# ---------------------------------------------------------------------------
   321	# CLI
   322	# ---------------------------------------------------------------------------
   323	
   324	def build_arg_parser() -> argparse.ArgumentParser:
   325	    p = argparse.ArgumentParser(
   326	        prog="reconcile-history.py",
   327	        description=__doc__,
   328	        formatter_class=argparse.RawDescriptionHelpFormatter,
   329	    )
   330	    p.add_argument("--trace", required=True, metavar="PATH",
   331	                   help="wire trace JSONL 文件路径（本地，已录好）")
   332	    p.add_argument("--base", metavar="URL",
   333	                   help="openclaw gateway 的 base URL，例如 http://127.0.0.1:PORT。"
   334	                        "与 --session-key 搭配用于拉取 history；给了 --history-file 则忽略。")
   335	    p.add_argument("--session-key", metavar="KEY",
   336	                   help="要对账的 session key，例如 agent:main:dashboard:xxxx。"
   337	                        "走 HTTP 拉取 history 时必需。")
   338	    p.add_argument("--limit", type=int, default=500, metavar="N",
   339	                   help="history 快照请求的 limit（仅在走 HTTP 拉取时生效；默认 500）")
   340	    p.add_argument("--drop-one", action="store_true",
   341	                   help="破坏性反证：从 wire 侧集合删掉一条 assistant 消息后再对账，"
   342	                        "证明反向断言（history 侧完整性）确实能捕获缺失。")
   343	    p.add_argument("--history-file", metavar="PATH",
   344	                   help='离线模式：直接读本地 JSON 文件代替 HTTP 请求，形状与 '
   345	                        'GET .../history 的响应一致（{"messages": [...]}）。'
   346	                        "给了这个就不会发任何 HTTP 请求，也可用来把线上 history 快照存档取证。")
   347	    p.add_argument("--token", metavar="TOKEN", default=None,
   348	                   help="覆盖 OPENCLAW_GATEWAY_TOKEN 环境变量。默认从环境变量读；"
   349	                        "命令行参数会留痕在 shell history / `ps`，能用环境变量就别用这个。")
   350	    p.add_argument("--timeout", type=float, default=30.0, metavar="SECONDS",
   351	                   help="HTTP 请求超时秒数（默认 30；仅在走 HTTP 拉取时生效）")
   352	    return p
   353	
   354	
   355	def main(argv: Optional[List[str]] = None) -> int:
   356	    args = build_arg_parser().parse_args(argv)
   357	
   358	    if not os.path.isfile(args.trace):
   359	        fatal("--trace 文件不存在：%s" % args.trace)
   360	
   361	    # --- resolve history source -------------------------------------------------
   362	    if args.history_file:
   363	        history_source_label = "file:%s" % args.history_file
   364	        history_obj = load_history_file(args.history_file)
   365	    else:
   366	        if not args.base or not args.session_key:
   367	            fatal("必须提供 --history-file，或同时提供 --base 与 --session-key")
   368	        token = args.token or os.environ.get("OPENCLAW_GATEWAY_TOKEN")
   369	        if not token:
   370	            fatal(
   371	                "缺少鉴权 token：设置环境变量 OPENCLAW_GATEWAY_TOKEN，或传 --token"
   372	                "（不推荐，会留痕在 shell history / ps）"
   373	            )
   374	        history_source_label = "%s/sessions/%s/history?limit=%s" % (
   375	            args.base.rstrip("/"), args.session_key, args.limit
   376	        )
   377	        try:
   378	            history_obj = fetch_history_http(args.base, args.session_key, args.limit, token, args.timeout)
   379	        except ReconcileError as e:
   380	            fatal(str(e))
   381	
   382	    # --- parse both sides ---------------------------------------------------
   383	    try:
   384	        wire_recs, wire_stats = parse_wire_trace(args.trace)
   385	    except OSError as e:
   386	        fatal("读取 --trace 失败：%s" % e)
   387	        return EXIT_USAGE_ERROR  # unreachable; fatal() exits
   388	
   389	    try:
   390	        history_recs, history_stats = extract_history_records(history_obj)
   391	    except ReconcileError as e:
   392	        fatal(str(e))
   393	        return EXIT_USAGE_ERROR  # unreachable; fatal() exits
   394	
   395	    # --- report header -------------------------------------------------------
   396	    print("=" * 70)
   397	    print("RAE-0001 条件③(b)(c) 对账报告")
   398	    print("=" * 70)
   399	    print("wire trace   : %s" % args.trace)
   400	    print("history 来源  : %s" % history_source_label)
   401	    print("session key  : %s" % (args.session_key or "(未提供)"))
   402	    print("drop-one     : %s" % ("开" if args.drop_one else "关"))
   403	    print()
   404	
   405	    print("--- wire 侧解析 ---")
   406	    kv("总行数", wire_stats["total_lines"])
   407	    kv("空行（跳过）", wire_stats["blank_lines"])
   408	    kv("JSON 解析失败（跳过）", wire_stats["parse_error_lines"])
   409	    sub("解析失败的行号", wire_stats["parse_error_line_numbers"])
   410	    kv("JSON 顶层非对象（跳过）", wire_stats["unexpected_shape_lines"])
   411	    sub("该类行号", wire_stats["unexpected_shape_line_numbers"])
   412	    kv("无 evt.message.delta（忽略，非缺陷）", wire_stats["no_delta_lines"])
   413	    kv("role != assistant（忽略，非缺陷）", wire_stats["non_assistant_delta_lines"])
   414	    kv("缺 messageId/messageSeq（跳过，异常）", wire_stats["malformed_candidate_lines"])
   415	    sub("该类行号", wire_stats["malformed_line_numbers"])
   416	    kv("匹配的 assistant delta 帧（去重前）", wire_stats["matched_frames"])
   417	    kv("去重后 unique (id, seq)", len(wire_recs))
   418	    kv("重复键（同一 key 出现 >=2 次）", wire_stats["duplicate_keys"])
   419	    print()
   420	
   421	    print("--- history 侧解析 ---")
   422	    kv("messages 总条数", history_stats["total_messages"])
   423	    kv("role != assistant（忽略，非缺陷）", history_stats["non_assistant_messages"])
   424	    kv("缺 __openclaw.id/seq（跳过，异常）", history_stats["malformed_messages"])
   425	    sub("该类索引", history_stats["malformed_indices"])
   426	    kv("去重后 unique (id, seq)", len(history_recs))
   427	    kv("重复键（同一 key 出现 >=2 次）", history_stats["duplicate_keys"])
   428	    print()
   429	
   430	    # --- optional destructive counter-proof ----------------------------------
   431	    if args.drop_one:
   432	        if not wire_recs:
   433	            fatal("wire 侧没有任何 assistant 消息，无法 --drop-one（没有可删的记录）")
   434	
   435	        intersection_keys = sorted(k for k in wire_recs if k in history_recs)
   436	        if intersection_keys:
   437	            dropped_key = intersection_keys[0]
   438	        else:
   439	            dropped_key = sorted(wire_recs.keys())[0]
   440	            print(
   441	                "[WARN] wire 与 history 在删除前就没有交集——基线本身不干净。"
   442	                "仍会从 wire 任取一条演示 --drop-one，但这次删除未必能反映反向断言的"
   443	                "捕获能力（因为该键本就不在 history 里）。",
   444	                file=sys.stderr,
   445	            )
   446	
   447	        dropped_text = wire_recs[dropped_key]
   448	        print("[DROP-ONE] 删除前原样打印被删记录（这是硬要求——没打印出来这次反证不算数）：")
   449	        print("  %s  text[:60]=%r" % (fmt_key(dropped_key), preview(dropped_text)))
   450	        del wire_recs[dropped_key]
   451	        print()
   452	
   453	    # --- reconcile -------------------------------------------------------------
   454	    wire_keys = set(wire_recs.keys())
   455	    history_keys = set(history_recs.keys())
   456	    wire_only = sorted(wire_keys - history_keys)
   457	    history_only = sorted(history_keys - wire_keys)
   458	
   459	    print("--- 差集 ---")
   460	    kv("wire 有、history 没有的条数（断言① wire<=history 违反）", len(wire_only))
   461	    kv("history 有、wire 没有的条数（断言② history<=wire 违反 = 受控会话内有缺失）", len(history_only))
   462	    print()
   463	
   464	    if wire_only:
   465	        print("--- 断言① 违反明细：wire subset-of history 不成立 ---")
   466	        for k in wire_only:
   467	            print("  %s  text[:60]=%r" % (fmt_key(k), preview(wire_recs[k])))
   468	        print()
   469	
   470	    if history_only:
   471	        print("--- 断言② 违反明细：history 的 assistant 消息未在 wire 侧全部出现 ---")
   472	        for k in history_only:
   473	            print("  %s  text[:60]=%r" % (fmt_key(k), preview(history_recs[k])))
   474	        print()
   475	
   476	    passed = not wire_only and not history_only
   477	
   478	    print("=" * 70)
   479	    if args.drop_one:
   480	        if not passed:
   481	            print("结果：FAIL（符合预期）—— [DROP-ONE 自证] 断言②正确捕获了被删除的消息。")
   482	            print("=" * 70)
   483	            return EXIT_FAIL
   484	        else:
   485	            print("结果：PASS —— 但这是 --drop-one 模式，删了一条消息对账却仍然是绿的！")
   486	            print("破坏性反证失效——断言不守门。")
   487	            print("=" * 70)
   488	            return EXIT_DROP_ONE_INTEGRITY_FAILURE
   489	    else:
   490	        if passed:
   491	            print("结果：PASS")
   492	            print("=" * 70)
   493	            return EXIT_PASS
   494	        else:
   495	            print("结果：FAIL")
   496	            print("=" * 70)
   497	            return EXIT_FAIL
   498	
   499	
   500	if __name__ == "__main__":
   501	    try:
   502	        sys.exit(main())
   503	    except KeyboardInterrupt:
   504	        sys.exit(130)
   505	    except ReconcileError as e:
   506	        print("[FATAL] %s" % e, file=sys.stderr)
   507	        sys.exit(EXIT_USAGE_ERROR)
   508	    except Exception as e:  # last-resort guard: never dump a raw traceback
   509	        print("[FATAL] 未预期的异常：%s: %s" % (type(e).__name__, e), file=sys.stderr)
   510	        sys.exit(EXIT_USAGE_ERROR)

