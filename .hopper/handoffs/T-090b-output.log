   182	    durationMs: params.outcome.durationMs,
   183	    commandLength: params.command.length,
   184	    ...(params.sessionKey?.trim() ? { sessionKey: params.sessionKey.trim() } : {}),
   185	    ...(typeof params.outcome.exitCode === "number" ? { exitCode: params.outcome.exitCode } : {}),
   186	    ...(exitSignal ? { exitSignal } : {}),
   187	    ...(params.outcome.status === "failed"
   188	      ? {
   189	          timedOut: params.outcome.timedOut,
   190	          failureKind: params.outcome.failureKind,
   191	        }
   192	      : {}),
   193	  });
   194	}
