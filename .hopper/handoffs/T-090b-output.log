   241	    if (!isRecord(entry)) {
   242	      continue;
   243	    }
   244	    const path = typeof entry.path === "string" ? entry.path : "";
   245	    if (!path) {
   246	      continue;
   247	    }
   248	    const bytes = formatBytes(entry.bytes);
   249	    lines.push(`- ${bytes ? `${path} (${bytes})` : path}`);
   250	  }
   251	  if (contents.length > 12) {
   252	    lines.push(`- ... ${contents.length - 12} more`);
   253	  }
   254	  return lines;
   255	}
