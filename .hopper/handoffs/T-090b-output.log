   277	/** Normalizes notification snippets to a compact single-line form. */
   278	export function normalizeNotifyOutput(value: string) {
   279	  return value.replace(/\s+/g, " ").trim();
   280	}
   281	
   282	function compactNotifyOutput(value: string, maxChars = DEFAULT_NOTIFY_SNIPPET_CHARS) {
   283	  const normalized = normalizeNotifyOutput(value);
   284	  if (!normalized) {
   285	    return "";
   286	  }
   287	  if (normalized.length <= maxChars) {
   288	    return normalized;
   289	  }
   290	  const safe = Math.max(1, maxChars - 1);
   291	  return `${truncateUtf16Safe(normalized, safe)}…`;
   292	}
