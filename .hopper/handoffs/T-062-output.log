   575	            "bare-domain URLs (docs.python.org/..., github.com/...), or templated "
   576	            "paths with an angle-bracket placeholder (goals/<id>/...) are exempt "
   577	            "automatically; a citation known to be intentional prose rather than a "
   578	            "real reference can be exempted explicitly by putting "
   579	            "'<!-- verify:ignore -->' on the same line or the line before it. "
   580	            "Citations are resolved against the project root, the round's goal and "
   581	            "round directories, the project's own .harnessloop/ directory (for "
   582	            "citations using a PATHISH_PREFIXES prefix verbatim, e.g. "
   583	            "setup/data-sources.md), and the root of every git submodule (any depth) "
   584	            "declared in the project's .gitmodules. A trailing :<line>, :<start>-<end>, "
   585	            "or ::<anchor> locator is stripped before checking. If still unresolved, a "
   586	            "citation with >=2 path segments that matches exactly one real file as a "
   587	            "path suffix anywhere in the project is also accepted. Home-relative (~/...) "
   588	            "and filesystem-absolute (/...) citations are exempt (out of project scope)."
   589	        )
   590	    )
   591	    parser.add_argument("--project", "-p", default=".", help="Target project directory. Defaults to current directory.")
   592	    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON output.")
   593	    args = parser.parse_args()
