     1	#!/usr/bin/env python3
     2	"""Verify the mechanical subset of the Harnessloop protocol.
     3	
     4	Judgment gates (does this evidence support acceptance?) stay with the model.
     5	This script enforces only machine-checkable rules:
     6	
     7	- Rule A (scope-lock containment): every file under a round's evidence/ and
     8	  reviews/ directories must fall inside a path allowed by that round's
     9	  scope-lock.md "Allowed Changes" section.
    10	- Rule B (citation existence): every backtick-quoted span in a round's
    11	  review files that looks like a project-relative path must exist in the
    12	  project. A span is exempt from this check (not treated as a citation) if
    13	  any of the following hold:
    14	    - it contains a regex/glob metacharacter (^ $ * ? | ( ) [ ] { } \\ +),
    15	      e.g. a quoted pattern like `^_?\\s*(no|none)\\b` or a shell glob like
    16	      `__pycache__/*.pyc` — these are not literal paths;
    17	    - it opens with a bare (schemeless) domain followed by a path, e.g.
    18	      `docs.python.org/3/library/os.html` or `github.com/org/repo` — full
    19	      `scheme://` URLs were already exempt, this extends that to the bare
    20	      form reviewers commonly write when citing external docs;
    21	    - it contains an angle-bracket placeholder anywhere, e.g.
    22	      `goals/<id>/data-contract.md` — this describes the *shape* of a path
    23	      template, not a literal reference;
    24	    - the citation's line, or the line immediately before it, carries an
    25	      explicit `<!-- verify:ignore -->` HTML comment — use this to mark a
    26	      review line whose citation is known-intentional prose (e.g. quoting
    27	      another document's typo verbatim) rather than a real reference. This
    28	      is the escape hatch for cases the heuristics above cannot resolve
    29	      mechanically; it does not require a project-level opt-out.
    30	
    31	  Existence is checked against the project root, the round's goal
    32	  directory, the round directory itself, the project's own `.harnessloop/`
    33	  directory (so a citation using one of the PATHISH_PREFIXES verbatim,
    34	  e.g. `setup/data-sources.md` or `state/self-check.md`, resolves against
    35	  where those directories actually live), and the root of every
    36	  git submodule declared in the project's .gitmodules — including nested
    37	  ones (e.g. `path = kernels/openclaw`), so a citation written relative to
    38	  a submodule's own root, e.g. `plugins/foo/` when `foo` is checked out as
    39	  a submodule at <project>/foo or <project>/kernels/foo, resolves
    40	  correctly instead of being flagged as dangling).
    41	
    42	  Before existence is checked, a trailing locator suffix is stripped from
    43	  the citation: `:<line>`, `:<start>-<end>`, or `::<anchor>` (see
    44	  `strip_locator_suffix`). Reviewers routinely cite `path/to/file.py:123`
    45	  or `doc.md::some-anchor` — the locator addresses a position *within* an
    46	  already-real file, it is not part of the file's path, and checking the
    47	  literal locator-suffixed string against the filesystem always fails.
    48	  Both the original and the stripped form are tried, in that order, so a
    49	  citation that happens to end in something that is coincidentally not a
    50	  locator is not silently mis-resolved.
    51	
    52	  If a citation still does not resolve against any of the bases above
    53	  (after locator-stripping), it is tried once more as a path *suffix*
    54	  against every file that actually exists anywhere under the project tree
    55	  (see `build_suffix_index` / `suffix_unique_match`): this is the fallback
    56	  for a citation that is correct but written relative to neither the
    57	  project root, the round/goal directory, `.harnessloop/`, nor any
    58	  submodule root — e.g. `harnessloop-setup/SKILL.md` for a file that
    59	  actually lives at `plugins/harnessloop/skills/harnessloop-setup/SKILL.md`.
    60	  This fallback is deliberately conservative: it requires at least two
    61	  path segments (a single bare filename never qualifies — that shape is
    62	  both the most common typo and the least informative citation), compares
    63	  whole path *segments* rather than raw string suffixes (so `os.html`
    64	  cannot match `macos.html`), excludes common build/vendor noise
    65	  directories, and only exempts the citation when exactly one file in the
    66	  whole project tree matches that suffix — zero or multiple matches both
    67	  still report `dangling-citation` (an ambiguous or absent suffix is not a
    68	  resolved citation).
    69	
    70	  A citation that starts with `~/` (home-relative) or `/` (filesystem
    71	  absolute) is exempt from existence checking entirely, for the same
    72	  reason a `scheme://` URL is exempt: it names a location outside the
    73	  project tree, and Rule B has no project-declared base to resolve it
    74	  against — inventing one (e.g. treating `/` as the OS root) would let the
    75	  check silently walk outside the project. This is a real, known gap: a
    76	  review that cites a path inside an external design wiki kept outside
    77	  this project (e.g. under a user's `~/.llm-wiki/...`) is never verified,
    78	  because harnessloop has no way to know where — or whether — that
    79	  external tree exists. Closing that gap requires a project to declare an
    80	  additional resolution base for such external stores; that is a
    81	  separate, project-level protocol decision and is out of scope here.
    82	
    83	Exit codes: 0 = pass, 1 = violations found, 2 = usage error.
    84	"""
    85	
    86	from __future__ import annotations
    87	
    88	import argparse
    89	import json
    90	import os
    91	import re
    92	import sys
    93	from pathlib import Path
    94	
    95	CODE_SPAN = re.compile(r"`([^`]+)`")
    96	PATHISH_PREFIXES = (
    97	    ".harnessloop/",
    98	    "rounds/",
    99	    "evidence/",
   100	    "reviews/",
   101	    "goals/",
   102	    "state/",
   103	    "setup/",
   104	    "meta/",
   105	    "evals/",
   106	    "intake/",
   107	)
   108	
   109	# Explicit per-line opt-out for Rule B: a review line that carries this
   110	# marker (or is immediately preceded by a line that does) has every
   111	# citation on it skipped. See module docstring for when to use it.
   112	IGNORE_MARKER = "<!-- verify:ignore -->"
   113	
   114	# Regex/glob metacharacters. A backtick span containing any of these is a
   115	# quoted pattern (regex alternation, anchors, glob wildcards, ...), not a
   116	# literal path, so it is never treated as a citation.
   117	PATH_META_CHARS = frozenset("^$*?|(){}[]\\+")
   118	
   119	# A bare (schemeless) domain: at least two dot-separated alnum/hyphen
   120	# labels, e.g. "docs.python.org" or "github.com". Anchored so it must
   121	# consume the whole first path segment — this deliberately does not match
   122	# a plain filename with an extension (e.g. "package.json" has no `/`
   123	# after it, and is never even offered to this check; see
   124	# _looks_like_bare_domain).
   125	BARE_DOMAIN_RE = re.compile(
   126	    r"^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
   127	    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"
   128	)
   129	
   130	# Trailing locator suffixes stripped before existence checking: `::anchor`
   131	# (checked first, since it is the more specific shape) and `:line` /
   132	# `:start-end`. See `strip_locator_suffix`.
   133	ANCHOR_SUFFIX_RE = re.compile(r"::[^:]+$")
   134	LINE_SUFFIX_RE = re.compile(r":\d+(?:-\d+)?$")
   135	
   136	# Noise directories excluded from the Rule B suffix-unique fallback index
   137	# (`build_suffix_index`): build output, vendored/installed dependencies, and
   138	# VCS internals are never what a review is citing, and including them would
   139	# both slow the index and manufacture spurious "unique" matches inside
   140	# generated trees that happen to mirror source filenames.
   141	NOISE_DIR_NAMES = frozenset(
   142	    {
   143	        ".git",
   144	        "node_modules",
   145	        "dist",
   146	        "build",
   147	        "bin",
   148	        "obj",
   149	        ".venv",
   150	        "__pycache__",
   151	        ".artifacts",
   152	        "coverage",
   153	    }
   154	)
   155	
   156	
   157	def norm(path: Path) -> str:
   158	    return os.path.normcase(os.path.normpath(str(path)))
   159	
   160	
   161	def is_under(child: Path, parent: Path) -> bool:
   162	    child_s, parent_s = norm(child), norm(parent)
   163	    return child_s == parent_s or child_s.startswith(parent_s + os.sep)
   164	
   165	
   166	def extract_allowed_spans(scope_lock_text: str) -> list[str]:
   167	    """Collect allowed paths from the '## Allowed Changes' section.
   168	
   169	    Accepts both formats in the wild: backtick path spans in prose/bullets,
   170	    and the scope-lock-template.md table whose first column is the path.
   171	    """
   172	    spans: list[str] = []
   173	    in_section = False
   174	    for line in scope_lock_text.splitlines():
   175	        stripped = line.strip()
   176	        if stripped.startswith("## "):
   177	            in_section = stripped.lower() == "## allowed changes"
   178	            continue
   179	        if not in_section:
   180	            continue
   181	        spans.extend(CODE_SPAN.findall(line))
   182	        if stripped.startswith("|"):
   183	            cells = [c.strip() for c in stripped.strip("|").split("|")]
   184	            if not cells:
   185	                continue
   186	            first = cells[0].strip("`").strip()
   187	            if (
   188	                first
   189	                and not set(first) <= {"-", ":", " "}
   190	                and first.lower() not in {"path/data/tool", "path", "file", "target"}
   191	                and " " not in first
   192	            ):
   193	                spans.append(first)
   194	    return sorted({s.strip().replace("\\", "/") for s in spans if s.strip()})
   195	
   196	
   197	def _looks_like_pattern(cleaned: str) -> bool:
   198	    """True if the span contains a regex/glob metacharacter.
   199	
   200	    A quoted regex (e.g. ``^_?\\s*(no|none)\\b.*declared.*_?$``) or a shell
   201	    glob (e.g. ``__pycache__/*.pyc``) is not a literal path reference, even
   202	    though it may contain slashes and look pathish otherwise.
   203	    """
   204	    return any(ch in PATH_META_CHARS for ch in cleaned)
   205	
   206	
   207	def _looks_like_bare_domain(cleaned: str) -> bool:
   208	    """True if the span opens with a schemeless domain followed by a path.
   209	
   210	    Matches things like ``docs.python.org/3/library/os.html`` or
   211	    ``github.com/org/repo/blob/main/src/foo.py``. Requires a `/` after the
   212	    domain-looking head so plain filenames with an extension (e.g.
   213	    ``package.json``, which has no trailing path segment) are never
   214	    considered here.
   215	    """
   216	    if "/" not in cleaned:
   217	        return False
   218	    head = cleaned.split("/", 1)[0]
   219	    return bool(BARE_DOMAIN_RE.match(head))
   220	
   221	
   222	def _looks_like_placeholder(cleaned: str) -> bool:
   223	    """True if the span contains an angle-bracket placeholder anywhere.
   224	
   225	    Templated paths such as ``goals/<id>/data-contract.md`` describe a
   226	    *shape* of path, not a literal reference — the leading-character check
   227	    below only catches a span that *starts* with `<`; a placeholder in the
   228	    middle of an otherwise pathish span (e.g. after a real prefix like
   229	    `goals/`) needs its own check.
   230	    """
   231	    return "<" in cleaned or ">" in cleaned
   232	
   233	
   234	def _looks_like_out_of_project(cleaned: str) -> bool:
   235	    """True if the span is home-relative (``~/...``) or filesystem-absolute
   236	    (``/...``).
   237	
   238	    These name a location outside the project tree, not a project-relative
   239	    citation. Rule B has no project-declared base to resolve such a path
   240	    against, so — exactly like a `scheme://` URL — it is exempt rather than
   241	    checked (and rather than mis-resolved: `Path(base) / "/abs/x"` silently
   242	    discards `base` and re-checks the literal absolute path against the real
   243	    filesystem, which is not what this rule is verifying). See the module
   244	    docstring for the known-uncovered case this leaves (e.g. an external
   245	    `~/.llm-wiki/...` design-doc store).
   246	    """
   247	    return cleaned.startswith("~/") or cleaned.startswith("/")
   248	
   249	
   250	def strip_locator_suffix(cleaned: str) -> str:
   251	    """Strip a trailing `::<anchor>`, `:<line>`, or `:<start>-<end>` locator.
   252	
   253	    Reviewers commonly cite a position *within* a file rather than just the
   254	    file itself: `plugins/foo/scripts/check_setup.py:123` (a line number),
   255	    `docs/x.md:10-20` (a line range), or `.hopper/tasks/foo.md::root` (a
   256	    named anchor). The locator is not part of the path — checking the
   257	    literal locator-suffixed string against the filesystem always fails
   258	    even when the file plainly exists. The `::anchor` form is tried first
   259	    since it is the more specific shape (and would otherwise be partially
   260	    consumed by the line-number pattern if the anchor itself looked
   261	    numeric). Returns `cleaned` unchanged if neither suffix is present.
   262	    """
   263	    match = ANCHOR_SUFFIX_RE.search(cleaned)
   264	    if match:
   265	        return cleaned[: match.start()]
   266	    match = LINE_SUFFIX_RE.search(cleaned)
   267	    if match:
   268	        return cleaned[: match.start()]
   269	    return cleaned
   270	
   271	
   272	def pathish_citations(markdown_text: str) -> list[str]:
   273	    """Extract citation spans that look like file paths.
   274	
   275	    Beyond the protocol prefixes, any slash-containing span with a file
   276	    extension, a trailing slash, or a `..` segment is treated as a path so
   277	    that citations of source/test files (e.g. `src/app.py`) are verified too.
   278	    Spans with spaces, URLs, flags, and variables are ignored, as are
   279	    regex/glob patterns (`_looks_like_pattern`), bare-domain URLs
   280	    (`_looks_like_bare_domain`), templated paths containing an
   281	    angle-bracket placeholder (`_looks_like_placeholder`, e.g.
   282	    `goals/<id>/data-contract.md`), and home-relative or absolute paths
   283	    naming a location outside the project (`_looks_like_out_of_project`,
   284	    e.g. `~/.llm-wiki/x.md` or `/etc/hosts`). A line carrying (or
   285	    immediately following a line that carries) the `<!-- verify:ignore -->`
   286	    marker has all of its citations skipped — see module docstring.
   287	    """
   288	    cited: list[str] = []
   289	    lines = markdown_text.splitlines()
   290	    for i, line in enumerate(lines):
   291	        if IGNORE_MARKER in line or (i > 0 and IGNORE_MARKER in lines[i - 1]):
   292	            continue
   293	        for span in CODE_SPAN.findall(line):
   294	            cleaned = span.strip().replace("\\", "/")
   295	            if not cleaned or " " in cleaned or "://" in cleaned:
   296	                continue
   297	            if cleaned.startswith(("-", "$", "<")):
   298	                continue
   299	            if _looks_like_pattern(cleaned):
   300	                continue
   301	            if _looks_like_bare_domain(cleaned):
   302	                continue
   303	            if _looks_like_placeholder(cleaned):
   304	                continue
   305	            if _looks_like_out_of_project(cleaned):
   306	                continue
   307	            if cleaned.startswith(PATHISH_PREFIXES):
   308	                cited.append(cleaned)
   309	                continue
   310	            if "/" in cleaned:
   311	                tail = cleaned.rsplit("/", 1)[-1]
   312	                if Path(tail).suffix or cleaned.endswith("/") or ".." in cleaned:
   313	                    cited.append(cleaned)
   314	    return cited
   315	
   316	
   317	def submodule_roots(project: Path) -> list[Path]:
   318	    """Every git submodule directory declared in .gitmodules, at any depth.
   319	
   320	    Used as extra resolution bases for Rule B citation existence (not for
   321	    Rule A scope-lock containment). A review may cite a path relative to a
   322	    submodule's own root (e.g. `plugins/harnessloop/` when `harnessloop` is
   323	    checked out as a submodule at <project>/harnessloop) rather than
   324	    relative to the outer project root; without this, such citations are
   325	    dangling relative to every existing base even though the file exists.
   326	
   327	    `.gitmodules` `path =` values are honored verbatim, including nested
   328	    ones (e.g. `path = kernels/openclaw`) — a submodule need not be
   329	    checked out directly under the project root. Projects without a
   330	    .gitmodules file get an empty list and behavior is unchanged.
   331	    """
   332	    gitmodules = project / ".gitmodules"
   333	    if not gitmodules.is_file():
   334	        return []
   335	    path_re = re.compile(r"^\s*path\s*=\s*(.+?)\s*$")
   336	    roots: list[Path] = []
   337	    for line in gitmodules.read_text(encoding="utf-8", errors="replace").splitlines():
   338	        match = path_re.match(line)
   339	        if not match:
   340	            continue
   341	        rel = match.group(1).strip().replace("\\", "/")
   342	        if not rel:
   343	            continue
   344	        candidate = project / rel
   345	        if candidate.is_dir():
   346	            roots.append(candidate)
   347	    return roots
   348	
   349	
   350	def build_suffix_index(project: Path) -> dict[str, list[tuple[str, ...]]]:
   351	    """Index every real file under `project` by basename, once per run.
   352	
   353	    Backs the Rule B suffix-unique fallback (`suffix_unique_match`): after a
   354	    citation fails to resolve against every explicit base (project root,
   355	    goal/round dirs, `.harnessloop/`, submodule roots — with and without a
   356	    locator suffix stripped), it is tried once more as a path *suffix*
   357	    against this index. Building it once per `verify_project` call (rather
   358	    than walking the tree per citation) keeps that fallback from turning an
   359	    O(citations) check into an O(citations * tree size) one.
   360	
   361	    Noise directories (`NOISE_DIR_NAMES`: `.git`, `node_modules`, build
   362	    output, venvs, ...) are *pruned during the walk* rather than filtered
   363	    out afterwards — `os.walk` with in-place `dirnames` pruning, not
   364	    `Path.rglob("*")` — since a project with vendored dependencies
   365	    (`node_modules`, `.venv`, ...) can have orders of magnitude more files
   366	    inside those directories than in the whole rest of the tree; walking
   367	    into them just to discard every result made this index the dominant
   368	    cost of a `verify_protocol.py` run. Each entry maps a basename to the
   369	    list of path-segment tuples (relative to `project`) of every real file
   370	    with that basename anywhere in the (pruned) tree.
   371	    """
   372	    index: dict[str, list[tuple[str, ...]]] = {}
   373	    for dirpath, dirnames, filenames in os.walk(project):
   374	        dirnames[:] = [d for d in dirnames if d not in NOISE_DIR_NAMES]
   375	        rel_dir = Path(dirpath).relative_to(project)
   376	        dir_parts = () if str(rel_dir) == "." else rel_dir.parts
   377	        for filename in filenames:
   378	            parts = dir_parts + (filename,)
   379	            index.setdefault(filename, []).append(parts)
   380	    return index
   381	
   382	
   383	def suffix_unique_match(cleaned: str, index: dict[str, list[tuple[str, ...]]]) -> bool:
   384	    """True if `cleaned` matches exactly one real file as a path *suffix*.
   385	
   386	    Last-resort Rule B fallback (see module docstring) for a citation that
   387	    is correct but written relative to none of the explicit bases — e.g.
   388	    `harnessloop-setup/SKILL.md` for a file that actually lives at
   389	    `plugins/harnessloop/skills/harnessloop-setup/SKILL.md`. Deliberately
   390	    conservative in three ways, each guarding a specific false-negative
   391	    risk:
   392	
   393	    - Comparison is by path *segment*, not raw string suffix — `os.html`
   394	      must not match `.../macos.html` (string `endswith` would).
   395	    - At least two path segments are required — a single bare filename
   396	      (`agents/`-style single component citations, or a bare basename like
   397	      `verify_protocol.py`) is the shape most likely to be a typo and least
   398	      likely to disambiguate anything, so it never qualifies here; it is
   399	      still checked (and can still fail) against the explicit bases above.
   400	    - The match must be *unique* across the whole indexed tree — 0 hits is
   401	      still dangling (no such file), and >=2 hits is also still dangling
   402	      (an ambiguous suffix is not a resolved citation; picking one of
   403	      several candidates would silently paper over which file was meant).
   404	    """
   405	    parts = tuple(p for p in cleaned.split("/") if p)
   406	    if len(parts) < 2:
   407	        return False
   408	    candidates = index.get(parts[-1], [])
   409	    matches = [c for c in candidates if len(c) >= len(parts) and c[-len(parts) :] == parts]
   410	    return len(matches) == 1
   411	
   412	
   413	def verify_round(
   414	    project: Path, round_dir: Path, suffix_index: dict[str, list[tuple[str, ...]]]
   415	) -> tuple[list[dict], dict]:
   416	    violations: list[dict] = []
   417	    goal_dir = round_dir.parent.parent
   418	    bases = [project, goal_dir, round_dir]
   419	    # Rule B only: extra resolution bases for (1) citations that use one of
   420	    # the PATHISH_PREFIXES verbatim (setup/, state/, goals/, ...) — those
   421	    # directories actually live under <project>/.harnessloop/, which none of
   422	    # `bases` covers on their own — and (2) citations written relative to a
   423	    # submodule's own root. Kept separate from `bases` so Rule A's
   424	    # scope-lock containment check is not loosened by either addition.
   425	    citation_bases = bases + [project / ".harnessloop"] + submodule_roots(project)
   426	
   427	    checked_files = [
   428	        path
   429	        for sub in ("evidence", "reviews")
   430	        for path in sorted((round_dir / sub).rglob("*"))
   431	        if path.is_file()
   432	    ]
   433	
   434	    coverage = _empty_coverage()
   435	    coverage["rounds"] = 1
   436	    if not checked_files:
   437	        coverage["rounds_zero_inspected"] = 1
   438	
   439	    # E2(a): scope-lock existence and Allowed-Changes parseability are
   440	    # checked unconditionally for every round, independent of whether the
   441	    # round has any evidence/review files. Before this change both checks
   442	    # lived behind `if checked_files:`, so a round with nothing under
   443	    # evidence/ or reviews/ never had its scope-lock inspected at all (the
   444	    # historical "9 rounds zero-inspected, still exit 0" gap). Containment
   445	    # (below) still requires artifacts to check, so it stays guarded.
   446	    scope_lock = round_dir / "scope-lock.md"
   447	    spans: list[str] = []
   448	    if not scope_lock.exists():
   449	        violations.append(
   450	            {
   451	                "round": str(round_dir),
   452	                "kind": "missing-scope-lock",
   453	                "detail": f"{scope_lock} does not exist",
   454	            }
   455	        )
   456	    else:
   457	        spans = extract_allowed_spans(scope_lock.read_text(encoding="utf-8"))
   458	        if not spans:
   459	            violations.append(
   460	                {
   461	                    "round": str(round_dir),
   462	                    "kind": "unparseable-allowed-changes",
   463	                    "detail": f"no backtick path spans found under '## Allowed Changes' in {scope_lock}",
   464	                }
   465	            )
   466	
   467	    if checked_files and spans:
   468	        coverage["rule_a_files"] = len(checked_files)
   469	        for file_path in checked_files:
   470	            allowed = any(
   471	                is_under(file_path, base / span)
   472	                for base in bases
   473	                for span in spans
   474	            )
   475	            if not allowed:
   476	                violations.append(
   477	                    {
   478	                        "round": str(round_dir),
   479	                        "kind": "scope-lock-violation",
   480	                        "detail": f"{file_path} is outside every allowed path in {scope_lock}",
   481	                    }
   482	                )
   483	
   484	    reviews_dir = round_dir / "reviews"
   485	    if reviews_dir.is_dir():
   486	        for review in sorted(reviews_dir.rglob("*.md")):
   487	            coverage["rule_b_files"] += 1
   488	            for cited in pathish_citations(review.read_text(encoding="utf-8")):
   489	                coverage["citations_checked"] += 1
   490	                resolved = any((base / cited).exists() for base in citation_bases)
   491	                if not resolved:
   492	                    stripped = strip_locator_suffix(cited)
   493	                    if stripped != cited:
   494	                        resolved = any((base / stripped).exists() for base in citation_bases)
   495	                    else:
   496	                        stripped = cited
   497	                if not resolved:
   498	                    resolved = suffix_unique_match(stripped, suffix_index)
   499	                if not resolved:
   500	                    violations.append(
   501	                        {
   502	                            "round": str(round_dir),
   503	                            "kind": "dangling-citation",
   504	                            "detail": f"{review} cites `{cited}` which does not exist",
   505	                        }
   506	                    )
   507	
   508	    # E4: same-file enum contradiction in decision.md. Deliberately the
   509	    # narrowest possible check — two enum lines in one file, compared after
   510	    # strip().lower(). No prose parsing, no path resolution, no cross-file
   511	    # join, no value normalization: those are exactly what produced six of
   512	    # this repo's ten evolution issues. Absent fields are never a violation,
   513	    # so existing rounds need no migration.
   514	    decision = round_dir / "decision.md"
   515	    if decision.exists():
   516	        verdict = residuals = None
   517	        for line in decision.read_text(encoding="utf-8", errors="ignore").splitlines():
   518	            stripped = line.strip()
   519	            if verdict is None and stripped.lower().startswith("- verdict:"):
   520	                verdict = stripped.split(":", 1)[1].strip().lower()
   521	            elif residuals is None and stripped.lower().startswith("- residuals:"):
   522	                residuals = stripped.split(":", 1)[1].strip().lower()
   523	        if verdict == "pass" and residuals not in (None, "", "none"):
   524	            violations.append(
   525	                {
   526	                    "round": str(round_dir),
   527	                    "kind": "verdict-residual-contradiction",
   528	                    "detail": (
   529	                        f"{decision} declares `Verdict: pass` while `Residuals` is "
   530	                        f"non-none — use `pass-with-residual` when part of the claim "
   531	                        f"is uncovered or deferred"
   532	                    ),
   533	                }
   534	            )
   535	
   536	    return violations, coverage
