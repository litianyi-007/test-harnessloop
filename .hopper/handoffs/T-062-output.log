# Host case sensitivity probe.
case=root/'casefs'; case.mkdir(); (case/'MixedCase').write_text('x')
results['host_case_sensitive']={'exact':(case/'MixedCase').exists(),'wrong_case':(case/'mixedcase').exists()}
print(json.dumps(results,indent=2,ensure_ascii=False))
shutil.rmtree(root)
