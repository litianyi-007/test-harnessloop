    p = root/name
    rd = p/'.harnessloop/goals/g/rounds/0001'
    (rd/'reviews').mkdir(parents=True)
    (rd/'evidence').mkdir()
    (rd/'scope-lock.md').write_text('# Scope Lock\\n\\n## Allowed Changes\\n\\n- "'`reviews/`'"\\n- "'`evidence/`'"\\n')
    for rel in files:
        f=p/rel; f.parent.mkdir(parents=True, exist_ok=True); f.write_text('x\\n')
    for rel,target in symlinks:
        f=p/rel; f.parent.mkdir(parents=True, exist_ok=True); f.symlink_to(target)
    if gitmodules is not None: (p/'.gitmodules').write_text(gitmodules)
    (rd/'reviews/case.md').write_text(f'- "'`{citation}`'"\\n')
    violations,cov=vp.verify_project(p)
    dangling=[v['detail'] for v in violations if v['kind']=='dangling-citation']
    return {'citation':citation,'dangling_count':len(dangling),'dangling':dangling,'coverage':cov}

results['trailing_slash_file'] = fixture('trail','pkg/real.md/',files=['deep/pkg/real.md'])
results['broken_symlink'] = fixture('broken','pkg/broken.md',symlinks=[('deep/pkg/broken.md','missing-target.md')])
results['noise_pruned_ambiguity'] = fixture('noise','pkg/real.md',files=['src/pkg/real.md','build/pkg/real.md'])
# malformed .gitmodules traversal base: outside directory is sibling of project.
out=(root/'outside/pkg'); out.mkdir(parents=True); (out/'ghost.py').write_text('x\\n')
results['submodule_parent_escape'] = fixture('subescape','pkg/ghost.py',gitmodules='[submodule \"outside\"]\\n\\tpath = ../outside\\n\\turl = https://example.invalid/x\\n')
# Snapshot staleness: the helper still returns True after its indexed file is removed.
stale=root/'stale'; (stale/'deep/pkg').mkdir(parents=True); sf=stale/'deep/pkg/gone.md'; sf.write_text('x\\n')
idx=vp.build_suffix_index(stale); sf.unlink()
results['stale_index_after_delete']={'match_after_delete':vp.suffix_unique_match('pkg/gone.md',idx),'target_exists':sf.exists()}
# Segment/path boundary probes against a pure index.
