   539	def _empty_coverage() -> dict:
   540	    """Zeroed coverage accumulator. Keys match the `### Mechanical Gate
   541	    Boundary` IN column in harnessloop-loop/SKILL.md one-to-one; a rename on
   542	    either side must update the other."""
   543	    return {
   544	        "rounds": 0,
   545	        "rounds_zero_inspected": 0,
   546	        "rule_a_files": 0,
   547	        "rule_b_files": 0,
   548	        "citations_checked": 0,
   549	    }
   550	
   551	
   552	def verify_project(project: Path) -> tuple[list[dict], dict]:
   553	    goals_dir = project / ".harnessloop" / "goals"
   554	    coverage = _empty_coverage()
   555	    if not goals_dir.is_dir():
   556	        return [], coverage
   557	    violations: list[dict] = []
   558	    # Built once per project run (not per round/citation) — see
   559	    # `build_suffix_index` for why this matters for performance.
   560	    suffix_index = build_suffix_index(project)
   561	    for round_dir in sorted(goals_dir.glob("*/rounds/*")):
   562	        if round_dir.is_dir():
   563	            round_violations, round_coverage = verify_round(project, round_dir, suffix_index)
   564	            violations.extend(round_violations)
   565	            for key in coverage:
   566	                coverage[key] += round_coverage[key]
   567	    return violations, coverage
