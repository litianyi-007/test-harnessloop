   353	// MARK: - ③ agent(stream:"lifecycle") -> turnComplete / operationCompleted（现场实测样本 grounding）
   354	
   355	/// `!aborted` 分支：正常回合结束 -> turnComplete。
   356	///
   357	/// **F6 订正**：上一轮把"合法 `phase:end` 但没有 `stopReason`"默认记成 `.error`，对抗审 codex 指出
   358	/// openclaw 测试里确实存在 `data:{phase:"end"}`（无 stopReason）这种合法终态，不该被误报成错误。
   359	/// 源码坐实（rework 轮新读 `kernels/openclaw/src/agents/embedded-agent-subscribe.handlers.lifecycle.ts:
   360	/// 176-202`）：`phase` 只有在 `isError`（= 上一条 assistant 消息自己的 `stopReason === "error"`）时
   361	/// 才会是 `"error"`，否则一律是 `"end"`（或 `"finishing"`，本文件不处理，见头注释④）——也就是说
   362	/// **`phase == "end"` 这个事实本身，由 openclaw 自己的构造逻辑保证 `isError == false`**，缺失
   363	/// `stopReason` 只代表"没有更细的终止原因可报"，不代表出错。因此缺失/未知取值一律折叠到
   364	/// `.completed`，不再默认 `.error`。
   365	/// 真实取值来源（同文件 `terminalStopReason` 变量）：非 error 分支的 `stopReason` 落回"上一条
   366	/// assistant 消息自己的 `stopReason`"——真实样本观察到 `"stop"`（正常结束）与 `"toolUse"`（回合内
   367	/// 还在工具调用中就进入了 lifecycle "end"，边缘情况，同样折叠进 `.completed`，因为 `aborted:false`
   368	/// + `phase:"end"` 已经由 openclaw 保证"不是错误终止"）。`"max_turns"`/`"maxTurns"` 本轮仍未现场
   369	/// 观察到，映射到 `.maxTurns`维持上一轮的推断标注，未改判。
   370	func mapOpenclawAgentLifecycleToTurnComplete(
   371	    _ data: JSONObject,
   372	    ourSessionID: String,
   373	    runID: String,
   374	    originTS: Date,
   375	    cachedUsage: (input: Int, output: Int)?,
   376	    nextSeq: () -> Int
   377	) -> EventMessageUnion {
   378	    let rawStopReason = jsonString(data["stopReason"])
   379	    let stopReason: StopReason
   380	    switch rawStopReason {
   381	    case "max_turns", "maxTurns":
   382	        stopReason = .maxTurns // 推断：本轮未现场观察到这个取值，维持上一轮标注
   383	    default:
   384	        // "stop"/"toolUse"/nil/其余未知取值：aborted:false + phase:"end" 由 openclaw 自身构造逻辑
   385	        // 保证非错误终止（见函数文档注释），一律记 completed，不再默认 error（F6）。
   386	        stopReason = .completed
   387	    }
   388	    let usage = cachedUsage.map { Usage(inputTokens: $0.input, outputTokens: $0.output) }
   389	    let turnPayload = TurnCompleteEventMessagePayload(
   390	        degraded: nil, forceResolvedApprovals: nil, stopReason: stopReason, usage: usage
   391	    )
   392	    return .turnComplete(TurnCompleteEventMessage(
   393	        direction: .event, payload: turnPayload, runID: runID,
   394	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtTurnComplete
   395	    ))
   396	}
   397	
   398	/// `aborted` 分支：**F6 订正**——上一轮只发一条 `operationCompleted`，且其 `operationId` 是
   399	/// mapper 自己派生的 `"\(ourSessionID)-abort-\(runID)"`，与 `OpenclawGatewayKernelClient.stop()`
   400	/// 返回给调用方的 `StopResultPayload.operationID`（上一轮是完全不同的
   401	/// `"\(sessionID)-stop-abort_\(status)"`）互不相同，调用方拿到的 Promise 结果和异步旁路事件根本无法
   402	/// 关联；D1 v3 §9.3"stop 的事件顺序保证"还要求这次强制取消**必须**同时产出
   403	/// `TurnCompleteEvent(stopReason:'cancelled')`，上一轮完全没发。
   404	///
   405	/// rework 轮修法：`operationID` 改为**调用方（`stop()`）在发起 `sessions.abort` 之前就已经铸造好**
   406	/// 的唯一值，通过参数传入（不再自己派生）；本函数一次性返回 `[operationCompleted, turnComplete]`
   407	/// 两个事件（顺序即数组顺序，调用方按序 yield，先 operation_completed 后 turn_complete，符合
   408	/// 任务书 F6 要求的"单个 operation_completed → turn_complete(cancelled) → session_end(stopped)"
   409	/// 序列的前两段）。调用方负责保证本函数对同一次 stop() 只被调用一次（同一个 run 的第二条 aborted
   410	/// 帧——真实样本里 `phase:"end"` 之后常跟一条 `phase:"error",error:"This operation was aborted"`
   411	/// 的收尾帧——被调用方去重，不再产出第二组 operationCompleted/turnComplete，见
   412	/// `OpenclawGatewayKernelClient.handleAgentEvent` 的 pendingStop 状态机）。
   413	///
   414	/// outcome 判别（同上一轮，未改判）：真实样本里 phase=="end" 时 status=="cancelled"（sessions.abort
   415	/// 的 RPC 结果本身也确认了 outcome:"aborted"）记 succeeded（"这次 abort 操作成功执行了"）；
   416	/// phase=="error" 那条后续帧语义不够确定，保守记 abortedEffectUnknown。
   417	func mapOpenclawAgentLifecycleToAbortTerminalEvents(
   418	    _ data: JSONObject,
   419	    ourSessionID: String,
   420	    runID: String,
   421	    operationID: String,
   422	    originTS: Date,
   423	    cachedUsage: (input: Int, output: Int)?,
   424	    nextSeq: () -> Int
   425	) -> [EventMessageUnion] {
   426	    let phase = jsonString(data["phase"])
   427	    let outcome: PayloadOutcome = phase == "end" ? .succeeded : .abortedEffectUnknown
   428	    let detail = jsonString(data["error"])
   429	    let opPayload = OperationCompletedEventMessagePayload(
   430	        affectedRunID: runID, detail: detail, newRunID: nil,
   431	        operationID: operationID, operationKind: .stop, outcome: outcome
   432	    )
   433	    let operationCompletedEvent = EventMessageUnion.operationCompleted(OperationCompletedEventMessage(
   434	        direction: .event, payload: opPayload, runID: runID,
   435	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtOperationCompleted
   436	    ))
   437	
   438	    let usage = cachedUsage.map { Usage(inputTokens: $0.input, outputTokens: $0.output) }
   439	    let turnPayload = TurnCompleteEventMessagePayload(
   440	        degraded: nil, forceResolvedApprovals: nil, stopReason: .cancelled, usage: usage
   441	    )
   442	    let turnCompleteEvent = EventMessageUnion.turnComplete(TurnCompleteEventMessage(
   443	        direction: .event, payload: turnPayload, runID: runID,
   444	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtTurnComplete
   445	    ))
   446	
   447	    return [operationCompletedEvent, turnCompleteEvent]
   448	}
   449	
   450	// MARK: - ④ session.approval -> approvalRequest（现场实测样本 grounding；toolCallID 关联 F4 rework）
   451	
   452	/// 真实样本（`sessions.messages.subscribe` 必须带 `includeApprovals:true` 才收得到这个事件；把
   453	/// 会话 execAsk 临时 patch 成 "always" 才能在这个隔离环境里真正触发一次审批，默认策略 DEFAULT_ASK
   454	/// 是 "off"——见 kernels/openclaw/src/infra/exec-approvals.ts:318）：
   455	/// ```
   456	/// {"sessionKey":"...","sourceSessionKey":"...","updatedAtMs":1784871218655,"phase":"pending",
   457	///  "approval":{"id":"d7085add-...","status":"pending",
   458	///    "presentation":{"kind":"exec","commandText":"echo hello-sg5","commandPreview":null,
   459	///      "warningText":null,"host":"gateway","nodeId":null,"agentId":"main",
   460	///      "allowedDecisions":["allow-once","deny"]},
   461	///    "urlPath":"/approve/d7085add-...","createdAtMs":1784871218655,
   462	///    "expiresAtMs":1784873018655}}
   463	/// ```
   464	/// 字段映射:
   465	///  - reqID = approval.id ——D2 ApprovalRequestEventMessagePayload.reqID 的文档注释原文就是
   466	///    "respondApproval() 的关联主键(= 内核 approval id,非 toolCallId)"，与 openclaw 的 approval.id
   467	///    语义完全对上。
   468	///  - kind：openclaw `ApprovalKindSchema` 只有 exec/plugin/system-agent 三个值，D2 `KindElement`
   469	///    是 exec/file_write/mcp/sandbox/tool 五个值——只有 "exec" 直接对上（真实样本验证）。
   470	///    "plugin"/"system-agent" 本轮没有现场样本，映射到 `.tool` 只是"最不失真的通用兜底"，未经验证。
   471	///  - timeoutMS = expiresAtMs - createdAtMs（真实样本算出 1800000ms = 30min）。
   472	///  - timeoutAuthority = .documented——D1 spec 原文注释就是"openclaw 'documented'；hermes
   473	///    'best_effort'"，这是 D1 设计文本自带的定性，不是本文件现场测出来的一个数字。
   474	///  - **toolCallID（F6 rework 订正，取代上一轮的"最近一次 toolCall"猜测）**：openclaw 的
   475	///    `session.approval` payload 本身仍然不携带 toolCallId 字段（`ExecApprovalPresentationSchema`
   476	///    字段集确认无此字段）。上一轮用调用方传入的"同 session 最近一次 toolCallId"做时序关联，被
   477	///    codex 对抗审指出会串号（两个 toolCall 交错、或旧缓存残留时误配）。rework 轮改为：调用方
   478	///    (`OpenclawGatewayKernelClient`) 从**另一个更权威的真实来源**——`agent(stream:"approval",
   479	///    data.phase:"requested")`，其 `data.approvalId`/`data.toolCallId` 都是这次审批的准确值
   480	///    （见 `embedded-agent-subscribe.handlers.tools.ts:1669-1699`）——按 `approvalId` 建立一个精确
   481	///    的一次性缓存，本函数的 `toolCallIDForApprovalID` 参数就是"用 `approval.id` 去查这个缓存"的
   482	///    结果，不再是"最近一次"的猜测。缺失时仍诚实跳过（不拿占位符顶替）。
   483	///  - payload（JSONAny，D1 定义为"该 kind 下的不透明详情"）：取 `approval.presentation` 整体
   484	///    包装——openclaw 没有另外一个字段专门叫"payload"，presentation 是这里语义最贴近的现场数据。
   485	///  - proposedDecision：openclaw 真实样本没有这个字段，如实置 nil，不编造。
   486	///  - **ts（F3 rework 新增）**：取 `payload.updatedAtMs`（这条 session.approval 事件自己的
   487	///    产出时刻），`sentAt` 改为 `Date()`（适配器本地转发时刻）——上一轮把两者都设成
   488	///    `updatedAtMs`，混淆了 envelope `sentAt` 与业务 `ts` 两个不同语义（D2 v3 §2）。
   489	///
   490	/// phase:"terminal" 分支：真实样本观察到 reason 取值是 openclaw 自己的
   491	/// `ApprovalTerminalReasonSchema`（user/timeout/malformed-verdict/no-route/run-aborted/
   492	/// gateway-restart/storage-corrupt），这个词表和 D1 `ApprovalBufferResolvedEvent` 要求的
   493	/// reason（仅 buffered_timeout/queue_overflow）完全不相交，因此 phase:"terminal" 不映射到 D2 11
   494	/// 变体中的任何一个——如实返回 nil。
   495	func mapOpenclawSessionApprovalToKernelEvent(
   496	    _ payload: JSONObject,
   497	    ourSessionID: String,
   498	    runIDHint: String?,
   499	    toolCallIDForApprovalID: String?,
   500	    nextSeq: () -> Int
   501	) -> EventMessageUnion? {
   502	    guard jsonString(payload["phase"]) == "pending" else {
   503	        // terminal 分支：见上方文档注释，D1 11 变体里没有它的对应位置。
   504	        return nil
   505	    }
   506	    guard let approval = jsonObject(payload["approval"]) else { return nil }
   507	    guard let reqID = jsonString(approval["id"]) else { return nil }
   508	    guard let toolCallID = toolCallIDForApprovalID else {
   509	        // 没有从 agent(stream:"approval") 观察到这次 approvalId 对应的 toolCallId——诚实跳过，
   510	        // 不拿"最近一次"占位符顶替（F4：那正是上一轮被判定会串号的做法）。
   511	        return nil
   512	    }
   513	    guard let runID = runIDHint else {
   514	        // ApprovalRequestEventMessage.runID 是必填字段——真缺失时诚实跳过。
   515	        return nil
   516	    }
   517	
   518	    let presentation = jsonObject(approval["presentation"]) ?? [:]
   519	    let openclawKind = jsonString(presentation["kind"])
   520	    let kind: KindElement = openclawKind == "exec" ? .exec : .tool // 见上方文档注释，非 exec 未验证
   521	
   522	    let createdAtMs = jsonInt(approval["createdAtMs"])
   523	    let expiresAtMs = jsonInt(approval["expiresAtMs"])
   524	    let timeoutMS = (createdAtMs != nil && expiresAtMs != nil) ? (expiresAtMs! - createdAtMs!) : 0
   525	
   526	    let approvalPayload = ApprovalRequestEventMessagePayload(
   527	        kind: kind,
   528	        payload: makeJSONAny(presentation),
   529	        proposedDecision: nil,
   530	        reqID: reqID,
   531	        timeoutAuthority: .documented,
   532	        timeoutMS: timeoutMS,
   533	        toolCallID: toolCallID
   534	    )
   535	    let originTS = msEpochToDate(jsonInt(payload["updatedAtMs"]))
   536	    return .approvalRequest(ApprovalRequestEventMessage(
   537	        direction: .event, payload: approvalPayload, runID: runID,
   538	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtApprovalRequest
   539	    ))
   540	}
