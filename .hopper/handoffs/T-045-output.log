   477	    // MARK: - 内部：RPC 请求/响应关联
   478	
   479	    private func request(method: String, params: JSONObject) async throws -> JSONObject {
   480	        guard let task = task else { throw KernelClientError.notConnected }
   481	        nextReqID += 1
   482	        let id = "r\(nextReqID)"
   483	        let frame: JSONObject = ["type": "req", "id": id, "method": method, "params": params]
   484	        prettyPrint("SEND req \(method)", frame)
   485	        let data = try encodeFrame(frame)
   486	
   487	        return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<JSONObject, Error>) in
   488	            self.pending[id] = continuation
   489	            task.send(.data(data)) { error in
   490	                if let error = error {
   491	                    Task { await self.failPending(id: id, error: KernelClientError.transport(error.localizedDescription)) }
   492	                }
   493	            }
   494	        }
   495	    }
   496	
   497	    private func failPending(id: String, error: Error) {
   498	        if let continuation = pending.removeValue(forKey: id) {
   499	            continuation.resume(throwing: error)
   500	        }
   501	    }
   502	
   503	    private func waitForNextEvent(named eventName: String) async throws -> JSONObject {
   504	        try await withCheckedThrowingContinuation { continuation in
   505	            self.oneShotEventWaiters[eventName] = continuation
   506	        }
   507	    }
   508	
   509	    // MARK: - 内部：接收循环
   510	
   511	    private func receiveLoop() async {
   512	        guard let task = task else { return }
   513	        while !Task.isCancelled {
   514	            do {
   515	                let message = try await task.receive()
   516	                switch message {
   517	                case .data(let data):
   518	                    handleIncoming(data)
   519	                case .string(let text):
   520	                    if let data = text.data(using: .utf8) {
   521	                        handleIncoming(data)
   522	                    }
   523	                @unknown default:
   524	                    break
   525	                }
   526	            } catch {
   527	                // 传输中断前先尽力给每个尚未产出过 terminal 的活跃 session 补一条
   528	                // sessionEnd(reason:.transportClosed)——F8：与 shutdown/stop 两条路径共享
   529	                // `sessionTerminalEmitted` 去重标记，不会对同一个 session 重复/矛盾地产出 sessionEnd。
   530	                for (ourSessionID, continuation) in eventContinuations {
   531	                    guard !sessionTerminalEmitted.contains(ourSessionID) else { continue }
   532	                    sessionTerminalEmitted.insert(ourSessionID)
   533	                    continuation.yield(makeSessionEndEventForTransportClosed(
   534	                        ourSessionID: ourSessionID,
   535	                        nextSeq: { self.nextSeq(runID: nil, sessionID: ourSessionID) }
   536	                    ))
   537	                }
   538	                failAllPending(error: KernelClientError.transport("\(error)"))
   539	                break
   540	            }
   541	        }
   542	    }
   543	
   544	    private func failAllPending(error: Error) {
   545	        for (_, continuation) in pending {
   546	            continuation.resume(throwing: error)
   547	        }
   548	        pending.removeAll()
   549	        for (_, waiter) in oneShotEventWaiters {
   550	            waiter.resume(throwing: error)
   551	        }
   552	        oneShotEventWaiters.removeAll()
   553	        for (_, cont) in eventContinuations {
   554	            cont.finish(throwing: error)
   555	        }
   556	        eventContinuations.removeAll()
   557	    }
   558	
   559	    private func handleIncoming(_ data: Data) {
   560	        guard let frame = try? decodeFrame(data) else { return }
   561	        guard let type = frame["type"] as? String else { return }
   562	
   563	        switch type {
   564	        case "res":
   565	            guard let id = frame["id"] as? String else { return }
   566	            guard let continuation = pending.removeValue(forKey: id) else { return }
   567	            let ok = (frame["ok"] as? Bool) ?? false
   568	            if ok {
   569	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   570	                continuation.resume(returning: payload)
   571	            } else {
   572	                let err = (frame["error"] as? JSONObject) ?? [:]
   573	                let code = (err["code"] as? String) ?? "unknown"
   574	                let message = err["message"] as? String
   575	                continuation.resume(throwing: KernelClientError.rpcRejected(code: code, message: message))
   576	            }
   577	
   578	        case "event":
   579	            guard let eventName = frame["event"] as? String else { return }
   580	            if let waiter = oneShotEventWaiters.removeValue(forKey: eventName) {
   581	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   582	                waiter.resume(returning: payload)
   583	                return
   584	            }
   585	            // session.message 之外还要分发 agent(command_output/lifecycle/thinking/error/item/
   586	            // approval)、session.approval、全局 shutdown 三类 wire 事件——D2 11 变体里除
   587	            // message_delta/tool_call 之外的大多数都不是从 session.message 来的。
   588	            switch eventName {
   589	            case "session.message":
   590	                handleSessionMessageEvent(frame)
   591	            case "agent":
   592	                handleAgentEvent(frame)
   593	            case "session.approval":
   594	                handleSessionApprovalEvent(frame)
   595	            case "shutdown":
   596	                handleShutdownEvent(frame)
   597	            default:
   598	                prettyPrint("RECV event \(eventName) (未处理的旁路事件，原样打印)", frame)
   599	            }
   600	
   601	        default:
   602	            break
   603	        }
   604	    }
   605	
   606	    /// 按 openclaw 原生 key 反查我们自己铸造的 sessionID——四个事件 handler（session.message/
   607	    /// agent/session.approval）共享同一套"payload.sessionKey -> ourSessionID -> continuation"
   608	    /// 查找逻辑，抽成一个小helper 避免重复。
   609	    private func ourSessionID(forKernelKey kernelKey: String) -> String? {
   610	        kernelKeyBySessionID.first(where: { $0.value == kernelKey })?.key
   611	    }
   612	
   613	    private func handleSessionMessageEvent(_ frame: JSONObject) {
   614	        guard let payload = frame["payload"] as? JSONObject,
   615	              let kernelKey = payload["sessionKey"] as? String,
   616	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   617	            return
   618	        }
   619	        guard let continuation = eventContinuations[ourSessionID] else { return }
   620	
   621	        // 顺带刷新 runId/usage 缓存——session.message 的 session 快照里带 activeRunIds，assistant
   622	        // 消息自己带 usage。F1：usage 缓存改为 **per-run**（用刚刷新出来的 runId 做键），不再是
   623	        // per-session，避免上一个 run 的残留 usage 串给下一个 run 的 turn_complete。
   624	        var currentRunID = lastRunIDBySessionID[ourSessionID]
   625	        if let sessionSnapshot = payload["session"] as? JSONObject,
   626	           let activeRunIDs = sessionSnapshot["activeRunIds"] as? [Any],
   627	           let firstRunID = activeRunIDs.first as? String {
   628	            lastRunIDBySessionID[ourSessionID] = firstRunID
   629	            runIDsBySessionID[ourSessionID, default: []].insert(firstRunID)
   630	            currentRunID = firstRunID
   631	        }
   632	        if let message = payload["message"] as? JSONObject, let usage = message["usage"] as? JSONObject,
   633	           let input = jsonInt(usage["input"]), let output = jsonInt(usage["output"]),
   634	           let runID = currentRunID {
   635	            lastUsageByRunID[runID] = (input: input, output: output)
   636	        }
   637	
   638	        let runIDHint = currentRunID
   639	        let sid = ourSessionID
   640	        let events = mapOpenclawSessionMessageToKernelEvents(
   641	            payload, ourSessionID: ourSessionID, runIDHint: runIDHint,
   642	            nextSeq: { self.nextSeq(runID: runIDHint, sessionID: sid) }
   643	        )
   644	        if events.isEmpty {
   645	            prettyPrint("RECV session.message（未能映射到 D2 KernelEvent 11 变体之一）", frame)
   646	            return
   647	        }
   648	        for event in events {
   649	            if case .toolCall(let toolCall) = event, let runID = runIDHint {
   650	                // F1：per-run 缓存（不是 per-session），approval 的 toolCallId 时序关联（F4 已改用
   651	                // 更权威的 agent(stream:"approval") 来源，这里保留只是为了兼容潜在的其它读者/诊断）。
   652	                lastToolCallIDByRunID[runID] = toolCall.payload.toolCallID
   653	            }
   654	            continuation.yield(event)
   655	        }
   656	    }
   657	
   658	    /// `agent` wire 事件——`payload.stream` 分好几种，本轮 dispatch：`command_output`(phase:end)、
   659	    /// `item`(kind:tool,phase:end，非 exec 工具)、`lifecycle`(phase:end/error)、`thinking`、`error`、
   660	    /// `approval`(只做 toolCallId 关联缓存，不直接产出事件，见 F4)。其余 stream（run_status/usage/
   661	    /// assistant/plan/compaction 等，均为 openclaw 自有 UI 进度信号，D1 11 变体没有对应位置）原样
   662	    /// 打印、不映射。
   663	    private func handleAgentEvent(_ frame: JSONObject) {
   664	        guard let payload = frame["payload"] as? JSONObject,
   665	              let kernelKey = payload["sessionKey"] as? String,
   666	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   667	            return
   668	        }
   669	        guard let continuation = eventContinuations[ourSessionID] else { return }
   670	
   671	        // agent 事件的 payload.runId 是本轮拿到 runIDHint 最可靠的现场来源之一（session.create
   672	        // 之后、真正 send() 之前也可能已经有别的 run 在跑），顺带刷新缓存。
   673	        if let runID = payload["runId"] as? String {
   674	            lastRunIDBySessionID[ourSessionID] = runID
   675	            runIDsBySessionID[ourSessionID, default: []].insert(runID)
   676	        }
   677	
   678	        guard let stream = payload["stream"] as? String, let data = payload["data"] as? JSONObject else {
   679	            return
   680	        }
   681	        let runIDHint = lastRunIDBySessionID[ourSessionID]
   682	        // F3：ts 取 `agent` wire 帧外层 payload.ts（openclaw `enrichAgentEvent` 盖章的事件发生时刻，
   683	        // `infra/agent-events.ts:628` `ts: Date.now()`），不用 Date()。
   684	        let originTS = msEpochToDate(jsonInt(payload["ts"]))
   685	        let sid = ourSessionID
   686	        let nextSeqForRun: () -> Int = { self.nextSeq(runID: runIDHint, sessionID: sid) }
   687	
   688	        switch stream {
   689	        case "command_output":
   690	            if let event = mapOpenclawAgentCommandOutputToToolResult(
   691	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   692	            ) {
   693	                continuation.yield(event)
   694	            }
   695	
   696	        case "item":
   697	            // F5：非 exec 工具的 toolResult 来源。exec 工具（"exec"/"bash"）继续只信任
   698	            // command_output（有真实 output/exitCode），这里显式排除避免同一个 toolCallId 产出两条
   699	            // 矛盾的 toolResult。
   700	            guard jsonString(data["kind"]) == "tool", !isOpenclawExecToolName(jsonString(data["name"])) else {
   701	                break
   702	            }
   703	            if let event = mapOpenclawAgentToolItemToToolResult(
   704	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   705	            ) {
   706	                continuation.yield(event)
   707	            }
   708	
   709	        case "thinking":
   710	            if let event = mapOpenclawAgentThinkingToKernelEvent(
   711	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   712	            ) {
   713	                continuation.yield(event)
   714	            }
   715	
   716	        case "error":
   717	            if let event = mapOpenclawAgentErrorToKernelEvent(
   718	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   719	            ) {
   720	                continuation.yield(event)
   721	            }
   722	
   723	        case "approval":
   724	            // F4：只做 approvalId -> toolCallId 的精确关联缓存，不直接产出 D2 事件——真正的
   725	            // approval_request 仍由 session.approval(phase:pending) 产出（它才有 timeoutMs/
   726	            // presentation 等完整字段），这里只是给它提供一个不会串号的 toolCallId 来源。
   727	            if jsonString(data["phase"]) == "requested",
   728	               let approvalID = jsonString(data["approvalId"]),
   729	               let toolCallID = jsonString(data["toolCallId"]) {
   730	                toolCallIDByApprovalID[approvalID] = toolCallID
   731	            }
   732	
   733	        case "lifecycle":
   734	            guard let phase = jsonString(data["phase"]), phase == "end" || phase == "error" else { break }
   735	            guard let runID = runIDHint else {
   736	                // turnComplete/operationCompleted 的 runID 字段在 D2 里是必填——理论上不会缺失
   737	                // （lifecycle 事件本身携带真实 runId），真缺失时诚实跳过，不拿编造值填充。
   738	                break
   739	            }
   740	            let aborted = jsonBool(data["aborted"]) ?? false
   741	            if aborted {
   742	                if var pendingForRun = pendingStops[ourSessionID], pendingForRun.affectedRunID == runID, !pendingForRun.terminalEmitted {
   743	                    // F6：单个 operation_completed + turn_complete(cancelled)，用 stop() 铸造的
   744	                    // 唯一 operationId，且对同一次 pendingStop 只做一次（后续同 run 的收尾帧，如
   745	                    // 真实样本里 phase:"end" 之后常跟的 phase:"error","This operation was
   746	                    // aborted" 帧，被下面 else 分支丢弃）。
   747	                    let events = mapOpenclawAgentLifecycleToAbortTerminalEvents(
   748	                        data, ourSessionID: ourSessionID, runID: runID, operationID: pendingForRun.operationID,
   749	                        originTS: originTS, cachedUsage: lastUsageByRunID[runID], nextSeq: nextSeqForRun
   750	                    )
   751	                    for event in events { continuation.yield(event) }
   752	                    pendingForRun.terminalEmitted = true
   753	                    pendingStops[ourSessionID] = pendingForRun
   754	                    lastUsageByRunID.removeValue(forKey: runID)
   755	                    resolvePendingStopWaiter(sessionID: ourSessionID, timedOut: false)
   756	                } else if pendingStops[ourSessionID] == nil {
   757	                    // 理论上不会出现——interrupt() 本轮未实现，没有别的方法会产生 aborted:true 且
   758	                    // 没有对应 pendingStop 的 lifecycle 帧。防御性兜底：自己派生一个 operationId，
   759	                    // 保持"至少不丢事件"的旧行为，同时如实标注这是非预期路径。
   760	                    let fallbackOperationID = "\(ourSessionID)-abort-\(runID)-unowned"
   761	                    let events = mapOpenclawAgentLifecycleToAbortTerminalEvents(
   762	                        data, ourSessionID: ourSessionID, runID: runID, operationID: fallbackOperationID,
   763	                        originTS: originTS, cachedUsage: lastUsageByRunID[runID], nextSeq: nextSeqForRun
   764	                    )
   765	                    for event in events { continuation.yield(event) }
   766	                    lastUsageByRunID.removeValue(forKey: runID)
   767	                }
   768	                // else：已经为这次 stop() 发过 terminal——如实丢弃这条收尾帧，不重复产出。
   769	            } else {
   770	                let event = mapOpenclawAgentLifecycleToTurnComplete(
   771	                    data, ourSessionID: ourSessionID, runID: runID, originTS: originTS,
   772	                    cachedUsage: lastUsageByRunID[runID], nextSeq: nextSeqForRun
   773	                )
   774	                continuation.yield(event)
   775	                lastUsageByRunID.removeValue(forKey: runID)
   776	            }
   777	
   778	        default:
   779	            // run_status/usage/assistant/plan/compaction 等：openclaw 自有 UI 进度信号，D1 11 变体
   780	            // 没有对应位置，如实不映射。
   781	            break
   782	        }
   783	    }
   784	
   785	    /// `session.approval` wire 事件——subscribe() 已在 `sessions.messages.subscribe` 参数里带上
   786	    /// `includeApprovals:true`（见 subscribe() 实现），否则收不到这个事件。
   787	    private func handleSessionApprovalEvent(_ frame: JSONObject) {
   788	        guard let payload = frame["payload"] as? JSONObject,
   789	              let kernelKey = payload["sessionKey"] as? String,
   790	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   791	            return
   792	        }
   793	        guard let continuation = eventContinuations[ourSessionID] else { return }
   794	
   795	        let runIDHint = lastRunIDBySessionID[ourSessionID]
   796	        let approvalID = (payload["approval"] as? JSONObject)?["id"] as? String
   797	        // F4：用 approvalId 去查"更权威的 agent(stream:approval) 来源"缓存的精确 toolCallId，
   798	        // 取代上一轮"最近一次 toolCall"的猜测。
   799	        let toolCallIDForApprovalID = approvalID.flatMap { toolCallIDByApprovalID[$0] }
   800	        let sid = ourSessionID
   801	
   802	        if let event = mapOpenclawSessionApprovalToKernelEvent(
   803	            payload, ourSessionID: ourSessionID,
   804	            runIDHint: runIDHint,
   805	            toolCallIDForApprovalID: toolCallIDForApprovalID,
   806	            nextSeq: { self.nextSeq(runID: runIDHint, sessionID: sid) }
   807	        ) {
   808	            // 用过就清掉，避免这张一次性关联表无限增长（同一个 approvalId 不会有第二次 pending）。
   809	            if let approvalID = approvalID {
   810	                toolCallIDByApprovalID.removeValue(forKey: approvalID)
   811	            }
   812	            continuation.yield(event)
   813	        } else {
   814	            prettyPrint("RECV session.approval（phase:terminal 或缺关联字段，D1 11 变体无对应/跳过）", frame)
   815	        }
   816	    }
   817	
   818	    /// gateway 全局 `shutdown` 事件——对所有当前活跃、尚未产出过 terminal 的 session 各广播一条
   819	    /// sessionEnd(reason:.kernelExited)。F8：与 stop()/transportClosed 两条路径共享
   820	    /// `sessionTerminalEmitted` 去重标记。
   821	    private func handleShutdownEvent(_ frame: JSONObject) {
   822	        prettyPrint("RECV event shutdown（向所有活跃 session 广播 sessionEnd(reason:kernelExited)）", frame)
   823	        for (ourSessionID, continuation) in eventContinuations {
   824	            guard !sessionTerminalEmitted.contains(ourSessionID) else { continue }
   825	            sessionTerminalEmitted.insert(ourSessionID)
   826	            continuation.yield(makeSessionEndEventForShutdown(
   827	                ourSessionID: ourSessionID,
   828	                nextSeq: { self.nextSeq(runID: nil, sessionID: ourSessionID) }
   829	            ))
   830	        }
   831	    }
   832	
   833	    // MARK: - Test-only 支持面（frame-replay 单测用；生产路径不调用）
   834	    //
   835	    // 这个项目没有 XCTest/SwiftPM test target（`app/contracts/d2/codegen` 同一套"纯 swiftc 编译"
   836	    // 风格），`FrameReplayTests.swift` 和这个文件在同一次 swiftc 调用里编译成同一个隐式 module——
   837	    // 没有 `@testable import` 机制，`private` 是文件级作用域。下面这几个方法把"搭建一个已订阅的
   838	    // 假 session、灌入合成 wire 帧、读取内部锁/终态状态"这三件事暴露成 internal（去掉 `private`），
   839	    // 让测试文件可以直接驱动真实的 `handleIncoming` -> dispatch -> mapping 流水线，而不需要一个真
   840	    // WebSocket 连接。方法名统一加 `testSupport` 前缀，一眼可辨认，不是生产调用路径的一部分。
   841	
   842	    /// 不经过任何 RPC，直接注册一个"已订阅"的假 session——供测试灌入合成 wire 帧。
