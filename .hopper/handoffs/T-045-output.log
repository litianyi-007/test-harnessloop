    67	//      诚实 defer**，本文件接入并映射到 D2 evt.error（code 用 `.unknown`，因为 D1 ErrorEvent.code
    68	//      封闭枚举里没有专门对应"协议层 seq 断档"的取值，如实标注是推断映射不是字面对应；
    69	//      recoverable 记 `.run`，因为 seq gap 只影响这个 run 的事件流完整性，不代表 session 本身失效）。
    70	//      evt.capability_changed 本轮仍未接到任何真实触发路径：D1 INV-4 原文就说"能力变更的感知路径是
    71	//      内核 RPC 报错(被动发现)+我方 Server 能力开关 override(主动决策)"——即它从来不是一个 kernel
    72	//      主动 push 的事件，需要 capabilities() 方法本身先落地（本轮仍是 TODO 桩）才有基线可 diff，
    73	//      构造函数保留、明确未接入 dispatch，诚实标 unsupported。
    74	
    75	import Foundation
    76	
    77	// MARK: - JSON 取值小工具（JSONSerialization 产物的 [String: Any] 上做安全取值）
    78	
    79	func jsonInt(_ any: Any?) -> Int? {
    80	    if let i = any as? Int { return i }
    81	    if let n = any as? NSNumber { return n.intValue }
    82	    if let d = any as? Double { return Int(d) }
    83	    return nil
    84	}
    85	
    86	func jsonString(_ any: Any?) -> String? {
    87	    any as? String
    88	}
    89	
    90	func jsonBool(_ any: Any?) -> Bool? {
    91	    if let b = any as? Bool { return b }
    92	    if let n = any as? NSNumber { return n.boolValue }
    93	    return nil
    94	}
    95	
    96	func jsonObject(_ any: Any?) -> JSONObject? {
    97	    any as? JSONObject
    98	}
    99	
   100	func jsonArray(_ any: Any?) -> [Any]? {
   101	    any as? [Any]
   102	}
   103	
   104	/// 把一个内存里的 `Any`（来自 JSONSerialization 解出的 JSON 值）包成 D2 codegen 的 `JSONAny`。
   105	/// `JSONAny` 只暴露 `init(from: Decoder)`（Decodable 要求），没有直接take `Any` 的构造器——这里借道
   106	/// `JSONSerialization` + `JSONDecoder` 往返一次：包一层 `{"v": value}` 再解出来，是因为
   107	/// `JSONSerialization.data(withJSONObject:)` 在顶层只接受 Array/Dictionary，标量值（纯字符串/数字/
   108	/// 布尔）必须先包一层才能序列化。`value` 传 `NSNull()` 时往返出的是 JSON `null`——用于诚实表达"这个
   109	/// 字段本轮确实取不到真实值"（如非 exec 工具的 output，见②），不是遗漏，是明确的空值。
   110	func makeJSONAny(_ value: Any) -> JSONAny {
   111	    let wrapper: JSONObject = ["v": value]
   112	    guard JSONSerialization.isValidJSONObject(wrapper),
   113	          let data = try? JSONSerialization.data(withJSONObject: wrapper, options: []),
   114	          let decoded = try? JSONDecoder().decode([String: JSONAny].self, from: data),
   115	          let result = decoded["v"] else {
   116	        // "null" 恒可解码（走 JSONAny.init(from:) 的 singleValueContainer + decodeNil 分支），
   117	        // 用作不可序列化输入（例如非 JSON 兼容的 Swift 值）时的诚实兜底，不是伪造业务数据。
   118	        return try! JSONDecoder().decode(JSONAny.self, from: Data("null".utf8))
   119	    }
   120	    return result
   121	}
   122	
   123	/// 把 openclaw wire 上的毫秒 epoch 数字字段转成 `Date`——用于 F3：D2 `KernelEventBase.ts` 语义是
   124	/// "事件发生时刻"，必须取 openclaw 原始 payload/message 自带的时间戳，不能用 `Date()`（那是适配器
   125	/// 本地处理/转发时刻，属于 envelope 的 `sentAt` 语义，两者是 D2 v3 §2 明确分开的两个字段）。
   126	/// 缺失时退化到 `Date()` 只发生在 openclaw 自己也没有提供任何时间戳的合成事件上（如 transport_closed，
   127	/// 没有更早的 wire 帧可以取时间戳），且发生处均有单独注释标注。
   128	func msEpochToDate(_ ms: Int?) -> Date {
   129	    guard let ms = ms else { return Date() }
   130	    return Date(timeIntervalSince1970: Double(ms) / 1000.0)
   131	}
   132	
   133	// MARK: - F3：per-run seq 生成器契约
   134	//
   135	// D1 v3 §9.2/§3：`seq` 仅承诺"同一 runId 内排序"，不是全局单调、也不是 wire 帧外层 `seq`/
   136	// `messageSeq` 的直接透传——上一轮（a07dc67）在 `session.message` 用 `messageSeq`、在 `agent` 事件用
   137	// frame 外层 `seq`，两个域混用导致同一个 run 观察到 `2→21→4→30`（对抗审 T-044 F3 复现）。
   138	// rework 轮改为：每个 mapper 函数都不再自己从 wire 读 seq，而是通过调用方传入的 `nextSeq` 闭包按
   139	// **runId 作用域**取号——闭包本身由 `OpenclawGatewayKernelClient`（actor 隔离，状态安全）按
   140	// `runID ?? sessionID` 维护一个从 1 开始递增的计数器，保证同一 run 内先产出的事件 seq 更小。
   141	
   142	// MARK: - ① session.message -> messageDelta / thinking / toolCall（三种，均现场实测样本 grounding）
   143	
   144	/// openclaw `session.message` 的 `payload.message` 只在 role=="assistant" 时才可能产出 D2 事件——
   145	/// role=="user" 是调用方自己发的输入回显，D1 的 KernelEvent 流不表达"回显我方输入"这件事（D2
   146	/// MessageDeltaEventMessagePayload.role 这个类型本身就只有一个取值 `.assistant`，quicktype
   147	/// 从 schema 生成时就把这一点固化了）。一条 assistant 消息的 `content` 可以是纯字符串，也可以是
   148	/// 多个 block 的数组（真实样本证实：文本 block 和 toolCall block 可以同时出现在同一条消息里），
   149	/// 因此一条 session.message 可能产出 0~N 个 D2 事件，返回值是数组，`nextSeq()` 每产出一个事件调用
   150	/// 一次，保证同一条消息里的多个 block 拿到严格递增的 run 内 seq（F3）。
   151	///
   152	/// 现场样本（`scratchpad/openclaw-iso3`，D3-proxy + 真实 Kimi）：
   153	/// ```
   154	/// {"role":"assistant","content":[{"type":"toolCall","id":"tool_...","name":"exec",
   155	///   "arguments":{"command":"ls -la"},"partialArgs":"..."}],
   156	///  "usage":{"input":9288,"output":2346,...},"stopReason":"toolUse","timestamp":1784...,
   157	///  "responseId":"..."}
   158	/// ```
   159	/// `timestamp` 字段（ms epoch）是本条 assistant 消息真正产出的时刻——F3 要求的 `ts` 就取这里，
   160	/// 不用 `Date()`。
   161	func mapOpenclawSessionMessageToKernelEvents(
   162	    _ payload: JSONObject,
   163	    ourSessionID: String,
   164	    runIDHint: String?,
   165	    nextSeq: () -> Int
   166	) -> [EventMessageUnion] {
   167	    guard let message = jsonObject(payload["message"]) else { return [] }
   168	    guard jsonString(message["role"]) == "assistant" else {
   169	        // role=="user"：回显，无 D2 对应事件。role=="toolResult" 从未在 session.message 里现场
   170	        // 观察到（见头注释①），如果未来 openclaw 版本改变了这一点、这里会静默丢弃——保留在这里
   171	        // 一并说明，而不是假装处理了一个从未见过的分支。
   172	        return []
   173	    }
   174	
   175	    let sentAt = Date()
   176	    let originTS = msEpochToDate(jsonInt(message["timestamp"]))
   177	    var events: [EventMessageUnion] = []
   178	
   179	    // 顶层字段（usage/stopReason/timestamp）是 assistant 消息自己的，不是某个 content block 的——
   180	    // 供 turnComplete 之类的调用方缓存 usage 用，这里只按 content block 逐个产出事件。
   181	    let content = message["content"]
   182	    let blocks: [JSONObject]
   183	    if let arr = jsonArray(content) {
   184	        blocks = arr.compactMap { jsonObject($0) }
   185	    } else if let text = jsonString(content) {
   186	        // 纯字符串 content——SG-4 唯一覆盖过的形状，保留兼容。
   187	        blocks = [["type": "text", "text": text]]
   188	    } else {
   189	        blocks = []
   190	    }
   191	
   192	    for (index, block) in blocks.enumerated() {
   193	        guard let type = jsonString(block["type"]) else { continue }
   194	        switch type {
   195	        case "text":
   196	            guard let text = jsonString(block["text"]) else { continue }
   197	            let deltaPayload = MessageDeltaEventMessagePayload(delta: text, index: index, role: .assistant)
   198	            events.append(.messageDelta(MessageDeltaEventMessage(
   199	                direction: .event, payload: deltaPayload, runID: runIDHint,
   200	                sentAt: sentAt, seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtMessageDelta
   201	            )))
   202	
   203	        case "thinking", "reasoning", "redacted_thinking":
   204	            // grounding：源码——kernels/openclaw/src/gateway/chat-display-projection.ts
   205	            // `isAssistantInternalReasoningContentType` 把 "thinking"/"reasoning"/
   206	            // "redacted_thinking" 三个字面量识别为推理类 block。这是 thinking 的第二个来源
   207	            // （第一个来源是下面 handleAgentEvent 的 `agent(stream:"thinking")`，F5 新增，
   208	            // 源码级 grounding：`embedded-agent-subscribe.ts:1226-1254` `emitReasoningStream`）——
   209	            // 两者不冲突：session.message 里的 thinking block 是"这条已落地的 assistant 消息带的
   210	            // 完整推理内容投影"，agent(stream:"thinking") 是"逐 token 的推理增量流"，同一次真实推理
   211	            // 可能两条路径都会各自产出一次 D2 thinking 事件，这是 openclaw 自身双通道广播的忠实反映，
   212	            // 不是本文件重复映射的 bug。
   213	            let delta = jsonString(block["text"]) ?? jsonString(block["thinking"]) ?? ""
   214	            let visibility: Visibility = type == "redacted_thinking" ? .summary : .raw
   215	            let thinkingPayload = ThinkingEventMessagePayload(delta: delta, visibility: visibility)
   216	            events.append(.thinking(ThinkingEventMessage(
   217	                direction: .event, payload: thinkingPayload, runID: runIDHint,
   218	                sentAt: sentAt, seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtThinking
   219	            )))
   220	
   221	        case "toolCall", "tool_call", "toolUse", "tool_use":
   222	            guard let toolCallID = jsonString(block["id"]), let name = jsonString(block["name"]) else { continue }
   223	            let input = makeJSONAny(block["arguments"] ?? block["input"] ?? [:] as JSONObject)
   224	            let toolCallPayload = ToolCallEventMessagePayload(input: input, name: name, status: .started, toolCallID: toolCallID)
   225	            events.append(.toolCall(ToolCallEventMessage(
   226	                direction: .event, payload: toolCallPayload, runID: runIDHint,
   227	                sentAt: sentAt, seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtToolCall
   228	            )))
   229	
   230	        default:
   231	            // 未识别的 content block type——如实跳过，不臆造映射。
   232	            continue
   233	        }
   234	    }
   235	
   236	    return events
   237	}
   238	
   239	// MARK: - ② agent(stream:"command_output") -> toolResult（exec 工具族，现场实测样本 grounding）
   240	
   241	/// 真实样本（同一 exec 工具调用的完整生命周期，`agent` 事件 `payload.stream` 依次是
   242	/// run_status→item(×N)→command_output(phase delta×N)→item(phase end)→command_output(phase end)）：
   243	/// ```
   244	/// {"stream":"command_output","data":{"itemId":"command:tool_Jd9...","phase":"end",
   245	///   "toolCallId":"tool_Jd9HsUlLKZyhkA7uhkIvInHr","name":"exec",
   246	///   "output":"AGENTS.md\nBOOTSTRAP.md\n...","status":"completed","exitCode":0,
   247	///   "durationMs":20,"cwd":"/Users/.../workspace"}}
   248	/// ```
   249	/// 只取 `phase:"end"` 的 `command_output`（`phase:"delta"` 是流式中间态，不代表工具调用终态）。
   250	/// `originTS` 取 `agent` wire 帧外层 `payload.ts`（openclaw `enrichAgentEvent` 在事件产生时盖章的
   251	/// 真实时刻，见 `infra/agent-events.ts:628` `ts: Date.now()`），不用 `Date()`（F3）。
   252	///
   253	/// 范围声明（rework 轮 F5 用真实非 exec 工具样本坐实的结论，取代上一轮"未拿到样本"的开放问题）：
   254	/// `command_output` 这个 stream 名字确认只属于 exec/命令族工具（真实样本：`update_plan` 这个非 exec
   255	/// 内置工具走的是 `stream:"item"`，从未产出 `command_output`，见文件头注释②与
   256	/// `mapOpenclawAgentToolItemToToolResult`）。本函数只对 stream=="command_output" 生效。
   257	func mapOpenclawAgentCommandOutputToToolResult(
   258	    _ data: JSONObject,
   259	    ourSessionID: String,
   260	    runIDHint: String?,
   261	    originTS: Date,
   262	    nextSeq: () -> Int
   263	) -> EventMessageUnion? {
   264	    guard jsonString(data["phase"]) == "end" else { return nil }
   265	    guard let toolCallID = jsonString(data["toolCallId"]) else { return nil }
   266	
   267	    let status = jsonString(data["status"])
   268	    let exitCode = jsonInt(data["exitCode"])
   269	    let isError = (status == "failed") || ((exitCode ?? 0) != 0)
   270	    let output = makeJSONAny(data["output"] ?? "")
   271	    let durationMS = jsonInt(data["durationMs"])
   272	
   273	    let resultPayload = ToolResultEventMessagePayload(
   274	        durationMS: durationMS, isError: isError, output: output, toolCallID: toolCallID
   275	    )
   276	    return .toolResult(ToolResultEventMessage(
   277	        direction: .event, payload: resultPayload, runID: runIDHint,
   278	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtToolResult
   279	    ))
   280	}
   281	
   282	// MARK: - ②b agent(stream:"item", kind:"tool") -> toolResult（非 exec 工具族，F5 rework 轮新增）
   283	
   284	/// **真实样本 grounding**（`scratchpad/openclaw-iso3/nonexec-run4.jsonl`，真实 Kimi + 内置
   285	/// `update_plan` 工具，2026-07-24 rework 轮隔离环境重新探针）：
   286	/// ```
   287	/// {"stream":"item","data":{"itemId":"tool:tool_p8yLr7taJUMG2ePajv3zPtmR","phase":"end","kind":"tool",
   288	///   "title":"tool_call","status":"completed","name":"tool_call",
   289	///   "toolCallId":"tool_p8yLr7taJUMG2ePajv3zPtmR","startedAt":1784876075348,"endedAt":1784876075377}}
   290	/// ```
   291	/// 对照同一次真实调用的 `session.message` toolCall content block：
   292	/// `{"type":"toolCall","id":"tool_p8yLr7taJUMG2ePajv3zPtmR","name":"tool_call",
   293	///   "arguments":{"id":"openclaw:core:update_plan","args":{...}}}`——`item.data.toolCallId` 与
   294	/// `session.message` toolCall block 的 `id` 字段**逐字相同**，证实这条 item 事件确实是那次
   295	/// toolCall 的终态回执，关联是可靠的（不是猜测）。
   296	///
   297	/// **诚实的缺口（F5 open question 的现场结论，非臆造）**：这条 `item` 事件只有
   298	/// itemId/phase/kind/title/status/name/meta/toolCallId/startedAt/endedAt——**没有任何 output/
   299	/// result 字段**。openclaw 源码里确实存在一个专门携带完整输出的通用事件
   300	/// （`embedded-agent-subscribe.handlers.tools.ts:1615-1628`，`emitAgentEvent({stream:"tool",
   301	/// data:{phase:"result", result: eventResult, ...}})`，`eventResult` 对非 exec 工具就是完整
   302	/// `sanitizeToolResult(result)`），但本轮用真实 `sessions.messages.subscribe`
   303	/// （`includeApprovals:true`）客户端反复探针，**从未收到过一条 `stream:"tool"` 的 `agent` wire
   304	/// 事件**——gateway 侧似乎要求连接先被登记为该 run 的"tool event recipient"才能收到这条通用
   305	/// tool 流（`gateway/server-chat.ts` 里 `runToolRecipients`/`broadcastToConnIds("agent", ...)` 一带
   306	/// 的分发逻辑指向这个方向，但具体登记 RPC/时机本轮未定位到，属于协议层未探明的缺口，如实标注，
   307	/// 不是本文件的映射 bug）。因此非 exec 工具的 `output` 字段本函数诚实置为 JSON `null`
   308	/// （`makeJSONAny(NSNull())`），`isError` 用 `status != "completed"` 判定（真实可用），`durationMS`
   309	/// 用 `endedAt - startedAt` 换算（真实可用，非编造）。
   310	///
   311	/// **去重规则**：exec 工具（`isExecToolName`：`"exec"`/`"bash"`）同时会产出这条 `item` 事件
   312	/// **和**权威的 `command_output`（真正带 output/exitCode）——调用方（`handleAgentEvent`）按
   313	/// `data.name` 排除 exec 工具族，只对非 exec 工具调用本函数，避免同一个 toolCallId 产出两条互相
   314	/// 矛盾的 D2 toolResult（一条有真实 output、一条 output 是 null）。
   315	func mapOpenclawAgentToolItemToToolResult(
   316	    _ data: JSONObject,
   317	    ourSessionID: String,
   318	    runIDHint: String?,
   319	    originTS: Date,
   320	    nextSeq: () -> Int
   321	) -> EventMessageUnion? {
   322	    guard jsonString(data["kind"]) == "tool" else { return nil }
   323	    guard jsonString(data["phase"]) == "end" else { return nil }
   324	    guard let toolCallID = jsonString(data["toolCallId"]) else { return nil }
   325	
   326	    let status = jsonString(data["status"])
   327	    let isError = status != "completed"
   328	    let durationMS: Int?
   329	    if let started = jsonInt(data["startedAt"]), let ended = jsonInt(data["endedAt"]) {
   330	        durationMS = max(0, ended - started)
   331	    } else {
   332	        durationMS = nil
   333	    }
   334	    // 诚实置空——见函数文档注释的"诚实的缺口"一段,不编造 output。
   335	    let output = makeJSONAny(NSNull())
   336	
   337	    let resultPayload = ToolResultEventMessagePayload(
   338	        durationMS: durationMS, isError: isError, output: output, toolCallID: toolCallID
   339	    )
   340	    return .toolResult(ToolResultEventMessage(
   341	        direction: .event, payload: resultPayload, runID: runIDHint,
   342	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtToolResult
   343	    ))
   344	}
   345	
   346	/// exec 工具名词表——与 openclaw `embedded-agent-subscribe.handlers.tools.ts:362-364`
   347	/// `isExecToolName` 逐字对应（`toolName === "exec" || toolName === "bash"`），供调用方判断
   348	/// 一次 `agent(stream:"item", kind:"tool")` 是否应该跳过（让权威的 command_output 来源接管）。
   349	func isOpenclawExecToolName(_ name: String?) -> Bool {
   350	    name == "exec" || name == "bash"
   351	}
