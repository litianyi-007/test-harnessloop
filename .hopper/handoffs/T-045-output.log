   168	// MARK: - F6：abort 的 end+error 双帧 -> 单个 operation_completed + turn_complete(cancelled)
   169	
   170	/// **修前 fail / 修后 pass**：上一轮每一条 `aborted:true` 的 lifecycle 帧都会各自产出一条
   171	/// `operationCompleted`（operationId 是 mapper 自己派生的，与 `stop()` 返回的 `StopResultPayload.
   172	/// operationID` 不同），真实样本里 `sessions.abort` 会连续发两帧（`phase:"end"` 然后
   173	/// `phase:"error","This operation was aborted"`），上一轮会产出两条互相矛盾的 operation_completed
   174	/// （outcome 不同），且从不产出 `turn_complete(cancelled)`。本轮：`stop()` 铸造一个唯一
   175	/// operationId 登记到 `pendingStops`，`handleAgentEvent` 对同一次 pendingStop 只在**第一条**
   176	/// aborted 帧时产出 `[operationCompleted, turnComplete(cancelled)]`（用 stop() 铸造的那个
   177	/// operationId），第二条收尾帧被去重丢弃。
   178	func testAbortEndThenErrorProducesSingleTerminalPair() async -> Bool {
   179	    let name = "F6 abort end+error double frame -> single operation_completed+turn_complete"
   180	    let client = freshClient()
   181	    let sessionID = "sess-abort-1"
   182	    let runID = "run-abort-1"
   183	    let operationID = "op-stop-test-fixed-id"
   184	    let stream = await client.testSupportRegisterSession(ourSessionID: sessionID, kernelKey: "kernel-key-1")
   185	    await client.testSupportSeedPendingStop(sessionID: sessionID, runID: runID, operationID: operationID)
   186	
   187	    // 真实样本形状（EventMapping.swift 头注释③引用的现场帧）：
   188	    let endFrame: JSONObject = [
   189	        "type": "event", "event": "agent",
   190	        "payload": [
   191	            "runId": runID, "sessionKey": "kernel-key-1", "stream": "lifecycle",
   192	            "data": ["phase": "end", "status": "cancelled", "aborted": true, "stopReason": "rpc"] as JSONObject,
   193	            "seq": 18, "ts": 1_784_871_000_000,
   194	        ] as JSONObject,
   195	    ]
   196	    let errorFollowupFrame: JSONObject = [
   197	        "type": "event", "event": "agent",
   198	        "payload": [
   199	            "runId": runID, "sessionKey": "kernel-key-1", "stream": "lifecycle",
   200	            "data": ["phase": "error", "aborted": true, "stopReason": "aborted", "error": "This operation was aborted"] as JSONObject,
   201	            "seq": 19, "ts": 1_784_871_000_100,
   202	        ] as JSONObject,
   203	    ]
   204	    await client.testSupportFeedFrame(endFrame)
   205	    await client.testSupportFeedFrame(errorFollowupFrame)
   206	
   207	    // 期望恰好 2 条事件（operationCompleted + turnComplete）；多要 1 条来验证"没有第 3 条"。
   208	    let events = await collectUpTo(stream, maxCount: 3)
   209	    guard events.count == 2 else {
   210	        return fail(name, "expected exactly 2 events (1 operation_completed + 1 turn_complete), got \(events.count) — 修前会对两条 aborted 帧各产出一条 operation_completed（共 2 条，且没有 turn_complete）")
   211	    }
   212	    guard case .operationCompleted(let opEvent) = events[0] else {
   213	        return fail(name, "expected first event to be .operationCompleted, got \(events[0].wireType)")
   214	    }
   215	    guard opEvent.payload.operationID == operationID else {
   216	        return fail(name, "operationCompleted.operationId=\(opEvent.payload.operationID) != stop() 铸造的 \(operationID) — 修前 mapper 自己派生一个不同的 operationId，Promise 结果与旁路事件无法关联")
   217	    }
   218	    guard opEvent.payload.outcome == .succeeded else {
   219	        return fail(name, "expected outcome=.succeeded for phase:end frame, got \(opEvent.payload.outcome)")
   220	    }
   221	    guard case .turnComplete(let turnEvent) = events[1] else {
   222	        return fail(name, "expected second event to be .turnComplete, got \(events[1].wireType) — 上一轮从不产出这个事件")
   223	    }
   224	    guard turnEvent.payload.stopReason == .cancelled else {
   225	        return fail(name, "expected turnComplete.stopReason=.cancelled, got \(turnEvent.payload.stopReason)")
   226	    }
   227	    let terminalEmitted = await client.testSupportPendingStopTerminalEmitted(sessionID: sessionID)
   228	    guard terminalEmitted == true else {
   229	        return fail(name, "pendingStop.terminalEmitted should be true after first aborted frame")
   230	    }
   231	    return pass(name, "恰好 2 条事件：operationCompleted(operationId=\(opEvent.payload.operationID),outcome=\(opEvent.payload.outcome.rawValue)) + turnComplete(stopReason=cancelled)；第二条收尾帧被正确去重")
   232	}
