   573	// MARK: - ⑥ agent(stream:"error") -> error（F5 rework 新增，取代上一轮的 defer）
   574	
   575	/// 真实源码（`kernels/openclaw/src/gateway/server-chat.ts:1387-1403`）：连接侧观察到某个 run 的
   576	/// `agent` 事件 `seq` 与本地记录的期望值不连续时，同步广播一条：
   577	/// ```ts
   578	/// broadcast("agent", { runId, stream: "error", ts, sessionKey, data: { reason: "seq gap", expected, received } }, ...)
   579	/// ```
   580	/// 这是本轮唯一有源码级确切字段坐实的 `agent(stream:"error")` 形状；`infra/agent-events.ts:35-49`
   581	/// 的 `AgentEventStream` 类型声明还列了这个 stream 名字本身是协议一等公民（不是旁路），但具体还有
   582	/// 哪些场景会产出 `stream:"error"`、携带什么别的 `data` 形状，本轮未逐一穷举源码调用点——因此本函数
   583	/// 对"seq gap"形状做精确字段映射，对其余未知形状做尽力而为的兜底（取 `data.reason`/`data.message`
   584	/// 任意能找到的字符串字段拼一条 message，不假装认得全部变体）。
   585	///
   586	/// 字段映射：
   587	///  - code：D1 `ErrorEvent.code` 是封闭枚举（approval_timeout/auth_failed/kernel_crashed/
   588	///    network_lost/rate_limited/sandbox_denied/unknown），"seq gap"（协议层事件序号断档）没有
   589	///    一个字面对应的取值——映射到 `.unknown` 是诚实的推断，不是字面对应，如实标注。
   590	///  - message：拼一条人类可读的诊断信息（"event stream seq gap: expected X, got Y"），不编造。
   591	///  - nativeCode：D2 文档注释里明确"调试参考，非契约稳定字段"——直接塞 `"seq gap"` 这个 openclaw
   592	///    自己的 `reason` 字面值，供调试用，不承诺稳定。
   593	///  - recoverable：`.run`——seq gap 只影响这一个 run 的事件流完整性（调用方可能错过了几条中间
   594	///    事件），不代表整个 session 已经失效，`.run` 比 `.session`/`.none` 更贴近这个语义，如实标注为
   595	///    推断而非字面对应（D1 没有为"seq gap"这个具体场景钉死 recoverable 取值）。
   596	func mapOpenclawAgentErrorToKernelEvent(
   597	    _ data: JSONObject,
   598	    ourSessionID: String,
   599	    runIDHint: String?,
   600	    originTS: Date,
   601	    nextSeq: () -> Int
   602	) -> EventMessageUnion? {
   603	    let reason = jsonString(data["reason"])
   604	    let message: String
   605	    let nativeCode: String?
   606	    if reason == "seq gap" {
   607	        let expected = jsonInt(data["expected"])
   608	        let received = jsonInt(data["received"])
   609	        message = "event stream seq gap: expected \(expected.map(String.init) ?? "?"), got \(received.map(String.init) ?? "?")"
   610	        nativeCode = "seq gap"
   611	    } else {
   612	        // 未穷举的形状——尽力而为拼一条诊断信息，不假装认得。
   613	        message = reason ?? jsonString(data["message"]) ?? "unrecognized agent error stream payload"
   614	        nativeCode = reason
   615	    }
   616	    let errorPayload = ErrorEventMessagePayload(
   617	        code: .unknown, message: message, nativeCode: nativeCode, recoverable: .run
   618	    )
   619	    return .error(ErrorEventMessage(
   620	        direction: .event, payload: errorPayload, runID: runIDHint,
   621	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtError
   622	    ))
   623	}
