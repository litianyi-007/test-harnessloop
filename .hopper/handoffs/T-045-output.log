    74	/// （真实 openclaw `session.message`/`hello-ok` 快照）会把 `contextTokens`/`inputTokens`/
    75	/// `outputTokens`/`totalTokens` 这些纯粹的"token 计数"字段（不是凭证）一起误伤，白白丢失这些真实
    76	/// 诊断数据的可见性。整词匹配（`token` 单数精确命中 `authToken`/`apiToken`/`params.auth.token`
    77	/// 这类真凭证字段，`tokens` 复数不命中）避免了这个副作用，同时仍然覆盖上面这条 CRITICAL 缺陷本身
    78	/// 关心的字段。
    79	private let sensitiveWords: Set<String> = [
    80	    "auth", "authorization", "token", "secret", "password", "credential", "apikey",
    81	]
    82	
    83	/// 把一个 camelCase/snake_case/kebab-case 的 key 拆成小写单词列表——`"contextTokens"` ->
    84	/// `["context","tokens"]`，`"authToken"` -> `["auth","token"]`，`"api_key"` -> `["api","key"]`。
    85	private func lowercasedWords(_ key: String) -> [String] {
    86	    var words: [String] = []
    87	    var current = ""
    88	    for char in key {
    89	        if char == "_" || char == "-" {
    90	            if !current.isEmpty { words.append(current); current = "" }
    91	            continue
    92	        }
    93	        if char.isUppercase, !current.isEmpty {
    94	            words.append(current)
    95	            current = String(char).lowercased()
    96	        } else {
    97	            current.append(Character(char.lowercased()))
    98	        }
    99	    }
   100	    if !current.isEmpty { words.append(current) }
   101	    return words
   102	}
   103	
   104	private func isSensitiveKey(_ key: String) -> Bool {
   105	    let words = lowercasedWords(key)
   106	    if words.contains(where: { sensitiveWords.contains($0) }) {
   107	        return true
   108	    }
   109	    // "apiKey"/"api_key" 这类复合词——"api"/"key" 相邻出现才算敏感,不能把"key"单独列为敏感词
   110	    // (RPC 里大量语义完全不同的字段就叫 "key",例如 openclaw 的 session key,不是凭证)。
   111	    guard words.count >= 2 else { return false }
   112	    for i in 0..<(words.count - 1) where words[i] == "api" && words[i + 1] == "key" {
   113	        return true
   114	    }
   115	    return false
   116	}
