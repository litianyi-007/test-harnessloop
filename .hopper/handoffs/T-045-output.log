   163	    public func createSession(config: Config) async throws -> SessionHandle {
   164	        // openclaw 侧本轮只透传 label(+model)。D2 Config 的 cwd/newapiEndpoint/toolset/sandbox/
   165	        // approvalProfile/resume 这些字段本轮未接入 openclaw 原生 CreateSessionConfig 的等价物
   166	        // ——两边字段集并非天然一一对应（openclaw 的 sessions.create 走它自己的 schema，见 recipe
   167	        // §3），完整字段级映射留给后续轮次；这里如实标注，不假装已经打通。
   168	        var params: JSONObject = ["label": "sg4-kernel-client-l1"]
   169	        if let model = config.model {
   170	            params["model"] = model
   171	        }
   172	        let result = try await request(method: "sessions.create", params: params)
   173	        prettyPrint("RECV sessions.create result", result)
   174	
   175	        guard let kernelKey = result["key"] as? String else {
   176	            throw KernelClientError.protocolMismatch("sessions.create result missing 'key' field")
   177	        }
   178	        let kernelSessionID = result["sessionId"] as? String
   179	
   180	        // D1 §2.1 步骤 1：adapter 本地预分配 sessionId。本轮用一个新 UUID，不复用 openclaw 自己
   181	        // 返回的 sessionId——两者语义不同（前者是 KernelPort 层面的稳定寻址锚点，早于原生会话
   182	        // 存在；后者是内核自己认得的原生 id），本实现如实保留这个区分，写入
   183	        // SessionHandle.kernelSessionId 的是 openclaw 的 `key`（后续 subscribe/abort/delete 真正
   184	        // 需要用它寻址,不是 `sessionId` 字段）。
   185	        let ourSessionID = UUID().uuidString
   186	        kernelKeyBySessionID[ourSessionID] = kernelKey
   187	
   188	        // billing.tokenRef 本轮是占位符——SG-4 没有实现 D1 §7 的 newapi token 铸造（那是 createSession
   189	        // 内部执行序列步骤 2，需要真正调用 newapi POST /api/token/），如实标注，不虚构一个看起来
   190	        // "真实"的值掩盖这个缺口。
   191	        return SessionHandle(
   192	            billing: Billing(tokenRef: "TODO-sg4-no-newapi-token-minted"),
   193	            createdAt: Date(),
   194	            kernel: .openclaw,
   195	            kernelSessionID: kernelSessionID ?? kernelKey,
   196	            sessionID: ourSessionID
   197	        )
   198	    }
   199	
   200	    /// D1 §2.2 send()。适配为 openclaw `sessions.send`（recipe §3.3 params:
   201	    /// `{key, agentId?, message, thinking?, attachments?, timeoutMs?, idempotencyKey?}`）。
   202	    ///
   203	    /// **返回语义**（SG-5 实测坐实）：`sessions.send` 的 RPC 响应是一次同步 ack，形状
   204	    /// `{"runId":"...","status":"started","messageSeq":1}`——不是模型的最终输出。真正的 agent
   205	    /// 输出全部经由已建立的 `subscribe()` 事件流异步到达。本实现只取 wire 响应的 `runId` 字段构造
   206	    /// `SendResultPayload(runID:)`。
   207	    ///
   208	    /// **F1 rework**：D1 v3.1 §9.3（v3.6 继承）要求 send() 遵守 session 级 `send_pending` 互斥锁——
   209	    /// 同一 session 不允许两个 `send()` RPC 同时在途。上一轮只在 actor 内保存了 runId 缓存但没有
   210	    /// 锁本身，两个并发 `send()` 都能进入 `await request(...)`，谁的 ack 先回来谁就"赢"，与调用
   211	    /// 顺序无关，导致 `lastRunIDBySessionID` 可能被"后发起但先返回"的调用覆盖成错误值。本轮加锁：
   212	    /// 进入函数时若锁不是 idle 一律 reject(session_locked)，否则在**第一次 await 之前**（因此
   213	    /// actor 不会在这个检查-设置对之间被重入）把锁设成 send_pending，RPC ack 到达（无论成功失败）
   214	    /// 后释放回 idle。
   215	    public func send(session: SessionHandle, input: Input) async throws -> SendResultPayload {
   216	        guard let kernelKey = kernelKeyBySessionID[session.sessionID] else {
   217	            throw KernelClientError.protocolMismatch("unknown session \(session.sessionID)")
   218	        }
   219	
   220	        let currentLock = lockStateBySessionID[session.sessionID] ?? .idle
   221	        guard currentLock == .idle else {
   222	            throw KernelClientError.rpcRejected(
   223	                code: "session_locked",
   224	                message: "send() rejected: session \(session.sessionID) lock state is \(currentLock), expected idle (D1 v3.1 §9.3)"
   225	            )
   226	        }
   227	        lockStateBySessionID[session.sessionID] = .sendPending
   228	        defer {
   229	            // send_pending 只是"等待 kernel ack"的极短窗口——ack 到达（无论成功失败）后立刻释放。
   230	            if lockStateBySessionID[session.sessionID] == .sendPending {
   231	                lockStateBySessionID[session.sessionID] = .idle
   232	            }
   233	        }
   234	
   235	        var params: JSONObject = [
   236	            "key": kernelKey,
   237	            "message": resolveSendMessageText(from: input),
   238	            "timeoutMs": 0,
   239	        ]
   240	        // F2 rework：openclaw `gateway/server-methods/attachment-normalize.ts:29-56`
   241	        // （`normalizeRpcAttachmentsToChatAttachments`）只保留带 `content` 字段（base64 或字符串）
   242	        // 的附件，`.filter((a) => a.content)` 会把上一轮发送的 `{mimeType,path}` 形状直接丢弃（无
   243	        // content 字段）——见 `server-methods.test.ts:2693-2699` 明确验证这一点。本轮改为读取
   244	        // `Part.path` 指向的本地文件、base64 编码后塞进 `content`；读不到文件就诚实跳过这一个
   245	        // attachment（不编造 content，也不让整个 send() 失败——可能只是这一个 part 路径失效）。
   246	        if input.kind == .structured, let parts = input.parts {
   247	            // encodeAttachmentForWire 是 OpenclawWire.swift 里的纯函数（F2），不依赖 actor 状态，
   248	            // 方便 FrameReplayTests.swift 直接单测。
   249	            let attachments: [JSONObject] = parts.compactMap { part -> JSONObject? in
   250	                guard part.kind != .text else { return nil }
   251	                return encodeAttachmentForWire(part)
   252	            }
   253	            if !attachments.isEmpty {
   254	                params["attachments"] = attachments
   255	            }
   256	        }
   257	
   258	        let result = try await request(method: "sessions.send", params: params)
   259	        prettyPrint("RECV sessions.send result", result)
   260	
   261	        guard let runID = result["runId"] as? String else {
   262	            throw KernelClientError.protocolMismatch("sessions.send result missing 'runId' field")
   263	        }
   264	        lastRunIDBySessionID[session.sessionID] = runID
   265	        runIDsBySessionID[session.sessionID, default: []].insert(runID)
   266	        return SendResultPayload(runID: runID)
   267	    }
   268	
   269	    /// D1 Input -> openclaw `sessions.send.message`（纯文本字符串）的最小转换。`kind:.text` 直接用
   270	    /// `input.text`；`kind:.structured` 把 `parts` 里 `kind:.text` 的段落用换行拼接（非文本 part
   271	    /// 走上面 attachments 分支，不混进正文），三者都拿不到文本时退化为空字符串而不是抛错——openclaw
   272	    /// 的 `SessionsSendParamsSchema.message` 是必填 `Type.String()`，允许空串，比在这里主观拒绝更
   273	    /// 贴近"如实转发调用方输入"的适配器职责。
   274	    private func resolveSendMessageText(from input: Input) -> String {
   275	        if input.kind == .text {
   276	            return input.text ?? ""
   277	        }
   278	        let texts = (input.parts ?? []).compactMap { part -> String? in
   279	            guard part.kind == .text else { return nil }
   280	            return part.text
   281	        }
   282	        return texts.joined(separator: "\n")
   283	    }
   284	
   285	    public func subscribe(session: SessionHandle) async -> AsyncThrowingStream<EventMessageUnion, Error> {
   286	        let ourSessionID = session.sessionID
   287	        let (stream, continuation) = AsyncThrowingStream<EventMessageUnion, Error>.makeStream()
   288	        eventContinuations[ourSessionID] = continuation
   289	
   290	        Task {
   291	            guard let kernelKey = await self.kernelKey(for: ourSessionID) else {
   292	                continuation.finish(throwing: KernelClientError.protocolMismatch("unknown session \(ourSessionID)"))
   293	                return
   294	            }
   295	            do {
   296	                // includeApprovals:true——不带这个 flag 收不到 session.approval 事件
   297	                // （`SessionsMessagesSubscribeParamsSchema` 的 `includeApprovals` 是 opt-in，默认不
   298	                // 推送），approvalRequest 映射的现场 grounding 全部建立在这个 flag 打开的前提上。
   299	                let result = try await self.request(
   300	                    method: "sessions.messages.subscribe",
   301	                    params: ["key": kernelKey, "includeApprovals": true]
   302	                )
   303	                prettyPrint("RECV sessions.messages.subscribe result", result)
   304	                if let subscribed = result["subscribed"] as? Bool, !subscribed {
   305	                    continuation.finish(throwing: KernelClientError.protocolMismatch("subscribe returned subscribed:false"))
   306	                }
   307	            } catch {
   308	                continuation.finish(throwing: error)
   309	            }
   310	        }
   311	
   312	        return stream
   313	    }
