   440	/// stop() 同样受这把锁保护——lock 不是 idle 时 reject。
   441	func testStopRejectedWhenLocked() async -> Bool {
   442	    let name = "F1 stop() rejected when lock is send_pending"
   443	    let client = freshClient()
   444	    let sessionID = "sess-lock-2"
   445	    _ = await client.testSupportRegisterSession(ourSessionID: sessionID, kernelKey: "kernel-key-5")
   446	    await client.testSupportForceLockToSendPending(sessionID: sessionID)
   447	
   448	    let handle = SessionHandle(
   449	        billing: Billing(tokenRef: "test"), createdAt: Date(), kernel: .openclaw,
   450	        kernelSessionID: "kernel-key-5", sessionID: sessionID
   451	    )
   452	    do {
   453	        _ = try await client.stop(session: handle)
   454	        return fail(name, "expected stop() to throw session_locked, but it succeeded")
   455	    } catch let KernelClientError.rpcRejected(code, _) {
   456	        guard code == "session_locked" else {
   457	            return fail(name, "expected code=session_locked, got \(code)")
   458	        }
   459	        return pass(name, "stop() 正确 reject(session_locked)")
   460	    } catch {
   461	        return fail(name, "expected KernelClientError.rpcRejected, got \(error)")
   462	    }
   463	}
   464	
   465	// MARK: - F2：attachment-only（附件编码成 openclaw 期望的 content 形状）
   466	
   467	/// **修前 fail / 修后 pass**：上一轮发送 `{mimeType, path}`——openclaw
   468	/// `normalizeRpcAttachmentsToChatAttachments` 的 `.filter((a) => a.content)` 会把它丢弃（没有
   469	/// content 字段）。本轮读取本地文件、base64 编码进 `content`。
   470	func testAttachmentOnlyEncodesContent() -> Bool {
   471	    let name = "F2 attachment-only encodes content (not {mimeType,path})"
   472	    let tmpDir = FileManager.default.temporaryDirectory
   473	    let fileURL = tmpDir.appendingPathComponent("frame-replay-attachment-\(UUID().uuidString).txt")
   474	    let fileBytes = Data("hello-sg5-attachment".utf8)
   475	    do {
   476	        try fileBytes.write(to: fileURL)
   477	    } catch {
   478	        return fail(name, "failed to write temp fixture file: \(error)")
   479	    }
   480	    defer { try? FileManager.default.removeItem(at: fileURL) }
   481	
   482	    let part = Part(kind: .fileRef, text: nil, mimeType: "text/plain", path: fileURL.path)
   483	    guard let encoded = encodeAttachmentForWire(part) else {
   484	        return fail(name, "expected non-nil encoded attachment")
   485	    }
   486	    guard encoded["path"] == nil else {
   487	        return fail(name, "encoded attachment must NOT carry a bare 'path' field — openclaw would silently drop it (no content)")
   488	    }
   489	    guard let content = encoded["content"] as? String else {
   490	        return fail(name, "expected 'content' field (base64), got keys \(encoded.keys.sorted())")
   491	    }
   492	    guard let decoded = Data(base64Encoded: content), decoded == fileBytes else {
   493	        return fail(name, "content did not base64-decode back to the original file bytes")
   494	    }
   495	    guard (encoded["mimeType"] as? String) == "text/plain" else {
   496	        return fail(name, "expected mimeType=text/plain to be preserved")
   497	    }
   498	    return pass(name, "content(base64) 正确还原原始字节，且不再携带裸 path 字段")
   499	}
   500	
   501	// MARK: - F7：递归脱敏 auth/token
   502	
   503	/// **修前 fail / 修后 pass**：上一轮 `prettyPrint` 直接把整帧（含 `params.auth.token`）序列化打印，
   504	/// token 明文进 stdout。本轮 `redactedCopy` 递归脱敏，命中 auth/token 等敏感键名的字段整体替换成
   505	/// "***REDACTED***"，非敏感字段原样保留。
   506	func testCredentialRedaction() -> Bool {
   507	    let name = "F7 credential redaction (auth/token)"
   508	    let frame: JSONObject = [
   509	        "type": "req", "id": "r1", "method": "connect",
   510	        "params": [
   511	            "minProtocol": 3,
   512	            "auth": ["token": "super-secret-real-token-value"] as JSONObject,
   513	            "client": ["id": "cli", "mode": "cli"] as JSONObject,
   514	        ] as JSONObject,
   515	    ]
   516	    guard let redacted = redactedCopy(frame) as? JSONObject,
   517	          let params = redacted["params"] as? JSONObject else {
   518	        return fail(name, "unexpected redacted shape")
   519	    }
   520	    guard let auth = params["auth"] as? String, auth == "***REDACTED***" else {
   521	        return fail(name, "expected params.auth to be fully redacted to a placeholder string, got \(String(describing: params["auth"]))")
   522	    }
   523	    guard (params["minProtocol"] as? Int) == 3 else {
   524	        return fail(name, "non-sensitive field params.minProtocol should survive unchanged")
   525	    }
   526	    guard let client = params["client"] as? JSONObject, (client["id"] as? String) == "cli" else {
   527	        return fail(name, "non-sensitive nested field params.client.id should survive unchanged")
   528	    }
   529	    // 序列化后确认明文 token 字符串确实不会出现在最终打印文本里（这是 F7 最终关心的可观察结果）。
   530	    let serialized = String(describing: redacted)
   531	    guard !serialized.contains("super-secret-real-token-value") else {
   532	        return fail(name, "raw token value leaked into redacted copy's string representation")
   533	    }
   534	    return pass(name, "auth 字段整体脱敏，非敏感字段保留，明文 token 未出现在序列化结果里")
   535	}
   536	
   537	// MARK: - 总入口
   538	
   539	public func runFrameReplayTests() async -> Bool {
   540	    print("=== SG-5 rework frame-replay 单测 ===")
   541	    var results: [Bool] = []
   542	    results.append(testSeqOrderingWithinRunAndOriginTS())
   543	    results.append(testNoStopReasonEndMapsToCompleted())
   544	    results.append(testUnknownStopReasonAlsoMapsToCompleted())
   545	    results.append(await testAbortEndThenErrorProducesSingleTerminalPair())
   546	    results.append(await testInterleavedApprovalsDoNotCrossWire())
   547	    results.append(testNonExecToolItemHonestMapping())
   548	    results.append(testExecToolNameFiltering())
   549	    results.append(testSeqGapErrorEvent())
   550	    results.append(await testShutdownDedup())
   551	    results.append(await testConcurrentSendRejectedWhenLocked())
   552	    results.append(await testStopRejectedWhenLocked())
   553	    results.append(testAttachmentOnlyEncodesContent())
   554	    results.append(testCredentialRedaction())
   555	
   556	    let passCount = results.filter { $0 }.count
   557	    let total = results.count
   558	    print("=== 结果: \(passCount)/\(total) PASS ===")
   559	    return passCount == total
   560	}
