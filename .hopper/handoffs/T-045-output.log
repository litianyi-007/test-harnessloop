   111	    }
   112	    // ts 必须来自 message.timestamp（换算成 Date），不是 Date()（现在）。
   113	    let expectedTS = Date(timeIntervalSince1970: Double(messageTimestampMs) / 1000.0)
   114	    for event in events {
   115	        let ts: Date
   116	        switch event {
   117	        case .messageDelta(let e): ts = e.ts
   118	        case .toolCall(let e): ts = e.ts
   119	        default: continue
   120	        }
   121	        guard abs(ts.timeIntervalSince(expectedTS)) < 0.001 else {
   122	            return fail(name, "ts \(ts) 不等于 message.timestamp 换算值 \(expectedTS)——修前用的是 Date()（现在），必然不等")
   123	        }
   124	    }
   125	    return pass(name, "seq=\(seqs) ts 均等于 message.timestamp（非 Date()）")
   126	}
