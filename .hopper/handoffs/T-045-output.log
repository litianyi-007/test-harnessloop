   645	/// WS 传输层自身断开（receiveLoop 报错、没有先收到 shutdown 帧）的 sessionEnd 合成——
   646	/// **本轮未现场实测**（没有单独构造"纯网络中断、无 shutdown 帧"的场景），是源码/设计层面的推断。
   647	/// F8：调用方必须保证这条与 `makeSessionEndEventForShutdown`/`makeSessionEndEventForStop` 三者
   648	/// 对同一个 session 只产出其中一条（去重逻辑在 `OpenclawGatewayKernelClient` 的 terminal 状态记录，
   649	/// 不在本函数——本函数本身仍是纯字段构造，不做去重判断）。
   650	func makeSessionEndEventForTransportClosed(ourSessionID: String, nextSeq: () -> Int) -> EventMessageUnion {
   651	    let now = Date()
   652	    let payload = SessionEndEventMessagePayload(reason: .transportClosed)
   653	    return .sessionEnd(SessionEndEventMessage(
   654	        direction: .event, payload: payload, runID: nil,
   655	        sentAt: now, seq: nextSeq(), sessionID: ourSessionID, ts: now, type: .evtSessionEnd
   656	    ))
   657	}
