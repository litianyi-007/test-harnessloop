    15	// 退出码：全部通过为 0，任意一条 FAIL 为 1（供 CI/脚本判定，不依赖肉眼看 PASS/FAIL 字样）。
    16	
    17	import Foundation
    18	
    19	@main
    20	struct FrameReplayTestMain {
