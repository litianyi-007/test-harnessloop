   411	// MARK: - F1：并发 send()/stop() 的 session 级互斥锁
   412	
   413	/// **修前 fail / 修后 pass**：上一轮 `send()` 没有任何锁——两个并发调用都会无条件进入 RPC。本轮
   414	/// 加了 `send_pending` 互斥锁：锁不是 idle 时新的 `send()` 一律 reject(session_locked)。这里直接
   415	/// 把锁摆到 `send_pending`（模拟"另一个 send() 正在途中"这个窗口）验证 reject 行为。
   416	func testConcurrentSendRejectedWhenLocked() async -> Bool {
   417	    let name = "F1 concurrent send() rejected when lock is send_pending"
   418	    let client = freshClient()
   419	    let sessionID = "sess-lock-1"
   420	    _ = await client.testSupportRegisterSession(ourSessionID: sessionID, kernelKey: "kernel-key-4")
   421	    await client.testSupportForceLockToSendPending(sessionID: sessionID)
   422	
   423	    let handle = SessionHandle(
   424	        billing: Billing(tokenRef: "test"), createdAt: Date(), kernel: .openclaw,
   425	        kernelSessionID: "kernel-key-4", sessionID: sessionID
   426	    )
   427	    do {
   428	        _ = try await client.send(session: handle, input: Input(kind: .text, text: "hello", parts: nil))
   429	        return fail(name, "expected send() to throw session_locked, but it succeeded")
   430	    } catch let KernelClientError.rpcRejected(code, _) {
   431	        guard code == "session_locked" else {
   432	            return fail(name, "expected code=session_locked, got \(code)")
   433	        }
   434	        return pass(name, "send() 正确 reject(session_locked) —— 修前完全没有这层锁,会直接尝试发起 RPC")
   435	    } catch {
   436	        return fail(name, "expected KernelClientError.rpcRejected, got \(error)")
   437	    }
   438	}
