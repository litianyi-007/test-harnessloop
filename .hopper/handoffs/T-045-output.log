   134	/// 把收发的每一帧打印出来——这是本轮 SG-4 的验收铁证要求（"把每步的响应/事件打印出来"），不是调试
   135	/// 脚手架，是交付物本身的一部分。**F7 rework**：打印前统一走 `redactedCopy`，递归脱敏
   136	/// auth/token/secret 等凭证字段——这是唯一的调用路径（`OpenclawGatewayKernelClient` 里所有
   137	/// `prettyPrint(...)` 调用点都不需要各自记得脱敏），content 类字段（消息正文/工具输出/审批
   138	/// payload）默认随这条统一路径打印，不再单独提供一个"不脱敏"的旁路。
   139	func prettyPrint(_ label: String, _ object: JSONObject) {
   140	    let safeObject = (redactedCopy(object) as? JSONObject) ?? object
   141	    let data = (try? JSONSerialization.data(withJSONObject: safeObject, options: [.prettyPrinted, .sortedKeys])) ?? Data()
   142	    let text = String(data: data, encoding: .utf8) ?? "<unprintable>"
   143	    print("\n--- \(label) ---\n\(text)")
   144	}
