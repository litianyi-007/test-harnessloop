   315	    public func interrupt(session: SessionHandle, options: InterruptRequestMessagePayload) async throws -> InterruptResultPayload {
   316	        throw KernelClientError.notImplemented("interrupt() 本轮 TODO 桩——L1 闭环没有 active run 需要 interrupt")
   317	    }
   318	
   319	    /// D1 §2.5 stop()。**F6 rework**：上一轮把 stop() 实现为"abort -> delete -> finish 流"三步，
   320	    /// 存在两个严重缺陷（对抗审 T-044 复现）：
   321	    ///   ① 返回给调用方的 `StopResultPayload.operationID` 是 `"\(sessionID)-stop-abort_\(status)"`，
   322	    ///      与 EventMapping 里 lifecycle 映射自己派生的 `"\(sessionID)-abort-\(runID)"` 完全不同，
   323	    ///      调用方的 Promise 结果和异步 `operation_completed` 事件根本无法关联。
   324	    ///   ② delete 之后立刻 `finishEventContinuation`（= 立刻 finish 流），如果该 run 的强制取消
   325	    ///      产生的 `turn_complete(cancelled)`/`operation_completed` 事件恰好还没被 receiveLoop 处理
   326	    ///      完，调用方永远收不到这两个 D1 §9.3 明确要求的必需终态。
   327	    ///
   328	    /// 本轮修法：
   329	    ///   1. 在发起 `sessions.abort` **之前**就铸造一个唯一 operationId，登记到 `pendingStops`
   330	    ///      （连同"这次 stop 生效前活跃的 runId"），供 `handleAgentEvent` 观察到对应的 aborted
   331	    ///      lifecycle 帧时使用**同一个** operationId 构造 operation_completed，不再自己派生。
   332	    ///   2. abort 之后、delete 之前，有界等待（`waitForPendingStopTerminal`，非无限悬挂）该 run 的
   333	    ///      operation_completed + turn_complete(cancelled) 已经被 `handleAgentEvent` 观察并 yield
   334	    ///      完成——只有等到确认（或超时）才继续，避免过早 finish 流。
   335	    ///   3. delete 之后、finish 流之前，yield 一条 `session_end(reason:.stopped)`（上一轮从未产出
   336	    ///      这个事件）。
   337	    ///   4. `StopResultPayload.operationID` 返回同一个铸造好的值，`outcome` 在等待超时时诚实记
   338	    ///      `.timedOut`（D1 §2.5 stop() 可达 outcome 子集本就包含这一态），否则按 delete 是否成功
   339	    ///      记 succeeded/rejected（同上一轮）。
   340	    public func stop(session: SessionHandle) async throws -> StopResultPayload {
   341	        guard let kernelKey = kernelKeyBySessionID[session.sessionID] else {
   342	            throw KernelClientError.protocolMismatch("unknown session \(session.sessionID)")
   343	        }
   344	
   345	        let currentLock = lockStateBySessionID[session.sessionID] ?? .idle
   346	        guard currentLock == .idle else {
   347	            throw KernelClientError.rpcRejected(
   348	                code: "session_locked",
   349	                message: "stop() rejected: session \(session.sessionID) lock state is \(currentLock), expected idle (D1 v3.1 §9.3)"
   350	            )
   351	        }
   352	        lockStateBySessionID[session.sessionID] = .stopInProgress
   353	
   354	        let operationID = "op-stop-\(UUID().uuidString)"
   355	        let affectedRunID = lastRunIDBySessionID[session.sessionID]
   356	        pendingStops[session.sessionID] = PendingStop(operationID: operationID, affectedRunID: affectedRunID)
   357	
   358	        let abortResult = try await request(method: "sessions.abort", params: ["key": kernelKey])
   359	        prettyPrint("RECV sessions.abort result", abortResult)
   360	
   361	        // D1 v3 §9.3："stop() 调用时存在 active run，适配器必须先完成该 run 的强制取消并产出
   362	        // TurnCompleteEvent(cancelled)...确认该事件已经进入 subscribe() 流之后，才能产出
   363	        // SessionEndEvent(reason:'stopped')"。有界等待（不是无限悬挂），交由 handleAgentEvent 在
   364	        // 观察到对应 aborted lifecycle 帧时唤醒；超时则诚实继续（不让调用方永久悬挂），并把
   365	        // outcome 记成 .timedOut。
   366	        //
   367	        // **是否需要等待，由 `sessions.abort` 自己的返回值判断，不是本地缓存的 `affectedRunID`**
   368	        // ——现场实测（scratchpad/openclaw-iso3 隔离环境）坐实：`lastRunIDBySessionID` 只在收到新
   369	        // run 时刷新，一个 run 正常 turnComplete 之后这个缓存不会被清空；如果 stop() 在该 run 早已
   370	        // 自然结束之后才被调用，`sessions.abort` 会诚实回报 `{"abortedRunId":null,
   371	        // "status":"no-active-run"}`——这种情况下压根不会有任何 aborted lifecycle 帧到达，若仍然
   372	        // 用 `affectedRunID != nil` 去等待，会白白悬挂满 5 秒、还诚实性错误地把 outcome 报成
   373	        // `.timedOut`（本轮真实探针复现过这个具体场景：`sessions.send` 的模型回复早已完成，
   374	        // stop() 才被调用，`abortedRunId` 为 nil，若仍等待就是在等一个永远不会来的事件）。改为
   375	        // 直接读 `abortResult.abortedRunId`——非空才说明这次 abort 真的中止了一个活跃 run，才需要
   376	        // 等待其终态；为 nil 就没有等待的意义，直接把这次 pendingStop 标记掉，不留悬空 waiter。
   377	        var timedOut = false
   378	        let actuallyAbortedRunID = abortResult["abortedRunId"] as? String
   379	        if actuallyAbortedRunID != nil {
   380	            timedOut = await waitForPendingStopTerminal(sessionID: session.sessionID, timeoutSeconds: 5)
   381	        } else {
   382	            pendingStops.removeValue(forKey: session.sessionID)
   383	        }
   384	
   385	        let deleteResult = try await request(method: "sessions.delete", params: ["key": kernelKey])
   386	        prettyPrint("RECV sessions.delete result", deleteResult)
   387	        let deleted = (deleteResult["deleted"] as? Bool) ?? false
   388	
   389	        // F8：session_end(stopped) 必须在 finish 流之前 yield，且与 shutdown/transportClosed 两条
   390	        // 路径共享同一个"这个 session 是否已经产出过 terminal"标记，避免重复/矛盾的 sessionEnd。
   391	        if !sessionTerminalEmitted.contains(session.sessionID) {
   392	            sessionTerminalEmitted.insert(session.sessionID)
   393	            if let continuation = eventContinuations[session.sessionID] {
   394	                let sid = session.sessionID
   395	                continuation.yield(makeSessionEndEventForStop(
   396	                    ourSessionID: sid,
   397	                    nextSeq: { self.nextSeq(runID: nil, sessionID: sid) }
   398	                ))
   399	            }
   400	        }
   401	
   402	        finishEventContinuation(sessionID: session.sessionID)
   403	        kernelKeyBySessionID.removeValue(forKey: session.sessionID)
   404	        pendingStops.removeValue(forKey: session.sessionID)
   405	        lockStateBySessionID.removeValue(forKey: session.sessionID)
   406	
   407	        // D1 §2.5：stop() 可达的 outcome 子集是 succeeded/timed_out/rejected 三态。
   408	        let outcome: StopResultPayloadOutcome = timedOut ? .timedOut : (deleted ? .succeeded : .rejected)
   409	        return StopResultPayload(operationID: operationID, outcome: outcome)
   410	    }
   411	
   412	    /// 等待 `pendingStops[sessionID]` 对应的 run 终态（operation_completed + turn_complete）已被
   413	    /// `handleAgentEvent` 观察并 yield——由该处理器调用 `resolvePendingStopWaiter(timedOut:false)`
   414	    /// 唤醒；超时（`timeoutSeconds`）则由本函数内部起的定时器调用 `resolvePendingStopWaiter
   415	    /// (timedOut:true)` 唤醒。`resolvePendingStopWaiter` 内部先取出并清空 waiter 再 resume，保证
   416	    /// 无论两条路径谁先到，`CheckedContinuation` 都只会被 resume 恰好一次。
   417	    private func waitForPendingStopTerminal(sessionID: String, timeoutSeconds: Int) async -> Bool {
   418	        guard let pending = pendingStops[sessionID], !pending.terminalEmitted else { return false }
   419	        return await withCheckedContinuation { (continuation: CheckedContinuation<Bool, Never>) in
   420	            self.pendingStops[sessionID]?.waiter = continuation
   421	            Task {
   422	                try? await Task.sleep(nanoseconds: UInt64(timeoutSeconds) * 1_000_000_000)
   423	                await self.resolvePendingStopWaiter(sessionID: sessionID, timedOut: true)
   424	            }
   425	        }
   426	    }
   427	
   428	    private func resolvePendingStopWaiter(sessionID: String, timedOut: Bool) {
   429	        guard let waiter = pendingStops[sessionID]?.waiter else { return }
   430	        pendingStops[sessionID]?.waiter = nil
   431	        waiter.resume(returning: timedOut)
   432	    }
