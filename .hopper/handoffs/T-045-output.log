    86	    // runId；approvalRequest 还要求 toolCallID，但 openclaw 的审批 payload 本身不带 toolCallId）。
    87	    // F1 订正：run/tool/usage 三个缓存改为 **per-run**（用 runId 做键），不再是 per-session——
    88	    // per-session 缓存在并发/连续多个 run 的场景下会把上一个 run 的残留值串给下一个 run（对抗审
    89	    // T-044 F1 复现场景），per-run 键天然避免这个问题：新 run 开始时缓存自然是空的。
    90	    private var lastRunIDBySessionID: [String: String] = [:]
    91	    private var runIDsBySessionID: [String: Set<String>] = [:] // 供 session 结束时批量清理 per-run 缓存
    92	    private var lastToolCallIDByRunID: [String: String] = [:]
    93	    private var lastUsageByRunID: [String: (input: Int, output: Int)] = [:]
    94	    /// F4：`agent(stream:"approval", phase:"requested")` 的 approvalId -> toolCallId 精确映射，
    95	    /// 取代上一轮"同 session 最近一次 toolCall"的猜测。一次性缓存，用过即清（同一个 approvalId
    96	    /// 不会有第二次 pending）。
    97	    private var toolCallIDByApprovalID: [String: String] = [:]
    98	
    99	    // MARK: F3 — per-run 单调 seq 域
   100	    private var seqByRunID: [String: Int] = [:]
   101	    /// 没有 runId 的事件（sessionEnd 等）退化为按 session 走一个独立递增序列——D1 只承诺"同一 runId
   102	    /// 内排序"，这里只是让无 run 归属的事件也至少非递减，不是额外的契约承诺。
   103	    private var seqFallbackBySessionID: [String: Int] = [:]
   104	
   105	    public private(set) var lastHandshakeScopes: [String] = []
   106	    public private(set) var lastHandshakeProtocol: Int?
   107	
   108	    public init(endpoint: URL, token: String) {
   109	        self.endpoint = endpoint
   110	        self.token = token
   111	        self.urlSession = URLSession(configuration: .default)
   112	    }
   113	
   114	    // MARK: - 连接 + 握手（recipe §2）
   115	
   116	    /// 建立 WS 连接并完成 challenge -> connect 握手，返回 hello-ok 里协商到的 scopes——供调用方
   117	    /// 核验"确实拿到了 operator.write/operator.admin 等写权限"（recipe §2 里最容易踩的坑：
   118	    /// client.id/mode 不是 "cli"/"cli" 时握手仍会成功，但 scopes 会被服务端清空）。
   119	    public func connect() async throws -> [String] {
   120	        let t = urlSession.webSocketTask(with: endpoint)
   121	        self.task = t
   122	        t.resume()
   123	        receiveLoopTask = Task { await self.receiveLoop() }
   124	
   125	        let challenge = try await waitForNextEvent(named: "connect.challenge")
   126	        prettyPrint("RECV connect.challenge", challenge)
   127	
   128	        // 握手 params 逐字段对照 recipe §2 末尾"一次完整、可复制的最小 connect 请求"。
   129	        let connectParams: JSONObject = [
   130	            "minProtocol": 3,
   131	            "maxProtocol": 4,
   132	            "client": [
   133	                "id": "cli",
   134	                "version": "0.0.1",
   135	                "platform": "darwin",
   136	                "mode": "cli",
   137	            ] as JSONObject,
   138	            "caps": [] as [String],
   139	            "role": "operator",
   140	            "scopes": ["operator.admin"] as [String],
   141	            "auth": ["token": token] as JSONObject,
   142	        ]
   143	        let hello = try await request(method: "connect", params: connectParams)
   144	        prettyPrint("RECV hello-ok (connect response payload)", hello)
   145	
   146	        if let proto = hello["protocol"] as? Int {
   147	            lastHandshakeProtocol = proto
   148	        }
   149	        if let auth = hello["auth"] as? JSONObject, let scopes = auth["scopes"] as? [String] {
   150	            lastHandshakeScopes = scopes
   151	        }
   152	        return lastHandshakeScopes
   153	    }
   154	
   155	    public func disconnect() {
   156	        receiveLoopTask?.cancel()
   157	        task?.cancel(with: .normalClosure, reason: nil)
   158	        task = nil
   159	    }
