   412	    /// 等待 `pendingStops[sessionID]` 对应的 run 终态（operation_completed + turn_complete）已被
   413	    /// `handleAgentEvent` 观察并 yield——由该处理器调用 `resolvePendingStopWaiter(timedOut:false)`
   414	    /// 唤醒；超时（`timeoutSeconds`）则由本函数内部起的定时器调用 `resolvePendingStopWaiter
   415	    /// (timedOut:true)` 唤醒。`resolvePendingStopWaiter` 内部先取出并清空 waiter 再 resume，保证
   416	    /// 无论两条路径谁先到，`CheckedContinuation` 都只会被 resume 恰好一次。
   417	    private func waitForPendingStopTerminal(sessionID: String, timeoutSeconds: Int) async -> Bool {
   418	        guard let pending = pendingStops[sessionID], !pending.terminalEmitted else { return false }
   419	        return await withCheckedContinuation { (continuation: CheckedContinuation<Bool, Never>) in
   420	            self.pendingStops[sessionID]?.waiter = continuation
   421	            Task {
   422	                try? await Task.sleep(nanoseconds: UInt64(timeoutSeconds) * 1_000_000_000)
   423	                await self.resolvePendingStopWaiter(sessionID: sessionID, timedOut: true)
   424	            }
   425	        }
   426	    }
