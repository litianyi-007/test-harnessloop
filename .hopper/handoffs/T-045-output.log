   353	// MARK: - ③ agent(stream:"lifecycle") -> turnComplete / operationCompleted（现场实测样本 grounding）
   354	
   355	/// `!aborted` 分支：正常回合结束 -> turnComplete。
   356	///
   357	/// **F6 订正**：上一轮把"合法 `phase:end` 但没有 `stopReason`"默认记成 `.error`，对抗审 codex 指出
   358	/// openclaw 测试里确实存在 `data:{phase:"end"}`（无 stopReason）这种合法终态，不该被误报成错误。
   359	/// 源码坐实（rework 轮新读 `kernels/openclaw/src/agents/embedded-agent-subscribe.handlers.lifecycle.ts:
   360	/// 176-202`）：`phase` 只有在 `isError`（= 上一条 assistant 消息自己的 `stopReason === "error"`）时
   361	/// 才会是 `"error"`，否则一律是 `"end"`（或 `"finishing"`，本文件不处理，见头注释④）——也就是说
   362	/// **`phase == "end"` 这个事实本身，由 openclaw 自己的构造逻辑保证 `isError == false`**，缺失
   363	/// `stopReason` 只代表"没有更细的终止原因可报"，不代表出错。因此缺失/未知取值一律折叠到
   364	/// `.completed`，不再默认 `.error`。
   365	/// 真实取值来源（同文件 `terminalStopReason` 变量）：非 error 分支的 `stopReason` 落回"上一条
   366	/// assistant 消息自己的 `stopReason`"——真实样本观察到 `"stop"`（正常结束）与 `"toolUse"`（回合内
   367	/// 还在工具调用中就进入了 lifecycle "end"，边缘情况，同样折叠进 `.completed`，因为 `aborted:false`
   368	/// + `phase:"end"` 已经由 openclaw 保证"不是错误终止"）。`"max_turns"`/`"maxTurns"` 本轮仍未现场
   369	/// 观察到，映射到 `.maxTurns`维持上一轮的推断标注，未改判。
   370	func mapOpenclawAgentLifecycleToTurnComplete(
   371	    _ data: JSONObject,
   372	    ourSessionID: String,
   373	    runID: String,
   374	    originTS: Date,
   375	    cachedUsage: (input: Int, output: Int)?,
   376	    nextSeq: () -> Int
   377	) -> EventMessageUnion {
   378	    let rawStopReason = jsonString(data["stopReason"])
   379	    let stopReason: StopReason
   380	    switch rawStopReason {
   381	    case "max_turns", "maxTurns":
   382	        stopReason = .maxTurns // 推断：本轮未现场观察到这个取值，维持上一轮标注
   383	    default:
   384	        // "stop"/"toolUse"/nil/其余未知取值：aborted:false + phase:"end" 由 openclaw 自身构造逻辑
   385	        // 保证非错误终止（见函数文档注释），一律记 completed，不再默认 error（F6）。
   386	        stopReason = .completed
   387	    }
   388	    let usage = cachedUsage.map { Usage(inputTokens: $0.input, outputTokens: $0.output) }
   389	    let turnPayload = TurnCompleteEventMessagePayload(
   390	        degraded: nil, forceResolvedApprovals: nil, stopReason: stopReason, usage: usage
   391	    )
   392	    return .turnComplete(TurnCompleteEventMessage(
   393	        direction: .event, payload: turnPayload, runID: runID,
   394	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtTurnComplete
   395	    ))
   396	}
   397	
   398	/// `aborted` 分支：**F6 订正**——上一轮只发一条 `operationCompleted`，且其 `operationId` 是
   399	/// mapper 自己派生的 `"\(ourSessionID)-abort-\(runID)"`，与 `OpenclawGatewayKernelClient.stop()`
   400	/// 返回给调用方的 `StopResultPayload.operationID`（上一轮是完全不同的
   401	/// `"\(sessionID)-stop-abort_\(status)"`）互不相同，调用方拿到的 Promise 结果和异步旁路事件根本无法
   402	/// 关联；D1 v3 §9.3"stop 的事件顺序保证"还要求这次强制取消**必须**同时产出
   403	/// `TurnCompleteEvent(stopReason:'cancelled')`，上一轮完全没发。
   404	///
   405	/// rework 轮修法：`operationID` 改为**调用方（`stop()`）在发起 `sessions.abort` 之前就已经铸造好**
   406	/// 的唯一值，通过参数传入（不再自己派生）；本函数一次性返回 `[operationCompleted, turnComplete]`
   407	/// 两个事件（顺序即数组顺序，调用方按序 yield，先 operation_completed 后 turn_complete，符合
   408	/// 任务书 F6 要求的"单个 operation_completed → turn_complete(cancelled) → session_end(stopped)"
   409	/// 序列的前两段）。调用方负责保证本函数对同一次 stop() 只被调用一次（同一个 run 的第二条 aborted
   410	/// 帧——真实样本里 `phase:"end"` 之后常跟一条 `phase:"error",error:"This operation was aborted"`
   411	/// 的收尾帧——被调用方去重，不再产出第二组 operationCompleted/turnComplete，见
   412	/// `OpenclawGatewayKernelClient.handleAgentEvent` 的 pendingStop 状态机）。
   413	///
   414	/// outcome 判别（同上一轮，未改判）：真实样本里 phase=="end" 时 status=="cancelled"（sessions.abort
   415	/// 的 RPC 结果本身也确认了 outcome:"aborted"）记 succeeded（"这次 abort 操作成功执行了"）；
   416	/// phase=="error" 那条后续帧语义不够确定，保守记 abortedEffectUnknown。
   417	func mapOpenclawAgentLifecycleToAbortTerminalEvents(
   418	    _ data: JSONObject,
   419	    ourSessionID: String,
   420	    runID: String,
   421	    operationID: String,
   422	    originTS: Date,
   423	    cachedUsage: (input: Int, output: Int)?,
   424	    nextSeq: () -> Int
   425	) -> [EventMessageUnion] {
   426	    let phase = jsonString(data["phase"])
   427	    let outcome: PayloadOutcome = phase == "end" ? .succeeded : .abortedEffectUnknown
   428	    let detail = jsonString(data["error"])
   429	    let opPayload = OperationCompletedEventMessagePayload(
   430	        affectedRunID: runID, detail: detail, newRunID: nil,
   431	        operationID: operationID, operationKind: .stop, outcome: outcome
   432	    )
   433	    let operationCompletedEvent = EventMessageUnion.operationCompleted(OperationCompletedEventMessage(
   434	        direction: .event, payload: opPayload, runID: runID,
   435	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtOperationCompleted
   436	    ))
   437	
   438	    let usage = cachedUsage.map { Usage(inputTokens: $0.input, outputTokens: $0.output) }
   439	    let turnPayload = TurnCompleteEventMessagePayload(
   440	        degraded: nil, forceResolvedApprovals: nil, stopReason: .cancelled, usage: usage
   441	    )
   442	    let turnCompleteEvent = EventMessageUnion.turnComplete(TurnCompleteEventMessage(
   443	        direction: .event, payload: turnPayload, runID: runID,
   444	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtTurnComplete
   445	    ))
   446	
   447	    return [operationCompletedEvent, turnCompleteEvent]
   448	}
