   479	    private func request(method: String, params: JSONObject) async throws -> JSONObject {
   480	        guard let task = task else { throw KernelClientError.notConnected }
   481	        nextReqID += 1
   482	        let id = "r\(nextReqID)"
   483	        let frame: JSONObject = ["type": "req", "id": id, "method": method, "params": params]
   484	        prettyPrint("SEND req \(method)", frame)
   485	        let data = try encodeFrame(frame)
   486	
   487	        return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<JSONObject, Error>) in
   488	            self.pending[id] = continuation
   489	            task.send(.data(data)) { error in
   490	                if let error = error {
   491	                    Task { await self.failPending(id: id, error: KernelClientError.transport(error.localizedDescription)) }
   492	                }
   493	            }
   494	        }
   495	    }
