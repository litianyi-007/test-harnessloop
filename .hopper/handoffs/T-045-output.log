    92	        ] as JSONObject,
    93	    ]
    94	    var counter = 0
    95	    let events = mapOpenclawSessionMessageToKernelEvents(
    96	        payload, ourSessionID: "s1", runIDHint: "run-1",
    97	        nextSeq: { counter += 1; return counter }
    98	    )
    99	    guard events.count == 2 else {
   100	        return fail(name, "expected 2 events (text + toolCall), got \(events.count)")
   101	    }
   102	    let seqs: [Int] = events.map { event in
   103	        switch event {
   104	        case .messageDelta(let e): return e.seq
   105	        case .toolCall(let e): return e.seq
   106	        default: return -1
   107	        }
   108	    }
   109	    guard seqs == [1, 2] else {
