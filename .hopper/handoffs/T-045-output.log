     1	// Attachment normalization accepts permissive RPC attachment payloads and turns
     2	// them into the bounded chat attachment shape used by gateway chat methods.
     3	import type { ChatAttachment } from "../chat-attachments.js";
     4	
     5	/** RPC attachment payload shape accepted by chat-like gateway methods. */
     6	export type RpcAttachmentInput = {
     7	  type?: unknown;
     8	  mimeType?: unknown;
     9	  fileName?: unknown;
    10	  content?: unknown;
    11	  source?: unknown;
    12	};
    13	
    14	function normalizeAttachmentContent(content: unknown): string | undefined {
    15	  // RPC callers may send browser ArrayBuffers, typed-array slices, or base64
    16	  // strings. Normalize all accepted forms to the chat attachment wire shape.
    17	  if (typeof content === "string") {
    18	    return content;
    19	  }
    20	  if (ArrayBuffer.isView(content)) {
    21	    return Buffer.from(content.buffer, content.byteOffset, content.byteLength).toString("base64");
    22	  }
    23	  if (content instanceof ArrayBuffer) {
    24	    return Buffer.from(content).toString("base64");
    25	  }
    26	  return undefined;
    27	}
    28	
    29	/** Convert permissive RPC attachment payloads into the bounded chat attachment shape. */
    30	export function normalizeRpcAttachmentsToChatAttachments(
    31	  attachments: RpcAttachmentInput[] | undefined,
    32	): ChatAttachment[] {
    33	  // Accept both the OpenClaw attachment fields and Anthropic-style
    34	  // source:{type:"base64",media_type,data} payloads used by some clients.
    35	  return (
    36	    attachments
    37	      ?.map((a) => {
    38	        const source = a?.source && typeof a.source === "object" ? a.source : undefined;
    39	        const sourceRecord = source as
    40	          | { type?: unknown; media_type?: unknown; data?: unknown }
    41	          | undefined;
    42	        const sourceType = typeof sourceRecord?.type === "string" ? sourceRecord.type : undefined;
    43	        const sourceMimeType =
    44	          typeof sourceRecord?.media_type === "string" ? sourceRecord.media_type : undefined;
    45	        const sourceContent =
    46	          sourceType === "base64" ? normalizeAttachmentContent(sourceRecord?.data) : undefined;
    47	
    48	        return {
    49	          type: typeof a?.type === "string" ? a.type : undefined,
