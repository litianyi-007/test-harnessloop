   239	// MARK: - ② agent(stream:"command_output") -> toolResult（exec 工具族，现场实测样本 grounding）
   240	
   241	/// 真实样本（同一 exec 工具调用的完整生命周期，`agent` 事件 `payload.stream` 依次是
   242	/// run_status→item(×N)→command_output(phase delta×N)→item(phase end)→command_output(phase end)）：
   243	/// ```
   244	/// {"stream":"command_output","data":{"itemId":"command:tool_Jd9...","phase":"end",
   245	///   "toolCallId":"tool_Jd9HsUlLKZyhkA7uhkIvInHr","name":"exec",
   246	///   "output":"AGENTS.md\nBOOTSTRAP.md\n...","status":"completed","exitCode":0,
   247	///   "durationMs":20,"cwd":"/Users/.../workspace"}}
   248	/// ```
   249	/// 只取 `phase:"end"` 的 `command_output`（`phase:"delta"` 是流式中间态，不代表工具调用终态）。
   250	/// `originTS` 取 `agent` wire 帧外层 `payload.ts`（openclaw `enrichAgentEvent` 在事件产生时盖章的
   251	/// 真实时刻，见 `infra/agent-events.ts:628` `ts: Date.now()`），不用 `Date()`（F3）。
   252	///
   253	/// 范围声明（rework 轮 F5 用真实非 exec 工具样本坐实的结论，取代上一轮"未拿到样本"的开放问题）：
   254	/// `command_output` 这个 stream 名字确认只属于 exec/命令族工具（真实样本：`update_plan` 这个非 exec
   255	/// 内置工具走的是 `stream:"item"`，从未产出 `command_output`，见文件头注释②与
   256	/// `mapOpenclawAgentToolItemToToolResult`）。本函数只对 stream=="command_output" 生效。
   257	func mapOpenclawAgentCommandOutputToToolResult(
   258	    _ data: JSONObject,
   259	    ourSessionID: String,
   260	    runIDHint: String?,
   261	    originTS: Date,
   262	    nextSeq: () -> Int
   263	) -> EventMessageUnion? {
   264	    guard jsonString(data["phase"]) == "end" else { return nil }
   265	    guard let toolCallID = jsonString(data["toolCallId"]) else { return nil }
   266	
   267	    let status = jsonString(data["status"])
   268	    let exitCode = jsonInt(data["exitCode"])
   269	    let isError = (status == "failed") || ((exitCode ?? 0) != 0)
   270	    let output = makeJSONAny(data["output"] ?? "")
   271	    let durationMS = jsonInt(data["durationMs"])
   272	
   273	    let resultPayload = ToolResultEventMessagePayload(
   274	        durationMS: durationMS, isError: isError, output: output, toolCallID: toolCallID
   275	    )
   276	    return .toolResult(ToolResultEventMessage(
   277	        direction: .event, payload: resultPayload, runID: runIDHint,
   278	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtToolResult
   279	    ))
   280	}
