   442	    // MARK: - 内部：session 映射表 + 事件流生命周期
   443	
   444	    private func kernelKey(for ourSessionID: String) -> String? {
   445	        kernelKeyBySessionID[ourSessionID]
   446	    }
   447	
   448	    /// F3：per-run（或无 run 归属时按 session）单调递增 seq——供所有 mapper 调用的
   449	    /// `nextSeq` 闭包共享同一份 actor 隔离状态。
   450	    private func nextSeq(runID: String?, sessionID: String) -> Int {
   451	        if let runID = runID {
   452	            let next = (seqByRunID[runID] ?? 0) + 1
   453	            seqByRunID[runID] = next
   454	            return next
   455	        }
   456	        let next = (seqFallbackBySessionID[sessionID] ?? 0) + 1
   457	        seqFallbackBySessionID[sessionID] = next
   458	        return next
   459	    }
   460	
   461	    private func finishEventContinuation(sessionID: String) {
   462	        eventContinuations[sessionID]?.finish()
   463	        eventContinuations.removeValue(forKey: sessionID)
   464	        // per-run 缓存一并清理，避免长生命周期的 client 无限累积已经 stop() 掉的 session 名下所有
   465	        // run 的 seq/toolCallId/usage 缓存（F1：缓存改成 per-run 键之后，这里改为按
   466	        // `runIDsBySessionID` 记录的清单批量清）。
   467	        for runID in runIDsBySessionID[sessionID] ?? [] {
   468	            seqByRunID.removeValue(forKey: runID)
   469	            lastToolCallIDByRunID.removeValue(forKey: runID)
   470	            lastUsageByRunID.removeValue(forKey: runID)
   471	        }
   472	        runIDsBySessionID.removeValue(forKey: sessionID)
   473	        lastRunIDBySessionID.removeValue(forKey: sessionID)
   474	        seqFallbackBySessionID.removeValue(forKey: sessionID)
   475	    }
