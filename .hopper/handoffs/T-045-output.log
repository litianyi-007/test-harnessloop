    30	/// 收集流上最多 `maxCount` 个事件，超过 `timeoutMs` 还没凑够就提前放弃——用于"验证不多不少"的场景
    31	/// （F6/F8 去重测试：如果 bug 复现会多出一条事件，正确实现下多等的这一条永远不会来，需要一个超时
    32	/// 兜底，不能无限悬挂）。所有测试里的 `testSupportFeedFrame` 调用都已经在 `await` 返回前完成了
    33	/// `continuation.yield`（AsyncThrowingStream 默认无界缓冲，yield 不阻塞），所以正常情况下这里几乎
    34	/// 不会真的等到超时——超时只在"期望没有更多事件、且确实没有更多事件"时才会触发。
    35	final class EventBox: @unchecked Sendable {
    36	    var events: [EventMessageUnion] = []
    37	}
    38	
    39	func collectUpTo(
    40	    _ stream: AsyncThrowingStream<EventMessageUnion, Error>,
    41	    maxCount: Int,
    42	    timeoutMs: UInt64 = 300
    43	) async -> [EventMessageUnion] {
    44	    let box = EventBox()
    45	    await withTaskGroup(of: Void.self) { group in
    46	        group.addTask {
    47	            var iterator = stream.makeAsyncIterator()
    48	            for _ in 0..<maxCount {
    49	                let next: EventMessageUnion?
    50	                do {
    51	                    next = try await iterator.next()
    52	                } catch {
    53	                    break
    54	                }
    55	                guard let event = next else { break }
    56	                box.events.append(event)
    57	            }
    58	        }
    59	        group.addTask {
    60	            try? await Task.sleep(nanoseconds: timeoutMs * 1_000_000)
    61	        }
    62	        await group.next()
    63	        group.cancelAll()
    64	    }
    65	    return box.events
    66	}
