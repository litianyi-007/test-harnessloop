   234	// MARK: - F4：两个交错的 tool approval 不会串号
   235	
   236	/// **修前 fail / 修后 pass**：上一轮用"同 session 最近一次 toolCall"猜测 approval 的 toolCallId——
   237	/// 复现场景：两个 toolCall（A 先、B 后）几乎同时在途，B 的 `session.message` 先落地把"最近一次
   238	/// toolCall"刷新成 B，随后 A 的 `session.approval(pending)` 才到达，上一轮会把 A 的 approval 错误
   239	/// 关联到 B 的 toolCallId。本轮改用 `agent(stream:"approval", phase:"requested")` 的准确
   240	/// `approvalId -> toolCallId` 映射，按 approvalId（不是"最近一次"）精确关联，两个交错的审批各自
   241	/// 拿到正确的 toolCallId。
   242	func testInterleavedApprovalsDoNotCrossWire() async -> Bool {
   243	    let name = "F4 interleaved approvals do not cross-wire toolCallId"
   244	    let client = freshClient()
   245	    let sessionID = "sess-approval-1"
   246	    let stream = await client.testSupportRegisterSession(ourSessionID: sessionID, kernelKey: "kernel-key-2")
   247	
   248	    func agentApprovalFrame(approvalID: String, toolCallID: String) -> JSONObject {
   249	        [
   250	            "type": "event", "event": "agent",
   251	            "payload": [
   252	                "runId": "run-x", "sessionKey": "kernel-key-2", "stream": "approval",
   253	                "data": ["phase": "requested", "kind": "exec", "status": "pending", "title": "t",
   254	                         "toolCallId": toolCallID, "approvalId": approvalID] as JSONObject,
   255	                "seq": 1, "ts": 1_784_871_200_000,
   256	            ] as JSONObject,
   257	        ]
   258	    }
   259	    func sessionApprovalFrame(approvalID: String, createdAtMs: Int) -> JSONObject {
   260	        [
   261	            "type": "event", "event": "session.approval",
   262	            "payload": [
   263	                "sessionKey": "kernel-key-2", "updatedAtMs": createdAtMs, "phase": "pending",
   264	                "approval": [
   265	                    "id": approvalID, "status": "pending",
   266	                    "presentation": ["kind": "exec", "commandText": "echo \(approvalID)"] as JSONObject,
   267	                    "createdAtMs": createdAtMs, "expiresAtMs": createdAtMs + 1_800_000,
   268	                ] as JSONObject,
   269	            ] as JSONObject,
   270	        ]
   271	    }
   272	
   273	    // 交错顺序：B 的 toolCall 关联先到达（模拟"B 的 session.message 先落地"），然后 A 的关联到达，
   274	    // 然后 session.approval 按 B 先、A 后的顺序到达（对上一轮"最近一次"的猜测最不利的顺序）。
   275	    await client.testSupportFeedFrame(agentApprovalFrame(approvalID: "approval-B", toolCallID: "tool-B"))
   276	    await client.testSupportFeedFrame(agentApprovalFrame(approvalID: "approval-A", toolCallID: "tool-A"))
   277	    await client.testSupportFeedFrame(sessionApprovalFrame(approvalID: "approval-B", createdAtMs: 1_784_871_200_100))
   278	    await client.testSupportFeedFrame(sessionApprovalFrame(approvalID: "approval-A", createdAtMs: 1_784_871_200_200))
   279	
   280	    let events = await collectUpTo(stream, maxCount: 3)
   281	    guard events.count == 2 else {
   282	        return fail(name, "expected exactly 2 approvalRequest events, got \(events.count)")
   283	    }
   284	    var toolCallByReqID: [String: String] = [:]
   285	    for event in events {
   286	        guard case .approvalRequest(let e) = event else {
   287	            return fail(name, "expected .approvalRequest, got \(event.wireType)")
   288	        }
   289	        toolCallByReqID[e.payload.reqID] = e.payload.toolCallID
   290	    }
   291	    guard toolCallByReqID["approval-B"] == "tool-B" else {
   292	        return fail(name, "approval-B should map to tool-B, got \(toolCallByReqID["approval-B"] ?? "nil") — 修前「最近一次」猜测在这个顺序下会串号")
   293	    }
   294	    guard toolCallByReqID["approval-A"] == "tool-A" else {
   295	        return fail(name, "approval-A should map to tool-A, got \(toolCallByReqID["approval-A"] ?? "nil") — 修前「最近一次」猜测在这个顺序下会串号")
   296	    }
   297	    return pass(name, "approval-B->tool-B, approval-A->tool-A，交错顺序下未串号")
   298	}
