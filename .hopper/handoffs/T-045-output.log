   118	/// 递归构造一份脱敏副本，供日志/打印使用——原始 `object`/嵌套字典/数组本身不被修改（这是"打印前的
   119	/// 只读转换"，不影响实际发给 openclaw 的请求内容）。
   120	func redactedCopy(_ value: Any) -> Any {
   121	    if let dict = value as? JSONObject {
   122	        var out: JSONObject = [:]
   123	        for (key, nested) in dict {
   124	            out[key] = isSensitiveKey(key) ? "***REDACTED***" : redactedCopy(nested)
   125	        }
   126	        return out
   127	    }
   128	    if let array = value as? [Any] {
   129	        return array.map { redactedCopy($0) }
   130	    }
   131	    return value
   132	}
