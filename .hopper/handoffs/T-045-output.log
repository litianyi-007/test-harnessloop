   542	// MARK: - ⑤ agent(stream:"thinking") -> thinking（F5 rework 新增，源码级 grounding）
   543	
   544	/// 真实源码（`kernels/openclaw/src/agents/embedded-agent-subscribe.ts:1226-1254`
   545	/// `emitReasoningStream`）：
   546	/// ```ts
   547	/// emitAgentEvent({ runId: params.runId, stream: "thinking", data: { text: trimmed, delta } });
   548	/// ```
   549	/// `data.delta` 是相对上一次已发送内容的增量，`data.text` 是累计全文——D2 `ThinkingEventMessagePayload`
   550	/// 只要 `delta`，直接取 `data.delta`。`visibility` 这条流本身不携带脱敏/摘要标记，`.raw` 是最贴近
   551	/// "逐 token 实时推理流"语义的取值（与 `session.message` 里未打 `redacted_thinking` 标记的
   552	/// thinking block 用同一取值一致）。
   553	///
   554	/// **本轮未能现场触发一次真实带 thinking 内容的响应**（`d3proxy/kimi-for-coding` provider 目录项
   555	/// 声明 `reasoning:false`，结构性验证了"当前现场配置下 thinking 不可达"）——这是源码级 grounding
   556	/// （dispatch 路径确实存在、字段确实这样取），不是现场实测；诚实标注，与上一轮 SG-5 对同一限制的
   557	/// 标注一致。
   558	func mapOpenclawAgentThinkingToKernelEvent(
   559	    _ data: JSONObject,
   560	    ourSessionID: String,
   561	    runIDHint: String?,
   562	    originTS: Date,
   563	    nextSeq: () -> Int
   564	) -> EventMessageUnion? {
   565	    let delta = jsonString(data["delta"]) ?? jsonString(data["text"]) ?? ""
   566	    let thinkingPayload = ThinkingEventMessagePayload(delta: delta, visibility: .raw)
   567	    return .thinking(ThinkingEventMessage(
   568	        direction: .event, payload: thinkingPayload, runID: runIDHint,
   569	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtThinking
   570	    ))
   571	}
