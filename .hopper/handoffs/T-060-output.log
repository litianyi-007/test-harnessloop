            errors.extend(_validate_plugin(plugin, f"plugins[{i}]", schema_doc))

    if args.wiki or args.file or not args.plugins_yaml:
        if args.file:
            schema_md = Path(args.file)
            wiki_root = schema_md.parent
        else:
            wiki_root = find_wiki_root(args.wiki)
