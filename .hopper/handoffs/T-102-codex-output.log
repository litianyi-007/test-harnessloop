   224	function runCli(args, hopperDir) {
   225	  try {
   226	    const stdout = execFileSync(process.execPath, [DISPATCH_BIN, ...args], {
   227	      env: { ...process.env, HOPPER_DIR: hopperDir, HOPPER_HOST_VENDOR: 'test-harness-neutral-host' },
   228	      stdio: ['ignore', 'pipe', 'pipe'],
   229	      encoding: 'utf-8',
   230	    });
   231	    return { stdout, stderr: '', exitCode: 0 };
   232	  } catch (err) {
   233	    return {
   234	      stdout: err.stdout ? err.stdout.toString() : '',
   235	      stderr: err.stderr ? err.stderr.toString() : '',
   236	      exitCode: err.status,
   237	    };
   238	  }
   239	}
