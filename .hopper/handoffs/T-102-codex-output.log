   296	/**
   297	 * Assemble the task CONTENT for a queued dispatch out of its two possible
   298	 * sources, and say (to the operator, never to the vendor) when one is missing.
   299	 *
   300	 * Rules:
   301	 *   - both present  → detailed spec first, then the Brief under `### Queue brief`,
   302	 *                     with an explicit "detailed spec wins on conflict" line
   303	 *   - spec only     → the spec verbatim
   304	 *   - brief only    → the brief verbatim (mirrors the ad-hoc path, where the brief
   305	 *                     IS the spec) + an operator notice explaining why there is no
   306	 *                     detailed section
   307	 *   - neither       → THROW (fail closed). Dispatching a content-free prompt is how
   308	 *                     a vendor "succeeds" (exit 0, status done) at nothing. Matches
   309	 *                     the ad-hoc/swarm paths, which already reject an empty brief.
   310	 *
   311	 * Note `??` is unusable here: queue.js gives a missing Brief cell the EMPTY STRING,
   312	 * and `'' ?? brief` is `''` — nullish coalescing only catches null/undefined.
   313	 * Everything below is emptiness-aware via .trim().
   314	 *
   315	 * @param {{hopperDir: string, taskId: string, task: {brief?: string}}} args
   316	 * @returns {Promise<{taskSpec: string, specNotice: string|null}>}
   317	 */
   318	async function composeTaskContent({ hopperDir, taskId, task }) {
   319	  const detailed = (await loadTaskSpec(hopperDir, taskId) || '').trim();
   320	  const brief = typeof task?.brief === 'string' ? task.brief.trim() : '';
