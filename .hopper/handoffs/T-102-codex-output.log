   322	  if (detailed && brief) {
   323	    return {
   324	      taskSpec: `${detailed}\n\n${QUEUE_BRIEF_HEADING}\n\n${brief}\n\n${QUEUE_BRIEF_PRECEDENCE_NOTE}`,
