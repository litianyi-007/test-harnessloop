   537	  // text now goes to the OPERATOR (stderr / --resolve echo) instead of being fed to
   538	  // the vendor as if it were the task.
   539	  const path = leaderTasklistPath(hopperDir);
   540	  const tasklistExists = await fileExists(path);
   541	  if (brief) {
   542	    return {
   543	      taskSpec: brief,
   544	      specNotice: tasklistExists
   545	        ? `No detailed spec section for ${taskId} in leader-tasklist.md; task content comes from queue.md Brief.`
   546	        : `leader-tasklist.md is absent at ${path}; task content comes from queue.md Brief.`,
