+ * by itself: blank, a horizontal rule, a table delimiter/all-empty row, a
+ * bare blockquote marker, or a bare list marker. False for everything else —
+ * INCLUDING a table row / blockquote / list item that has real text, and
+ * INCLUDING a bare heading, which is not in the reported structural-token
+ * list (see the residual-gap note above).
+ */
+function isStructuralOnlyLine(line) {
+  const t = line.trim();
+  if (t === '') return true;
+  if (isStructuralTableRow(t)) return true;
+  if (HR_LINE_RE.test(t)) return true;
+  if (BARE_BLOCKQUOTE_RE.test(t)) return true;
+  if (BARE_LIST_MARKER_RE.test(t)) return true;
+  return false;
+}
+
+/**
+ * A section body carries real content the instant AT LEAST ONE line is not
+ * pure structural noise (isStructuralOnlyLine) — deliberately permissive: a
+ * legitimate spec that is MOSTLY structure (a table, a horizontal rule, a
+ * blockquote) still passes as soon as it has one line of real prose or table
+ * data anywhere in it. Only a body that is ENTIRELY structural noise (or
+ * blank) is rejected.
+ */
+function hasSubstantiveContent(text) {
+  return text.split('\n').some((line) => !isStructuralOnlyLine(line));
+}
