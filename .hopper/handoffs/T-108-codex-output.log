   526	
   527	  if (detailed && brief) {
   528	    return {
   529	      taskSpec: `${detailed}\n\n${QUEUE_BRIEF_HEADING}\n\n${brief}\n\n${QUEUE_BRIEF_PRECEDENCE_NOTE}`,
   530	      specNotice: null,
   531	    };
   532	  }
