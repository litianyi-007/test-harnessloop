   499	/**
   500	 * Assemble the task CONTENT for a queued dispatch out of its two possible
   501	 * sources, and say (to the operator, never to the vendor) when one is missing.
   502	 *
   503	 * Rules:
   504	 *   - both present  → detailed spec first, then the Brief under `### Queue brief`,
   505	 *                     with an explicit "detailed spec wins on conflict" line
   506	 *   - spec only     → the spec verbatim
   507	 *   - brief only    → the brief verbatim (mirrors the ad-hoc path, where the brief
   508	 *                     IS the spec) + an operator notice explaining why there is no
   509	 *                     detailed section
   510	 *   - neither       → THROW (fail closed). Dispatching a content-free prompt is how
   511	 *                     a vendor "succeeds" (exit 0, status done) at nothing. Matches
   512	 *                     the ad-hoc/swarm paths, which already reject an empty brief.
   513	 *
   514	 * Note `??` is unusable here: queue.js gives a missing Brief cell the EMPTY STRING,
   515	 * and `'' ?? brief` is `''` — nullish coalescing only catches null/undefined.
   516	 * Everything below is emptiness-aware via .trim().
   517	 *
   518	 * @param {{hopperDir: string, taskId: string, task: {brief?: string}, otherTaskIds?: string[]}} args
   519	 *   `otherTaskIds` — passed straight through to loadTaskSpec's exact-boundary
   520	 *   resolution (every other known task id from queue.md); see its doc comment.
   521	 * @returns {Promise<{taskSpec: string, specNotice: string|null}>}
   522	 */
   523	async function composeTaskContent({ hopperDir, taskId, task, otherTaskIds }) {
   524	  const detailed = (await loadTaskSpec(hopperDir, taskId, { otherTaskIds }) || '').trim();
