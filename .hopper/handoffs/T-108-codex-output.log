   552	    + `. Fill the Brief cell for ${taskId} in .hopper/queue.md, or add a "## ${taskId}" section to leader-tasklist.md.`
   553	  );
   554	}
   555	
   556	async function fileExists(path) {
   557	  try {
   558	    await access(path);
   559	    return true;
   560	  } catch (err) {
   561	    // Only "does not exist" maps to false. Anything else (EACCES, etc.) is a real
   562	    // fault and must not be misreported as "file does not exist".
   563	    if (err.code === 'ENOENT') return false;
   564	    throw err;
   565	  }
