   991	    /// F3：per-run（或无 run 归属时按 session）单调递增 seq——供所有 mapper 调用的
   992	    /// `nextSeq` 闭包共享同一份 actor 隔离状态。
   993	    private func nextSeq(runID: String?, sessionID: String) -> Int {
   994	        if let runID = runID {
   995	            let next = (seqByRunID[runID] ?? 0) + 1
   996	            seqByRunID[runID] = next
   997	            return next
   998	        }
   999	        let next = (seqFallbackBySessionID[sessionID] ?? 0) + 1
  1000	        seqFallbackBySessionID[sessionID] = next
  1001	        return next
  1002	    }
