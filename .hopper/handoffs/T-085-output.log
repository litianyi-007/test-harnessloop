  1004	    /// M5（收 T-045 codex 确认性再审 MUST-FIX）：一个 session 的全部派生缓存——per-run
  1005	    /// seq/toolCallId/usage、M1 approval 双向缓冲区（含从未配对成功的孤儿条目）、pendingStop、
  1006	    /// session 锁、F8 terminal 去重标记——统一在这里清干净。`finishEventContinuation`（stop()/
  1007	    /// 正常 subscribe 流结束）和 `handleTransportClosed`（transport 异常）两条路径都必须调用同一份
  1008	    /// 清理，不能像上一轮那样只清一半（前者只清了 per-run 缓存，后者干脆什么都不清；approval 缓存
  1009	    /// 更是只有 join 成功时才删除，pending-first 漏配对的条目会永久残留）。
  1010	    private func clearSessionDerivedCaches(sessionID: String) {
  1011	        for runID in runIDsBySessionID[sessionID] ?? [] {
  1012	            seqByRunID.removeValue(forKey: runID)
  1013	            lastToolCallIDByRunID.removeValue(forKey: runID)
  1014	            lastUsageByRunID.removeValue(forKey: runID)
  1015	        }
  1016	        runIDsBySessionID.removeValue(forKey: sessionID)
  1017	        lastRunIDBySessionID.removeValue(forKey: sessionID)
  1018	        seqFallbackBySessionID.removeValue(forKey: sessionID)
  1019	
  1020	        for approvalID in approvalIDsBySessionID[sessionID] ?? [] {
  1021	            agentApprovalInfoByApprovalID.removeValue(forKey: approvalID)
  1022	            pendingSessionApprovalByApprovalID.removeValue(forKey: approvalID)
  1023	        }
  1024	        approvalIDsBySessionID.removeValue(forKey: sessionID)
  1025	
  1026	        // M3：session 结束时同样清掉"已产出、仍在 pending 等待决策"的审批表——不清理的话，一个从未被
  1027	        // stop() 强制处理过的孤儿 reqId（例如 session 走 shutdown/transportClosed 终结，而不是走
  1028	        // stop()）会永久残留在 pendingApprovalsByReqID 里。
  1029	        for reqID in pendingApprovalReqIDsBySessionID[sessionID] ?? [] {
  1030	            pendingApprovalsByReqID.removeValue(forKey: reqID)
  1031	        }
  1032	        pendingApprovalReqIDsBySessionID.removeValue(forKey: sessionID)
  1033	
  1034	        // NOTE-1 防御性兜底：任何调用路径都不应该在 pendingStop 仍有存活 waiter 时直接
  1035	        // removeValue——那样等待中的 stop() 永远等不到 resume（T-047 复现的真挂起 bug）。正常情况下
  1036	        // 这里已经是 nil（transport 关闭路径已经由 handleTransportClosed ->
  1037	        // resolvePendingStopForTransportClose 提前 resolve 过，且那条路径还会带上 operation_completed
  1038	        // 镜像）；这几行只是最后一道防线——没有 continuation 引用发不出镜像，但至少唤醒等待者，绝不
  1039	        // 留永久挂起。
  1040	        if let danglingWaiter = pendingStops[sessionID]?.waiter {
  1041	            pendingStops[sessionID]?.waiter = nil
  1042	            pendingStops[sessionID]?.terminalEmitted = true
  1043	            danglingWaiter.resume(returning: .transportClosed)
  1044	        }
  1045	        pendingStops.removeValue(forKey: sessionID)
  1046	        lockStateBySessionID.removeValue(forKey: sessionID)
  1047	        sessionTerminalEmitted.remove(sessionID)
  1048	
  1049	        // rounds/0012 ②：session 结束时同样清掉订阅 dispatch 屏障的残留状态——正常情况下
  1050	        // `subscriptionDispatchPending` 此刻已经不含这个 sessionID（订阅 RPC 早就 dispatch 过了），
  1051	        // 这里只是最后一道防线：若 session 在订阅 RPC 尚未 dispatch 完就被 transport 关闭等路径提前
  1052	        // 终结，任何仍在 `awaitSubscriptionRpcDispatchIfPending` 里挂起的 send()/stop() 调用会被
  1053	        // 唤醒（而不是永久挂起）——它们醒来后走到自己的 kernelKey 查找会独立发现 session 已经不在，
  1054	        // 如实报错，不会假装成功。
  1055	        subscriptionDispatchPending.remove(sessionID)
  1056	        if let waiters = subscriptionDispatchWaiters.removeValue(forKey: sessionID) {
  1057	            for waiter in waiters { waiter.resume() }
  1058	        }
  1059	    }
