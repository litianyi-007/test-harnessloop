   493	    /// D1 §2.3 subscribe。
   494	    ///
   495	    /// **rounds/0012 ② 二次返工（推翻上一版"subscribe() 自己等 ack"的修法）**：上一版把这个方法改成
   496	    /// 内联 `await` `sessions.messages.subscribe` RPC、等它真正落地（或失败）才 `return stream`——
   497	    /// 这个方向被证明是错的，两条独立理由：
   498	    ///
   499	    /// 1. **违反 D1**：`KernelClient.swift` 协议签名的文档注释明文写着——"D1 的 TS 签名里 subscribe
   500	    ///    本身不是 Promise（`subscribe(session): AsyncStream<KernelEvent>`）……语义上仍然等价于
   501	    ///    『拿到一个事件流』……不因为这一处签名调整而改变 D1 的行为语义"。等 ack 才 return，就是把
   502	    ///    "拿到一个事件流"变成了"拿到一个已确认的事件流"，行为语义变了。
   503	    /// 2. **打穿 CI**：`app/contracts/d2/fixtures/swift-runner/SwiftFixtureRunner.swift`
   504	    ///    的 `performClientCall` 对 `subscribe` 是**直接 `await client.subscribe(session:)`**（不像
   505	    ///    `send`/`stop` 那样包一层背景 `Task`，见该文件 `case "subscribe":` 与其上方注释——原文
   506	    ///    "真实 subscribe() 同步（在第一次 await 之前）就把 eventContinuations[sessionID] 建好、
   507	    ///    立即返回事件流……若 fixture 没提供 mock_response，gate 永远悬挂也不影响后续任何事件
   508	    ///    观察"）。`subscribe()` 一旦自己先悬挂住等 ack，整条 fixture 时间线推进不下去——本轮开工前
   509	    ///    实测过一次（`swiftc` 编出当时的错误方向实现、跑 CI 同款命令）：进程直接悬挂不退出，比
   510	    ///    此前报告的"4/8/1"更差。
   511	    ///
   512	    /// **本轮改回原形态**：本地事件续体仍然同步注册（`eventContinuations[ourSessionID] =
   513	    /// continuation`，在任何 `await` 之前），真正发 `sessions.messages.subscribe` RPC 的逻辑仍然
   514	    /// 包在一个**不等待的背景 `Task`** 里，`subscribe()` 本身几乎立即返回——D1 契约、CI 兼容性都
   515	    /// 恢复原状。
   516	    ///
   517	    /// **但订阅竞态本身不是假问题**——`evidence/item2-subscribe-race.md`「返工结论」一节已经用
   518	    /// openclaw 服务端源码判定坐实：`sessions.messages.subscribe` 与 `sessions.send` 的 handler 在
   519	    /// 服务端 `void runWithDiagnosticTraceContext(...)`（fire-and-forget）下并发处理，谁先抵达
   520	    /// `dispatch` 无序化保证。这次改为**换个位置**收口——在 `send()`/`stop()` 开头设一道屏障，而不是
   521	    /// 卡在 `subscribe()` 自己身上。`subscribe()` 这边只新增两行配合：进入本方法同步前缀时调用
   522	    /// `beginTrackingSubscriptionDispatch`（登记"这个 session 有一个尚未 dispatch 的订阅 RPC"），
   523	    /// 背景 `Task` 里真正调用 `request(method:"sessions.messages.subscribe",...)` **之前**调用
   524	    /// `markSubscriptionRpcDispatched`（登记完成、唤醒等待中的 `send()`/`stop()`）。完整设计取舍
   525	    /// （尤其是"为什么只等『RPC 已 dispatch』、不等『RPC 已 ack』"，以及这个折衷放弃了什么）记在
   526	    /// `send()` 的文档注释里，不在这里重复。
   527	    ///
   528	    /// **协议签名不带 `throws`**（见 `KernelClient.swift`：`func subscribe(session:) async ->
   529	    /// AsyncThrowingStream<...>`，scope-lock 明文禁止改这 7 个方法签名）——因此订阅 RPC 失败（RPC
   530	    /// 本身抛错，或响应体里 `subscribed:false`）**不能**让本方法向调用方抛错，只能塞进已经交给调用
   531	    /// 方的这个 `AsyncThrowingStream`：`continuation.finish(throwing:)` 让它在第一次
   532	    /// `for try await` 迭代时就抛出同一个错误。调用方现有的错误路径
   533	    /// （`SessionStore.consumeEvents` 的 `session.streamError = describeError(error)` ->
   534	    /// `SessionDetailView` 的红色横幅）原样覆盖这种情况，不需要新的错误通道。这一段行为原样保留自
   535	    /// SG-4/SG-5，未受本轮任何一版改动影响。
   536	    ///
   537	    /// 本地事件续体（`eventContinuations[ourSessionID]`）**仍然在 RPC 之前、同步完成**——这一点没
   538	    /// 变（`evidence/item2-subscribe-race.md` §1b 已实测坐实 `AsyncThrowingStream` 默认
   539	    /// `.unbounded` 缓冲，先注册好续体，之后到达的帧不会因为消费者还没开始 `for try await` 而丢）。
   540	    public func subscribe(session: SessionHandle) async -> AsyncThrowingStream<EventMessageUnion, Error> {
   541	        let ourSessionID = session.sessionID
   542	        let (stream, continuation) = AsyncThrowingStream<EventMessageUnion, Error>.makeStream()
   543	        eventContinuations[ourSessionID] = continuation
   544	        beginTrackingSubscriptionDispatch(sessionID: ourSessionID)
   545	
   546	        Task {
   547	            guard let kernelKey = await self.kernelKey(for: ourSessionID) else {
   548	                // 这条 RPC 根本不会被发起——照样标记 dispatch，否则等待中的 send()/stop() 会永久
   549	                // 卡住（它们自己紧随其后的 kernelKey 查找也会独立失败，这里只是不让它们死在屏障上）。
   550	                await self.markSubscriptionRpcDispatched(sessionID: ourSessionID)
   551	                continuation.finish(throwing: KernelClientError.protocolMismatch("unknown session \(ourSessionID)"))
   552	                return
   553	            }
   554	            if let delayNanoseconds = await self.subscribeDispatchDelayNanosecondsForTesting() {
   555	                // Test-only（见 `testSupportSetSubscribeDispatchDelay` 文档注释）——生产路径这里
   556	                // 恒为 nil，下面这行不会被执行到。
   557	                try? await Task.sleep(nanoseconds: delayNanoseconds)
   558	            }
   559	            await self.markSubscriptionRpcDispatched(sessionID: ourSessionID)
   560	            do {
   561	                // includeApprovals:true——不带这个 flag 收不到 session.approval 事件
   562	                // （`SessionsMessagesSubscribeParamsSchema` 的 `includeApprovals` 是 opt-in，默认不
   563	                // 推送），approvalRequest 映射的现场 grounding 全部建立在这个 flag 打开的前提上。
   564	                let result = try await self.request(
   565	                    method: "sessions.messages.subscribe",
   566	                    params: ["key": kernelKey, "includeApprovals": true]
   567	                )
   568	                prettyPrint("RECV sessions.messages.subscribe result", result)
   569	                if let subscribed = result["subscribed"] as? Bool, !subscribed {
   570	                    continuation.finish(throwing: KernelClientError.protocolMismatch("subscribe returned subscribed:false"))
   571	                } else {
   572	                    // M1：消费 subscribe 响应里的 `approvalReplay`（authoritative 的当前 pending
   573	                    // 审批快照，见下方 consumeApprovalReplay 文档注释）。
   574	                    await self.consumeApprovalReplay(result, kernelKey: kernelKey)
   575	                }
   576	            } catch {
   577	                continuation.finish(throwing: error)
   578	            }
   579	        }
   580	
   581	        return stream
   582	    }
   583	
   584	    public func interrupt(session: SessionHandle, options: InterruptRequestMessagePayload) async throws -> InterruptResultPayload {
   585	        throw KernelClientError.notImplemented("interrupt() 本轮 TODO 桩——L1 闭环没有 active run 需要 interrupt")
   586	    }
   587	
   588	    /// D1 §2.5 stop()。**M3 rework（收 T-045 codex 确认性再审 MUST-FIX，在 F6 基础上第二次收残）**：
   589	    /// F6 只解决了"operationId 不共享"和"delete 前不等终态"两个问题，但重写本身引入/遗留了三类新
   590	    /// 缺陷（codex 独立复现）：
   591	    ///   ① `abortedRunId==nil`（无 active run）与"等待超时"两条路径只让 Promise 知道结果，从不给
   592	    ///      `subscribe()` 事件流补一条 `operation_completed` 镜像——只订阅事件流、不等 Promise 的
   593	    ///      观察者完全看不到这次 stop 操作本身的终态。
   594	    ///   ② active-run 路径把"这次 stop 操作成功与否"和"sessions.delete 这一步资源回收是否成功"
   595	    ///      两件事混为一谈：`handleAgentEvent` 在 delete **之前**就已经用 `succeeded` 发出了
   596	    ///      operation_completed（这个时机是对的，D1 §9.3 要求先有终态再有 session_end），但 Promise
   597	    ///      的 outcome 却在 delete **之后**重新按 `deleted` 布尔值计算——如果 delete 恰好返回
   598	    ///      `deleted:false`，Promise 报 `.rejected`，与已经发出的 Event `.succeeded` 直接矛盾。
   599	    ///      修法：outcome 只由"等没等到终态确认"（timedOut）决定，不再看 `deleted`——delete 是这次
   600	    ///      stop 操作的收尾资源回收步骤，和"abort 本身有没有成功"是两件事，不应该互相污染判定，这样
   601	    ///      Promise 和已经发出的 Event 天然保持一致（因为它们不再有两个独立的信息来源）。
   602	    ///   ③ `sessions.abort`/`sessions.delete` 抛错时整个函数直接向上抛出，`stopInProgress` 锁、
   603	    ///      `pendingStops` 条目都不会被释放——真实复现：第一次 stop() 因传输错误抛出后，锁永久卡在
   604	    ///      `stop_in_progress`，第二次 stop() 会被误判成"另一个 stop 正在进行"而拒绝
   605	    ///      （`session_locked`），即使第一次调用早就已经失败结束。修法：`do/catch` 包裹两次 RPC，
   606	    ///      catch 里统一释放锁 + 清理 pendingStop + 发一条 `operation_completed(outcome:.rejected)`
   607	    ///      镜像，然后把原始错误重新抛给调用方（stop() 这次调用确实失败了，调用方需要知道）。
   608	    ///
   609	    /// `PendingStop.affectedRunID` 在 abort 之后立刻用 `abortResult.abortedRunId`（权威值）覆盖——
   610	    /// 不能一直沿用发起 abort 前的本地缓存 `lastRunIDBySessionID`，那个值可能陈旧，会让
   610	    /// 不能一直沿用发起 abort 前的本地缓存 `lastRunIDBySessionID`，那个值可能陈旧，会让
   611	    /// `handleAgentEvent` 里 `pendingForRun.affectedRunID == runID` 的相等判断永远不成立、白等到
   612	    /// 超时（codex 复现的具体机制）。
   613	    ///
   614	    /// **rounds/0012 ② 复用 send() 的订阅 dispatch 屏障**：函数体第一行同样
   615	    /// `await awaitSubscriptionRpcDispatchIfPending(...)`——完整设计取舍见 `send()` 文档注释，这里
   616	    /// 只记为什么 `stop()` 也要等：`stop()` 会在有 active run 时产出 `turn_complete(cancelled)` 等
   617	    /// 事件（见下方 `waitForPendingStopTerminal`），这些事件同样要经过已建立的订阅才能被调用方观察
   618	    /// 到，与 `send()` 面对的是同一类"订阅是否已经登记"的风险，理应共享同一道屏障。`interrupt()`/
   619	    /// `respondApproval()` 仍是 TODO 桩、函数体第一行就 `throw .notImplemented`，从不触达任何 RPC，
   620	    /// 没有屏障可加、也不需要加。
   621	    public func stop(session: SessionHandle) async throws -> StopResultPayload {
   622	        await awaitSubscriptionRpcDispatchIfPending(sessionID: session.sessionID)
   623	        guard let kernelKey = kernelKeyBySessionID[session.sessionID] else {
   624	            throw KernelClientError.protocolMismatch("unknown session \(session.sessionID)")
   625	        }
   626	
   627	        let currentLock = lockStateBySessionID[session.sessionID] ?? .idle
   628	        guard currentLock == .idle else {
   629	            throw KernelClientError.rpcRejected(
   630	                code: "session_locked",
   631	                message: "stop() rejected: session \(session.sessionID) lock state is \(currentLock), expected idle (D1 v3.1 §9.3)"
   632	            )
   633	        }
   634	        lockStateBySessionID[session.sessionID] = .stopInProgress
   635	
   636	        let operationID = "op-stop-\(UUID().uuidString)"
   637	        let affectedRunIDBeforeAbort = lastRunIDBySessionID[session.sessionID]
   638	        pendingStops[session.sessionID] = PendingStop(operationID: operationID, affectedRunID: affectedRunIDBeforeAbort)
   639	
   640	        do {
   641	            // D1 §6.2 M3（强制定序，rework）：取消当前 run 之前，若该 session 名下存在 pending
   642	            // 审批，必须先把它们强制 deny 掉、确认内核已接受，才能发起 sessions.abort——见
   643	            // `forceDenyPendingApprovalsBeforeStop` 文档注释。这一步必须在 `sessions.abort` 之前
   644	            // 完成，且失败时（RPC 抛错/内核未确认 denied）不能继续往下发 abort——直接落进下面的
   645	            // catch 统一收尾（锁释放+pendingStop 清理+operation_completed(rejected) 镜像），不能
   646	            // 假装"反正等会儿再看"。
   647	            let forceResolvedApprovalReqIDs = try await forceDenyPendingApprovalsBeforeStop(sessionID: session.sessionID)
   648	            pendingStops[session.sessionID]?.forceResolvedApprovalReqIDs = forceResolvedApprovalReqIDs
   649	
   650	            let abortResult = try await request(method: "sessions.abort", params: ["key": kernelKey])
   651	            prettyPrint("RECV sessions.abort result", abortResult)
   652	
   653	            // D1 v3 §9.3："stop() 调用时存在 active run，适配器必须先完成该 run 的强制取消并产出
   654	            // TurnCompleteEvent(cancelled)...确认该事件已经进入 subscribe() 流之后，才能产出
   655	            // SessionEndEvent(reason:'stopped')"。有界等待（不是无限悬挂），交由 handleAgentEvent 在
   656	            // 观察到对应 aborted lifecycle 帧时唤醒；超时则诚实继续（不让调用方永久悬挂），并把
   657	            // outcome 记成 .timedOut。
   658	            //
   659	            // **是否需要等待，由 `sessions.abort` 自己的返回值判断，不是本地缓存的 `affectedRunID`**
   660	            // ——现场实测（scratchpad/openclaw-iso3 隔离环境）坐实：`lastRunIDBySessionID` 只在收到
   661	            // 新 run 时刷新，一个 run 正常 turnComplete 之后这个缓存不会被清空；如果 stop() 在该 run
   662	            // 早已自然结束之后才被调用，`sessions.abort` 会诚实回报 `{"abortedRunId":null,
   663	            // "status":"no-active-run"}`——这种情况下压根不会有任何 aborted lifecycle 帧到达。改为
   664	            // 直接读 `abortResult.abortedRunId`——非空才说明这次 abort 真的中止了一个活跃 run，才需要
   665	            // 等待其终态；为 nil 就没有等待的意义。
   666	            let actuallyAbortedRunID = abortResult["abortedRunId"] as? String
   667	            var timedOut = false
   668	            if let actuallyAbortedRunID = actuallyAbortedRunID {
   669	                // M3：用权威值覆盖，不再信任 abort 前的本地缓存（见函数文档注释）。
   670	                pendingStops[session.sessionID]?.affectedRunID = actuallyAbortedRunID
   671	                let timeoutSeconds = testSupportStopTimeoutSecondsOverride ?? 5
   672	                let waitOutcome = await waitForPendingStopTerminal(sessionID: session.sessionID, timeoutSeconds: timeoutSeconds)
   673	                switch waitOutcome {
   674	                case .transportClosed:
   675	                    // NOTE-1（T-047 grok 复核，真挂起 bug 修复）：等待过程中 transport 已经关闭——
   676	                    // `resolvePendingStopForTransportClose`（见 `handleTransportClosed`）已经代发
   677	                    // `operation_completed(aborted_effect_unknown)` 镜像、标记 `terminalEmitted`，
   678	                    // 且 `clearSessionDerivedCaches` 已经清理了包括本函数 `stopInProgress` 锁在内的
   679	                    // 全部派生状态。这里绝不能假装 succeeded/timed_out 继续往下走——`sessions.delete`
   680	                    // 在 transport 已断的情况下多半也会失败，即使侥幸命中测试桩"成功"了，也会跟已经
   681	                    // 发出的镜像终态矛盾（M3 修的正是 Promise/Event 矛盾这类问题）。如实抛错，交给
   682	                    // 下面的 catch 统一收尾——此时 pendingStop/lock 已经是空的，catch 里的清理调用
   683	                    // 都是安全的 no-op。
   684	                    throw KernelClientError.transport("stop() aborted: transport closed while waiting for aborted-run terminal confirmation")
   685	                case .timedOut:
   686	                    // M3：等待超时也必须给事件流补一条 operation_completed 镜像——上一轮只有 Promise
   687	                    // 知道超时了，只订阅事件流的观察者永远看不到这个 run 的终态。
   688	                    emitOperationCompletedMirror(
   689	                        sessionID: session.sessionID, operationID: operationID,
   690	                        affectedRunID: actuallyAbortedRunID, outcome: .timedOut
   691	                    )
   692	                    // NOTE-2：超时路径也要标记 terminalEmitted——否则迟到的 aborted lifecycle 帧仍
   693	                    // 可能在 clearSessionDerivedCaches 清缓存前，被 handleAgentEvent 的
   694	                    // `!pendingForRun.terminalEmitted` 判断当成"还没发过 terminal"又发一组。
   695	                    pendingStops[session.sessionID]?.terminalEmitted = true
   696	                    timedOut = true
   697	                case .terminalObserved:
   698	                    timedOut = false
   699	                }
   700	            } else {
   701	                // M3：这次 stop() 生效时该 run 早已自然结束（sessions.abort 诚实回报
   702	                // abortedRunId:null）——没有可等待的终态，但 Promise 即将报 succeeded，必须同时给
   703	                // 事件流补一条 operation_completed 镜像（上一轮这条路径只发 session_end，事件流
   704	                // 观察者完全看不到这次 stop 操作本身的终态）。
   705	                pendingStops.removeValue(forKey: session.sessionID)
   706	                emitOperationCompletedMirror(
   707	                    sessionID: session.sessionID, operationID: operationID,
   708	                    affectedRunID: nil, outcome: .succeeded
   709	                )
   710	            }
   711	
   712	            let deleteResult = try await request(method: "sessions.delete", params: ["key": kernelKey])
   713	            prettyPrint("RECV sessions.delete result", deleteResult)
   714	            let deleted = (deleteResult["deleted"] as? Bool) ?? false
   715	            if !deleted {
   716	                // 诚实记录：delete 未确认成功，但不据此把已经发出/即将返回的 succeeded 倒转成
   717	                // rejected——delete 是会话资源回收的收尾步骤，和"这次 stop 操作本身有没有成功中止
   718	                // run"是两件事，不应该互相污染判定（M3 修的正是这个矛盾）。
   719	                prettyPrint("WARN sessions.delete reported deleted:false after stop() otherwise succeeded", deleteResult)
   720	            }
   721	
   722	            emitStopSessionEndAndFinish(session: session)
   723	
   724	            // D1 §2.5：stop() 可达的 outcome 子集是 succeeded/timed_out/rejected 三态——本函数只有
   725	            // 走到这里（两次 RPC 都没有抛错）才可能是 succeeded/timed_out，`.rejected` 专属于下面
   726	            // catch 分支代表的"RPC 本身失败"。
   727	            let outcome: StopResultPayloadOutcome = timedOut ? .timedOut : .succeeded
   728	            return StopResultPayload(operationID: operationID, outcome: outcome)
   729	        } catch {
   730	            // M3：sessions.abort/sessions.delete 抛错——释放锁 + 清理 pendingStop + 发一条
   731	            // operation_completed(outcome:.rejected) 镜像，再把原始错误重新抛出。不清理这三样状态
   732	            // 会让该 session 永久卡在 stop_in_progress（复现：第一次 stop 抛错后锁不释放，第二次
   733	            // stop 被 session_locked 拒绝，即使第一次调用早已结束）。
   734	            //
   735	            // NOTE-1 订正（写 NOTE-1 回归测试时坐实的竞态）：只有当"这次 stop() 还没有为任何其它
   736	            // 路径发过终态镜像"时才在这里补发 rejected——否则会跟已经发出的镜像互相矛盾。两个具体
   737	            // 场景都会走到这里却已经发过别的镜像：① NOTE-1 的 transport-closed 路径
   738	            // （resolvePendingStopForTransportClose 已经标记 terminalEmitted=true 并发出
   739	            // aborted_effect_unknown，stop() 随后如实 throw，落进这个 catch）；②"无 active
   740	            // run"分支已经移除 pendingStop 并发出 succeeded，之后 sessions.delete 才抛错。两种情况
   741	            // 都不该再补一条 rejected——那会让同一次 stop() 在事件流里出现两条互相打架的终态。
   742	            let alreadyTerminalEmitted = pendingStops[session.sessionID]?.terminalEmitted ?? true
   743	            let affectedRunID = pendingStops[session.sessionID]?.affectedRunID ?? affectedRunIDBeforeAbort
   744	            if !alreadyTerminalEmitted {
   745	                emitOperationCompletedMirror(
   746	                    sessionID: session.sessionID, operationID: operationID,
   747	                    affectedRunID: affectedRunID, outcome: .rejected
   748	                )
   749	            }
   750	            pendingStops.removeValue(forKey: session.sessionID)
   751	            lockStateBySessionID.removeValue(forKey: session.sessionID)
   752	            throw error
   753	        }
   754	    }
   755	
   756	    /// D1 §6.2 M3 + §6.3（stop-path 强制 deny，本轮新增）：在 `stop()` 发起 `sessions.abort` 之前，把
   757	    /// 该 session 当前所有仍处于 pending 的审批（由 `emitApprovalRequestIfPossible` 登记进
   758	    /// `pendingApprovalsByReqID`）逐个强制 deny。
   759	    ///
   760	    /// **openclaw wire grounding（只读参考，未改该文件）**：
   761	    /// `kernels/openclaw/src/gateway/server-methods/approval.ts` 的 `"approval.resolve"` handler——
   762	    /// 这是 openclaw 统一的、kind-agnostic 的审批解决 RPC（`packages/sdk/src/client.ts:943`
   763	    /// `ApprovalsNamespace.respond` 走的也是这一条，只是 SDK 包了一层 `exec.approval.resolve` 别名）。
   764	    /// params schema（`packages/gateway-protocol/src/schema/approvals.ts:245`
   765	    /// `ApprovalResolveParamsSchema`）：`{id, kind, decision}`；成功响应体
   766	    /// （`ApprovalResolveResultSchema`）：`{applied: Bool, approval: {status, ...}}`。**"确认①的
   767	    /// deny 已生效（内核侧确认接受，而非仅适配器本地标记）"由这次 RPC 的 `await` 本身构成**：`await
   768	    /// request(...)` 只有等到 openclaw 真正处理完这条 `approval.resolve` 请求、回一个 `ok:true` 的
   769	    /// 响应帧之后才会返回；`ok:false`（`handleIncoming` 的 "res" 分支）会被 `request()` 转成
   770	    /// `KernelClientError.rpcRejected` 抛出——这里不吞掉这个错误，调用方（`stop()`）会因此中止、
   771	    /// 落进它自己的 catch 分支统一收尾，绝不会在没有真正拿到内核确认的情况下继续往下发
   772	    /// `sessions.abort`（那正是 M3 定序要防止的竞态：deny 还没被内核接受，abort 已经发出去了）。
   773	    /// 拿到 `ok:true` 响应后，本函数还要求 `approval.status == "denied"`——只有这个字段真的是
   774	    /// "denied" 才算数，见下方 guard。
   775	    ///
   776	    /// `approval.resolve` 对 `id` 的路由（`record.kind === "exec" ? execApprovalManager : ...`，见
   777	    /// `approval.ts:492-518`）本身按**服务端已持久化的 record.kind** 选择 manager，不依赖客户端传的
   778	    /// `kind` 字段是否精确匹配——传错 `kind` 只会让服务端把这次决议记成
   779	    /// `reason:"malformed-verdict"`（`applyForcedDeny`）而不是 `"user"`，两者都会落地成
   780	    /// `status:"denied"`。本函数仍然传本地缓存的真实 `openclawKind`（见
   781	    /// `emitApprovalRequestIfPossible`）——如实转发协议要求的字段，不是"反正传错也能过就随便填"。
   782	    ///
   783	    /// 返回值是这一批被强制终态化的 reqId 列表，供调用方（`stop()`）塞进该 run
   784	    /// `TurnCompleteEvent.forceResolvedApprovals`（D1 §6.2 M3："步骤①的强制终态化须同步在该 run 的
   785	    /// `TurnCompleteEvent.forceResolvedApprovals` 中列出"）。没有任何 pending 审批时直接返回空数组、
   786	    /// **不发起任何 RPC**——绝大多数 stop() 调用都会走这条空路径，这也是为什么这个函数不会打破既有的
   787	    /// 26 个 frame-replay 测试（它们都没有 stub `approval.resolve`，真打了这条 RPC 会因为没有测试桩、
   788	    /// 也没有真实连接而 `throw KernelClientError.notConnected`）。
   789	    ///
   790	    /// **NOTE-A（T-049 grok 对抗审复核，本轮修复）drain-loop rework**：上一轮只对 pending reqId 取
   791	    /// **一次快照**再逐个 await deny——若某个 approval 在这 N 个 `approval.resolve` RPC 往返组成的
   792	    /// await 窗口内新到（`emitApprovalRequestIfPossible` 在 actor 重入期间登记进
   793	    /// `pendingApprovalReqIDsBySessionID`），会逃过本轮快照、仍处于 pending 就被随后的
   794	    /// `sessions.abort` 甩下——这正是 D1 §6.2 力保的 exactly-once 想避免的"cancel 已生效、审批还
   795	    /// pending、内核对即将消失的 run 又异步接受一个人工决策"的变体。
   796	    ///
   797	    /// **选型：drain-loop（而非 freeze 登记 + deny late arrival）**。两个方向都能关闭这个窗口，选
   798	    /// drain-loop 的理由：
   799	    /// - **正确性等价，改动面更小**：freeze 方向要求 `emitApprovalRequestIfPossible`（当前是
   800	    ///   `handleAgentEvent`/`handleSessionApprovalEvent`/`consumeApprovalReplay` 这几个纯同步 wire
   801	    ///   dispatch 方法内部的同步调用）在 `stopInProgress` 期间对新到的 approval 立即发一次
   802	    ///   `await request("approval.resolve", ...)`——但这几个 dispatch 方法本身是从 `handleIncoming`
   803	    ///   同步调用的（`receiveLoop` 的热路径），要嵌入一次真正的 RPC await 就必须让它们要么整体变成
   804	    ///   `async`（连锁改动 `handleIncoming`/`receiveLoop` 的调用形状），要么用 `Task { await ... }`
   805	    ///   fire-and-forget——而后者恰好**重新引入同一类竞态**：`stop()` 完全不知道这个 detached Task
   806	    ///   有没有跑完 deny 就已经继续发 `sessions.abort` 了，为了堵住这个新洞，还是得让 `stop()` 在
   807	    ///   abort 前等所有"在途 late-deny"收尾——这就是把 drain-loop 拆成两个协作的地方重新实现一遍，
   808	    ///   状态更分散、更难论证，C# 那边还要多一层"锁外调度 detached 任务"的心智负担。
   809	    /// - **有界性论证**（D1 §9：一个 session 同一时刻只有一个 active run；`stop()` 进入
   810	    ///   `stopInProgress` 早于本函数被调用，`send()` 在锁不是 `idle` 时一律 reject——因此这个 session
   811	    ///   在整段 drain 期间**不会有新 run 被创建**）：drain 期间还能继续冒出新 pending 审批的唯一来源
   812	    ///   是"这次 stop() 即将 abort 的、唯一的那个 run"自己的 agent 事件流仍在正常产出（`sessions.abort`
   813	    ///   要等 drain 完全收敛成空之后才发出，所以这个 run 在 drain 期间确实还活着、还能请求审批）——
