  1539	            approvalIDsBySessionID[ourSessionID, default: []].insert(approvalID)
  1540	            prettyPrint("RECV session.approval(phase:pending)（agent(stream:approval) 尚未到达，缓冲等待补发）", frame)
  1541	        }
  1542	    }
