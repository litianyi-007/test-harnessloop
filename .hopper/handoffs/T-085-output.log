  1750	/// actor 调度细节、不适合作断言对象，见 `send()` 文档注释与这两个测试自己的说明）。
  1751	actor DispatchFlag {
  1752	    private(set) var dispatched = false
  1753	    func markDispatched() { dispatched = true }
