   170	    /// 调用 `markSubscriptionRpcDispatched` 的信号，就是制造一个永久挂起——D1 §2.2 send() 本身并不
   171	    /// 要求先 subscribe，任务书明确点名的 fixture 场景"只 createSession + send、不 subscribe"必须
   172	    /// 立即可用）。
   173	    private func awaitSubscriptionRpcDispatchIfPending(sessionID: String) async {
   174	        guard subscriptionDispatchPending.contains(sessionID) else { return }
   175	        await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
   176	            subscriptionDispatchWaiters[sessionID, default: []].append(continuation)
   177	        }
   178	    }
