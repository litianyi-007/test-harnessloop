  1514	    /// `handleAgentEvent` 的 "approval" 分支补发。
  1515	    private func handleSessionApprovalEvent(_ frame: JSONObject) {
  1516	        guard let payload = frame["payload"] as? JSONObject,
  1517	              let kernelKey = payload["sessionKey"] as? String,
  1518	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
  1519	            return
  1520	        }
  1521	        guard eventContinuations[ourSessionID] != nil else { return }
  1522	
  1523	        guard jsonString(payload["phase"]) == "pending" else {
  1524	            // terminal 分支：D1 11 变体没有它的对应位置（见 EventMapping.swift 文档注释），如实跳过。
