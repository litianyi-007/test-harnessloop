  1067	    // MARK: - 内部：RPC 请求/响应关联
  1068	
  1069	    private func request(method: String, params: JSONObject) async throws -> JSONObject {
  1070	        if let responder = testSupportRPCResponders[method] {
  1071	            prettyPrint("SEND req \(method) (test-stubbed, no real transport)", ["method": method, "params": params])
  1072	            return try await responder(params)
  1073	        }
  1074	        guard let task = task else { throw KernelClientError.notConnected }
  1075	        nextReqID += 1
  1076	        let id = "r\(nextReqID)"
  1077	        let frame: JSONObject = ["type": "req", "id": id, "method": method, "params": params]
  1078	        prettyPrint("SEND req \(method)", frame)
  1079	        let data = try encodeFrame(frame)
  1080	
  1081	        return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<JSONObject, Error>) in
  1082	            self.pending[id] = continuation
  1083	            task.send(.data(data)) { error in
  1084	                if let error = error {
  1085	                    Task { await self.failPending(id: id, error: KernelClientError.transport(error.localizedDescription)) }
  1086	                }
  1087	            }
  1088	        }
  1089	    }
  1090	
  1091	    private func failPending(id: String, error: Error) {
  1092	        if let continuation = pending.removeValue(forKey: id) {
  1093	            continuation.resume(throwing: error)
  1094	        }
  1095	    }
  1096	
  1097	    private func waitForNextEvent(named eventName: String) async throws -> JSONObject {
  1098	        try await withCheckedThrowingContinuation { continuation in
  1099	            self.oneShotEventWaiters[eventName] = continuation
  1100	        }
  1470	                    )
  1471	                    for event in events {
  1472	                        continuation.yield(event)
  1473	                        wireTraceCollector?.append(event)
  1474	                    }
  1475	                    lastUsageByRunID.removeValue(forKey: runID)
  1476	                }
  1477	                // else：已经为这次 stop() 发过 terminal——如实丢弃这条收尾帧，不重复产出。
  1478	            } else {
  1479	                // M3：极罕见竞态——force-deny 已经生效、sessions.abort 尚未真正让这个 run 落地
  1480	                // aborted 状态之前，run 自己先自然完成（这条 lifecycle 帧走的是 aborted:false 分支）。
  1481	                // 即便如此，仍要把已经强制 deny 掉的 reqId 挂到这条 TurnCompleteEvent 上——不能因为
  1482	                // 走的是"正常结束"分支就丢失这个信息（D1 §6.2 M3 只要求"该 run 的 TurnCompleteEvent"
  1483	                // 带上 forceResolvedApprovals，没有区分它是从 aborted 分支还是正常分支产出的）。
  1484	                let forceResolvedApprovals: [String]? = {
  1485	                    guard let pendingForRun = pendingStops[ourSessionID], pendingForRun.affectedRunID == runID,
  1486	                          !pendingForRun.forceResolvedApprovalReqIDs.isEmpty else { return nil }
  1487	                    return pendingForRun.forceResolvedApprovalReqIDs
  1488	                }()
  1489	                let event = mapOpenclawAgentLifecycleToTurnComplete(
  1490	                    data, ourSessionID: ourSessionID, runID: runID, originTS: originTS,
  1491	                    cachedUsage: lastUsageByRunID[runID], forceResolvedApprovals: forceResolvedApprovals,
  1492	                    nextSeq: nextSeqForRun
  1493	                )
  1494	                continuation.yield(event)
  1495	                wireTraceCollector?.append(event)
  1496	                lastUsageByRunID.removeValue(forKey: runID)
  1497	            }
  1498	
  1499	        default:
  1500	            // run_status/usage/assistant/plan/compaction 等：openclaw 自有 UI 进度信号，D1 11 变体
  1501	            // 没有对应位置，如实不映射。
  1502	            break
  1503	        }
  1504	    }
