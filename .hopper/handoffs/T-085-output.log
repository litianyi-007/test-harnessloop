  1061	    private func finishEventContinuation(sessionID: String) {
  1062	        eventContinuations[sessionID]?.finish()
  1063	        eventContinuations.removeValue(forKey: sessionID)
  1064	        clearSessionDerivedCaches(sessionID: sessionID)
  1065	    }
