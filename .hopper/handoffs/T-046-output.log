   375	    ///      Promise 和已经发出的 Event 天然保持一致（因为它们不再有两个独立的信息来源）。
   376	    ///   ③ `sessions.abort`/`sessions.delete` 抛错时整个函数直接向上抛出，`stopInProgress` 锁、
   377	    ///      `pendingStops` 条目都不会被释放——真实复现：第一次 stop() 因传输错误抛出后，锁永久卡在
   378	    ///      `stop_in_progress`，第二次 stop() 会被误判成"另一个 stop 正在进行"而拒绝
   379	    ///      （`session_locked`），即使第一次调用早就已经失败结束。修法：`do/catch` 包裹两次 RPC，
   380	    ///      catch 里统一释放锁 + 清理 pendingStop + 发一条 `operation_completed(outcome:.rejected)`
   381	    ///      镜像，然后把原始错误重新抛给调用方（stop() 这次调用确实失败了，调用方需要知道）。
   382	    ///
   383	    /// `PendingStop.affectedRunID` 在 abort 之后立刻用 `abortResult.abortedRunId`（权威值）覆盖——
   384	    /// 不能一直沿用发起 abort 前的本地缓存 `lastRunIDBySessionID`，那个值可能陈旧，会让
   385	    /// `handleAgentEvent` 里 `pendingForRun.affectedRunID == runID` 的相等判断永远不成立、白等到
   386	    /// 超时（codex 复现的具体机制）。
   387	    public func stop(session: SessionHandle) async throws -> StopResultPayload {
   388	        guard let kernelKey = kernelKeyBySessionID[session.sessionID] else {
   389	            throw KernelClientError.protocolMismatch("unknown session \(session.sessionID)")
   390	        }
   391	
   392	        let currentLock = lockStateBySessionID[session.sessionID] ?? .idle
   393	        guard currentLock == .idle else {
   394	            throw KernelClientError.rpcRejected(
   395	                code: "session_locked",
   396	                message: "stop() rejected: session \(session.sessionID) lock state is \(currentLock), expected idle (D1 v3.1 §9.3)"
   397	            )
   398	        }
   399	        lockStateBySessionID[session.sessionID] = .stopInProgress
   400	
   401	        let operationID = "op-stop-\(UUID().uuidString)"
   402	        let affectedRunIDBeforeAbort = lastRunIDBySessionID[session.sessionID]
   403	        pendingStops[session.sessionID] = PendingStop(operationID: operationID, affectedRunID: affectedRunIDBeforeAbort)
   404	
   405	        do {
   406	            let abortResult = try await request(method: "sessions.abort", params: ["key": kernelKey])
   407	            prettyPrint("RECV sessions.abort result", abortResult)
   408	
   409	            // D1 v3 §9.3："stop() 调用时存在 active run，适配器必须先完成该 run 的强制取消并产出
   410	            // TurnCompleteEvent(cancelled)...确认该事件已经进入 subscribe() 流之后，才能产出
   411	            // SessionEndEvent(reason:'stopped')"。有界等待（不是无限悬挂），交由 handleAgentEvent 在
   412	            // 观察到对应 aborted lifecycle 帧时唤醒；超时则诚实继续（不让调用方永久悬挂），并把
   413	            // outcome 记成 .timedOut。
   414	            //
   415	            // **是否需要等待，由 `sessions.abort` 自己的返回值判断，不是本地缓存的 `affectedRunID`**
   416	            // ——现场实测（scratchpad/openclaw-iso3 隔离环境）坐实：`lastRunIDBySessionID` 只在收到
   417	            // 新 run 时刷新，一个 run 正常 turnComplete 之后这个缓存不会被清空；如果 stop() 在该 run
   418	            // 早已自然结束之后才被调用，`sessions.abort` 会诚实回报 `{"abortedRunId":null,
   419	            // "status":"no-active-run"}`——这种情况下压根不会有任何 aborted lifecycle 帧到达。改为
   420	            // 直接读 `abortResult.abortedRunId`——非空才说明这次 abort 真的中止了一个活跃 run，才需要
   421	            // 等待其终态；为 nil 就没有等待的意义。
   422	            let actuallyAbortedRunID = abortResult["abortedRunId"] as? String
   423	            var timedOut = false
   424	            if let actuallyAbortedRunID = actuallyAbortedRunID {
   425	                // M3：用权威值覆盖，不再信任 abort 前的本地缓存（见函数文档注释）。
   426	                pendingStops[session.sessionID]?.affectedRunID = actuallyAbortedRunID
   427	                let timeoutSeconds = testSupportStopTimeoutSecondsOverride ?? 5
   428	                timedOut = await waitForPendingStopTerminal(sessionID: session.sessionID, timeoutSeconds: timeoutSeconds)
   429	                if timedOut {
   430	                    // M3：等待超时也必须给事件流补一条 operation_completed 镜像——上一轮只有 Promise
   431	                    // 知道超时了，只订阅事件流的观察者永远看不到这个 run 的终态。
   432	                    emitOperationCompletedMirror(
   433	                        sessionID: session.sessionID, operationID: operationID,
   434	                        affectedRunID: actuallyAbortedRunID, outcome: .timedOut
   435	                    )
   436	                }
   437	            } else {
   438	                // M3：这次 stop() 生效时该 run 早已自然结束（sessions.abort 诚实回报
   439	                // abortedRunId:null）——没有可等待的终态，但 Promise 即将报 succeeded，必须同时给
   440	                // 事件流补一条 operation_completed 镜像（上一轮这条路径只发 session_end，事件流
   441	                // 观察者完全看不到这次 stop 操作本身的终态）。
   442	                pendingStops.removeValue(forKey: session.sessionID)
   443	                emitOperationCompletedMirror(
   444	                    sessionID: session.sessionID, operationID: operationID,
   445	                    affectedRunID: nil, outcome: .succeeded
   446	                )
   447	            }
   448	
   449	            let deleteResult = try await request(method: "sessions.delete", params: ["key": kernelKey])
   450	            prettyPrint("RECV sessions.delete result", deleteResult)
   451	            let deleted = (deleteResult["deleted"] as? Bool) ?? false
   452	            if !deleted {
   453	                // 诚实记录：delete 未确认成功，但不据此把已经发出/即将返回的 succeeded 倒转成
   454	                // rejected——delete 是会话资源回收的收尾步骤，和"这次 stop 操作本身有没有成功中止
   455	                // run"是两件事，不应该互相污染判定（M3 修的正是这个矛盾）。
   456	                prettyPrint("WARN sessions.delete reported deleted:false after stop() otherwise succeeded", deleteResult)
   457	            }
   458	
   459	            emitStopSessionEndAndFinish(session: session)
   460	
   461	            // D1 §2.5：stop() 可达的 outcome 子集是 succeeded/timed_out/rejected 三态——本函数只有
   462	            // 走到这里（两次 RPC 都没有抛错）才可能是 succeeded/timed_out，`.rejected` 专属于下面
   463	            // catch 分支代表的"RPC 本身失败"。
   464	            let outcome: StopResultPayloadOutcome = timedOut ? .timedOut : .succeeded
   465	            return StopResultPayload(operationID: operationID, outcome: outcome)
   466	        } catch {
   467	            // M3：sessions.abort/sessions.delete 抛错——释放锁 + 清理 pendingStop + 发一条
   468	            // operation_completed(outcome:.rejected) 镜像，再把原始错误重新抛出。不清理这三样状态
   469	            // 会让该 session 永久卡在 stop_in_progress（复现：第一次 stop 抛错后锁不释放，第二次
   470	            // stop 被 session_locked 拒绝，即使第一次调用早已结束）。
   471	            let affectedRunID = pendingStops[session.sessionID]?.affectedRunID ?? affectedRunIDBeforeAbort
   472	            emitOperationCompletedMirror(
   473	                sessionID: session.sessionID, operationID: operationID,
   474	                affectedRunID: affectedRunID, outcome: .rejected
   475	            )
   476	            pendingStops.removeValue(forKey: session.sessionID)
   477	            lockStateBySessionID.removeValue(forKey: session.sessionID)
   478	            throw error
   479	        }
   480	    }
   481	
   482	    /// M3：为 stop() 不会经过 `handleAgentEvent` 真实 aborted lifecycle 帧的路径（无 active run、
   483	    /// 等待超时、RPC 抛错）补一条 `operation_completed` 镜像——D1 §9.3 要求 Promise 结果与
   484	    /// `subscribe()` 流里的 `operation_completed` 必须是同一个 `{operationId,outcome}`，不能让只
   485	    /// 订阅事件流的观察者完全看不到这次 stop 操作的终态。
   486	    private func emitOperationCompletedMirror(
   487	        sessionID: String, operationID: String, affectedRunID: String?, outcome: PayloadOutcome
   488	    ) {
   489	        guard let continuation = eventContinuations[sessionID] else { return }
   490	        let opPayload = OperationCompletedEventMessagePayload(
   491	            affectedRunID: affectedRunID, detail: nil, newRunID: nil,
   492	            operationID: operationID, operationKind: .stop, outcome: outcome
   493	        )
   494	        continuation.yield(.operationCompleted(OperationCompletedEventMessage(
   495	            direction: .event, payload: opPayload, runID: affectedRunID,
   496	            sentAt: Date(), seq: nextSeq(runID: affectedRunID, sessionID: sessionID),
   497	            sessionID: sessionID, ts: Date(), type: .evtOperationCompleted
   498	        )))
   499	    }
   500	
   501	    /// stop() 成功路径的收尾：F8 `sessionTerminalEmitted` 去重 + yield `session_end(stopped)` +
   502	    /// finish 事件流（`finishEventContinuation` 内部的 `clearSessionDerivedCaches` 已经覆盖 M5
   503	    /// 要求的全部派生缓存清理，这里只再额外清 `kernelKeyBySessionID`——那张表不是"派生缓存"，是
   504	    /// session 本身是否还存在的权威映射，不属于 `clearSessionDerivedCaches` 的职责范围）。
   505	    private func emitStopSessionEndAndFinish(session: SessionHandle) {
   506	        if !sessionTerminalEmitted.contains(session.sessionID) {
   507	            sessionTerminalEmitted.insert(session.sessionID)
   508	            if let continuation = eventContinuations[session.sessionID] {
   509	                let sid = session.sessionID
   510	                continuation.yield(makeSessionEndEventForStop(
   511	                    ourSessionID: sid,
   512	                    nextSeq: { self.nextSeq(runID: nil, sessionID: sid) }
   513	                ))
   514	            }
   515	        }
   516	        finishEventContinuation(sessionID: session.sessionID)
   517	        kernelKeyBySessionID.removeValue(forKey: session.sessionID)
   518	    }
   519	
   520	    /// 等待 `pendingStops[sessionID]` 对应的 run 终态（operation_completed + turn_complete）已被
   521	    /// `handleAgentEvent` 观察并 yield——由该处理器调用 `resolvePendingStopWaiter(timedOut:false)`
   522	    /// 唤醒；超时（`timeoutSeconds`）则由本函数内部起的定时器调用 `resolvePendingStopWaiter
   523	    /// (timedOut:true)` 唤醒。`resolvePendingStopWaiter` 内部先取出并清空 waiter 再 resume，保证
   524	    /// 无论两条路径谁先到，`CheckedContinuation` 都只会被 resume 恰好一次。
   525	    private func waitForPendingStopTerminal(sessionID: String, timeoutSeconds: Int) async -> Bool {
   526	        guard let pending = pendingStops[sessionID], !pending.terminalEmitted else { return false }
   527	        return await withCheckedContinuation { (continuation: CheckedContinuation<Bool, Never>) in
   528	            self.pendingStops[sessionID]?.waiter = continuation
   529	            Task {
   530	                try? await Task.sleep(nanoseconds: UInt64(timeoutSeconds) * 1_000_000_000)
   531	                await self.resolvePendingStopWaiter(sessionID: sessionID, timedOut: true)
   532	            }
   533	        }
   534	    }
   535	
   536	    private func resolvePendingStopWaiter(sessionID: String, timedOut: Bool) {
   537	        guard let waiter = pendingStops[sessionID]?.waiter else { return }
   538	        pendingStops[sessionID]?.waiter = nil
   539	        waiter.resume(returning: timedOut)
   540	    }
   540	    }
