   147	
   148	        private static readonly HashSet<string> UnambiguousSensitiveSingulars = new(StringComparer.Ordinal)
   149	        {
   150	            "auth", "authorization", "secret", "password", "credential",
   151	        };
   152	
   153	        private static readonly HashSet<string> TokenCountingQualifiers = new(StringComparer.Ordinal)
   154	        {
   155	            "context", "input", "output", "total", "max", "budget", "count", "limit", "usage", "remaining",
   156	        };
   157	
   158	        /// <summary>
   159	        /// 把一个 camelCase/snake_case/kebab-case 的 key 拆成小写单词列表——`"contextTokens"` ->
   160	        /// `["context","tokens"]`，`"authToken"` -> `["auth","token"]`，`"api_key"` -> `["api","key"]`。
   161	        /// </summary>
   162	        private static List<string> LowercasedWords(string key)
   163	        {
   164	            var words = new List<string>();
   165	            var current = new StringBuilder();
   166	            foreach (var ch in key)
   167	            {
   168	                if (ch == '_' || ch == '-')
   169	                {
   170	                    if (current.Length > 0) { words.Add(current.ToString()); current.Clear(); }
   171	                    continue;
   172	                }
   173	                if (char.IsUpper(ch) && current.Length > 0)
   174	                {
   175	                    words.Add(current.ToString());
   176	                    current.Clear();
   177	                    current.Append(char.ToLowerInvariant(ch));
   178	                }
   179	                else
   180	                {
   181	                    current.Append(char.ToLowerInvariant(ch));
   182	                }
   183	            }
   184	            if (current.Length > 0) words.Add(current.ToString());
   185	            return words;
   186	        }
