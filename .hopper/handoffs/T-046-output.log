   192	        // MARK: - ③ agent(stream:"lifecycle") -> turnComplete / operationCompleted
   193	
   194	        public static EventMessageUnion MapOpenclawAgentLifecycleToTurnComplete(
   195	            JSONObject data, string ourSessionId, string runId, DateTimeOffset originTs,
   196	            (long Input, long Output)? cachedUsage, Func<long> nextSeq)
   197	        {
   198	            var phase = OpenclawWire.JsonString(data.Get("phase"));
   199	            var rawStopReason = OpenclawWire.JsonString(data.Get("stopReason"));
   200	            StopReason stopReason;
   201	            if (phase == "error")
   202	            {
   203	                // M2：phase 本身就是 assistant 错误终止的权威信号——不看 stopReason 字段。
   204	                stopReason = StopReason.Error;
   205	            }
   206	            else
   207	            {
   208	                stopReason = rawStopReason switch
   209	                {
   210	                    "max_turns" or "maxTurns" => StopReason.MaxTurns,
   211	                    _ => StopReason.Completed,
   212	                };
   213	            }
   214	            Usage? usage = cachedUsage.HasValue
   215	                ? new Usage { InputTokens = cachedUsage.Value.Input, OutputTokens = cachedUsage.Value.Output }
   216	                : null;
   217	            var turnPayload = new TurnCompleteEventMessagePayload { Degraded = null, ForceResolvedApprovals = null, StopReason = stopReason, Usage = usage };
   218	            return new TurnCompleteEventMessage
   219	            {
   220	                Direction = MessageDeltaEventMessageDirection.Event, Payload = turnPayload, RunId = runId,
   221	                SentAt = DateTimeOffset.UtcNow, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = TurnCompleteEventMessageType.EvtTurnComplete,
   222	            }.AsUnion();
   223	        }
