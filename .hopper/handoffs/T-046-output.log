   584	        // MARK: - 内部：RPC 请求/响应关联
   585	
   586	        private async Task<JSONObject> RequestAsync(string method, JSONObject parameters)
   587	        {
   588	            Func<JSONObject, Task<JSONObject>>? responder;
   589	            lock (_sync) { _testSupportRpcResponders.TryGetValue(method, out responder); }
   590	            if (responder != null)
   591	            {
   592	                OpenclawWire.PrettyPrint($"SEND req {method} (test-stubbed, no real transport)", new JSONObject { ["method"] = method, ["params"] = parameters });
   593	                return await responder(parameters);
   594	            }
   595	
   596	            var socket = _socket ?? throw new KernelClientException(KernelClientErrorKind.NotConnected, "");
   597	
   598	            string id;
   599	            lock (_sync) { _nextReqId += 1; id = $"r{_nextReqId}"; }
   600	
   601	            var frame = new JSONObject { ["type"] = "req", ["id"] = id, ["method"] = method, ["params"] = parameters };
   602	            OpenclawWire.PrettyPrint($"SEND req {method}", frame);
   603	            var data = OpenclawWire.EncodeFrame(frame);
   604	
   605	            var tcs = new TaskCompletionSource<JSONObject>(TaskCreationOptions.RunContinuationsAsynchronously);
   606	            lock (_sync) { _pending[id] = tcs; }
   607	
   608	            try
   609	            {
   610	                await socket.SendAsync(new ArraySegment<byte>(data), WebSocketMessageType.Text, true, CancellationToken.None);
   611	            }
   612	            catch (Exception ex)
   613	            {
   614	                FailPending(id, new KernelClientException(KernelClientErrorKind.Transport, ex.Message));
   615	            }
   616	
   617	            return await tcs.Task;
   618	        }
   619	
   620	        private void FailPending(string id, Exception error)
   621	        {
   622	            TaskCompletionSource<JSONObject>? tcs;
   623	            lock (_sync) { _pending.Remove(id, out tcs); }
   624	            tcs?.TrySetException(error);
   625	        }
   626	
   627	        private Task<JSONObject> WaitForNextEventAsync(string eventName)
   628	        {
   629	            var tcs = new TaskCompletionSource<JSONObject>(TaskCreationOptions.RunContinuationsAsynchronously);
   630	            lock (_sync) { _oneShotEventWaiters[eventName] = tcs; }
   631	            return tcs.Task;
   632	        }
   633	
   634	        // MARK: - 内部：接收循环
   635	
   636	        private async Task ReceiveLoopAsync()
   637	        {
   638	            var socket = _socket;
   639	            if (socket == null) return;
   640	            var buffer = new byte[16 * 1024];
   641	            while (!_receiveLoopCts.IsCancellationRequested)
   642	            {
   643	                try
   644	                {
   645	                    using var ms = new System.IO.MemoryStream();
   646	                    WebSocketReceiveResult result;
   647	                    do
   648	                    {
   649	                        result = await socket.ReceiveAsync(new ArraySegment<byte>(buffer), _receiveLoopCts.Token);
   650	                        if (result.MessageType == WebSocketMessageType.Close)
   651	                            throw new KernelClientException(KernelClientErrorKind.Transport, "websocket closed by remote");
   652	                        ms.Write(buffer, 0, result.Count);
   653	                    } while (!result.EndOfMessage);
   654	                    HandleIncoming(ms.ToArray());
   655	                }
   656	                catch (OperationCanceledException)
   657	                {
   658	                    break;
   659	                }
   660	                catch (Exception ex)
   661	                {
   662	                    HandleTransportClosed(ex as KernelClientException ?? new KernelClientException(KernelClientErrorKind.Transport, ex.Message));
   663	                    break;
   664	                }
   665	            }
   666	        }
   667	
   668	        /// <summary>
   669	        /// 传输中断（真实 WS 断开，或 TestSupportSimulateTransportClosed 模拟）的统一处理。
   670	        /// </summary>
   671	        private void HandleTransportClosed(Exception error)
   672	        {
   673	            List<string> sessionIds;
   674	            lock (_sync) { sessionIds = _eventChannels.Keys.ToList(); }
   675	            foreach (var sessionId in sessionIds)
   676	            {
   677	                bool already;
   678	                lock (_sync)
   679	                {
   680	                    already = _sessionTerminalEmitted.Contains(sessionId);
   681	                    if (!already) _sessionTerminalEmitted.Add(sessionId);
   682	                }
   683	                if (already) continue;
   684	                Yield(sessionId, EventMapping.MakeSessionEndEventForTransportClosed(sessionId, () => NextSeq(null, sessionId)));
   685	            }
   686	            FailAllPending(error);
   687	        }
   688	
   689	        private void FailAllPending(Exception error)
   690	        {
   691	            List<TaskCompletionSource<JSONObject>> pendingList;
   692	            List<TaskCompletionSource<JSONObject>> waiterList;
   693	            List<KeyValuePair<string, Channel<EventMessageUnion>>> channels;
   694	            lock (_sync)
   695	            {
   696	                pendingList = _pending.Values.ToList();
   697	                _pending.Clear();
   698	                waiterList = _oneShotEventWaiters.Values.ToList();
   699	                _oneShotEventWaiters.Clear();
   700	                channels = _eventChannels.ToList();
   701	                _eventChannels.Clear();
   702	            }
   703	            foreach (var tcs in pendingList) tcs.TrySetException(error);
   704	            foreach (var tcs in waiterList) tcs.TrySetException(error);
   705	            // M5：transport 异常路径也要清理全部派生缓存，跟 finishEventContinuation 共享同一份。
   706	            foreach (var kv in channels)
   707	            {
   708	                kv.Value.Writer.TryComplete(error);
   709	                ClearSessionDerivedCaches(kv.Key);
   710	            }
   711	        }
   712	
   713	        private void HandleIncoming(byte[] data)
   714	        {
   715	            JSONObject frame;
   716	            try { frame = OpenclawWire.DecodeFrame(data); }
   717	            catch { return; }
   718	
   719	            var type = OpenclawWire.JsonString(frame.Get("type"));
   720	            if (type == null) return;
   721	
   722	            switch (type)
   723	            {
   724	                case "res":
   725	                {
   726	                    var id = OpenclawWire.JsonString(frame.Get("id"));
   727	                    if (id == null) return;
   728	                    TaskCompletionSource<JSONObject>? tcs;
   729	                    lock (_sync) { _pending.Remove(id, out tcs); }
   730	                    if (tcs == null) return;
   731	                    var ok = OpenclawWire.JsonBool(frame.Get("ok")) ?? false;
   732	                    if (ok)
   733	                    {
   734	                        var payload = OpenclawWire.JsonObj(frame.Get("payload")) ?? new JSONObject();
   735	                        tcs.TrySetResult(payload);
   736	                    }
   737	                    else
   738	                    {
   739	                        var err = OpenclawWire.JsonObj(frame.Get("error")) ?? new JSONObject();
   740	                        var code = OpenclawWire.JsonString(err.Get("code")) ?? "unknown";
   741	                        var message = OpenclawWire.JsonString(err.Get("message"));
   742	                        tcs.TrySetException(new KernelClientException(KernelClientErrorKind.RpcRejected, message ?? "", code));
   743	                    }
   744	                    break;
   745	                }
   746	
   747	                case "event":
   748	                {
   749	                    var eventName = OpenclawWire.JsonString(frame.Get("event"));
   750	                    if (eventName == null) return;
   751	                    TaskCompletionSource<JSONObject>? waiter;
   752	                    lock (_sync) { _oneShotEventWaiters.Remove(eventName, out waiter); }
   753	                    if (waiter != null)
   754	                    {
   755	                        var payload = OpenclawWire.JsonObj(frame.Get("payload")) ?? new JSONObject();
   756	                        waiter.TrySetResult(payload);
   757	                        break;
   758	                    }
   759	                    switch (eventName)
   760	                    {
   761	                        case "session.message": HandleSessionMessageEvent(frame); break;
   762	                        case "agent": HandleAgentEvent(frame); break;
   763	                        case "session.approval": HandleSessionApprovalEvent(frame); break;
   764	                        case "shutdown": HandleShutdownEvent(frame); break;
   765	                        default:
   766	                            OpenclawWire.PrettyPrint($"RECV event {eventName} (未处理的旁路事件，原样打印)", frame);
   767	                            break;
   768	                    }
   769	                    break;
   770	                }
   771	            }
   772	        }
   773	
   774	        private void HandleSessionMessageEvent(JSONObject frame)
   775	        {
   776	            var payload = OpenclawWire.JsonObj(frame.Get("payload"));
   777	            if (payload == null) return;
   778	            var kernelKey = OpenclawWire.JsonString(payload.Get("sessionKey"));
   779	            if (kernelKey == null) return;
   780	            var ourSessionId = OurSessionIdForKernelKey(kernelKey);
   781	            if (ourSessionId == null) return;
   782	            bool hasChannel;
   783	            lock (_sync) { hasChannel = _eventChannels.ContainsKey(ourSessionId); }
   784	            if (!hasChannel) return;
   785	
   786	            string? currentRunId;
   787	            lock (_sync) { _lastRunIdBySessionId.TryGetValue(ourSessionId, out currentRunId); }
   788	
   789	            var sessionSnapshot = OpenclawWire.JsonObj(payload.Get("session"));
   790	            if (sessionSnapshot != null &&
   791	                OpenclawWire.JsonArr(sessionSnapshot.Get("activeRunIds")) is List<object?> activeRunIds &&
   792	                activeRunIds.Count > 0 && activeRunIds[0] is string firstRunId)
   793	            {
   794	                lock (_sync)
   795	                {
   796	                    _lastRunIdBySessionId[ourSessionId] = firstRunId;
   797	                    if (!_runIdsBySessionId.TryGetValue(ourSessionId, out var set)) _runIdsBySessionId[ourSessionId] = set = new HashSet<string>();
   798	                    set.Add(firstRunId);
   799	                }
   800	                currentRunId = firstRunId;
   801	            }
   802	
   803	            var message = OpenclawWire.JsonObj(payload.Get("message"));
   804	            if (message != null && OpenclawWire.JsonObj(message.Get("usage")) is JSONObject usage &&
   805	                OpenclawWire.JsonInt(usage.Get("input")) is long usageInput && OpenclawWire.JsonInt(usage.Get("output")) is long usageOutput &&
   806	                currentRunId is string usageRunId)
   807	            {
   808	                lock (_sync) { _lastUsageByRunId[usageRunId] = (usageInput, usageOutput); }
   809	            }
   810	
   811	            var runIdHint = currentRunId;
   812	            var sid = ourSessionId;
   813	            var events = EventMapping.MapOpenclawSessionMessageToKernelEvents(
   814	                payload, ourSessionId, runIdHint, () => NextSeq(runIdHint, sid));
   815	
   816	            if (events.Count == 0)
   817	            {
   818	                OpenclawWire.PrettyPrint("RECV session.message（未能映射到 D2 KernelEvent 11 变体之一）", frame);
   819	                return;
   820	            }
   821	            foreach (var evt in events)
   822	            {
   823	                if (evt is ToolCallEventMessageCase toolCall && runIdHint != null)
   824	                {
   825	                    lock (_sync) { _lastToolCallIdByRunId[runIdHint] = toolCall.Value.Payload.ToolCallId; }
   826	                }
   827	                Yield(ourSessionId, evt);
   828	            }
   829	        }
   830	
   831	        private void HandleAgentEvent(JSONObject frame)
   832	        {
   833	            var payload = OpenclawWire.JsonObj(frame.Get("payload"));
   834	            if (payload == null) return;
   835	            var kernelKey = OpenclawWire.JsonString(payload.Get("sessionKey"));
   836	            if (kernelKey == null) return;
   837	            var ourSessionId = OurSessionIdForKernelKey(kernelKey);
   838	            if (ourSessionId == null) return;
   839	            bool hasChannel;
   840	            lock (_sync) { hasChannel = _eventChannels.ContainsKey(ourSessionId); }
   841	            if (!hasChannel) return;
   842	
   843	            if (OpenclawWire.JsonString(payload.Get("runId")) is string runIdFromFrame)
   844	            {
   845	                lock (_sync)
   846	                {
   847	                    _lastRunIdBySessionId[ourSessionId] = runIdFromFrame;
   848	                    if (!_runIdsBySessionId.TryGetValue(ourSessionId, out var set)) _runIdsBySessionId[ourSessionId] = set = new HashSet<string>();
   849	                    set.Add(runIdFromFrame);
   850	                }
   851	            }
   852	
   853	            var stream = OpenclawWire.JsonString(payload.Get("stream"));
   854	            var data = OpenclawWire.JsonObj(payload.Get("data"));
   855	            if (stream == null || data == null) return;
   856	
   857	            string? runIdHint;
   858	            lock (_sync) { _lastRunIdBySessionId.TryGetValue(ourSessionId, out runIdHint); }
   859	            var originTs = OpenclawWire.MsEpochToDate(OpenclawWire.JsonInt(payload.Get("ts")));
   860	            long NextSeqForRun() => NextSeq(runIdHint, ourSessionId);
   861	
   862	            switch (stream)
   863	            {
   864	                case "command_output":
   865	                {
   866	                    var evt = EventMapping.MapOpenclawAgentCommandOutputToToolResult(data, ourSessionId, runIdHint, originTs, NextSeqForRun);
   867	                    if (evt != null) Yield(ourSessionId, evt);
   868	                    break;
   869	                }
   870	
   871	                case "item":
   872	                {
   873	                    if (OpenclawWire.JsonString(data.Get("kind")) != "tool") break;
   874	                    if (EventMapping.IsOpenclawExecToolName(OpenclawWire.JsonString(data.Get("name")))) break;
   875	                    var evt = EventMapping.MapOpenclawAgentToolItemToToolResult(data, ourSessionId, runIdHint, originTs, NextSeqForRun);
   876	                    if (evt != null) Yield(ourSessionId, evt);
   877	                    break;
   878	                }
   879	
   880	                case "thinking":
   881	                {
   882	                    var evt = EventMapping.MapOpenclawAgentThinkingToKernelEvent(data, ourSessionId, runIdHint, originTs, NextSeqForRun);
   883	                    if (evt != null) Yield(ourSessionId, evt);
   884	                    break;
   885	                }
   886	
   887	                case "error":
   888	                {
   889	                    var evt = EventMapping.MapOpenclawAgentErrorToKernelEvent(data, ourSessionId, runIdHint, originTs, NextSeqForRun);
   890	                    if (evt != null) Yield(ourSessionId, evt);
   891	                    break;
   892	                }
   893	
   894	                case "approval":
   895	                {
   896	                    // F4/M1：这条 agent 帧本身不直接产出 D2 事件——真正的 approval_request 仍由
   897	                    // session.approval(phase:pending) 产出，这里只是给它提供不会串号的
   898	                    // {runId,toolCallId} 来源。
   899	                    if (OpenclawWire.JsonString(data.Get("phase")) == "requested" &&
   900	                        OpenclawWire.JsonString(data.Get("approvalId")) is string approvalId &&
   901	                        OpenclawWire.JsonString(data.Get("toolCallId")) is string toolCallId &&
   902	                        runIdHint is string approvalRunId)
   903	                    {
   904	                        PendingSessionApproval? buffered;
   905	                        lock (_sync)
   906	                        {
   907	                            if (!_approvalIdsBySessionId.TryGetValue(ourSessionId, out var set)) _approvalIdsBySessionId[ourSessionId] = set = new HashSet<string>();
   908	                            set.Add(approvalId);
   909	                            _pendingSessionApprovalByApprovalId.Remove(approvalId, out buffered);
   910	                        }
   911	                        if (buffered != null)
   912	                        {
   913	                            EmitApprovalRequestIfPossible(buffered.Payload, buffered.OurSessionId, approvalRunId, toolCallId);
   914	                            lock (_sync) { if (_approvalIdsBySessionId.TryGetValue(ourSessionId, out var set2)) set2.Remove(approvalId); }
   915	                        }
   916	                        else
   917	                        {
   918	                            lock (_sync) { _agentApprovalInfoByApprovalId[approvalId] = new AgentApprovalInfo(approvalRunId, toolCallId); }
   919	                        }
   920	                    }
   921	                    break;
   922	                }
   923	
   924	                case "lifecycle":
   925	                {
   926	                    var phase = OpenclawWire.JsonString(data.Get("phase"));
   927	                    if (phase != "end" && phase != "error") break;
   928	                    if (runIdHint == null) break;
   929	                    var runId = runIdHint;
   930	                    var aborted = OpenclawWire.JsonBool(data.Get("aborted")) ?? false;
   931	
   932	                    (long Input, long Output)? cachedUsage = null;
   933	                    lock (_sync) { if (_lastUsageByRunId.TryGetValue(runId, out var u)) cachedUsage = u; }
   934	
   935	                    if (aborted)
   936	                    {
   937	                        PendingStop? pendingForRun = null;
   938	                        bool noOwner = false;
   939	                        lock (_sync)
   940	                        {
   941	                            if (_pendingStops.TryGetValue(ourSessionId, out var p))
   942	                            {
   943	                                if (p.AffectedRunId == runId && !p.TerminalEmitted) pendingForRun = p;
   944	                            }
   945	                            else
   946	                            {
   947	                                noOwner = true;
   948	                            }
   949	                        }
   950	
   951	                        if (pendingForRun != null)
   952	                        {
   953	                            // F6：单个 operation_completed + turn_complete(cancelled)，用 stop() 铸造的
   954	                            // 唯一 operationId，且对同一次 pendingStop 只做一次。
   955	                            var events = EventMapping.MapOpenclawAgentLifecycleToAbortTerminalEvents(
   956	                                data, ourSessionId, runId, pendingForRun.OperationId, originTs, cachedUsage, NextSeqForRun);
   957	                            foreach (var e in events) Yield(ourSessionId, e);
   958	                            lock (_sync) { pendingForRun.TerminalEmitted = true; _lastUsageByRunId.Remove(runId); }
   959	                            ResolvePendingStopWaiter(ourSessionId, timedOut: false);
   960	                        }
   961	                        else if (noOwner)
   962	                        {
   963	                            // 理论上不会出现——interrupt() 本轮未实现。防御性兜底：自己派生一个
   964	                            // operationId，保持"至少不丢事件"的行为。
   965	                            var fallbackOperationId = $"{ourSessionId}-abort-{runId}-unowned";
   966	                            var events = EventMapping.MapOpenclawAgentLifecycleToAbortTerminalEvents(
   967	                                data, ourSessionId, runId, fallbackOperationId, originTs, cachedUsage, NextSeqForRun);
   968	                            foreach (var e in events) Yield(ourSessionId, e);
   969	                            lock (_sync) { _lastUsageByRunId.Remove(runId); }
   970	                        }
   971	                        // else：已经为这次 stop() 发过 terminal——如实丢弃这条收尾帧，不重复产出。
   972	                    }
   973	                    else
   974	                    {
   975	                        var evt = EventMapping.MapOpenclawAgentLifecycleToTurnComplete(data, ourSessionId, runId, originTs, cachedUsage, NextSeqForRun);
   976	                        Yield(ourSessionId, evt);
   977	                        lock (_sync) { _lastUsageByRunId.Remove(runId); }
   978	                    }
   979	                    break;
   980	                }
   981	            }
   982	        }
   983	
   984	        private void HandleSessionApprovalEvent(JSONObject frame)
   985	        {
   986	            var payload = OpenclawWire.JsonObj(frame.Get("payload"));
   987	            if (payload == null) return;
   988	            var kernelKey = OpenclawWire.JsonString(payload.Get("sessionKey"));
   989	            if (kernelKey == null) return;
   990	            var ourSessionId = OurSessionIdForKernelKey(kernelKey);
   991	            if (ourSessionId == null) return;
   992	            bool hasChannel;
   993	            lock (_sync) { hasChannel = _eventChannels.ContainsKey(ourSessionId); }
   994	            if (!hasChannel) return;
   995	
   996	            if (OpenclawWire.JsonString(payload.Get("phase")) != "pending")
   997	            {
   998	                OpenclawWire.PrettyPrint("RECV session.approval（phase:terminal，D1 11 变体无对应，跳过）", frame);
   999	                return;
  1000	            }
  1001	            var approval = OpenclawWire.JsonObj(payload.Get("approval"));
  1002	            var approvalId = approval != null ? OpenclawWire.JsonString(approval.Get("id")) : null;
  1003	            if (approvalId == null) return;
  1004	
  1005	            AgentApprovalInfo? agentInfo;
  1006	            lock (_sync) { _agentApprovalInfoByApprovalId.Remove(approvalId, out agentInfo); }
  1007	
  1008	            if (agentInfo != null)
  1009	            {
  1010	                lock (_sync) { if (_approvalIdsBySessionId.TryGetValue(ourSessionId, out var set)) set.Remove(approvalId); }
  1011	                EmitApprovalRequestIfPossible(payload, ourSessionId, agentInfo.RunId, agentInfo.ToolCallId);
  1012	            }
  1013	            else
  1014	            {
  1015	                lock (_sync)
  1016	                {
  1017	                    _pendingSessionApprovalByApprovalId[approvalId] = new PendingSessionApproval(payload, ourSessionId);
  1018	                    if (!_approvalIdsBySessionId.TryGetValue(ourSessionId, out var set)) _approvalIdsBySessionId[ourSessionId] = set = new HashSet<string>();
  1019	                    set.Add(approvalId);
  1020	                }
  1021	                OpenclawWire.PrettyPrint("RECV session.approval(phase:pending)（agent(stream:approval) 尚未到达，缓冲等待补发）", frame);
  1022	            }
  1023	        }
  1024	
  1025	        private void EmitApprovalRequestIfPossible(JSONObject payload, string ourSessionId, string runId, string toolCallId)
  1026	        {
  1027	            bool hasChannel;
  1028	            lock (_sync) { hasChannel = _eventChannels.ContainsKey(ourSessionId); }
  1029	            if (!hasChannel) return;
