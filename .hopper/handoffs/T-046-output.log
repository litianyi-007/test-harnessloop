    62	        /// <summary>同上，但驱动真实 Subscribe() 返回的 IAsyncEnumerable（不是 TestSupportRegisterSession 的 channel）。</summary>
    63	        private static async Task<List<EventMessageUnion>> CollectUpToAsync(
    64	            IAsyncEnumerable<EventMessageUnion> stream, int maxCount, int timeoutMs = 300)
    65	        {
    66	            var events = new List<EventMessageUnion>();
    67	            using var cts = new CancellationTokenSource(TimeSpan.FromMilliseconds(timeoutMs));
    68	            await using var enumerator = stream.GetAsyncEnumerator(cts.Token);
    69	            for (int i = 0; i < maxCount; i++)
    70	            {
    71	                try
    72	                {
    73	                    if (!await enumerator.MoveNextAsync()) break;
    74	                    events.Add(enumerator.Current);
    75	                }
    76	                catch
    77	                {
    78	                    break;
    79	                }
    80	            }
    81	            return events;
    82	        }
