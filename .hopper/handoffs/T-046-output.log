   602	    // MARK: - 内部：RPC 请求/响应关联
   603	
   604	    private func request(method: String, params: JSONObject) async throws -> JSONObject {
   605	        if let responder = testSupportRPCResponders[method] {
   606	            prettyPrint("SEND req \(method) (test-stubbed, no real transport)", ["method": method, "params": params])
   607	            return try await responder(params)
   608	        }
   609	        guard let task = task else { throw KernelClientError.notConnected }
   610	        nextReqID += 1
   611	        let id = "r\(nextReqID)"
   612	        let frame: JSONObject = ["type": "req", "id": id, "method": method, "params": params]
   613	        prettyPrint("SEND req \(method)", frame)
   614	        let data = try encodeFrame(frame)
   615	
   616	        return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<JSONObject, Error>) in
   617	            self.pending[id] = continuation
   618	            task.send(.data(data)) { error in
   619	                if let error = error {
   620	                    Task { await self.failPending(id: id, error: KernelClientError.transport(error.localizedDescription)) }
   621	                }
   622	            }
   623	        }
   624	    }
   625	
   626	    private func failPending(id: String, error: Error) {
   627	        if let continuation = pending.removeValue(forKey: id) {
   628	            continuation.resume(throwing: error)
   629	        }
   630	    }
   631	
   632	    private func waitForNextEvent(named eventName: String) async throws -> JSONObject {
   633	        try await withCheckedThrowingContinuation { continuation in
   634	            self.oneShotEventWaiters[eventName] = continuation
   635	        }
   636	    }
   637	
   638	    // MARK: - 内部：接收循环
   639	
   640	    private func receiveLoop() async {
   641	        guard let task = task else { return }
   642	        while !Task.isCancelled {
   643	            do {
   644	                let message = try await task.receive()
   645	                switch message {
   646	                case .data(let data):
   647	                    handleIncoming(data)
   648	                case .string(let text):
   649	                    if let data = text.data(using: .utf8) {
   650	                        handleIncoming(data)
   651	                    }
   652	                @unknown default:
   653	                    break
   654	                }
   655	            } catch {
   656	                handleTransportClosed(error: KernelClientError.transport("\(error)"))
   657	                break
   658	            }
   659	        }
   660	    }
   661	
   662	    /// 传输中断（真实 WS 断开，或 `testSupportSimulateTransportClosed` 模拟）的统一处理：先尽力给
   663	    /// 每个尚未产出过 terminal 的活跃 session 补一条 sessionEnd(reason:.transportClosed)——F8：与
   664	    /// shutdown/stop 两条路径共享 `sessionTerminalEmitted` 去重标记，不会对同一个 session 重复/
   665	    /// 矛盾地产出 sessionEnd；然后 `failAllPending` 收尾所有还在等待的 RPC/事件流。抽成独立方法只是
   666	    /// 为了让测试能直接触发这条路径（M6：真实驱动 shutdown+transport close 两条路径，不是像上一轮
   667	    /// 那样用两次同样的 shutdown 帧代替）。
   668	    private func handleTransportClosed(error: Error) {
   669	        for (ourSessionID, continuation) in eventContinuations {
   670	            guard !sessionTerminalEmitted.contains(ourSessionID) else { continue }
   671	            sessionTerminalEmitted.insert(ourSessionID)
   672	            continuation.yield(makeSessionEndEventForTransportClosed(
   673	                ourSessionID: ourSessionID,
   674	                nextSeq: { self.nextSeq(runID: nil, sessionID: ourSessionID) }
   675	            ))
   676	        }
   677	        failAllPending(error: error)
   678	    }
   679	
   680	    private func failAllPending(error: Error) {
   681	        for (_, continuation) in pending {
   682	            continuation.resume(throwing: error)
   683	        }
   684	        pending.removeAll()
   685	        for (_, waiter) in oneShotEventWaiters {
   686	            waiter.resume(throwing: error)
   687	        }
   688	        oneShotEventWaiters.removeAll()
   689	        // M5：transport 异常路径上一轮只 finish 了 continuation，从不清理per-session派生缓存
   690	        // （seq/toolCallId/usage/approval 双向缓冲/pendingStop/锁/terminal 标记）——这里改为跟
   691	        // `finishEventContinuation` 共享同一份 `clearSessionDerivedCaches`。
   692	        for (sessionID, cont) in eventContinuations {
   693	            cont.finish(throwing: error)
   694	            clearSessionDerivedCaches(sessionID: sessionID)
   695	        }
   696	        eventContinuations.removeAll()
   697	    }
   698	
   699	    private func handleIncoming(_ data: Data) {
   700	        guard let frame = try? decodeFrame(data) else { return }
   701	        guard let type = frame["type"] as? String else { return }
   702	
   703	        switch type {
   704	        case "res":
   705	            guard let id = frame["id"] as? String else { return }
   706	            guard let continuation = pending.removeValue(forKey: id) else { return }
   707	            let ok = (frame["ok"] as? Bool) ?? false
   708	            if ok {
   709	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   710	                continuation.resume(returning: payload)
   711	            } else {
   712	                let err = (frame["error"] as? JSONObject) ?? [:]
   713	                let code = (err["code"] as? String) ?? "unknown"
   714	                let message = err["message"] as? String
   715	                continuation.resume(throwing: KernelClientError.rpcRejected(code: code, message: message))
   716	            }
   717	
   718	        case "event":
   719	            guard let eventName = frame["event"] as? String else { return }
   720	            if let waiter = oneShotEventWaiters.removeValue(forKey: eventName) {
   721	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   722	                waiter.resume(returning: payload)
   723	                return
   724	            }
   725	            // session.message 之外还要分发 agent(command_output/lifecycle/thinking/error/item/
   726	            // approval)、session.approval、全局 shutdown 三类 wire 事件——D2 11 变体里除
   727	            // message_delta/tool_call 之外的大多数都不是从 session.message 来的。
   728	            switch eventName {
   729	            case "session.message":
   730	                handleSessionMessageEvent(frame)
   731	            case "agent":
   732	                handleAgentEvent(frame)
   733	            case "session.approval":
   734	                handleSessionApprovalEvent(frame)
   735	            case "shutdown":
   736	                handleShutdownEvent(frame)
   737	            default:
   738	                prettyPrint("RECV event \(eventName) (未处理的旁路事件，原样打印)", frame)
   739	            }
   740	
   741	        default:
   742	            break
   743	        }
   744	    }
   745	
   746	    /// 按 openclaw 原生 key 反查我们自己铸造的 sessionID——四个事件 handler（session.message/
   747	    /// agent/session.approval）共享同一套"payload.sessionKey -> ourSessionID -> continuation"
   748	    /// 查找逻辑，抽成一个小helper 避免重复。
   749	    private func ourSessionID(forKernelKey kernelKey: String) -> String? {
   750	        kernelKeyBySessionID.first(where: { $0.value == kernelKey })?.key
   751	    }
   752	
   753	    private func handleSessionMessageEvent(_ frame: JSONObject) {
   754	        guard let payload = frame["payload"] as? JSONObject,
   755	              let kernelKey = payload["sessionKey"] as? String,
   756	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   757	            return
   758	        }
   759	        guard let continuation = eventContinuations[ourSessionID] else { return }
   760	
   761	        // 顺带刷新 runId/usage 缓存——session.message 的 session 快照里带 activeRunIds，assistant
   762	        // 消息自己带 usage。F1：usage 缓存改为 **per-run**（用刚刷新出来的 runId 做键），不再是
   763	        // per-session，避免上一个 run 的残留 usage 串给下一个 run 的 turn_complete。
   764	        var currentRunID = lastRunIDBySessionID[ourSessionID]
   765	        if let sessionSnapshot = payload["session"] as? JSONObject,
   766	           let activeRunIDs = sessionSnapshot["activeRunIds"] as? [Any],
   767	           let firstRunID = activeRunIDs.first as? String {
   768	            lastRunIDBySessionID[ourSessionID] = firstRunID
   769	            runIDsBySessionID[ourSessionID, default: []].insert(firstRunID)
   770	            currentRunID = firstRunID
   771	        }
   772	        if let message = payload["message"] as? JSONObject, let usage = message["usage"] as? JSONObject,
   773	           let input = jsonInt(usage["input"]), let output = jsonInt(usage["output"]),
   774	           let runID = currentRunID {
   775	            lastUsageByRunID[runID] = (input: input, output: output)
   776	        }
   777	
   778	        let runIDHint = currentRunID
   779	        let sid = ourSessionID
   780	        let events = mapOpenclawSessionMessageToKernelEvents(
   781	            payload, ourSessionID: ourSessionID, runIDHint: runIDHint,
   782	            nextSeq: { self.nextSeq(runID: runIDHint, sessionID: sid) }
   783	        )
   784	        if events.isEmpty {
   785	            prettyPrint("RECV session.message（未能映射到 D2 KernelEvent 11 变体之一）", frame)
   786	            return
   787	        }
   788	        for event in events {
   789	            if case .toolCall(let toolCall) = event, let runID = runIDHint {
   790	                // F1：per-run 缓存（不是 per-session），approval 的 toolCallId 时序关联（F4 已改用
   791	                // 更权威的 agent(stream:"approval") 来源，这里保留只是为了兼容潜在的其它读者/诊断）。
   792	                lastToolCallIDByRunID[runID] = toolCall.payload.toolCallID
   793	            }
   794	            continuation.yield(event)
   795	        }
   796	    }
   797	
   798	    /// `agent` wire 事件——`payload.stream` 分好几种，本轮 dispatch：`command_output`(phase:end)、
   799	    /// `item`(kind:tool,phase:end，非 exec 工具)、`lifecycle`(phase:end/error)、`thinking`、`error`、
   800	    /// `approval`(只做 toolCallId 关联缓存，不直接产出事件，见 F4)。其余 stream（run_status/usage/
   801	    /// assistant/plan/compaction 等，均为 openclaw 自有 UI 进度信号，D1 11 变体没有对应位置）原样
   802	    /// 打印、不映射。
   803	    private func handleAgentEvent(_ frame: JSONObject) {
   804	        guard let payload = frame["payload"] as? JSONObject,
   805	              let kernelKey = payload["sessionKey"] as? String,
   806	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   807	            return
   808	        }
   809	        guard let continuation = eventContinuations[ourSessionID] else { return }
   810	
   811	        // agent 事件的 payload.runId 是本轮拿到 runIDHint 最可靠的现场来源之一（session.create
   812	        // 之后、真正 send() 之前也可能已经有别的 run 在跑），顺带刷新缓存。
   813	        if let runID = payload["runId"] as? String {
   814	            lastRunIDBySessionID[ourSessionID] = runID
   815	            runIDsBySessionID[ourSessionID, default: []].insert(runID)
   816	        }
   817	
   818	        guard let stream = payload["stream"] as? String, let data = payload["data"] as? JSONObject else {
   819	            return
   820	        }
   820	        }
   821	        let runIDHint = lastRunIDBySessionID[ourSessionID]
   822	        // F3：ts 取 `agent` wire 帧外层 payload.ts（openclaw `enrichAgentEvent` 盖章的事件发生时刻，
   823	        // `infra/agent-events.ts:628` `ts: Date.now()`），不用 Date()。
   824	        let originTS = msEpochToDate(jsonInt(payload["ts"]))
   825	        let sid = ourSessionID
   826	        let nextSeqForRun: () -> Int = { self.nextSeq(runID: runIDHint, sessionID: sid) }
   827	
   828	        switch stream {
   829	        case "command_output":
   830	            if let event = mapOpenclawAgentCommandOutputToToolResult(
   831	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   832	            ) {
   833	                continuation.yield(event)
   834	            }
   835	
   836	        case "item":
   837	            // F5：非 exec 工具的 toolResult 来源。exec 工具（"exec"/"bash"）继续只信任
   838	            // command_output（有真实 output/exitCode），这里显式排除避免同一个 toolCallId 产出两条
   839	            // 矛盾的 toolResult。
   840	            guard jsonString(data["kind"]) == "tool", !isOpenclawExecToolName(jsonString(data["name"])) else {
   841	                break
   842	            }
   843	            if let event = mapOpenclawAgentToolItemToToolResult(
   844	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   845	            ) {
   846	                continuation.yield(event)
   847	            }
   848	
   849	        case "thinking":
   850	            if let event = mapOpenclawAgentThinkingToKernelEvent(
   851	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   852	            ) {
   853	                continuation.yield(event)
   854	            }
   855	
   856	        case "error":
   857	            if let event = mapOpenclawAgentErrorToKernelEvent(
   858	                data, ourSessionID: ourSessionID, runIDHint: runIDHint, originTS: originTS, nextSeq: nextSeqForRun
   859	            ) {
   860	                continuation.yield(event)
   861	            }
   862	
   863	        case "approval":
   864	            // F4/M1：这条 agent 帧本身不直接产出 D2 事件——真正的 approval_request 仍由
   865	            // session.approval(phase:pending) 产出（它才有 timeoutMs/presentation 等完整字段），
   866	            // 这里只是给它提供不会串号的 {runId,toolCallId} 来源。
   867	            //
   868	            // M1 订正：`approvalRunID` 必须取**这一条 agent 帧自己的** `runIDHint`（上面已经用这条
   869	            // 帧自带的 `payload.runId` 刷新过 `lastRunIDBySessionID`，此刻 `runIDHint` 精确对应
   870	            // 这次审批），而不是等到 `session.approval` 落地时再去查全 session 的
   871	            // `lastRunIDBySessionID`——那时如果又有别的 run 的 approval 帧插队到达，会把这次审批
   872	            // 错误关联到"当前最新活跃的 run"（对抗审 T-045 M1 复现的具体机制）。按 approvalId 存好
   873	            // {runId,toolCallId} 之后，双向 join：
   874	            //   - 若 `session.approval(pending)` 已经先到达并缓冲（`pendingSessionApprovalByApprovalID`
   875	            //     有这个 approvalId 的条目）——现在信息齐了，立即补发 approvalRequest（上一轮这个
   876	            //     方向完全没处理，session.approval 先到时直接丢弃，approval_request 永久丢失）。
   877	            //   - 否则缓存 {runId,toolCallId}，等 `session.approval` 后到时再用。
   878	            if jsonString(data["phase"]) == "requested",
   879	               let approvalID = jsonString(data["approvalId"]),
   880	               let toolCallID = jsonString(data["toolCallId"]),
   881	               let approvalRunID = runIDHint {
   882	                approvalIDsBySessionID[ourSessionID, default: []].insert(approvalID)
   883	                if let bufferedSessionApproval = pendingSessionApprovalByApprovalID.removeValue(forKey: approvalID) {
   884	                    emitApprovalRequestIfPossible(
   885	                        payload: bufferedSessionApproval.payload, ourSessionID: bufferedSessionApproval.ourSessionID,
   886	                        runID: approvalRunID, toolCallID: toolCallID
   887	                    )
   888	                    approvalIDsBySessionID[ourSessionID]?.remove(approvalID)
   889	                } else {
   890	                    agentApprovalInfoByApprovalID[approvalID] = AgentApprovalInfo(runID: approvalRunID, toolCallID: toolCallID)
   891	                }
   892	            }
   893	
   894	        case "lifecycle":
   895	            guard let phase = jsonString(data["phase"]), phase == "end" || phase == "error" else { break }
   896	            guard let runID = runIDHint else {
   897	                // turnComplete/operationCompleted 的 runID 字段在 D2 里是必填——理论上不会缺失
   898	                // （lifecycle 事件本身携带真实 runId），真缺失时诚实跳过，不拿编造值填充。
   899	                break
   900	            }
   901	            let aborted = jsonBool(data["aborted"]) ?? false
   902	            if aborted {
   903	                if var pendingForRun = pendingStops[ourSessionID], pendingForRun.affectedRunID == runID, !pendingForRun.terminalEmitted {
   904	                    // F6：单个 operation_completed + turn_complete(cancelled)，用 stop() 铸造的
   905	                    // 唯一 operationId，且对同一次 pendingStop 只做一次（后续同 run 的收尾帧，如
   906	                    // 真实样本里 phase:"end" 之后常跟的 phase:"error","This operation was
   907	                    // aborted" 帧，被下面 else 分支丢弃）。
   908	                    let events = mapOpenclawAgentLifecycleToAbortTerminalEvents(
   909	                        data, ourSessionID: ourSessionID, runID: runID, operationID: pendingForRun.operationID,
   910	                        originTS: originTS, cachedUsage: lastUsageByRunID[runID], nextSeq: nextSeqForRun
   911	                    )
   912	                    for event in events { continuation.yield(event) }
   913	                    pendingForRun.terminalEmitted = true
   914	                    pendingStops[ourSessionID] = pendingForRun
   915	                    lastUsageByRunID.removeValue(forKey: runID)
   916	                    resolvePendingStopWaiter(sessionID: ourSessionID, timedOut: false)
   917	                } else if pendingStops[ourSessionID] == nil {
   918	                    // 理论上不会出现——interrupt() 本轮未实现，没有别的方法会产生 aborted:true 且
   919	                    // 没有对应 pendingStop 的 lifecycle 帧。防御性兜底：自己派生一个 operationId，
   920	                    // 保持"至少不丢事件"的旧行为，同时如实标注这是非预期路径。
   921	                    let fallbackOperationID = "\(ourSessionID)-abort-\(runID)-unowned"
   922	                    let events = mapOpenclawAgentLifecycleToAbortTerminalEvents(
   923	                        data, ourSessionID: ourSessionID, runID: runID, operationID: fallbackOperationID,
   924	                        originTS: originTS, cachedUsage: lastUsageByRunID[runID], nextSeq: nextSeqForRun
   925	                    )
   926	                    for event in events { continuation.yield(event) }
   927	                    lastUsageByRunID.removeValue(forKey: runID)
   928	                }
   929	                // else：已经为这次 stop() 发过 terminal——如实丢弃这条收尾帧，不重复产出。
   930	            } else {
   931	                let event = mapOpenclawAgentLifecycleToTurnComplete(
   932	                    data, ourSessionID: ourSessionID, runID: runID, originTS: originTS,
   933	                    cachedUsage: lastUsageByRunID[runID], nextSeq: nextSeqForRun
   934	                )
   935	                continuation.yield(event)
   936	                lastUsageByRunID.removeValue(forKey: runID)
   937	            }
   938	
   939	        default:
   940	            // run_status/usage/assistant/plan/compaction 等：openclaw 自有 UI 进度信号，D1 11 变体
   941	            // 没有对应位置，如实不映射。
   942	            break
   943	        }
   944	    }
   945	
   946	    /// `session.approval` wire 事件——subscribe() 已在 `sessions.messages.subscribe` 参数里带上
   947	    /// `includeApprovals:true`（见 subscribe() 实现），否则收不到这个事件。
   948	    ///
   949	    /// **M1 订正**：上一轮如果这条 `pending` 帧先于对应的 `agent(stream:"approval")` 帧到达
   950	    /// （`toolCallIDForApprovalID` 查不到），会直接 `return nil`——`approval_request` 就此永久丢失，
   951	    /// 即使 agent 帧随后真的到达也不会补发（对抗审 T-045 M1 第二个 REPRO：反向到达时
   952	    /// `eventTypes=["evt.session_end"]`，approval_request 完全缺席）。本轮改为双向缓冲 join：查不到
   953	    /// 就把整条 payload 按 approvalId 缓冲起来，等 agent 帧补上 `{runId,toolCallId}` 时由
   954	    /// `handleAgentEvent` 的 "approval" 分支补发。
   955	    private func handleSessionApprovalEvent(_ frame: JSONObject) {
   956	        guard let payload = frame["payload"] as? JSONObject,
   957	              let kernelKey = payload["sessionKey"] as? String,
   958	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   959	            return
   960	        }
   961	        guard eventContinuations[ourSessionID] != nil else { return }
   962	
   963	        guard jsonString(payload["phase"]) == "pending" else {
   964	            // terminal 分支：D1 11 变体没有它的对应位置（见 EventMapping.swift 文档注释），如实跳过。
   965	            prettyPrint("RECV session.approval（phase:terminal，D1 11 变体无对应，跳过）", frame)
   966	            return
   967	        }
   968	        guard let approvalID = (payload["approval"] as? JSONObject)?["id"] as? String else { return }
   969	
   970	        if let agentInfo = agentApprovalInfoByApprovalID.removeValue(forKey: approvalID) {
   971	            // agent(stream:"approval") 已经先到达，缓存里有准确的 {runId,toolCallId}——立即 join。
   972	            approvalIDsBySessionID[ourSessionID]?.remove(approvalID)
   973	            emitApprovalRequestIfPossible(
   974	                payload: payload, ourSessionID: ourSessionID, runID: agentInfo.runID, toolCallID: agentInfo.toolCallID
   975	            )
   976	        } else {
   977	            // M1 双向 join：agent 帧还没到——缓冲这条 session.approval，等它来补发，不再直接丢弃。
   978	            pendingSessionApprovalByApprovalID[approvalID] = PendingSessionApproval(payload: payload, ourSessionID: ourSessionID)
   979	            approvalIDsBySessionID[ourSessionID, default: []].insert(approvalID)
   980	            prettyPrint("RECV session.approval(phase:pending)（agent(stream:approval) 尚未到达，缓冲等待补发）", frame)
   981	        }
   982	    }
   983	
   984	    /// 用已经确定的 `{runID,toolCallID}`（无论是 agent 帧先到、session.approval 先到、还是
   985	    /// approvalReplay 重放）产出一条 approvalRequest 事件——三条来源路径共享这一份构造+yield 逻辑，
   986	    /// 不重新发明一遍判断。
   987	    private func emitApprovalRequestIfPossible(payload: JSONObject, ourSessionID: String, runID: String, toolCallID: String) {
   988	        guard let continuation = eventContinuations[ourSessionID] else { return }
   989	        let sid = ourSessionID
   990	        if let event = mapOpenclawSessionApprovalToKernelEvent(
   991	            payload, ourSessionID: ourSessionID, runIDHint: runID, toolCallIDForApprovalID: toolCallID,
   992	            nextSeq: { self.nextSeq(runID: runID, sessionID: sid) }
   993	        ) {
   994	            continuation.yield(event)
   995	        }
   996	    }
   997	
   998	    /// M1：消费 `sessions.messages.subscribe` 响应里的 `approvalReplay.approvals`——这是这次
   999	    /// subscribe 建立**之前**就已经处于 pending 状态的审批快照（真实场景：respondApproval 还没
  1000	    /// 落地、client 断线重连，或首次 subscribe 时错过了原始 `session.approval(pending)` 广播，只能
  1001	    /// 靠这份权威快照补齐——见 openclaw 源码
  1002	    /// `gateway/server-methods/sessions-subscriptions.ts:91-121`：`includeApprovals:true` 时
  1003	    /// subscribe 的响应本身就带上 `approvalReplay:{sessionKey,updatedAtMs,approvals,truncated}`，
  1004	    /// 每个 `approvals[]` 条目与 `session.approval(phase:"pending")` 的 `approval` 字段同构，见
  1005	    /// `packages/gateway-protocol/src/schema/approvals.ts` 的 `PendingApprovalSnapshotSchema`）。
  1006	    /// 上一轮完全没有读这个字段，这些审批永远不会出现在 D2 事件流里。逐条构造等价的
  1007	    /// `session.approval(phase:"pending")` frame，直接调用 `handleSessionApprovalEvent`——走跟真实
  1008	    /// wire 事件完全相同的双向 join 逻辑（大多数情况下这里还没有 agent(stream:approval) 帧，会被
  1009	    /// 正常缓冲，等随后真实到达的 agent 帧补发）。
  1010	    private func consumeApprovalReplay(_ result: JSONObject, kernelKey: String) {
  1011	        guard let replay = result["approvalReplay"] as? JSONObject,
  1012	              let approvals = replay["approvals"] as? [Any] else {
  1013	            return
  1014	        }
  1015	        let updatedAtMs = replay["updatedAtMs"]
  1016	        for case let approval as JSONObject in approvals {
  1017	            let syntheticPayload: JSONObject = [
  1018	                "sessionKey": kernelKey,
  1019	                "updatedAtMs": updatedAtMs as Any,
  1020	                "phase": "pending",
  1021	                "approval": approval,
  1022	            ]
  1023	            handleSessionApprovalEvent(["type": "event", "event": "session.approval", "payload": syntheticPayload])
  1024	        }
  1025	    }
  1026	
  1027	    /// gateway 全局 `shutdown` 事件——对所有当前活跃、尚未产出过 terminal 的 session 各广播一条
  1028	    /// sessionEnd(reason:.kernelExited)。F8：与 stop()/transportClosed 两条路径共享
  1029	    /// `sessionTerminalEmitted` 去重标记。
  1030	    private func handleShutdownEvent(_ frame: JSONObject) {
  1031	        prettyPrint("RECV event shutdown（向所有活跃 session 广播 sessionEnd(reason:kernelExited)）", frame)
  1032	        for (ourSessionID, continuation) in eventContinuations {
  1033	            guard !sessionTerminalEmitted.contains(ourSessionID) else { continue }
  1034	            sessionTerminalEmitted.insert(ourSessionID)
  1035	            continuation.yield(makeSessionEndEventForShutdown(
  1036	                ourSessionID: ourSessionID,
  1037	                nextSeq: { self.nextSeq(runID: nil, sessionID: ourSessionID) }
  1038	            ))
  1039	        }
  1040	    }
