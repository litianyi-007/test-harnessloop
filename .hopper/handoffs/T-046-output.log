   305	        // MARK: - ⑥ agent(stream:"error") -> error
   306	
   307	        public static EventMessageUnion? MapOpenclawAgentErrorToKernelEvent(
   308	            JSONObject data, string ourSessionId, string? runIdHint, DateTimeOffset originTs, Func<long> nextSeq)
   309	        {
   310	            var reason = OpenclawWire.JsonString(data.Get("reason"));
   311	            string message;
   312	            string? nativeCode;
   313	            if (reason == "seq gap")
   314	            {
   315	                var expected = OpenclawWire.JsonInt(data.Get("expected"));
   316	                var received = OpenclawWire.JsonInt(data.Get("received"));
   317	                message = $"event stream seq gap: expected {(expected.HasValue ? expected.Value.ToString() : "?")}, got {(received.HasValue ? received.Value.ToString() : "?")}";
   318	                nativeCode = "seq gap";
   319	            }
   320	            else
   321	            {
   322	                message = reason ?? OpenclawWire.JsonString(data.Get("message")) ?? "unrecognized agent error stream payload";
   323	                nativeCode = reason;
   324	            }
   325	            var errorPayload = new ErrorEventMessagePayload { Code = PayloadCode.Unknown, Message = message, NativeCode = nativeCode, Recoverable = Recoverable.Run };
   326	            return new ErrorEventMessage
   327	            {
   328	                Direction = MessageDeltaEventMessageDirection.Event, Payload = errorPayload, RunId = runIdHint,
   329	                SentAt = DateTimeOffset.UtcNow, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = ErrorEventMessageType.EvtError,
   330	            }.AsUnion();
   331	        }
