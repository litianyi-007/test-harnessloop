   282	// MARK: - ②b agent(stream:"item", kind:"tool") -> toolResult（非 exec 工具族，F5 rework 轮新增）
   283	
   284	/// **真实样本 grounding**（`scratchpad/openclaw-iso3/nonexec-run4.jsonl`，真实 Kimi + 内置
   285	/// `update_plan` 工具，2026-07-24 rework 轮隔离环境重新探针）：
   286	/// ```
   287	/// {"stream":"item","data":{"itemId":"tool:tool_p8yLr7taJUMG2ePajv3zPtmR","phase":"end","kind":"tool",
   288	///   "title":"tool_call","status":"completed","name":"tool_call",
   289	///   "toolCallId":"tool_p8yLr7taJUMG2ePajv3zPtmR","startedAt":1784876075348,"endedAt":1784876075377}}
   290	/// ```
   291	/// 对照同一次真实调用的 `session.message` toolCall content block：
   292	/// `{"type":"toolCall","id":"tool_p8yLr7taJUMG2ePajv3zPtmR","name":"tool_call",
   293	///   "arguments":{"id":"openclaw:core:update_plan","args":{...}}}`——`item.data.toolCallId` 与
   294	/// `session.message` toolCall block 的 `id` 字段**逐字相同**，证实这条 item 事件确实是那次
   295	/// toolCall 的终态回执，关联是可靠的（不是猜测）。
   296	///
   297	/// **诚实的缺口（F5 open question 的现场结论，非臆造）**：这条 `item` 事件只有
   298	/// itemId/phase/kind/title/status/name/meta/toolCallId/startedAt/endedAt——**没有任何 output/
   299	/// result 字段**。openclaw 源码里确实存在一个专门携带完整输出的通用事件
   300	/// （`embedded-agent-subscribe.handlers.tools.ts:1615-1628`，`emitAgentEvent({stream:"tool",
   301	/// data:{phase:"result", result: eventResult, ...}})`，`eventResult` 对非 exec 工具就是完整
   302	/// `sanitizeToolResult(result)`），但本轮用真实 `sessions.messages.subscribe`
   303	/// （`includeApprovals:true`）客户端反复探针，**从未收到过一条 `stream:"tool"` 的 `agent` wire
   304	/// 事件**——gateway 侧似乎要求连接先被登记为该 run 的"tool event recipient"才能收到这条通用
   305	/// tool 流（`gateway/server-chat.ts` 里 `runToolRecipients`/`broadcastToConnIds("agent", ...)` 一带
   306	/// 的分发逻辑指向这个方向，但具体登记 RPC/时机本轮未定位到，属于协议层未探明的缺口，如实标注，
   307	/// 不是本文件的映射 bug）。因此非 exec 工具的 `output` 字段本函数诚实置为 JSON `null`
   308	/// （`makeJSONAny(NSNull())`），`isError` 用 `status != "completed"` 判定（真实可用），`durationMS`
   309	/// 用 `endedAt - startedAt` 换算（真实可用，非编造）。
   310	///
   311	/// **去重规则**：exec 工具（`isExecToolName`：`"exec"`/`"bash"`）同时会产出这条 `item` 事件
   312	/// **和**权威的 `command_output`（真正带 output/exitCode）——调用方（`handleAgentEvent`）按
   313	/// `data.name` 排除 exec 工具族，只对非 exec 工具调用本函数，避免同一个 toolCallId 产出两条互相
   314	/// 矛盾的 D2 toolResult（一条有真实 output、一条 output 是 null）。
   315	func mapOpenclawAgentToolItemToToolResult(
   316	    _ data: JSONObject,
   317	    ourSessionID: String,
   318	    runIDHint: String?,
   319	    originTS: Date,
   320	    nextSeq: () -> Int
   321	) -> EventMessageUnion? {
   322	    guard jsonString(data["kind"]) == "tool" else { return nil }
   323	    guard jsonString(data["phase"]) == "end" else { return nil }
   324	    guard let toolCallID = jsonString(data["toolCallId"]) else { return nil }
   325	
   326	    let status = jsonString(data["status"])
   327	    let isError = status != "completed"
   328	    let durationMS: Int?
   329	    if let started = jsonInt(data["startedAt"]), let ended = jsonInt(data["endedAt"]) {
   330	        durationMS = max(0, ended - started)
   331	    } else {
   332	        durationMS = nil
   333	    }
   334	    // 诚实置空——见函数文档注释的"诚实的缺口"一段,不编造 output。
   335	    let output = makeJSONAny(NSNull())
   336	
   337	    let resultPayload = ToolResultEventMessagePayload(
   338	        durationMS: durationMS, isError: isError, output: output, toolCallID: toolCallID
   339	    )
   340	    return .toolResult(ToolResultEventMessage(
   341	        direction: .event, payload: resultPayload, runID: runIDHint,
   342	        sentAt: Date(), seq: nextSeq(), sessionID: ourSessionID, ts: originTS, type: .evtToolResult
   343	    ))
   344	}
   345	
   346	/// exec 工具名词表——与 openclaw `embedded-agent-subscribe.handlers.tools.ts:362-364`
   347	/// `isExecToolName` 逐字对应（`toolName === "exec" || toolName === "bash"`），供调用方判断
   348	/// 一次 `agent(stream:"item", kind:"tool")` 是否应该跳过（让权威的 command_output 来源接管）。
   349	func isOpenclawExecToolName(_ name: String?) -> Bool {
   350	    name == "exec" || name == "bash"
   351	}
