   535	        /// <summary>
   536	        /// M5：一个 session 的全部派生缓存——per-run seq/toolCallId/usage、M1 approval 双向缓冲区
   537	        /// （含从未配对成功的孤儿条目）、pendingStop、session 锁、F8 terminal 去重标记，统一清干净。
   538	        /// </summary>
   539	        private void ClearSessionDerivedCaches(string sessionId)
   540	        {
   541	            lock (_sync)
   542	            {
   543	                if (_runIdsBySessionId.TryGetValue(sessionId, out var runIds))
   544	                {
   545	                    foreach (var runId in runIds)
   546	                    {
   547	                        _seqByRunId.Remove(runId);
   548	                        _lastToolCallIdByRunId.Remove(runId);
   549	                        _lastUsageByRunId.Remove(runId);
   550	                    }
   551	                }
   552	                _runIdsBySessionId.Remove(sessionId);
   553	                _lastRunIdBySessionId.Remove(sessionId);
   554	                _seqFallbackBySessionId.Remove(sessionId);
   555	
   556	                if (_approvalIdsBySessionId.TryGetValue(sessionId, out var approvalIds))
   557	                {
   558	                    foreach (var approvalId in approvalIds)
   559	                    {
   560	                        _agentApprovalInfoByApprovalId.Remove(approvalId);
   561	                        _pendingSessionApprovalByApprovalId.Remove(approvalId);
   562	                    }
   563	                }
   564	                _approvalIdsBySessionId.Remove(sessionId);
   565	
   566	                _pendingStops.Remove(sessionId);
   567	                _lockStateBySessionId.Remove(sessionId);
   568	                _sessionTerminalEmitted.Remove(sessionId);
   569	            }
   570	        }
