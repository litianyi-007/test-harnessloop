   276	            var events = await CollectUpToAsync(channel.Reader, 2);
   277	            if (events.Count != 1 || events[0] is not ApprovalRequestEventMessageCase e)
   278	                return Fail(name, $"expected exactly 1 approvalRequest, got {events.Count}");
   279	            if (e.Value.RunId != "run-A")
