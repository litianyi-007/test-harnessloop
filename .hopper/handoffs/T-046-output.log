   145	        /// <summary>
   146	        /// 建立 WS 连接并完成 challenge -&gt; connect 握手，返回 hello-ok 里协商到的 scopes。镜像
   147	        /// Swift `connect()`。
   148	        /// </summary>
   149	        public async Task<IReadOnlyList<string>> ConnectAsync(CancellationToken cancellationToken = default)
   150	        {
   151	            var socket = new ClientWebSocket();
   152	            await socket.ConnectAsync(_endpoint, cancellationToken);
   153	            _socket = socket;
   154	            _receiveLoopTask = Task.Run(ReceiveLoopAsync);
   155	
   156	            var challenge = await WaitForNextEventAsync("connect.challenge");
   157	            OpenclawWire.PrettyPrint("RECV connect.challenge", challenge);
   158	
   159	            var connectParams = new JSONObject
   160	            {
   161	                ["minProtocol"] = 3L,
   162	                ["maxProtocol"] = 4L,
   163	                ["client"] = new JSONObject
   164	                {
   165	                    ["id"] = "cli",
   166	                    ["version"] = "0.0.1",
   167	                    ["platform"] = "darwin",
   168	                    ["mode"] = "cli",
   169	                },
   170	                ["caps"] = new List<object?>(),
   171	                ["role"] = "operator",
   172	                ["scopes"] = new List<object?> { "operator.admin" },
   173	                ["auth"] = new JSONObject { ["token"] = _token },
   174	            };
   175	            var hello = await RequestAsync("connect", connectParams);
   176	            OpenclawWire.PrettyPrint("RECV hello-ok (connect response payload)", hello);
   177	
   178	            if (OpenclawWire.JsonInt(hello.Get("protocol")) is long proto) LastHandshakeProtocol = (int)proto;
   179	            if (OpenclawWire.JsonObj(hello.Get("auth")) is JSONObject auth &&
   180	                OpenclawWire.JsonArr(auth.Get("scopes")) is List<object?> scopes)
   181	            {
   182	                LastHandshakeScopes = scopes.OfType<string>().ToList();
   183	            }
   184	            return LastHandshakeScopes;
   185	        }
