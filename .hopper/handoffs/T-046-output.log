   188	        /// <summary>简单的英语复数去除——只处理"末尾加 s"这一种最常见形态。</summary>
   189	        private static string Singularized(string word) =>
   190	            word.Length > 1 && word.EndsWith("s", StringComparison.Ordinal) ? word[..^1] : word;
   191	
   192	        private static bool IsSensitiveKey(string key)
   193	        {
   194	            var words = LowercasedWords(key);
   195	
   196	            // ① 无歧义凭证词（含复数）——整词命中（去掉可能的末尾 "s" 再比较）。
   197	            if (words.Any(w => UnambiguousSensitiveSingulars.Contains(Singularized(w)))) return true;
   198	
   199	            // ② apiKey/apiKeys 复合词——"api" 后紧跟 "key"/"keys" 才算敏感。
   200	            for (int i = 0; i < words.Count; i++)
   201	            {
   202	                if (words[i] == "api" && i + 1 < words.Count && Singularized(words[i + 1]) == "key") return true;
   203	            }
   204	
   205	            // ③ token/tokens——裸字段或与 auth/api 复合视为敏感；与计数类限定词相邻则明确排除。
   206	            for (int i = 0; i < words.Count; i++)
   207	            {
   208	                if (Singularized(words[i]) != "token") continue;
   209	                bool hasCountingNeighbor =
   210	                    (i > 0 && TokenCountingQualifiers.Contains(words[i - 1])) ||
   211	                    (i + 1 < words.Count && TokenCountingQualifiers.Contains(words[i + 1]));
   212	                if (hasCountingNeighbor) continue; // 明确排除：token 计数字段，不脱敏
   213	                return true; // 裸 token(s) 或与其它未知限定词复合——默认敏感（安全的一侧）
   214	            }
   215	
   216	            return false;
   217	        }
