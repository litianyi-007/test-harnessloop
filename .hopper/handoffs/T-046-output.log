   550	    // MARK: - 内部：session 映射表 + 事件流生命周期
   551	
   552	    private func kernelKey(for ourSessionID: String) -> String? {
   553	        kernelKeyBySessionID[ourSessionID]
   554	    }
   555	
   556	    /// F3：per-run（或无 run 归属时按 session）单调递增 seq——供所有 mapper 调用的
   557	    /// `nextSeq` 闭包共享同一份 actor 隔离状态。
   558	    private func nextSeq(runID: String?, sessionID: String) -> Int {
   559	        if let runID = runID {
   560	            let next = (seqByRunID[runID] ?? 0) + 1
   561	            seqByRunID[runID] = next
   562	            return next
   563	        }
   564	        let next = (seqFallbackBySessionID[sessionID] ?? 0) + 1
   565	        seqFallbackBySessionID[sessionID] = next
   566	        return next
   567	    }
   568	
   569	    /// M5（收 T-045 codex 确认性再审 MUST-FIX）：一个 session 的全部派生缓存——per-run
   570	    /// seq/toolCallId/usage、M1 approval 双向缓冲区（含从未配对成功的孤儿条目）、pendingStop、
   571	    /// session 锁、F8 terminal 去重标记——统一在这里清干净。`finishEventContinuation`（stop()/
   572	    /// 正常 subscribe 流结束）和 `handleTransportClosed`（transport 异常）两条路径都必须调用同一份
   573	    /// 清理，不能像上一轮那样只清一半（前者只清了 per-run 缓存，后者干脆什么都不清；approval 缓存
   574	    /// 更是只有 join 成功时才删除，pending-first 漏配对的条目会永久残留）。
   575	    private func clearSessionDerivedCaches(sessionID: String) {
   576	        for runID in runIDsBySessionID[sessionID] ?? [] {
   577	            seqByRunID.removeValue(forKey: runID)
   578	            lastToolCallIDByRunID.removeValue(forKey: runID)
   579	            lastUsageByRunID.removeValue(forKey: runID)
   580	        }
   581	        runIDsBySessionID.removeValue(forKey: sessionID)
   582	        lastRunIDBySessionID.removeValue(forKey: sessionID)
   583	        seqFallbackBySessionID.removeValue(forKey: sessionID)
   584	
   585	        for approvalID in approvalIDsBySessionID[sessionID] ?? [] {
   586	            agentApprovalInfoByApprovalID.removeValue(forKey: approvalID)
   587	            pendingSessionApprovalByApprovalID.removeValue(forKey: approvalID)
   588	        }
   589	        approvalIDsBySessionID.removeValue(forKey: sessionID)
   590	
   591	        pendingStops.removeValue(forKey: sessionID)
   592	        lockStateBySessionID.removeValue(forKey: sessionID)
   593	        sessionTerminalEmitted.remove(sessionID)
   594	    }
   595	
   596	    private func finishEventContinuation(sessionID: String) {
   597	        eventContinuations[sessionID]?.finish()
   598	        eventContinuations.removeValue(forKey: sessionID)
   599	        clearSessionDerivedCaches(sessionID: sessionID)
   600	    }
