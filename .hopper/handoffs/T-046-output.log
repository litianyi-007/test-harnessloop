   572	        private void FinishEventContinuation(string sessionId)
   573	        {
   574	            Channel<EventMessageUnion>? channel;
   575	            lock (_sync)
   576	            {
   577	                _eventChannels.TryGetValue(sessionId, out channel);
   578	                _eventChannels.Remove(sessionId);
   579	            }
   580	            channel?.Writer.TryComplete();
   581	            ClearSessionDerivedCaches(sessionId);
   582	        }
