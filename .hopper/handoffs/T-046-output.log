    46	    public static class EventMapping
    47	    {
    48	        // MARK: - ① session.message -> messageDelta / thinking / toolCall
    49	
    50	        public static List<EventMessageUnion> MapOpenclawSessionMessageToKernelEvents(
    51	            JSONObject payload, string ourSessionId, string? runIdHint, Func<long> nextSeq)
    52	        {
    53	            var message = OpenclawWire.JsonObj(payload.Get("message"));
    54	            if (message == null) return new List<EventMessageUnion>();
    55	            if (OpenclawWire.JsonString(message.Get("role")) != "assistant") return new List<EventMessageUnion>();
    56	
    57	            var sentAt = DateTimeOffset.UtcNow;
    58	            var originTs = OpenclawWire.MsEpochToDate(OpenclawWire.JsonInt(message.Get("timestamp")));
    59	            var events = new List<EventMessageUnion>();
    60	
    61	            var content = message.Get("content");
    62	            List<JSONObject> blocks;
    63	            if (OpenclawWire.JsonArr(content) is List<object?> arr)
    64	            {
    65	                blocks = arr.Select(OpenclawWire.JsonObj).Where(o => o != null).Select(o => o!).ToList();
    66	            }
    67	            else if (OpenclawWire.JsonString(content) is string text)
    68	            {
    69	                blocks = new List<JSONObject> { new JSONObject { ["type"] = "text", ["text"] = text } };
    70	            }
    71	            else
    72	            {
    73	                blocks = new List<JSONObject>();
    74	            }
    75	
    76	            for (int index = 0; index < blocks.Count; index++)
    77	            {
    78	                var block = blocks[index];
    79	                var type = OpenclawWire.JsonString(block.Get("type"));
    80	                if (type == null) continue;
    81	                switch (type)
    82	                {
    83	                    case "text":
    84	                    {
    85	                        var text = OpenclawWire.JsonString(block.Get("text"));
    86	                        if (text == null) continue;
    87	                        var deltaPayload = new MessageDeltaEventMessagePayload { Delta = text, Index = index, Role = Role.Assistant };
    88	                        events.Add(new MessageDeltaEventMessage
    89	                        {
    90	                            Direction = MessageDeltaEventMessageDirection.Event, Payload = deltaPayload, RunId = runIdHint,
    91	                            SentAt = sentAt, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = MessageDeltaEventMessageType.EvtMessageDelta,
    92	                        }.AsUnion());
    93	                        break;
    94	                    }
    95	
    96	                    case "thinking":
    97	                    case "reasoning":
    98	                    case "redacted_thinking":
    99	                    {
   100	                        var delta = OpenclawWire.JsonString(block.Get("text")) ?? OpenclawWire.JsonString(block.Get("thinking")) ?? "";
   101	                        var visibility = type == "redacted_thinking" ? Visibility.Summary : Visibility.Raw;
   102	                        var thinkingPayload = new ThinkingEventMessagePayload { Delta = delta, Visibility = visibility };
   103	                        events.Add(new ThinkingEventMessage
   104	                        {
   105	                            Direction = MessageDeltaEventMessageDirection.Event, Payload = thinkingPayload, RunId = runIdHint,
   106	                            SentAt = sentAt, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = ThinkingEventMessageType.EvtThinking,
   107	                        }.AsUnion());
   108	                        break;
   109	                    }
   110	
   111	                    case "toolCall":
   112	                    case "tool_call":
   113	                    case "toolUse":
   114	                    case "tool_use":
   115	                    {
   116	                        var toolCallId = OpenclawWire.JsonString(block.Get("id"));
   117	                        var name = OpenclawWire.JsonString(block.Get("name"));
   118	                        if (toolCallId == null || name == null) continue;
   119	                        var input = block.Get("arguments") ?? block.Get("input") ?? new JSONObject();
   120	                        var toolCallPayload = new ToolCallEventMessagePayload { Input = input, Name = name, Status = Status.Started, ToolCallId = toolCallId };
   121	                        events.Add(new ToolCallEventMessage
   122	                        {
   123	                            Direction = MessageDeltaEventMessageDirection.Event, Payload = toolCallPayload, RunId = runIdHint,
   124	                            SentAt = sentAt, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = ToolCallEventMessageType.EvtToolCall,
   125	                        }.AsUnion());
   126	                        break;
   127	                    }
   128	
   129	                    default:
   130	                        // 未识别的 content block type——如实跳过，不臆造映射。
   131	                        continue;
   132	                }
   133	            }
   134	
   135	            return events;
   136	        }
