   138	        // MARK: - ② agent(stream:"command_output") -> toolResult（exec 工具族）
   139	
   140	        public static EventMessageUnion? MapOpenclawAgentCommandOutputToToolResult(
   141	            JSONObject data, string ourSessionId, string? runIdHint, DateTimeOffset originTs, Func<long> nextSeq)
   142	        {
   143	            if (OpenclawWire.JsonString(data.Get("phase")) != "end") return null;
   144	            var toolCallId = OpenclawWire.JsonString(data.Get("toolCallId"));
   145	            if (toolCallId == null) return null;
   146	
   147	            var status = OpenclawWire.JsonString(data.Get("status"));
   148	            var exitCode = OpenclawWire.JsonInt(data.Get("exitCode"));
   149	            var isError = status == "failed" || (exitCode ?? 0) != 0;
   150	            var output = data.Get("output") ?? "";
   151	            var durationMs = OpenclawWire.JsonInt(data.Get("durationMs"));
   152	
   153	            var resultPayload = new ToolResultEventMessagePayload { DurationMs = durationMs, IsError = isError, Output = output, ToolCallId = toolCallId };
   154	            return new ToolResultEventMessage
   155	            {
   156	                Direction = MessageDeltaEventMessageDirection.Event, Payload = resultPayload, RunId = runIdHint,
   157	                SentAt = DateTimeOffset.UtcNow, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = ToolResultEventMessageType.EvtToolResult,
   158	            }.AsUnion();
   159	        }
