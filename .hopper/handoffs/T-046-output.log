   256	        // MARK: - ④ session.approval -> approvalRequest（toolCallID 关联走双向 join，见 KernelClient）
   257	
   258	        public static EventMessageUnion? MapOpenclawSessionApprovalToKernelEvent(
   259	            JSONObject payload, string ourSessionId, string? runIdHint, string? toolCallIdForApprovalId, Func<long> nextSeq)
   260	        {
   261	            if (OpenclawWire.JsonString(payload.Get("phase")) != "pending") return null;
   262	            var approval = OpenclawWire.JsonObj(payload.Get("approval"));
   263	            if (approval == null) return null;
   264	            var reqId = OpenclawWire.JsonString(approval.Get("id"));
   265	            if (reqId == null) return null;
   266	            if (toolCallIdForApprovalId == null) return null;
   267	            if (runIdHint == null) return null;
   268	            var runId = runIdHint;
   269	
   270	            var presentation = OpenclawWire.JsonObj(approval.Get("presentation")) ?? new JSONObject();
   271	            var openclawKind = OpenclawWire.JsonString(presentation.Get("kind"));
   272	            var kind = openclawKind == "exec" ? KindElement.Exec : KindElement.Tool;
   273	
   274	            var createdAtMs = OpenclawWire.JsonInt(approval.Get("createdAtMs"));
   275	            var expiresAtMs = OpenclawWire.JsonInt(approval.Get("expiresAtMs"));
   276	            long timeoutMs = (createdAtMs.HasValue && expiresAtMs.HasValue) ? expiresAtMs.Value - createdAtMs.Value : 0;
   277	
   278	            var approvalPayload = new ApprovalRequestEventMessagePayload
   279	            {
   280	                Kind = kind, Payload = presentation, ProposedDecision = null, ReqId = reqId,
   281	                TimeoutAuthority = TimeoutAuthority.Documented, TimeoutMs = timeoutMs, ToolCallId = toolCallIdForApprovalId,
   282	            };
   283	            var originTs = OpenclawWire.MsEpochToDate(OpenclawWire.JsonInt(payload.Get("updatedAtMs")));
   284	            return new ApprovalRequestEventMessage
   285	            {
   286	                Direction = MessageDeltaEventMessageDirection.Event, Payload = approvalPayload, RunId = runId,
   287	                SentAt = DateTimeOffset.UtcNow, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = ApprovalRequestEventMessageType.EvtApprovalRequest,
   288	            }.AsUnion();
   289	        }
