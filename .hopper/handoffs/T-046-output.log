   626	        private static async Task<bool> TestStopNoActiveRunEmitsOperationCompletedMirror()
   627	        {
   628	            var name = "M3 stop() no active run -> operation_completed(succeeded) mirror + Promise succeeded";
   629	            var client = FreshClient();
   630	            var sessionId = "sess-stop-noactive";
   631	            var kernelKey = "kernel-key-stop-noactive";
   632	            var channel = client.TestSupportRegisterSession(sessionId, kernelKey);
   633	            client.TestSupportStubRpc("sessions.abort", _ => Task.FromResult(new JSONObject { ["ok"] = true, ["abortedRunId"] = null, ["status"] = "no-active-run" }));
   634	            client.TestSupportStubRpc("sessions.delete", _ => Task.FromResult(new JSONObject { ["deleted"] = true }));
   635	            var handle = TestHandle(sessionId, kernelKey);
   636	
   637	            StopResultPayload result;
   638	            try { result = await client.StopAsync(handle); }
   639	            catch { return Fail(name, "stop() unexpectedly threw"); }
   640	            if (result.Outcome != StopResultPayloadOutcome.Succeeded)
   641	                return Fail(name, $"expected Promise outcome=.succeeded, got {result.Outcome}");
   642	
   643	            var events = await CollectUpToAsync(channel.Reader, 3);
   644	            if (events.Count != 2)
   645	                return Fail(name, $"expected 2 events (operation_completed mirror + session_end), got {events.Count} — 修前这条路径只发 session_end,完全没有 operation_completed 镜像");
   646	            if (events[0] is not OperationCompletedEventMessageCase op)
   647	                return Fail(name, $"expected first event .operationCompleted, got {events[0].WireType}");
   648	            if (op.Value.Payload.OperationId != result.OperationId || op.Value.Payload.Outcome != PayloadOutcome.Succeeded)
   649	                return Fail(name, $"operationCompleted must mirror Promise: got id={op.Value.Payload.OperationId} outcome={op.Value.Payload.Outcome}, Promise id={result.OperationId}");
   650	            if (events[1] is not SessionEndEventMessageCase end || end.Value.Payload.Reason != PurpleReason.Stopped)
   651	                return Fail(name, "expected second event sessionEnd(reason:.stopped)");
   652	            return Pass(name, $"operationId={result.OperationId} 双通道 outcome 均为 succeeded,session_end(stopped) 紧随其后");
   653	        }
