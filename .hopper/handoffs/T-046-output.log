     9	#nullable enable
    10	using System;
    11	
    12	namespace KernelClient
    13	{
    14	    public enum KernelClientErrorKind
    15	    {
    16	        NotImplemented,
    17	        Transport,
    18	        ProtocolMismatch,
    19	        RpcRejected,
    20	        NotConnected,
    21	    }
    22	
    23	    public sealed class KernelClientException : Exception
    24	    {
    25	        public KernelClientErrorKind Kind { get; }
    26	
    27	        /// <summary>仅 <see cref="KernelClientErrorKind.RpcRejected"/> 分支有意义。</summary>
    28	        public string? Code { get; }
    29	
    30	        public KernelClientException(KernelClientErrorKind kind, string message, string? code = null)
    31	            : base(Describe(kind, message, code))
    32	        {
    33	            Kind = kind;
    34	            Code = code;
    35	        }
    36	
    37	        private static string Describe(KernelClientErrorKind kind, string message, string? code) => kind switch
    38	        {
    39	            KernelClientErrorKind.NotImplemented => $"not implemented: {message}",
    40	            KernelClientErrorKind.Transport => $"transport error: {message}",
    41	            KernelClientErrorKind.ProtocolMismatch => $"protocol mismatch: {message}",
    42	            KernelClientErrorKind.RpcRejected => $"rpc rejected [{code}]: {message}",
    43	            KernelClientErrorKind.NotConnected => "kernel client not connected",
    44	            _ => message,
    45	        };
    46	    }
    47	}
