   709	                ClearSessionDerivedCaches(kv.Key);
   710	            }
   711	        }
   712	
   713	        private void HandleIncoming(byte[] data)
   714	        {
   715	            JSONObject frame;
   716	            try { frame = OpenclawWire.DecodeFrame(data); }
   717	            catch { return; }
   718	
   719	            var type = OpenclawWire.JsonString(frame.Get("type"));
   720	            if (type == null) return;
   721	
   722	            switch (type)
   723	            {
   724	                case "res":
   725	                {
   726	                    var id = OpenclawWire.JsonString(frame.Get("id"));
   727	                    if (id == null) return;
   728	                    TaskCompletionSource<JSONObject>? tcs;
   729	                    lock (_sync) { _pending.Remove(id, out tcs); }
   730	                    if (tcs == null) return;
   731	                    var ok = OpenclawWire.JsonBool(frame.Get("ok")) ?? false;
   732	                    if (ok)
   733	                    {
   734	                        var payload = OpenclawWire.JsonObj(frame.Get("payload")) ?? new JSONObject();
   735	                        tcs.TrySetResult(payload);
   736	                    }
   737	                    else
   738	                    {
   739	                        var err = OpenclawWire.JsonObj(frame.Get("error")) ?? new JSONObject();
   740	                        var code = OpenclawWire.JsonString(err.Get("code")) ?? "unknown";
   741	                        var message = OpenclawWire.JsonString(err.Get("message"));
   742	                        tcs.TrySetException(new KernelClientException(KernelClientErrorKind.RpcRejected, message ?? "", code));
   743	                    }
   744	                    break;
   745	                }
   746	
   747	                case "event":
   748	                {
   749	                    var eventName = OpenclawWire.JsonString(frame.Get("event"));
   750	                    if (eventName == null) return;
   751	                    TaskCompletionSource<JSONObject>? waiter;
   752	                    lock (_sync) { _oneShotEventWaiters.Remove(eventName, out waiter); }
   753	                    if (waiter != null)
   754	                    {
   755	                        var payload = OpenclawWire.JsonObj(frame.Get("payload")) ?? new JSONObject();
   756	                        waiter.TrySetResult(payload);
   757	                        break;
   758	                    }
   759	                    switch (eventName)
   760	                    {
   761	                        case "session.message": HandleSessionMessageEvent(frame); break;
   762	                        case "agent": HandleAgentEvent(frame); break;
   763	                        case "session.approval": HandleSessionApprovalEvent(frame); break;
   764	                        case "shutdown": HandleShutdownEvent(frame); break;
   765	                        default:
   766	                            OpenclawWire.PrettyPrint($"RECV event {eventName} (未处理的旁路事件，原样打印)", frame);
   767	                            break;
   768	                    }
   769	                    break;
   770	                }
   771	            }
   772	        }
   773	
   774	        private void HandleSessionMessageEvent(JSONObject frame)
   775	        {
   776	            var payload = OpenclawWire.JsonObj(frame.Get("payload"));
   777	            if (payload == null) return;
   778	            var kernelKey = OpenclawWire.JsonString(payload.Get("sessionKey"));
   779	            if (kernelKey == null) return;
   780	            var ourSessionId = OurSessionIdForKernelKey(kernelKey);
   781	            if (ourSessionId == null) return;
   782	            bool hasChannel;
   783	            lock (_sync) { hasChannel = _eventChannels.ContainsKey(ourSessionId); }
   784	            if (!hasChannel) return;
   785	
   786	            string? currentRunId;
   787	            lock (_sync) { _lastRunIdBySessionId.TryGetValue(ourSessionId, out currentRunId); }
   788	
   789	            var sessionSnapshot = OpenclawWire.JsonObj(payload.Get("session"));
   790	            if (sessionSnapshot != null &&
   791	                OpenclawWire.JsonArr(sessionSnapshot.Get("activeRunIds")) is List<object?> activeRunIds &&
   792	                activeRunIds.Count > 0 && activeRunIds[0] is string firstRunId)
   793	            {
   794	                lock (_sync)
   795	                {
   796	                    _lastRunIdBySessionId[ourSessionId] = firstRunId;
   797	                    if (!_runIdsBySessionId.TryGetValue(ourSessionId, out var set)) _runIdsBySessionId[ourSessionId] = set = new HashSet<string>();
   798	                    set.Add(firstRunId);
   799	                }
   800	                currentRunId = firstRunId;
   801	            }
   802	
   803	            var message = OpenclawWire.JsonObj(payload.Get("message"));
   804	            if (message != null && OpenclawWire.JsonObj(message.Get("usage")) is JSONObject usage &&
   805	                OpenclawWire.JsonInt(usage.Get("input")) is long usageInput && OpenclawWire.JsonInt(usage.Get("output")) is long usageOutput &&
   806	                currentRunId is string usageRunId)
   807	            {
   808	                lock (_sync) { _lastUsageByRunId[usageRunId] = (usageInput, usageOutput); }
   809	            }
   810	
   811	            var runIdHint = currentRunId;
   812	            var sid = ourSessionId;
   813	            var events = EventMapping.MapOpenclawSessionMessageToKernelEvents(
   814	                payload, ourSessionId, runIdHint, () => NextSeq(runIdHint, sid));
   815	
   816	            if (events.Count == 0)
   817	            {
   818	                OpenclawWire.PrettyPrint("RECV session.message（未能映射到 D2 KernelEvent 11 变体之一）", frame);
   819	                return;
   820	            }
   821	            foreach (var evt in events)
   822	            {
   823	                if (evt is ToolCallEventMessageCase toolCall && runIdHint != null)
   824	                {
   825	                    lock (_sync) { _lastToolCallIdByRunId[runIdHint] = toolCall.Value.Payload.ToolCallId; }
   826	                }
   827	                Yield(ourSessionId, evt);
   828	            }
   829	        }
