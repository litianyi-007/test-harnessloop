   753	    private func handleSessionMessageEvent(_ frame: JSONObject) {
   754	        guard let payload = frame["payload"] as? JSONObject,
   755	              let kernelKey = payload["sessionKey"] as? String,
   756	              let ourSessionID = ourSessionID(forKernelKey: kernelKey) else {
   757	            return
   758	        }
   759	        guard let continuation = eventContinuations[ourSessionID] else { return }
   760	
   761	        // 顺带刷新 runId/usage 缓存——session.message 的 session 快照里带 activeRunIds，assistant
   762	        // 消息自己带 usage。F1：usage 缓存改为 **per-run**（用刚刷新出来的 runId 做键），不再是
   763	        // per-session，避免上一个 run 的残留 usage 串给下一个 run 的 turn_complete。
   764	        var currentRunID = lastRunIDBySessionID[ourSessionID]
   765	        if let sessionSnapshot = payload["session"] as? JSONObject,
   766	           let activeRunIDs = sessionSnapshot["activeRunIds"] as? [Any],
   767	           let firstRunID = activeRunIDs.first as? String {
   768	            lastRunIDBySessionID[ourSessionID] = firstRunID
   769	            runIDsBySessionID[ourSessionID, default: []].insert(firstRunID)
   770	            currentRunID = firstRunID
   771	        }
   772	        if let message = payload["message"] as? JSONObject, let usage = message["usage"] as? JSONObject,
   773	           let input = jsonInt(usage["input"]), let output = jsonInt(usage["output"]),
   774	           let runID = currentRunID {
   775	            lastUsageByRunID[runID] = (input: input, output: output)
   776	        }
   777	
   778	        let runIDHint = currentRunID
   779	        let sid = ourSessionID
   780	        let events = mapOpenclawSessionMessageToKernelEvents(
   781	            payload, ourSessionID: ourSessionID, runIDHint: runIDHint,
   782	            nextSeq: { self.nextSeq(runID: runIDHint, sessionID: sid) }
   783	        )
   784	        if events.isEmpty {
   785	            prettyPrint("RECV session.message（未能映射到 D2 KernelEvent 11 变体之一）", frame)
   786	            return
   787	        }
   788	        for event in events {
   789	            if case .toolCall(let toolCall) = event, let runID = runIDHint {
   790	                // F1：per-run 缓存（不是 per-session），approval 的 toolCallId 时序关联（F4 已改用
   791	                // 更权威的 agent(stream:"approval") 来源，这里保留只是为了兼容潜在的其它读者/诊断）。
   792	                lastToolCallIDByRunID[runID] = toolCall.payload.toolCallID
   793	            }
   794	            continuation.yield(event)
   795	        }
   796	    }
