   219	        /// <summary>
   220	        /// 递归构造一份脱敏副本，供日志/打印使用——原始 `value` 不被修改。
   221	        /// </summary>
   222	        public static object? RedactedCopy(object? value)
   223	        {
   224	            if (value is JSONObject dict)
   225	            {
   226	                var outDict = new JSONObject();
   227	                foreach (var (key, nested) in dict)
   228	                    outDict[key] = IsSensitiveKey(key) ? "***REDACTED***" : RedactedCopy(nested);
   229	                return outDict;
   230	            }
   231	            if (value is List<object?> list)
   232	                return list.Select(RedactedCopy).ToList();
   233	            return value;
   234	        }
   235	
   236	        /// <summary>
   237	        /// 把收发的每一帧打印出来——F7 rework：打印前统一走 <see cref="RedactedCopy"/>，递归脱敏
   238	        /// auth/token/secret 等凭证字段，这是唯一的调用路径。
   239	        /// </summary>
   240	        public static void PrettyPrint(string label, JSONObject obj)
   241	        {
   242	            var safe = RedactedCopy(obj) as JSONObject ?? obj;
   243	            string text;
   244	            try
   245	            {
   246	                text = JsonSerializer.Serialize(safe, new JsonSerializerOptions { WriteIndented = true });
   247	            }
   248	            catch
   249	            {
   250	                text = "<unprintable>";
   251	            }
   252	            Console.WriteLine($"\n--- {label} ---\n{text}");
   253	        }
   254	    }
   255	}
     1	// SG-5 Stage C：openclaw 事件 -> D2 EventMessageUnion（11 变体）映射——C# 镜像
     2	// ../swift/EventMapping.swift（748 行，SG-5 rework 权威 spec，两轮对抗审 T-044/T-045 + 真 e2e 已验证
     3	// 正确）。每个函数逐一对应 Swift 侧同名函数，文档注释只记"C# 与 Swift 的表达差异"，字段级 grounding
     4	// （真实样本/源码引用）见 Swift 源文件，不在此重复誊抄。
     5	//
     6	// 关键表达差异：
     7	//   - Swift `EventMessageUnion` 是带关联值的 enum（`.toolResult(ToolResultEventMessage)`）；C#
     8	//     判别联合（DiscriminatedUnions.cs）是『抽象基类 + 具体 Case 子类』，这里用 `AsUnion()` 扩展方法
     9	//     （见文末）把具体 `XxxEventMessage` 包成 `EventMessageUnion`，语义等价于 Swift 的 case 构造。
    10	//   - Swift 用 `JSONAny`（借道 JSONEncoder/Decoder 往返）表达"取不到真实值时的诚实 JSON null"；C# 的
    11	//     D2 DTO 对应字段（ToolCallEventMessagePayload.Input / ToolResultEventMessagePayload.Output /
    12	//     ApprovalRequestEventMessagePayload.Payload）声明类型就是 `object?`，且未标
    13	//     `[JsonIgnore(WhenWritingNull)]`——直接赋值 `null` 就会在序列化时忠实产出 JSON `null`，不需要
    14	//     Swift 那样的 NSNull 包装往返，这是 C#/System.Text.Json 语义带来的简化，行为等价。
    15	//   - `nextSeq` 闭包类型是 `Func<long>`（D2 C# 的 Seq 字段是 `long`），对应 Swift 的 `() -> Int`。
    16	
    17	#nullable enable
    18	using System;
    19	using System.Collections.Generic;
    20	using System.Linq;
    21	using D2;
    22	
    23	namespace KernelClient
    24	{
    25	    using JSONObject = Dictionary<string, object?>;
    26	
    27	    /// <summary>
    28	    /// 把具体 `XxxEventMessage` 包成判别联合 `EventMessageUnion` 的具体 Case——对应 Swift
    29	    /// `.caseName(msg)` 的构造写法，C# 没有枚举关联值，用扩展方法把这层样板代码集中在一处。
    30	    /// </summary>
    31	    public static class EventUnionExtensions
    32	    {
    33	        public static EventMessageUnion AsUnion(this MessageDeltaEventMessage m) => new MessageDeltaEventMessageCase { Value = m };
    34	        public static EventMessageUnion AsUnion(this ThinkingEventMessage m) => new ThinkingEventMessageCase { Value = m };
    35	        public static EventMessageUnion AsUnion(this ToolCallEventMessage m) => new ToolCallEventMessageCase { Value = m };
    36	        public static EventMessageUnion AsUnion(this ToolResultEventMessage m) => new ToolResultEventMessageCase { Value = m };
    37	        public static EventMessageUnion AsUnion(this ApprovalRequestEventMessage m) => new ApprovalRequestEventMessageCase { Value = m };
    38	        public static EventMessageUnion AsUnion(this ErrorEventMessage m) => new ErrorEventMessageCase { Value = m };
    39	        public static EventMessageUnion AsUnion(this TurnCompleteEventMessage m) => new TurnCompleteEventMessageCase { Value = m };
    40	        public static EventMessageUnion AsUnion(this SessionEndEventMessage m) => new SessionEndEventMessageCase { Value = m };
    41	        public static EventMessageUnion AsUnion(this CapabilityChangedEventMessage m) => new CapabilityChangedEventMessageCase { Value = m };
    42	        public static EventMessageUnion AsUnion(this OperationCompletedEventMessage m) => new OperationCompletedEventMessageCase { Value = m };
    43	        public static EventMessageUnion AsUnion(this ApprovalBufferResolvedEventMessage m) => new ApprovalBufferResolvedEventMessageCase { Value = m };
    44	    }
