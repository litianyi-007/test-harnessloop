   499	        // MARK: - 内部：session 映射表 + 事件流生命周期
   500	
   501	        private string? OurSessionIdForKernelKey(string kernelKey)
   502	        {
   503	            lock (_sync)
   504	            {
   505	                foreach (var kv in _kernelKeyBySessionId)
   506	                    if (kv.Value == kernelKey) return kv.Key;
   507	            }
   508	            return null;
   509	        }
   510	
   511	        /// <summary>F3：per-run（或无 run 归属时按 session）单调递增 seq。</summary>
   512	        private long NextSeq(string? runId, string sessionId)
   513	        {
   514	            lock (_sync)
   515	            {
   516	                if (runId != null)
   517	                {
   518	                    var next = (_seqByRunId.TryGetValue(runId, out var cur) ? cur : 0) + 1;
   519	                    _seqByRunId[runId] = next;
   520	                    return next;
   521	                }
   522	                var nextFallback = (_seqFallbackBySessionId.TryGetValue(sessionId, out var curF) ? curF : 0) + 1;
   523	                _seqFallbackBySessionId[sessionId] = nextFallback;
   524	                return nextFallback;
   525	            }
   526	        }
