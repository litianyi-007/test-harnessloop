    84	///     敏感词，openclaw session key 等大量字段就叫 `key`，不是凭证）。
    85	///  3. `token`/`tokens`——裸字段（key 本身就是这一个词）或与 `auth`/`api` 复合（`authToken(s)`/
    86	///     `apiToken(s)`）视为敏感；与已知的计数类限定词（`context`/`input`/`output`/`total`/`max`/
    87	///     `budget`/`count`/`limit`/`usage`/`remaining`）相邻则明确排除，不脱敏——这些正是真实样本里
    88	///     观察到的 token 用量诊断字段，不是凭证。未知限定词默认落回敏感（安全的一侧：宁可多脱敏一个
    89	///     没见过的字段，也不能漏报真凭证）。
    90	private let unambiguousSensitiveSingulars: Set<String> = [
    91	    "auth", "authorization", "secret", "password", "credential",
    92	]
    93	private let tokenCountingQualifiers: Set<String> = [
    94	    "context", "input", "output", "total", "max", "budget", "count", "limit", "usage", "remaining",
    95	]
    96	
    97	/// 把一个 camelCase/snake_case/kebab-case 的 key 拆成小写单词列表——`"contextTokens"` ->
    98	/// `["context","tokens"]`，`"authToken"` -> `["auth","token"]`，`"api_key"` -> `["api","key"]`。
    99	private func lowercasedWords(_ key: String) -> [String] {
   100	    var words: [String] = []
   101	    var current = ""
   102	    for char in key {
   103	        if char == "_" || char == "-" {
   104	            if !current.isEmpty { words.append(current); current = "" }
   105	            continue
   106	        }
   107	        if char.isUppercase, !current.isEmpty {
   108	            words.append(current)
   109	            current = String(char).lowercased()
   110	        } else {
   111	            current.append(Character(char.lowercased()))
   112	        }
   113	    }
   114	    if !current.isEmpty { words.append(current) }
   115	    return words
   116	}
   117	
   118	/// 简单的英语复数去除——只处理"末尾加 s"这一种最常见形态（`credentials` -> `credential`，
   119	/// `secrets` -> `secret`）。这个项目的敏感词表本身都是规则复数，不需要处理不规则变形。
   120	private func singularized(_ word: String) -> String {
   121	    word.hasSuffix("s") && word.count > 1 ? String(word.dropLast()) : word
   122	}
   123	
   124	private func isSensitiveKey(_ key: String) -> Bool {
   125	    let words = lowercasedWords(key)
   126	
   127	    // ① 无歧义凭证词（含复数）——整词命中（去掉可能的末尾 "s" 再比较）。
   128	    if words.contains(where: { unambiguousSensitiveSingulars.contains(singularized($0)) }) {
   129	        return true
   130	    }
   131	
   132	    // ② apiKey/apiKeys 复合词——"api" 后紧跟 "key"/"keys" 才算敏感。
   133	    for i in 0..<words.count where words[i] == "api" && i + 1 < words.count {
   134	        if singularized(words[i + 1]) == "key" { return true }
   135	    }
   136	
   137	    // ③ token/tokens——裸字段或与 auth/api 复合视为敏感；与计数类限定词相邻则明确排除（诚实保留
   138	    // 这些真实的用量诊断字段，不误伤）。
   139	    for (i, word) in words.enumerated() where singularized(word) == "token" {
   140	        let hasCountingNeighbor =
   141	            (i > 0 && tokenCountingQualifiers.contains(words[i - 1])) ||
   142	            (i + 1 < words.count && tokenCountingQualifiers.contains(words[i + 1]))
   143	        if hasCountingNeighbor { continue } // 明确排除：token 计数字段，不脱敏
   144	        return true // 裸 token(s) 或与其它未知限定词复合——默认敏感（安全的一侧）
   145	    }
   146	
   147	    return false
   148	}
   149	
   150	/// 递归构造一份脱敏副本，供日志/打印使用——原始 `object`/嵌套字典/数组本身不被修改（这是"打印前的
   151	/// 只读转换"，不影响实际发给 openclaw 的请求内容）。
   152	func redactedCopy(_ value: Any) -> Any {
   153	    if let dict = value as? JSONObject {
   154	        var out: JSONObject = [:]
   155	        for (key, nested) in dict {
   156	            out[key] = isSensitiveKey(key) ? "***REDACTED***" : redactedCopy(nested)
   157	        }
   158	        return out
   159	    }
   160	    if let array = value as? [Any] {
   161	        return array.map { redactedCopy($0) }
   162	    }
   163	    return value
   164	}
   165	
   166	/// 把收发的每一帧打印出来——这是本轮 SG-4 的验收铁证要求（"把每步的响应/事件打印出来"），不是调试
   167	/// 脚手架，是交付物本身的一部分。**F7 rework**：打印前统一走 `redactedCopy`，递归脱敏
   168	/// auth/token/secret 等凭证字段——这是唯一的调用路径（`OpenclawGatewayKernelClient` 里所有
   169	/// `prettyPrint(...)` 调用点都不需要各自记得脱敏），content 类字段（消息正文/工具输出/审批
   170	/// payload）默认随这条统一路径打印，不再单独提供一个"不脱敏"的旁路。
   171	func prettyPrint(_ label: String, _ object: JSONObject) {
   172	    let safeObject = (redactedCopy(object) as? JSONObject) ?? object
   173	    let data = (try? JSONSerialization.data(withJSONObject: safeObject, options: [.prettyPrinted, .sortedKeys])) ?? Data()
   174	    let text = String(data: data, encoding: .utf8) ?? "<unprintable>"
   175	    print("\n--- \(label) ---\n\(text)")
   176	}
