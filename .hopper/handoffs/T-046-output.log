  1042	    // MARK: - Test-only 支持面（frame-replay 单测用；生产路径不调用）
  1043	    //
  1044	    // 这个项目没有 XCTest/SwiftPM test target（`app/contracts/d2/codegen` 同一套"纯 swiftc 编译"
  1045	    // 风格），`FrameReplayTests.swift` 和这个文件在同一次 swiftc 调用里编译成同一个隐式 module——
  1046	    // 没有 `@testable import` 机制，`private` 是文件级作用域。下面这几个方法把"搭建一个已订阅的
  1047	    // 假 session、灌入合成 wire 帧、读取内部锁/终态状态"这三件事暴露成 internal（去掉 `private`），
  1048	    // 让测试文件可以直接驱动真实的 `handleIncoming` -> dispatch -> mapping 流水线，而不需要一个真
  1049	    // WebSocket 连接。方法名统一加 `testSupport` 前缀，一眼可辨认，不是生产调用路径的一部分。
  1050	
  1051	    /// 不经过任何 RPC，直接注册一个"已订阅"的假 session——供测试灌入合成 wire 帧。
  1052	    func testSupportRegisterSession(ourSessionID: String, kernelKey: String) -> AsyncThrowingStream<EventMessageUnion, Error> {
  1053	        kernelKeyBySessionID[ourSessionID] = kernelKey
  1054	        let (stream, continuation) = AsyncThrowingStream<EventMessageUnion, Error>.makeStream()
  1055	        eventContinuations[ourSessionID] = continuation
  1056	        return stream
  1057	    }
  1058	
  1059	    /// 把一帧合成的 wire JSON 编码后送进真实的 `handleIncoming` dispatch 入口——测试因此走的是
  1060	    /// 生产代码本身的分支/映射逻辑，不是重新实现一遍判断。
  1061	    func testSupportFeedFrame(_ frame: JSONObject) {
  1062	        guard let data = try? encodeFrame(frame) else { return }
  1063	        handleIncoming(data)
  1064	    }
  1065	
  1066	    /// 读取当前锁状态的字符串描述（"idle"/"send_pending"/"stop_in_progress"）。
  1067	    func testSupportLockState(sessionID: String) -> String {
  1068	        (lockStateBySessionID[sessionID] ?? .idle).description
  1069	    }
  1070	
  1071	    /// 读取某个 pendingStop 是否已经被标记为"terminal 已产出"（F6 去重的核心状态）。
  1072	    func testSupportPendingStopTerminalEmitted(sessionID: String) -> Bool? {
  1073	        pendingStops[sessionID]?.terminalEmitted
  1074	    }
  1075	
  1076	    /// M3：读取某个 session 当前是否还残留一个 pendingStop 条目——用于验证 stop() 的各条退出路径
  1077	    /// （成功/超时/抛错）收尾之后确实清干净了，没有泄漏。
  1078	    func testSupportHasPendingStop(sessionID: String) -> Bool {
  1079	        pendingStops[sessionID] != nil
  1080	    }
  1081	
  1082	    /// 读取某个 session 是否已经产出过 terminal sessionEnd（F8 去重的核心状态）。
  1083	    func testSupportSessionTerminalEmitted(sessionID: String) -> Bool {
  1084	        sessionTerminalEmitted.contains(sessionID)
  1085	    }
  1086	
  1087	    /// M1/M5：读取某个 approvalId 当前是否还残留在任一方向的双向 join 缓冲区里——用于验证
  1088	    /// pending-first/agent-first 两个方向在 join 成功后确实清掉了自己的缓存条目，以及 session
  1089	    /// 结束时孤儿条目（从未配对成功的）确实被批量清理。
  1090	    func testSupportHasBufferedApproval(approvalID: String) -> Bool {
  1091	        agentApprovalInfoByApprovalID[approvalID] != nil || pendingSessionApprovalByApprovalID[approvalID] != nil
  1092	    }
  1093	
