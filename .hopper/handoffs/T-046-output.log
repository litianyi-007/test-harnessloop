   681	        private static async Task<bool> TestStopDeleteFailureDoesNotContradictAlreadyEmittedOutcome()
   682	        {
   683	            var name = "M3 stop() active-run success + sessions.delete deleted:false must not contradict already-emitted operation_completed(succeeded)";
   684	            var client = FreshClient();
   685	            var sessionId = "sess-stop-deletefail";
   686	            var kernelKey = "kernel-key-stop-deletefail";
   687	            var runId = "run-deletefail-1";
   688	            var channel = client.TestSupportRegisterSession(sessionId, kernelKey);
   689	
   690	            // 用一条无害的 run_status 帧模拟"目前有一个活跃 run"这一前置状态（刷新 lastRunId），走真实 dispatch。
   691	            client.TestSupportFeedFrame(new JSONObject
   692	            {
   693	                ["type"] = "event",
   694	                ["event"] = "agent",
   695	                ["payload"] = new JSONObject { ["runId"] = runId, ["sessionKey"] = kernelKey, ["stream"] = "run_status", ["data"] = new JSONObject() },
   696	            });
   697	
   698	            client.TestSupportStubRpc("sessions.abort", _ => Task.FromResult(new JSONObject { ["ok"] = true, ["abortedRunId"] = runId, ["status"] = "aborted" }));
   699	            client.TestSupportStubRpc("sessions.delete", _ => Task.FromResult(new JSONObject { ["deleted"] = false }));
   700	            var handle = TestHandle(sessionId, kernelKey);
   701	
   702	            var stopTask = client.StopAsync(handle);
   703	            // stop() 此刻已经发起 sessions.abort 并开始等待该 run 的 aborted lifecycle 终态——喂一条真实
   704	            // 形状的 aborted lifecycle 帧,唤醒等待、发出 operation_completed(succeeded)+turn_complete(cancelled)。
   705	            await Task.Delay(60);
   706	            client.TestSupportFeedFrame(new JSONObject
   707	            {
   708	                ["type"] = "event",
   709	                ["event"] = "agent",
   710	                ["payload"] = new JSONObject
   711	                {
   712	                    ["runId"] = runId,
   713	                    ["sessionKey"] = kernelKey,
   714	                    ["stream"] = "lifecycle",
   715	                    ["data"] = new JSONObject { ["phase"] = "end", ["status"] = "cancelled", ["aborted"] = true, ["stopReason"] = "rpc" },
   716	                    ["ts"] = 1_784_871_400_000L,
   717	                },
   718	            });
   719	
   720	            StopResultPayload result;
   721	            try { result = await stopTask; }
   722	            catch { return Fail(name, "stop() unexpectedly threw"); }
   723	            if (result.Outcome != StopResultPayloadOutcome.Succeeded)
   724	                return Fail(name, $"expected Promise outcome=.succeeded despite sessions.delete deleted:false, got {result.Outcome} — 修前会把它翻成 .rejected,与已经发出的 operation_completed(succeeded) 矛盾");
   725	
   726	            var events = await CollectUpToAsync(channel.Reader, 4);
   727	            if (events.Count != 3)
   728	                return Fail(name, $"expected exactly 3 events (operation_completed + turn_complete(cancelled) + session_end(stopped)), got {events.Count}");
   729	            if (events[0] is not OperationCompletedEventMessageCase op || op.Value.Payload.Outcome != PayloadOutcome.Succeeded || op.Value.Payload.OperationId != result.OperationId)
   730	                return Fail(name, "expected first event operation_completed(succeeded) matching Promise operationId");
   731	            if (events[1] is not TurnCompleteEventMessageCase turn || turn.Value.Payload.StopReason != StopReason.Cancelled)
