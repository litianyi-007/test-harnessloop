   161	        // MARK: - ②b agent(stream:"item", kind:"tool") -> toolResult（非 exec 工具族）
   162	
   163	        public static EventMessageUnion? MapOpenclawAgentToolItemToToolResult(
   164	            JSONObject data, string ourSessionId, string? runIdHint, DateTimeOffset originTs, Func<long> nextSeq)
   165	        {
   166	            if (OpenclawWire.JsonString(data.Get("kind")) != "tool") return null;
   167	            if (OpenclawWire.JsonString(data.Get("phase")) != "end") return null;
   168	            var toolCallId = OpenclawWire.JsonString(data.Get("toolCallId"));
   169	            if (toolCallId == null) return null;
   170	
   171	            var status = OpenclawWire.JsonString(data.Get("status"));
   172	            var isError = status != "completed";
   173	            long? durationMs = null;
   174	            var started = OpenclawWire.JsonInt(data.Get("startedAt"));
   175	            var ended = OpenclawWire.JsonInt(data.Get("endedAt"));
   176	            if (started.HasValue && ended.HasValue) durationMs = Math.Max(0, ended.Value - started.Value);
   177	
   178	            // 诚实置空——非 exec 工具的 output 字段本轮无真实来源，不编造（见 Swift 源同名函数文档注释）。
   179	            var resultPayload = new ToolResultEventMessagePayload { DurationMs = durationMs, IsError = isError, Output = null, ToolCallId = toolCallId };
   180	            return new ToolResultEventMessage
   181	            {
   182	                Direction = MessageDeltaEventMessageDirection.Event, Payload = resultPayload, RunId = runIdHint,
   183	                SentAt = DateTimeOffset.UtcNow, Seq = nextSeq(), SessionId = ourSessionId, Ts = originTs, Type = ToolResultEventMessageType.EvtToolResult,
   184	            }.AsUnion();
   185	        }
