   338	        public Task<InterruptResultPayload> InterruptAsync(SessionHandle session, InterruptRequestMessagePayload options, CancellationToken cancellationToken = default)
   339	            => throw new KernelClientException(KernelClientErrorKind.NotImplemented, "interrupt() 本轮 TODO 桩——L1 闭环没有 active run 需要 interrupt");
   340	
   341	        /// <summary>D1 §2.5 stop()。镜像 Swift `stop(session:)`（M3 rework，四条退出路径 + 锁/pendingStop 清理）。</summary>
   342	        public async Task<StopResultPayload> StopAsync(SessionHandle session, CancellationToken cancellationToken = default)
   343	        {
   344	            string kernelKey;
   345	            lock (_sync)
   346	            {
   347	                if (!_kernelKeyBySessionId.TryGetValue(session.SessionId, out kernelKey!))
   348	                    throw new KernelClientException(KernelClientErrorKind.ProtocolMismatch, $"unknown session {session.SessionId}");
   349	
   350	                var currentLock = _lockStateBySessionId.TryGetValue(session.SessionId, out var cl) ? cl : SessionLockState.Idle;
   351	                if (currentLock != SessionLockState.Idle)
   352	                    throw new KernelClientException(KernelClientErrorKind.RpcRejected,
   353	                        $"stop() rejected: session {session.SessionId} lock state is {Describe(currentLock)}, expected idle (D1 v3.1 §9.3)", "session_locked");
   354	
   355	                _lockStateBySessionId[session.SessionId] = SessionLockState.StopInProgress;
   356	            }
   357	
   358	            var operationId = $"op-stop-{Guid.NewGuid()}";
   359	            string? affectedRunIdBeforeAbort;
   360	            lock (_sync)
   361	            {
   362	                _lastRunIdBySessionId.TryGetValue(session.SessionId, out affectedRunIdBeforeAbort);
   363	                _pendingStops[session.SessionId] = new PendingStop(operationId, affectedRunIdBeforeAbort);
   364	            }
   365	
   366	            try
   367	            {
   368	                var abortResult = await RequestAsync("sessions.abort", new JSONObject { ["key"] = kernelKey });
   369	                OpenclawWire.PrettyPrint("RECV sessions.abort result", abortResult);
   370	
   371	                // 是否需要等待，由 sessions.abort 自己的返回值判断，不是本地缓存的 affectedRunID。
   372	                var actuallyAbortedRunId = OpenclawWire.JsonString(abortResult.Get("abortedRunId"));
   373	                bool timedOut = false;
   374	                if (actuallyAbortedRunId != null)
   375	                {
   376	                    // M3：用权威值覆盖，不再信任 abort 前的本地缓存。
   377	                    lock (_sync) { if (_pendingStops.TryGetValue(session.SessionId, out var p)) p.AffectedRunId = actuallyAbortedRunId; }
   378	                    int timeoutSeconds;
   379	                    lock (_sync) { timeoutSeconds = _testStopTimeoutSecondsOverride ?? 5; }
   380	                    timedOut = await WaitForPendingStopTerminalAsync(session.SessionId, timeoutSeconds);
   381	                    if (timedOut)
   382	                    {
   383	                        EmitOperationCompletedMirror(session.SessionId, operationId, actuallyAbortedRunId, PayloadOutcome.TimedOut);
   384	                    }
   385	                }
   386	                else
   387	                {
   388	                    // 这次 stop() 生效时该 run 早已自然结束——没有可等待的终态，但 Promise 即将报
   389	                    // succeeded，必须同时给事件流补一条 operation_completed 镜像。
   390	                    lock (_sync) { _pendingStops.Remove(session.SessionId); }
   391	                    EmitOperationCompletedMirror(session.SessionId, operationId, null, PayloadOutcome.Succeeded);
   392	                }
   393	
   394	                var deleteResult = await RequestAsync("sessions.delete", new JSONObject { ["key"] = kernelKey });
   395	                OpenclawWire.PrettyPrint("RECV sessions.delete result", deleteResult);
   396	                var deleted = OpenclawWire.JsonBool(deleteResult.Get("deleted")) ?? false;
   397	                if (!deleted)
   398	                {
   399	                    // 诚实记录：delete 未确认成功，但不据此把已经发出/即将返回的 succeeded 倒转成
   400	                    // rejected——delete 是资源回收收尾步骤，和"stop 本身有没有成功"是两件事。
   401	                    OpenclawWire.PrettyPrint("WARN sessions.delete reported deleted:false after stop() otherwise succeeded", deleteResult);
   402	                }
   403	
   404	                EmitStopSessionEndAndFinish(session);
   405	
   406	                var outcome = timedOut ? StopResultPayloadOutcome.TimedOut : StopResultPayloadOutcome.Succeeded;
   407	                return new StopResultPayload { OperationId = operationId, Outcome = outcome };
   408	            }
   409	            catch (Exception)
   410	            {
   411	                // M3：sessions.abort/sessions.delete 抛错——释放锁 + 清理 pendingStop + 发一条
   412	                // operation_completed(rejected) 镜像，再把原始错误重新抛出。
   413	                string? affectedRunId;
   414	                lock (_sync) { affectedRunId = _pendingStops.TryGetValue(session.SessionId, out var p) ? p.AffectedRunId : affectedRunIdBeforeAbort; }
   415	                EmitOperationCompletedMirror(session.SessionId, operationId, affectedRunId, PayloadOutcome.Rejected);
   416	                lock (_sync)
   417	                {
   418	                    _pendingStops.Remove(session.SessionId);
   419	                    _lockStateBySessionId.Remove(session.SessionId);
   420	                }
   421	                throw;
   422	            }
   423	        }
   424	
   425	        /// <summary>M3：为 stop() 不会经过真实 aborted lifecycle 帧的路径补一条 operation_completed 镜像。</summary>
   426	        private void EmitOperationCompletedMirror(string sessionId, string operationId, string? affectedRunId, PayloadOutcome outcome)
   427	        {
   428	            bool hasChannel;
   429	            lock (_sync) { hasChannel = _eventChannels.ContainsKey(sessionId); }
   430	            if (!hasChannel) return;
   431	
   432	            var opPayload = new OperationCompletedEventMessagePayload
   433	            {
   434	                AffectedRunId = affectedRunId, Detail = null, NewRunId = null,
   435	                OperationId = operationId, OperationKind = OperationKind.Stop, Outcome = outcome,
   436	            };
   437	            var evt = new OperationCompletedEventMessage
   438	            {
   439	                Direction = MessageDeltaEventMessageDirection.Event, Payload = opPayload, RunId = affectedRunId,
   440	                SentAt = DateTimeOffset.UtcNow, Seq = NextSeq(affectedRunId, sessionId),
   441	                SessionId = sessionId, Ts = DateTimeOffset.UtcNow, Type = OperationCompletedEventMessageType.EvtOperationCompleted,
   442	            }.AsUnion();
   443	            Yield(sessionId, evt);
   444	        }
   445	
   446	        /// <summary>stop() 成功路径的收尾：F8 去重 + yield session_end(stopped) + finish 事件流。</summary>
   447	        private void EmitStopSessionEndAndFinish(SessionHandle session)
   448	        {
   449	            bool already;
   450	            lock (_sync)
   451	            {
   452	                already = _sessionTerminalEmitted.Contains(session.SessionId);
   453	                if (!already) _sessionTerminalEmitted.Add(session.SessionId);
   454	            }
   455	            if (!already)
   456	            {
   457	                var sid = session.SessionId;
   458	                Yield(sid, EventMapping.MakeSessionEndEventForStop(sid, () => NextSeq(null, sid)));
   459	            }
   460	            FinishEventContinuation(session.SessionId);
   461	            lock (_sync) { _kernelKeyBySessionId.Remove(session.SessionId); }
   462	        }
   463	
   464	        private async Task<bool> WaitForPendingStopTerminalAsync(string sessionId, int timeoutSeconds)
   465	        {
   466	            TaskCompletionSource<bool> tcs;
   467	            lock (_sync)
   468	            {
   469	                if (!_pendingStops.TryGetValue(sessionId, out var pending) || pending.TerminalEmitted) return false;
   470	                tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
   471	                pending.Waiter = tcs;
   472	            }
   473	            _ = Task.Run(async () =>
   474	            {
   475	                await Task.Delay(TimeSpan.FromSeconds(timeoutSeconds));
   476	                ResolvePendingStopWaiter(sessionId, timedOut: true);
   477	            });
   478	            return await tcs.Task;
   479	        }
   480	
   481	        private void ResolvePendingStopWaiter(string sessionId, bool timedOut)
   482	        {
   483	            TaskCompletionSource<bool>? waiter;
   484	            lock (_sync)
   485	            {
   486	                if (!_pendingStops.TryGetValue(sessionId, out var pending) || pending.Waiter == null) return;
   487	                waiter = pending.Waiter;
   488	                pending.Waiter = null;
   489	            }
   490	            waiter.TrySetResult(timedOut);
   491	        }
