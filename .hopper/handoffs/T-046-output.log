   699	    private func handleIncoming(_ data: Data) {
   700	        guard let frame = try? decodeFrame(data) else { return }
   701	        guard let type = frame["type"] as? String else { return }
   702	
   703	        switch type {
   704	        case "res":
   705	            guard let id = frame["id"] as? String else { return }
   706	            guard let continuation = pending.removeValue(forKey: id) else { return }
   707	            let ok = (frame["ok"] as? Bool) ?? false
   708	            if ok {
   709	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   710	                continuation.resume(returning: payload)
   711	            } else {
   712	                let err = (frame["error"] as? JSONObject) ?? [:]
   713	                let code = (err["code"] as? String) ?? "unknown"
   714	                let message = err["message"] as? String
   715	                continuation.resume(throwing: KernelClientError.rpcRejected(code: code, message: message))
   716	            }
   717	
   718	        case "event":
   719	            guard let eventName = frame["event"] as? String else { return }
   720	            if let waiter = oneShotEventWaiters.removeValue(forKey: eventName) {
   721	                let payload = (frame["payload"] as? JSONObject) ?? [:]
   722	                waiter.resume(returning: payload)
   723	                return
   724	            }
   725	            // session.message 之外还要分发 agent(command_output/lifecycle/thinking/error/item/
   726	            // approval)、session.approval、全局 shutdown 三类 wire 事件——D2 11 变体里除
   727	            // message_delta/tool_call 之外的大多数都不是从 session.message 来的。
   728	            switch eventName {
   729	            case "session.message":
   730	                handleSessionMessageEvent(frame)
   731	            case "agent":
   732	                handleAgentEvent(frame)
   733	            case "session.approval":
   734	                handleSessionApprovalEvent(frame)
   735	            case "shutdown":
   736	                handleShutdownEvent(frame)
   737	            default:
   738	                prettyPrint("RECV event \(eventName) (未处理的旁路事件，原样打印)", frame)
   739	            }
   740	
   741	        default:
   742	            break
   743	        }
   744	    }
