   503	        // MARK: - M1：send()/stop() 会话锁——真实获取/拒绝/自动释放
   504	
   505	        private static async Task<bool> TestSendLockRealAcquireRejectAndRelease()
   506	        {
   507	            var name = "M1 send() real session lock: acquire during in-flight RPC, reject concurrent, auto-release after";
   508	            var client = FreshClient();
   509	            var sessionId = "sess-send-real-lock";
   510	            var kernelKey = "kernel-key-send-real-lock";
   511	            client.TestSupportRegisterSession(sessionId, kernelKey);
   512	            client.TestSupportStubRpc("sessions.send", async _ =>
   513	            {
   514	                await Task.Delay(200); // 200ms 窗口,足够第二次并发 send() 在这期间被拒绝
   515	                return new JSONObject { ["runId"] = "run-real-lock-1", ["status"] = "started", ["messageSeq"] = 1L };
   516	            });
   517	            var handle = TestHandle(sessionId, kernelKey);
   518	
   519	            var initialLock = client.TestSupportLockState(sessionId);
   520	            if (initialLock != "idle") return Fail(name, $"expected initial lock idle, got {initialLock}");
   520	            if (initialLock != "idle") return Fail(name, $"expected initial lock idle, got {initialLock}");
   521	
   522	            var firstSend = client.SendAsync(handle, new Input { Kind = InputKind.Text, Text = "first" });
   523	            await Task.Delay(40); // 足够第一次 send() 真实拿到锁、进入 RPC 等待
   524	
   525	            var lockDuringFlight = client.TestSupportLockState(sessionId);
   526	            if (lockDuringFlight != "send_pending")
   527	                return Fail(name, $"expected lock=send_pending while first send() RPC in flight, got {lockDuringFlight} — 说明锁没有被真实获取");
   528	
   529	            try
   530	            {
   531	                await client.SendAsync(handle, new Input { Kind = InputKind.Text, Text = "second" });
   532	                return Fail(name, "expected concurrent second send() to be rejected while first is in flight");
   533	            }
   534	            catch (KernelClientException ex) when (ex.Kind == KernelClientErrorKind.RpcRejected && ex.Code == "session_locked")
   535	            {
   536	                // 期望路径
   537	            }
   538	            catch (Exception ex)
   539	            {
   540	                return Fail(name, $"unexpected error from concurrent send(): {ex}");
   541	            }
   542	
   543	            SendResultPayload firstResult;
   544	            try
   545	            {
   546	                firstResult = await firstSend;
   547	            }
   548	            catch
   549	            {
   550	                return Fail(name, "first send() did not complete as expected");
   551	            }
   552	            if (firstResult.RunId != "run-real-lock-1") return Fail(name, "first send() did not complete as expected");
   553	
   554	            var lockAfter = client.TestSupportLockState(sessionId);
   555	            if (lockAfter != "idle") return Fail(name, $"expected lock released back to idle after first send() completes, got {lockAfter}");
   556	
   557	            return Pass(name, "真实并发下: 第一次 send() 在飞行中持锁 send_pending,第二次被拒 session_locked,完成后锁自动释放回 idle");
   558	        }
