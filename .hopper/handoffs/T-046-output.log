   528	        private void Yield(string sessionId, EventMessageUnion evt)
   529	        {
   530	            Channel<EventMessageUnion>? channel;
   531	            lock (_sync) { _eventChannels.TryGetValue(sessionId, out channel); }
   532	            channel?.Writer.TryWrite(evt);
   533	        }
