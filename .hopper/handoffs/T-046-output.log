    42	        /// <summary>收集 channel 上最多 maxCount 个事件，超过 timeoutMs 还没凑够就提前放弃。</summary>
    43	        private static async Task<List<EventMessageUnion>> CollectUpToAsync(
    44	            ChannelReader<EventMessageUnion> reader, int maxCount, int timeoutMs = 300)
    45	        {
    46	            var events = new List<EventMessageUnion>();
    47	            using var cts = new CancellationTokenSource(TimeSpan.FromMilliseconds(timeoutMs));
    48	            for (int i = 0; i < maxCount; i++)
    49	            {
    50	                try
    51	                {
    52	                    events.Add(await reader.ReadAsync(cts.Token));
    53	                }
    54	                catch
    55	                {
    56	                    break;
    57	                }
    58	            }
    59	            return events;
    60	        }
