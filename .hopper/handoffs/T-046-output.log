   196	        public async Task<SessionHandle> CreateSessionAsync(Config config, CancellationToken cancellationToken = default)
   197	        {
   198	            var parameters = new JSONObject { ["label"] = "sg4-kernel-client-l1" };
   199	            if (config.Model != null) parameters["model"] = config.Model;
   200	            var result = await RequestAsync("sessions.create", parameters);
   201	            OpenclawWire.PrettyPrint("RECV sessions.create result", result);
   202	
   203	            if (OpenclawWire.JsonString(result.Get("key")) is not string kernelKey)
   204	                throw new KernelClientException(KernelClientErrorKind.ProtocolMismatch, "sessions.create result missing 'key' field");
   205	            var kernelSessionId = OpenclawWire.JsonString(result.Get("sessionId"));
   206	
   207	            var ourSessionId = Guid.NewGuid().ToString();
   208	            lock (_sync) { _kernelKeyBySessionId[ourSessionId] = kernelKey; }
   209	
   210	            // billing.tokenRef 本轮是占位符——见 Swift 侧同名注释，未实现 newapi token 铸造。
   211	            return new SessionHandle
   212	            {
   213	                Billing = new Billing { TokenRef = "TODO-sg4-no-newapi-token-minted" },
   214	                CreatedAt = DateTimeOffset.UtcNow,
   215	                Kernel = D2.Kernel.Openclaw,
   216	                KernelSessionId = kernelSessionId ?? kernelKey,
   217	                SessionId = ourSessionId,
   218	            };
   219	        }
   220	
   221	        private static string ResolveSendMessageText(Input input)
   222	        {
   223	            if (input.Kind == InputKind.Text) return input.Text ?? "";
   224	            var texts = (input.Parts ?? Array.Empty<Part>())
   225	                .Where(p => p.Kind == PartKind.Text)
   226	                .Select(p => p.Text)
   227	                .Where(t => t != null)
   228	                .Select(t => t!);
   229	            return string.Join("\n", texts);
   230	        }
   231	
   232	        /// <summary>D1 §2.2 send()。F1：session 级 send_pending 互斥锁——镜像 Swift `send(session:input:)`。</summary>
   233	        public async Task<SendResultPayload> SendAsync(SessionHandle session, Input input, CancellationToken cancellationToken = default)
   234	        {
   235	            string kernelKey;
   236	            lock (_sync)
   237	            {
   238	                if (!_kernelKeyBySessionId.TryGetValue(session.SessionId, out kernelKey!))
   239	                    throw new KernelClientException(KernelClientErrorKind.ProtocolMismatch, $"unknown session {session.SessionId}");
   240	
   241	                var currentLock = _lockStateBySessionId.TryGetValue(session.SessionId, out var cl) ? cl : SessionLockState.Idle;
   242	                if (currentLock != SessionLockState.Idle)
   243	                    throw new KernelClientException(KernelClientErrorKind.RpcRejected,
   244	                        $"send() rejected: session {session.SessionId} lock state is {Describe(currentLock)}, expected idle (D1 v3.1 §9.3)", "session_locked");
   245	
   246	                _lockStateBySessionId[session.SessionId] = SessionLockState.SendPending;
   247	            }
   248	
   249	            try
   250	            {
   251	                var parameters = new JSONObject
   252	                {
   253	                    ["key"] = kernelKey,
   254	                    ["message"] = ResolveSendMessageText(input),
   255	                    ["timeoutMs"] = 0L,
   256	                };
   257	                // F2：attachment 改发 openclaw 期望的 `content`（base64）编码。
   258	                if (input.Kind == InputKind.Structured && input.Parts != null)
   259	                {
   260	                    var attachments = input.Parts
   261	                        .Where(p => p.Kind != PartKind.Text)
   262	                        .Select(OpenclawWire.EncodeAttachmentForWire)
   263	                        .Where(a => a != null)
   264	                        .Select(a => (object?)a)
   265	                        .ToList();
   266	                    if (attachments.Count > 0) parameters["attachments"] = attachments;
   267	                }
   268	
   269	                var result = await RequestAsync("sessions.send", parameters);
   270	                OpenclawWire.PrettyPrint("RECV sessions.send result", result);
   271	
   272	                if (OpenclawWire.JsonString(result.Get("runId")) is not string runId)
   273	                    throw new KernelClientException(KernelClientErrorKind.ProtocolMismatch, "sessions.send result missing 'runId' field");
   274	
   275	                lock (_sync)
   276	                {
   277	                    _lastRunIdBySessionId[session.SessionId] = runId;
   278	                    if (!_runIdsBySessionId.TryGetValue(session.SessionId, out var set))
   279	                        _runIdsBySessionId[session.SessionId] = set = new HashSet<string>();
   280	                    set.Add(runId);
   281	                }
   282	                return new SendResultPayload { RunId = runId };
   283	            }
   284	            finally
   285	            {
   286	                // send_pending 只是"等待 kernel ack"的极短窗口——ack 到达（无论成功失败）后立刻释放。
   287	                lock (_sync)
   288	                {
   289	                    if (_lockStateBySessionId.TryGetValue(session.SessionId, out var cl) && cl == SessionLockState.SendPending)
   290	                        _lockStateBySessionId[session.SessionId] = SessionLockState.Idle;
   291	                }
   292	            }
   293	        }
   294	
   295	        /// <summary>
   296	        /// D1 §2.3 subscribe()。镜像 Swift `subscribe(session:)`——**特意不用 `async IAsyncEnumerable`
   297	        /// 迭代器写法**，见文件头注释：本方法体同步立即执行（注册 channel + fire-and-forget 后台任务
   298	        /// 发起 RPC），调用即生效，不等调用方开始枚举。
   299	        /// </summary>
   300	        public IAsyncEnumerable<EventMessageUnion> Subscribe(SessionHandle session, CancellationToken cancellationToken = default)
   301	        {
   302	            var channel = Channel.CreateUnbounded<EventMessageUnion>();
   303	            lock (_sync) { _eventChannels[session.SessionId] = channel; }
   304	
   305	            _ = Task.Run(async () =>
   306	            {
   307	                string? kernelKey;
   308	                lock (_sync) { _kernelKeyBySessionId.TryGetValue(session.SessionId, out kernelKey); }
   309	                if (kernelKey == null)
   310	                {
   311	                    channel.Writer.TryComplete(new KernelClientException(KernelClientErrorKind.ProtocolMismatch, $"unknown session {session.SessionId}"));
   312	                    return;
   313	                }
   314	                try
   315	                {
   316	                    // includeApprovals:true——不带这个 flag 收不到 session.approval 事件。
   317	                    var result = await RequestAsync("sessions.messages.subscribe", new JSONObject { ["key"] = kernelKey, ["includeApprovals"] = true });
   318	                    OpenclawWire.PrettyPrint("RECV sessions.messages.subscribe result", result);
   319	                    if (OpenclawWire.JsonBool(result.Get("subscribed")) is false)
   320	                    {
   321	                        channel.Writer.TryComplete(new KernelClientException(KernelClientErrorKind.ProtocolMismatch, "subscribe returned subscribed:false"));
   322	                    }
   323	                    else
   324	                    {
   325	                        // M1：消费 approvalReplay——authoritative 的当前 pending 审批快照。
   326	                        ConsumeApprovalReplay(result, kernelKey);
   327	                    }
   328	                }
   329	                catch (Exception ex)
   330	                {
   331	                    channel.Writer.TryComplete(ex);
   332	                }
   333	            });
   334	
   335	            return channel.Reader.ReadAllAsync(cancellationToken);
   336	        }
