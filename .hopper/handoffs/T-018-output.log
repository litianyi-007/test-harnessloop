    87	## 2. 消息封套（Envelope）（v2 重写：字段分名 + 判别联合改用可实例化的封套模板）
    88	
    89	```ts
    90	/** 所有线上消息共享的头部字段——D2 专属传输元数据，不承载任何 D1 业务语义（v2 修复 1）*/
    91	interface MessageEnvelopeBase {
    92	  /** 判别字段，见下方三类方向的具体命名约定，§3.9/§4.1 给出封闭枚举实例化 */
    93	  type: string;
    94	  /** ISO-8601 UTC，本消息被封套/序列化发出的时刻——纯 D2 传输层字段。
    95	      event 消息另有 EventEnvelope.ts 字段，逐字透传 D1 KernelEventBase.ts（业务语义：
    96	      事件发生时刻），两者是两个独立字段、不同名、都保留——不再像 v1 那样共用 `ts` 这个名字
    97	      导致 D1 业务时间戳在线上没有位置（v1 F-02/BLOCKER，见 d2-review-dual-track §2）。*/
    98	  sentAt: string;
    99	}
   100	
   101	/** request 封套模板：TType/TPayload 由 §3.9 逐方法字面量实例化后 union 起来才是本页最终的
   102	    封闭判别联合——本身不是可以被"req.foo"任意扩展的开放形状（v2 修复 3）。 */
   103	interface RequestEnvelope<TType extends string, TPayload> extends MessageEnvelopeBase {
   104	  direction: 'request';
   105	  type: TType;
   106	  id: string;                    // 本次请求的关联 id，UI 侧铸造，同一条连接内唯一；
   107	                                  // 不是 D1 的 operationId，见下方"两个 id 不要混淆"
   108	  sessionId?: string;            // 除 createSession（尚无 session 可寻址）与 capabilities
   109	                                  // （D1 §2.7 明确允许 session?: SessionHandle 可选参数，见 §3.7）
   110	                                  // 两个例外外，其余方法均需要一个已存在的 session 作为寻址目标——
   111	                                  // v1 的注释遗漏了 capabilities 例外（codex T-015 finding，见
   112	                                  // d2-review-dual-track §3.5），v2 §3.9 在类型层面直接体现两个
   113	                                  // 例外，不再只靠注释承诺
   114	  payload: TPayload;
   115	}
   116	
   117	/** response 封套模板：success/failure 互斥判别联合（同一 TType 下恰好一个存在，不允许同时
   118	    存在或同时缺失）——v1 用两个独立可选字段（result?/failure?）表达"从不同时存在"的意图，
   119	    但 TS 类型本身不强制；v2 改用 `?: never` 配对写法，使类型系统本身拒绝二者同时出现或
   120	    同时缺失（v2 修复 3，消解 codex HIGH：判别联合不封闭）。*/
   121	type ResponseEnvelope<TType extends string, TSuccess, TFailure> =
   122	  | (MessageEnvelopeBase & {
   123	      direction: 'response';
   124	      type: TType;
   125	      id: string;                 // 回填触发它的 request 的 id
   126	      sessionId?: string;
   127	      result: TSuccess;
   128	      failure?: never;
   129	    })
   130	  | (MessageEnvelopeBase & {
   131	      direction: 'response';
   132	      type: TType;
   133	      id: string;
   134	      sessionId?: string;
   135	      result?: never;
   136	      failure: TFailure;
   137	    });
   138	
   139	/** event 封套模板：内核 → UI，单向推流，没有对应的 request，也不产生 response。
   140	    新增 `ts` 字段——D1 KernelEventBase.ts 的逐字透传位（v2 修复 1）。*/
   141	interface EventEnvelope<TType extends string, TPayload> extends MessageEnvelopeBase {
   142	  direction: 'event';
   143	  type: TType;
   144	  seq: number;                   // D1 KernelEventBase.seq 的线上表示，见 §8；只在 event 消息上出现
   145	  sessionId: string;
   146	  runId?: string;                // 部分事件类型将其收紧为必填，见 §4 逐类说明/§4.1 类型层面覆盖
   147	  ts: string;                    // D1 KernelEventBase.ts，业务语义：事件发生时刻，逐字透传 D1 值——
   148	                                  // 与 envelope 的 sentAt（封套发出时刻）是两个独立字段，不再共用
   149	                                  // 一个 `ts` 名字（v2 修复 1，消解 grok F-02/codex BLOCKER）
   150	  payload: TPayload;
   151	}
   152	```
