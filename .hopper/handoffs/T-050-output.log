   569	// MARK: - mock_response
   570	
   571	func applyMockResponse(_ op: TimelineOp, ctx: RunnerContext) async throws {
   572	    guard let replyTo = op.replyTo else {
   573	        throw RunnerError.malformed("mock_response 缺少 replyTo（t=\(op.t)）")
   574	    }
   575	    guard let gate = await ctx.gate(for: replyTo) else {
   576	        throw RunnerError.malformed(
   577	            "mock_response(replyTo=\(replyTo)) 找不到对应的 reply gate——对应 client_call 未发起，" +
   578	            "或该方法不需要 gate（如 subscribe）"
   579	        )
   580	    }
   581	    let messageAny = (op.message?.value as? [String: Any]) ?? [:]
   582	    let kind = await ctx.callKind(for: replyTo) ?? ""
   583	
   584	    if let failure = messageAny["failure"] as? [String: Any] {
   585	        let code = (failure["code"] as? String) ?? "unknown"
   586	        let detail = failure["detail"] as? String
   587	        await gate.resolve(.failure(KernelClientError.rpcRejected(code: code, message: detail)))
   588	        return
   589	    }
   590	
   591	    let result = (messageAny["result"] as? [String: Any]) ?? [:]
   592	
   593	    switch kind {
   594	    case "createSession":
   595	        let sessionId = (result["sessionHandle"] as? [String: Any])?["sessionId"] as? String
   596	        let key = "openclaw-key-\(sessionId ?? UUID().uuidString)"
   597	        await ctx.setCurrentKernelKey(key)
   598	        if let sessionId = sessionId {
   599	            // T-048 REWORK #4：记下 fixture 自己声明的 sessionId，供后续请求的 expect_outbound
   600	            // 规范化用（不是真实随机 UUID，见 RunnerContext.declaredSessionID 文档注释）。
   601	            await ctx.setDeclaredSessionID(sessionId)
   602	        }
   603	        await gate.resolve(.success(["key": key, "sessionId": sessionId ?? key]))
   604	
   605	    case "send":
   606	        let runId = (result["runId"] as? String) ?? "run-\(UUID().uuidString.prefix(8))"
   607	        await gate.resolve(.success(["runId": runId, "status": "started", "messageSeq": 1]))
   608	
   609	    case "subscribe":
   610	        let kernelKey = await ctx.currentKernelKeyValue ?? ""
   611	        await gate.resolve(.success(["subscribed": true, "key": kernelKey]))
   612	
   613	    case "stop":
   614	        // T-048 REWORK #1（删除非法 `_openclawAbortAck`）：真实 sessions.abort RPC ack 该携带的
   615	        // `abortedRunId`/`status`，从合法 canonical 字段无歧义派生——『此前是否已经有一个 send()
   616	        // 真实 resolve 出一个 runId』（`ctx.currentRunIDValue`，取自 res.send 的 runId，真实 client
   617	        // 内部铸造，不是伪造）本身就唯一决定了这次 stop() 命中时是否存在 active run，不需要 fixture
   618	        // 作者再声明一个只有本 runner 认得的私有提示字段——`message.result`（D2 合法 `succeeded/
   619	        // timed_out/rejected` 三态枚举）本身在这条路径上是纯装饰性的（真实 client 从不读它，只读
   620	        // `abortedRunId`；最终 OperationOutcome 由下面 mock_event/advance_clock/disconnect 决定），
   621	        // 因此这里完全不读 `result`。
   622	        let activeRunID = await ctx.currentRunIDValue
   623	        if let activeRunID = activeRunID {
   624	            await gate.resolve(.success(["abortedRunId": activeRunID, "status": "aborted"]))
   625	            await ctx.setHasStopWaitingForTerminal(true)
   626	            await ctx.setWaitingStopCallID(replyTo)
   627	        } else {
   628	            await gate.resolve(.success(["abortedRunId": NSNull(), "status": "no-active-run"]))
   629	        }
   630	
   631	    default:
   632	        throw RunnerError.malformed("mock_response(replyTo=\(replyTo)): 未知 client_call 类型『\(kind)』")
   633	    }
   634	}
