   525	// MARK: - expect_outbound
   526	
   527	/// D2 req.* 方法名 → 真实 client 会调用的 openclaw 原生 RPC 方法名。只覆盖 Stage A 用到的四个方法
   528	/// （interrupt/respondApproval/capabilities 对应的 fixture 已被整条 DEGRADED，不会走到这里）。
   529	let expectOutboundMethodTable: [String: String] = [
   530	    "req.createSession": "sessions.create",
   531	    "req.send": "sessions.send",
   532	    "req.subscribe": "sessions.messages.subscribe",
   533	    "req.stop": "sessions.abort",
   534	]
   535	
   536	func checkExpectOutbound(_ op: TimelineOp, ctx: RunnerContext) async throws {
   537	    guard let matches = op.matches else {
   538	        throw RunnerError.malformed("expect_outbound 缺少 matches（t=\(op.t)）")
   539	    }
   540	    let patternAny = (op.pattern?.value as? [String: Any]) ?? [:]
   541	    guard let expectedType = patternAny["type"] as? String else {
   542	        throw RunnerError.malformed("expect_outbound(\(matches)) 的 pattern 缺少 'type'")
   543	    }
   544	    guard let expectedMethod = expectOutboundMethodTable[expectedType] else {
   545	        await ctx.appendMismatch(
   546	            "expect_outbound(\(matches)): swift-runner 未登记『\(expectedType)』对应的 openclaw RPC 方法名" +
   547	            "（该 D2 方法本轮 SG-5 未实现，或超出 Stage A 翻译范围）"
   548	        )
   549	        return
   550	    }
   551	    let captured = await ctx.capturedOutboundMethod(for: matches)
   552	    guard captured == expectedMethod else {
   553	        await ctx.appendMismatch(
   554	            "expect_outbound(\(matches)): 期望真实 client 调用底层 openclaw RPC 方法『\(expectedMethod)』" +
   555	            "（对应 D2『\(expectedType)』），实际捕获到『\(captured ?? "<none>")』"
   556	        )
   557	        return
   558	    }
   559	    // T-048 REWORK #4：方法名匹配之后，不再到此为止——继续对一个『规范化请求』
   560	    // （`performClientCall` 在捕获真实 outbound 的同一时刻构造，见该函数与 RunnerContext.
   561	    // capturedOutbound 的文档注释）做与 `ts-runner/runner.ts` 的 `partialMatch` 等价的完整子集深度
   562	    // 匹配，让 pattern 里 `type` 之外的字段（如 basic fixture 的 `sessionId`、interrupt 的
   563	    // `payload.mode`）也真正生效，不再被静默丢弃。
   564	    let normalized = await ctx.capturedNormalizedRequest(for: matches) ?? ["type": expectedType]
   565	    let diff = partialMatch(actual: normalized, expected: patternAny, path: "expect_outbound(\(matches))")
   566	    for d in diff { await ctx.appendMismatch(d) }
   567	}
