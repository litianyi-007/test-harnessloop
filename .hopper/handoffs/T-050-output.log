   175	// MARK: - RunnerContext：一次 fixture 执行期间的全部可变状态（actor 隔离，天然并发安全）
   176	
   177	actor RunnerContext {
   178	    let client: OpenclawGatewayKernelClient
   179	
   180	    /// 真实收窄后的 stop() 等待超时（秒）——见文件头「虚拟时钟」一节的说明。
   181	    static let stopTimeoutSeconds = 1
   182	    static let stopTimeoutMs: UInt64 = 1000
   183	
   184	    var currentSessionHandle: SessionHandle?
   185	    var currentSessionID: String?
   186	    var currentKernelKey: String?
   187	    var currentRunID: String?
   188	
   189	    /// fixture 自己在 `res.createSession` mock_response 里声明过的 `sessionHandle.sessionId`
   190	    /// （如 "session-1"）——**不是**真实 client 内部铸造的随机 `SessionHandle.sessionID`（那个是
   191	    /// `currentSessionID`，真实状态查询如 `testSupportLockState` 必须用它）。只用于
   192	    /// `expect_outbound` 规范化请求里的 `sessionId` 字段，校验『同一 fixture 内前后请求引用同一个
   193	    /// 已声明会话』这条内部一致性（T-048 REWORK #4）。
   194	    var declaredSessionID: String?
   195	
   196	    /// 当前是否有一个 `stop()` client_call 正在等待 SG-5 内部终态确认（`hasStopWaitingForTerminal`
   197	    /// 为 true 期间）——记录是*哪一个* client_call id，供 `advance_clock`/`disconnect` 轮询
   198	    /// `isCallSettled(id:)` 时知道该盯哪个 id（T-048 REWORK #5）。
   199	    var waitingStopCallID: String?
   200	
   201	    var callKindByID: [String: String] = [:]
   202	    var replyGates: [String: ReplyGate] = [:]
   203	    /// `normalizedRequest`：T-048 REWORK #4 新增——`expect_outbound` 用于完整 pattern 匹配的规范化
   204	    /// 请求（`type` + 可选 `sessionId` + `payload`），在 stub 闭包捕获真实 outbound 的同一时刻构造，
   205	    /// 见 `performClientCall`。
   206	    var capturedOutbound: [String: (method: String, params: JSONObject, normalizedRequest: [String: Any])] = [:]
   207	
   208	    /// `client_call` 的 id → OperationOutcome（interrupt/stop 铸造的 operation 通道）——dsl.ts 明确
   209	    /// 允许键是『operationId 或 client_call 的 id』，本 runner 一律用后者（真实 operationId 是运行时
   210	    /// 随机 UUID，fixture 无法预先声明，见文件头说明）。
   211	    var pendingOperations: [String: Any] = [:]
   212	    var callOutcomes: [String: Any] = [:]
   213	    var approvalState: [String: Any] = [:]
   214	    var drainedEvents: [[String: Any]] = []
   215	
   216	    var pendingTasks: [Task<Void, Never>] = []
   217	    var accumulatedMismatches: [Mismatch] = []
   218	    var hasStopWaitingForTerminal = false
   219	
   220	    init(client: OpenclawGatewayKernelClient) {
   221	        self.client = client
   222	    }
   223	
   224	    func recordOutbound(id: String, method: String, params: JSONObject, normalizedRequest: [String: Any]) {
   225	        capturedOutbound[id] = (method, params, normalizedRequest)
   226	    }
   227	
   228	    func capturedOutboundMethod(for id: String) -> String? {
   229	        capturedOutbound[id]?.method
   230	    }
   231	
   232	    func capturedNormalizedRequest(for id: String) -> [String: Any]? {
   233	        capturedOutbound[id]?.normalizedRequest
   234	    }
   235	
   236	    func gate(for id: String) -> ReplyGate? { replyGates[id] }
   237	    func callKind(for id: String) -> String? { callKindByID[id] }
   238	    func setCurrentKernelKey(_ key: String) { currentKernelKey = key }
   239	    func setDeclaredSessionID(_ id: String) { declaredSessionID = id }
   240	    func setHasStopWaitingForTerminal(_ value: Bool) { hasStopWaitingForTerminal = value }
   241	    func setWaitingStopCallID(_ id: String?) { waitingStopCallID = id }
   242	    var hasStopWaitingForTerminalValue: Bool { hasStopWaitingForTerminal }
   243	    var currentKernelKeyValue: String? { currentKernelKey }
   244	    var currentRunIDValue: String? { currentRunID }
   245	    var declaredSessionIDValue: String? { declaredSessionID }
   246	    var waitingStopCallIDValue: String? { waitingStopCallID }
   247	
   248	    /// T-048 REWORK #5：`advance_clock`/`disconnect` 用来判定『这次 stop() 的最终结果是否已经
   249	    /// 结算』的同步目标——`onStopResolved`/`onStopThrew` 写完 `pendingOperations`/`callOutcomes`
   250	    /// 才算数，这正是随后 `assert_state` 要读的同一份状态，比轮询 SG-5 内部 `terminalEmitted`
   250	    /// 才算数，这正是随后 `assert_state` 要读的同一份状态，比轮询 SG-5 内部 `terminalEmitted`
   251	    /// 更贴近真正需要同步的时刻（后者只代表 `waitForPendingStopTerminal` 已返回，`stop()` 自己还要
   252	    /// 再走 `sessions.delete` + `emitStopSessionEndAndFinish`，`onStopResolved` 还有自己的
   253	    /// `settleForEventDrain` 才会真正落笔）。
   254	    func isCallSettled(id: String) -> Bool {
   255	        pendingOperations[id] != nil || callOutcomes[id] != nil
   256	    }
   257	
   258	    func appendMismatch(_ m: Mismatch) { accumulatedMismatches.append(m) }
   259	    func addPendingTask(_ task: Task<Void, Never>) { pendingTasks.append(task) }
   260	
   261	    func onCreateSessionResolved(id: String, handle: SessionHandle) {
   262	        currentSessionHandle = handle
   263	        currentSessionID = handle.sessionID
   264	        callOutcomes[id] = ["status": "resolved"]
   265	    }
   266	
   267	    func onSendResolved(id: String, result: SendResultPayload) {
   268	        currentRunID = result.runID
   269	        callOutcomes[id] = ["status": "resolved"]
   270	    }
   271	
   272	    func onCallThrew(id: String, error: Error) {
   273	        callOutcomes[id] = ["status": "rejected", "failure": failureDict(for: error)]
   274	    }
   275	
   276	    /// `emitOperationCompletedMirror` 在真实 `stop()` 内部是同步调用（`continuation.yield(...)`），
   277	    /// 但 yield 唤醒本 runner 的事件排空 Task（`startDraining` 里 `iterator.next()`）、再由它
   278	    /// `await self.appendEvent(...)` 写回 `drainedEvents`，这一步经过 Swift 并发调度器，不与
   279	    /// `stop()` 的 throw/return 同步——`onStopResolved`/`onStopThrew` 是从另一个 Task（`client_call`
   280	    /// 的包装 Task）在 `stop()` 刚返回/刚抛错的瞬间调用，如果不等待，可能在排空 Task 真正把镜像事件
   281	    /// 写进 `drainedEvents`之前就已经读完（真实复现：stop-rejected-rpc-failure fixture 最初跑出
   282	    /// 『pendingOperations.stop1 期望 rejected，实际 nil』的 flaky 结果）。这里短暂 sleep 一下
   283	    /// ——因为是 actor-isolated 方法内部的 await，会释放 actor，让排空 Task 有机会先把
   284	    /// `appendEvent` 处理完，再回来继续读 `drainedEvents`。
   285	    private func settleForEventDrain() async {
   286	        try? await Task.sleep(nanoseconds: 80_000_000)
   287	    }
   288	
   289	    func onStopResolved(id: String, result: StopResultPayload, eventsCountAtStart: Int) async {
   290	        hasStopWaitingForTerminal = false
   291	        await settleForEventDrain()
   292	        if let outcome = firstOperationCompletedOutcome(after: eventsCountAtStart) {
   293	            pendingOperations[id] = outcome
   294	        } else {
   295	            pendingOperations[id] = result.outcome.rawValue
   296	        }
   297	    }
   298	
   299	    func onStopThrew(id: String, error: Error, eventsCountAtStart: Int) async {
   300	        hasStopWaitingForTerminal = false
   301	        // `session_locked` 是 stop() 顶部 `currentLock == .idle` 前置 guard 直接抛出的——发生在
   302	        // `operationID` 铸造之前，真实 client **绝不会**为这次调用产出任何 operation_completed
   303	        // 镜像事件（见 onStopThrew 下方分支的文档注释）。这个分支不用等，等了也白等，还会不必要地
   304	        // 拖慢『并发 stop 被拒绝』这类断言的可观察时刻——因此只对『可能真的有镜像事件在路上』的其它
   305	        // 错误类型才 settle。
   306	        if case KernelClientError.rpcRejected(let code, _) = error, code == "session_locked" {
   307	            callOutcomes[id] = ["status": "rejected", "failure": failureDict(for: error)]
   308	            return
   309	        }
   310	        await settleForEventDrain()
   311	        if let outcome = firstOperationCompletedOutcome(after: eventsCountAtStart) {
   312	            // operationId 已铸造、RPC 中途失败（M3 catch 分支）——OperationOutcome 层面的终态，
   313	            // 走 pendingOperations（D1 v3.1 §9.1：这是『已经开始执行的 operation 的终态』通道）。
   314	            pendingOperations[id] = outcome
   315	        } else {
   316	            // 没有 operation_completed 镜像——说明这次 stop() 在铸造 operationId 之前就被同步拒绝
   317	            // （D1 v3.1 §9.1 `KernelPortRejectionCode` 层面的前置条件拒绝，例如 session_locked：
   318	            // stop() 顶部的 `currentLock == .idle` guard 在 `let operationID = ...` 之前就 throw），
   319	            // 根本没有进入 OperationOutcome 通道——不写 pendingOperations（那是 operationId 铸造
   320	            // 之后才有意义的字段），改记 callOutcomes，与其它不产生 operationId 的失败调用同一处理
   321	            // 方式一致。
   322	            callOutcomes[id] = ["status": "rejected", "failure": failureDict(for: error)]
   323	        }
   324	    }
   325	
   326	    private func firstOperationCompletedOutcome(after index: Int) -> String? {
   327	        guard index <= drainedEvents.count else { return nil }
   328	        for i in index..<drainedEvents.count {
   329	            let entry = drainedEvents[i]
   330	            if entry["type"] as? String == "evt.operation_completed",
   331	               let payload = entry["payload"] as? [String: Any],
   332	               let outcome = payload["outcome"] as? String {
   333	                return outcome
   334	            }
   335	        }
   336	        return nil
   337	    }
   338	
   339	    func appendEvent(_ entry: [String: Any]) {
   340	        drainedEvents.append(entry)
   341	        if entry["type"] as? String == "evt.approval_request",
   342	           let payload = entry["payload"] as? [String: Any],
   343	           let reqID = payload["reqId"] as? String {
   344	            approvalState[reqID] = "pending"
   345	        }
   346	    }
   347	
   348	    func startDraining(_ stream: AsyncThrowingStream<EventMessageUnion, Error>) {
   349	        let task = Task {
   350	            var iterator = stream.makeAsyncIterator()
   351	            while true {
   352	                let next: EventMessageUnion?
   353	                do {
   354	                    next = try await iterator.next()
   355	                } catch {
   356	                    break
   357	                }
   358	                guard let event = next else { break }
   359	                let entry = eventToObservedEntry(event)
   360	                await self.appendEvent(entry)
   361	            }
   362	        }
   363	        pendingTasks.append(task)
   364	    }
   365	
   366	    func snapshot() -> [String: Any] {
   367	        var out: [String: Any] = [:]
   368	        out["pendingOperations"] = pendingOperations
   369	        out["callOutcomes"] = callOutcomes
   370	        out["approvalState"] = approvalState
   371	        out["observedEvents"] = drainedEvents
   372	        return out
   373	    }
   374	
   375	    func snapshotWithLock() async -> [String: Any] {
   376	        var out = snapshot()
   377	        if let sid = currentSessionID {
   378	            out["sessionLock"] = await client.testSupportLockState(sessionID: sid)
   379	        }
   380	        return out
   381	    }
   382	
   383	    func drainedEventsCount() -> Int { drainedEvents.count }
   384	}
   385	
   386	// MARK: - client_call 翻译层
   387	
   388	func performClientCall(_ op: TimelineOp, ctx: RunnerContext) async throws {
   389	    guard let id = op.id, let call = op.call else {
   390	        throw RunnerError.malformed("client_call 缺少 id/call（t=\(op.t)）")
   391	    }
   392	    await ctx.setCallKind(id: id, call: call)
   393	    let argsAny = (op.args?.value as? [String: Any]) ?? [:]
   394	    let client = ctx.client
   395	
   396	    switch call {
   397	    case "createSession":
   398	        let configJSON = (argsAny["config"] as? [String: Any]) ?? [:]
   399	        let config = try decodeConfig(from: configJSON)
   400	        let gate = ReplyGate()
   401	        await ctx.setGate(id: id, gate: gate)
   402	        await client.testSupportStubRPC(method: "sessions.create") { params in
   403	            let normalized: [String: Any] = ["type": "req.createSession", "payload": argsAny]
   404	            await ctx.recordOutbound(id: id, method: "sessions.create", params: params, normalizedRequest: normalized)
   405	            return try await gate.wait()
   406	        }
   407	        let task = Task<Void, Never> {
   408	            do {
   409	                let handle = try await client.createSession(config: config)
   410	                await ctx.onCreateSessionResolved(id: id, handle: handle)
   411	            } catch {
   412	                await ctx.onCallThrew(id: id, error: error)
   413	            }
   414	        }
   415	        await ctx.addPendingTask(task)
   416	
   417	    case "send":
   418	        let input = try decodeInput(from: argsAny)
   419	        guard let handle = await ctx.currentSessionHandle else {
   420	            throw RunnerError.malformed("send（id=\(id)）在 createSession 之前调用")
   421	        }
   422	        let gate = ReplyGate()
   423	        await ctx.setGate(id: id, gate: gate)
   424	        await client.testSupportStubRPC(method: "sessions.send") { params in
   425	            var normalized: [String: Any] = ["type": "req.send", "payload": argsAny]
   426	            if let sessionID = await ctx.declaredSessionIDValue { normalized["sessionId"] = sessionID }
   427	            await ctx.recordOutbound(id: id, method: "sessions.send", params: params, normalizedRequest: normalized)
   428	            return try await gate.wait()
   429	        }
   430	        let task = Task<Void, Never> {
   431	            do {
   432	                let result = try await client.send(session: handle, input: input)
   433	                await ctx.onSendResolved(id: id, result: result)
   434	            } catch {
   435	                await ctx.onCallThrew(id: id, error: error)
   436	            }
   437	        }
   438	        await ctx.addPendingTask(task)
   439	
   440	    case "subscribe":
   441	        // 真实 `subscribe()` 同步（在第一次 await 之前）就把 `eventContinuations[sessionID]` 建好、
   442	        // 立即返回事件流——底层 `sessions.messages.subscribe` RPC 是否已经收到响应，不影响
   443	        // `handleAgentEvent`/`handleSessionMessageEvent` 等 dispatch 分支能否正常工作（它们只检查
   444	        // `eventContinuations` 是否存在），因此这里用『可选 gate』：fixture 若显式提供了
   445	        // `mock_response(replyTo: 这个 subscribe 调用的 id)`（如既有 basic fixture），gate 会在那时
   446	        // 被解锁，`callOutcomes[id]` 才会记为 resolved；若 fixture 没提供（本轮新写的三组 fixture
   447	        // 大多不需要），gate 永远悬挂也不影响后续任何事件观察——事件 dispatch 走的是另一条独立路径。
   448	        guard let handle = await ctx.currentSessionHandle else {
   449	            throw RunnerError.malformed("subscribe（id=\(id)）在 createSession 之前调用")
   450	        }
   451	        let gate = ReplyGate()
   452	        await ctx.setGate(id: id, gate: gate)
   453	        await client.testSupportStubRPC(method: "sessions.messages.subscribe") { params in
   454	            var normalized: [String: Any] = ["type": "req.subscribe", "payload": argsAny]
   455	            if let sessionID = await ctx.declaredSessionIDValue { normalized["sessionId"] = sessionID }
   456	            await ctx.recordOutbound(id: id, method: "sessions.messages.subscribe", params: params, normalizedRequest: normalized)
   457	            do {
   458	                let json = try await gate.wait()
   459	                await ctx.setCallOutcomeResolved(id: id)
   460	                return json
   461	            } catch {
   462	                await ctx.onCallThrew(id: id, error: error)
   463	                throw error
   464	            }
   465	        }
   466	        let stream = await client.subscribe(session: handle)
   467	        await ctx.startDraining(stream)
   468	
   469	    case "stop":
   470	        guard let handle = await ctx.currentSessionHandle else {
   471	            throw RunnerError.malformed("stop（id=\(id)）在 createSession 之前调用")
   472	        }
   473	        let gate = ReplyGate()
   474	        await ctx.setGate(id: id, gate: gate)
   475	        await client.testSupportStubRPC(method: "sessions.abort") { params in
   476	            var normalized: [String: Any] = ["type": "req.stop", "payload": argsAny]
   477	            if let sessionID = await ctx.declaredSessionIDValue { normalized["sessionId"] = sessionID }
   478	            await ctx.recordOutbound(id: id, method: "sessions.abort", params: params, normalizedRequest: normalized)
   479	            return try await gate.wait()
   480	        }
   481	        await client.testSupportStubRPC(method: "sessions.delete") { _ in ["deleted": true] }
   482	        // D1 §6.2 M3（stop() 强制 deny 补丁，本轮新落地）：`stop()` 在发起 `sessions.abort` 之前，
   483	        // 若该 session 仍有 pending 审批，会先对每一个调用真实 openclaw 统一审批解决 RPC
   484	        // `approval.resolve`（`forceDenyPendingApprovalsBeforeStop`，见
   485	        // OpenclawGatewayKernelClient.swift 文档注释），要求响应体 `approval.status == "denied"`
   486	        // 才算数。绝大多数 fixture 没有 pending 审批时，`forceDenyPendingApprovalsBeforeStop` 在空
   487	        // 列表上提前返回、根本不会发起这条 RPC（这条 stub 是安全的默认背景桩，不影响其余 fixture）；
   488	        // 只有 `approval/stop-force-denies-pending-approval.json` 会真正命中。
   489	        await client.testSupportStubRPC(method: "approval.resolve") { _ in
   490	            ["applied": true, "approval": ["status": "denied"]]
   491	        }
   492	        let eventsCountAtStart = await ctx.drainedEventsCount()
   493	        let task = Task<Void, Never> {
   494	            do {
   495	                let result = try await client.stop(session: handle)
   496	                await ctx.onStopResolved(id: id, result: result, eventsCountAtStart: eventsCountAtStart)
   497	            } catch {
   498	                await ctx.onStopThrew(id: id, error: error, eventsCountAtStart: eventsCountAtStart)
   499	            }
   500	        }
   501	        await ctx.addPendingTask(task)
   502	
   503	    case "interrupt", "respondApproval", "capabilities":
   504	        // 不应该走到这里——`degradeReason(for:)` 已经在执行 timeline 之前静态扫描并整条 fixture
   505	        // 标记 DEGRADED。留一个明确抛错，防止未来谁绕开了那道静态检查。
   506	        throw RunnerError.malformed("client_call『\(call)』本应在执行前被 degradeReason 拦截，未被拦截是 runner 自身的缺陷")
   507	
   508	    default:
   509	        throw RunnerError.malformed("未知 KernelClientMethod『\(call)』")
   510	    }
   511	
   512	    // 给刚 spawn 的 Task 一点真实时间跑到它的 RPC await 点（actor hop + 进入 gate.wait()），
   513	    // 让紧随其后的 expect_outbound/assert_state 断言的是『真的在途』而不是『还没开始』。
   514	    try? await Task.sleep(nanoseconds: 50_000_000)
   515	}
