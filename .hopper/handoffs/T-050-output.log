   517	// MARK: - RunnerContext 的几个薄 setter（放在 extension 里避免上面主体过长）
   518	
   519	extension RunnerContext {
   520	    func setCallKind(id: String, call: String) { callKindByID[id] = call }
   520	    func setCallKind(id: String, call: String) { callKindByID[id] = call }
   521	    func setGate(id: String, gate: ReplyGate) { replyGates[id] = gate }
   522	    func setCallOutcomeResolved(id: String) { callOutcomes[id] = ["status": "resolved"] }
   523	}
