    21	import { readFile } from 'node:fs/promises';
    22	import { fileURLToPath } from 'node:url';
    23	import { dirname, join, resolve } from 'node:path';
    24	import type { ParityFixture, TimelineOp, ClientObservableState } from '../dsl.ts';
    25	import { MockKernelClient } from './mock-kernel-client.ts';
    26	
    27	const __dirname = dirname(fileURLToPath(import.meta.url));
    28	
    29	/** 虚拟时钟基准——把 fixture 里的整数毫秒 `t` 转成确定性的 ISO-8601 字符串，不依赖真实
    30	 *  wall-clock（D4 §4.3「虚拟时钟」原则）。基准值本身任意，只要跨 op 一致即可。 */
    31	const VIRTUAL_EPOCH = Date.parse('2026-01-01T00:00:00.000Z');
    32	function tToIso(t: number): string {
    33	  return new Date(VIRTUAL_EPOCH + t).toISOString();
    34	}
    35	
    36	type Mismatch = string;
    37	
    38	/** 子集深度匹配：expected 里出现的每个字段都必须在 actual 里以相等值出现；actual 多出的字段
    39	 *  不算失败（这是『部分状态断言』的语义，D4 §4.3 `Partial<ClientObservableState>`）。 */
    40	function partialMatch(actual: unknown, expected: unknown, path: string): Mismatch[] {
    41	  if (expected === undefined) return [];
    42	  if (expected === null || typeof expected !== 'object') {
    43	    return actual === expected ? [] : [`${path}: 期望 ${JSON.stringify(expected)}，实际 ${JSON.stringify(actual)}`];
    44	  }
    45	  if (Array.isArray(expected)) {
    46	    if (!Array.isArray(actual)) return [`${path}: 期望数组，实际 ${JSON.stringify(actual)}`];
    47	    if (actual.length !== expected.length) {
    48	      return [`${path}: 期望长度 ${expected.length}，实际长度 ${actual.length}`];
    49	    }
    50	    const out: Mismatch[] = [];
    51	    expected.forEach((item, i) => out.push(...partialMatch(actual[i], item, `${path}[${i}]`)));
    52	    return out;
    53	  }
    54	  if (actual === null || typeof actual !== 'object') {
    55	    return [`${path}: 期望对象 ${JSON.stringify(expected)}，实际 ${JSON.stringify(actual)}`];
    56	  }
    57	  const out: Mismatch[] = [];
    58	  for (const key of Object.keys(expected as Record<string, unknown>)) {
    59	    out.push(
    60	      ...partialMatch(
    61	        (actual as Record<string, unknown>)[key],
    62	        (expected as Record<string, unknown>)[key],
    63	        `${path}.${key}`,
    64	      ),
    65	    );
    66	  }
    67	  return out;
    68	}
    69	
    70	function deriveState(client: MockKernelClient): ClientObservableState {
    71	  return {
    72	    sessionLock: client.sessionLock,
    73	    pendingOperations: client.pendingOperations,
    74	    callOutcomes: client.callOutcomes as ClientObservableState['callOutcomes'],
    75	    observedEvents: client.observedEvents,
    76	    // T-048 REWORK #3：approval/ 组新增 fixture 断言 approvalState，此前 deriveState 完全没有
    77	    // 暴露这个字段（MockKernelClient 也没有跟踪），导致 12 条新 fixture 里的 2 条 approval fixture
    78	    // 必然 FAIL——现已补齐，口径对齐 swift-runner 的 `ctx.approvalState`。
    79	    approvalState: client.approvalState,
    80	  };
    81	}
    82	
    83	/** 展开 mock_response/mock_event 的 shorthand——补全 runner 负责补全的传输元数据字段
    84	 *  （D4 §4.3 v2.2 收残：T-030 F-01 第二项 shorthand 自动补全规则）。 */
    85	function expandResponseShorthand(
    86	  shorthand: Record<string, unknown>,
    87	  t: number,
    88	  outboundId: string,
    89	): Record<string, unknown> {
    90	  return { ...shorthand, sentAt: tToIso(t), direction: 'response', id: outboundId };
    91	}
    92	function expandEventShorthand(shorthand: Record<string, unknown>, t: number): Record<string, unknown> {
    93	  return { ts: tToIso(t), ...shorthand, sentAt: tToIso(t), direction: 'event' };
    94	}
    95	
    96	export interface RunResult {
    97	  name: string;
    98	  passed: boolean;
    99	  mismatches: Mismatch[];
   100	}
   101	
   102	export async function runFixture(fixturePath: string): Promise<RunResult> {
   103	  const raw = await readFile(fixturePath, 'utf8');
   104	  const fixture = JSON.parse(raw) as ParityFixture;
   105	
   106	  const client = new MockKernelClient();
   107	  if (fixture.initialState?.sessionLock) client.sessionLock = fixture.initialState.sessionLock;
   108	
   109	  const mismatches: Mismatch[] = [];
   110	
   111	  for (const op of fixture.timeline as TimelineOp[]) {
   112	    switch (op.op) {
   113	      case 'client_call': {
   114	        const id = op.id ?? `anon-${op.t}`;
   115	        client.call(id, op.call, op.args);
   116	        break;
   117	      }
   118	      case 'expect_outbound': {
   119	        const record = client.getOutbound(op.matches);
   120	        if (!record) {
   121	          mismatches.push(`expect_outbound@t=${op.t}: 找不到 id='${op.matches}' 的 outbound 记录`);
   122	          break;
   123	        }
   124	        const diff = partialMatch(record.message, op.pattern, `expect_outbound(${op.matches})`);
   125	        mismatches.push(...diff);
   126	        break;
   127	      }
   128	      case 'mock_response': {
   129	        const record = client.getOutbound(op.replyTo);
   130	        if (!record) {
   131	          mismatches.push(`mock_response@t=${op.t}: 找不到 replyTo='${op.replyTo}' 的 outbound 记录`);
   132	          break;
   133	        }
   134	        const expanded = expandResponseShorthand(op.message as unknown as Record<string, unknown>, op.t, record.id);
   135	        client.applyResponse(op.replyTo, expanded);
   136	        break;
   137	      }
   138	      case 'mock_event': {
   139	        const expanded = expandEventShorthand(op.message as unknown as Record<string, unknown>, op.t);
   140	        client.applyEvent(expanded);
   141	        break;
   142	      }
   143	      case 'disconnect':
   144	        // T-048 REWORK #3：接到 MockKernelClient.disconnect()——若有 stop() 正在等待 active run
   145	        // 终态确认，按 D1 §9.2 NOTE-1 因果补 aborted_effect_unknown 镜像 + session_end
   146	        // (transport_closed)；其余断线重连语义仍是 TODO（见 mock-kernel-client.ts 文档注释）。
   147	        client.disconnect();
   148	        break;
   149	      case 'reconnect':
   150	        // TODO（本轮未实现，见文件顶部简化声明）：断线重连语义。
   151	        break;
   152	      case 'advance_clock':
   153	        // T-048 REWORK #3：接到 MockKernelClient.advanceClock()——若有 stop() 正在等待 active run
   154	        // 终态确认且 ms 跨越 TEST_STOP_TIMEOUT_MS 阈值，按 D1 §9.3 因果补 timed_out 镜像 +
   155	        // session_end(stopped)。
   156	        client.advanceClock(op.ms);
   157	        break;
   158	      case 'assert_state': {
   159	        const diff = partialMatch(deriveState(client), op.expected, `assert_state@t=${op.t}`);
   160	        mismatches.push(...diff);
   161	        break;
   162	      }
   163	      default: {
   164	        const _exhaustive: never = op;
   165	        throw new Error(`未知 TimelineOp: ${JSON.stringify(_exhaustive)}`);
   166	      }
   167	    }
   168	  }
   169	
   170	  const finalDiff = partialMatch(deriveState(client), fixture.expected, 'expected');
   171	  mismatches.push(...finalDiff);
   172	
   173	  return { name: fixture.name, passed: mismatches.length === 0, mismatches };
   174	}
