   230	    }
   231	
   232	    func capturedNormalizedRequest(for id: String) -> [String: Any]? {
   233	        capturedOutbound[id]?.normalizedRequest
   234	    }
   235	
   236	    func gate(for id: String) -> ReplyGate? { replyGates[id] }
   237	    func callKind(for id: String) -> String? { callKindByID[id] }
   238	    func setCurrentKernelKey(_ key: String) { currentKernelKey = key }
   239	    func setDeclaredSessionID(_ id: String) { declaredSessionID = id }
   240	    func setHasStopWaitingForTerminal(_ value: Bool) { hasStopWaitingForTerminal = value }
   241	    func setWaitingStopCallID(_ id: String?) { waitingStopCallID = id }
   242	    var hasStopWaitingForTerminalValue: Bool { hasStopWaitingForTerminal }
   243	    var currentKernelKeyValue: String? { currentKernelKey }
