   742	// MARK: - advance_clock（虚拟时钟：见文件头 + README 的详细说明）
   743	
   744	/// T-048 REWORK #5：轮询间隔——远小于 SG-5 测试专用超时阈值（`RunnerContext.stopTimeoutMs`），
   745	/// 保证不会把『还没结算』误判成『结算了』，也不会引入明显的额外延迟。
   746	private let syncPollIntervalNs: UInt64 = 10_000_000
   747	/// 轮询安全上限之外的额外余量——只是防止 SG-5 出现真实回归（比如又变回永久悬挂）时本 runner 陪着
   748	/// 无限期挂起；不是用来『凑够时长让内部定时器来得及触发』的 slack（那正是旧版的问题）。
   749	private let syncSafetyMarginNs: UInt64 = 5_000_000_000
   750	
   751	/// 轮询直到 `predicate()` 为 true 或超过 `maxWaitNs`——用于替换『固定 sleep 猜调度』（T-048
   752	/// REWORK #5 核心）：不管 SG-5 内部定时器/等待任务实际几时被真正 armed、几时真正结算，本 runner
   753	/// 都只是不断问『好了没』，而不是自己算一个『应该差不多好了』的时长再赌一把。
   754	private func pollUntilSettled(maxWaitNs: UInt64, predicate: () async -> Bool) async {
   755	    var waitedNs: UInt64 = 0
   756	    while waitedNs < maxWaitNs {
   757	        if await predicate() { return }
   758	        try? await Task.sleep(nanoseconds: syncPollIntervalNs)
   759	        waitedNs += syncPollIntervalNs
   760	    }
   761	}
   762	
   763	func applyAdvanceClock(_ op: TimelineOp, ctx: RunnerContext) async throws {
   764	    let ms = op.ms ?? 0
   765	    guard await ctx.hasStopWaitingForTerminalValue else {
   766	        // 当前没有 stop() 在等待终态确认——advance_clock 是 no-op（同 ts-runner 对这个 op 的既有
   767	        // 简化声明：advance_clock 本身不代表任何时钟无关的语义，只在『有人正在等超时』时才有意义）。
   768	        return
   769	    }
   770	    let thresholdNs = RunnerContext.stopTimeoutMs * 1_000_000
   771	    guard UInt64(ms) * 1_000_000 >= thresholdNs else { return }
   772	    guard let waitingID = await ctx.waitingStopCallIDValue else {
   773	        await ctx.setHasStopWaitingForTerminal(false)
   774	        return
   775	    }
   776	    // T-048 REWORK #5 收残：旧版靠『mock_response 后固定 50ms + 这里再固定 400ms slack』赌 SG-5
   777	    // 内部定时器『应该』已经 armed、且到期后的收尾链路『应该』已经跑完，高负载下两次固定猜测都可能
   778	    // 不够，导致断言抢跑（codex 复现）。改成显式『任务已结算』同步钩子：真实触发仍然完全不变
   779	    // （SG-5 的 `stop()` 超时机制基于 `Task.sleep` 真实挂钟时间，`testSupportSetStopTimeoutSeconds`
   780	    // 把生产 5 秒超时收窄到 1 秒，本 runner 未改 SG-5 行为一个字节），只是不再自己猜『该等多久』——
   781	    // 而是轮询 `ctx.isCallSettled(id:)`（复用本 runner 自己在 `onStopResolved`/`onStopThrew` 里
   782	    // 写入的 `pendingOperations`/`callOutcomes`，正是随后 `assert_state` 要读的同一份状态，比轮询
   783	    // SG-5 内部 `terminalEmitted` 更贴近真正需要同步的时刻，见 `isCallSettled` 文档注释），直到
   784	    // SG-5 内部定时器真正到期、`stop()` 走完 `sessions.delete`+`emitStopSessionEndAndFinish`+
   785	    // `onStopResolved` 的 `settleForEventDrain` 整条收尾链路、真正把结果写定为止。
   786	    await pollUntilSettled(maxWaitNs: thresholdNs + syncSafetyMarginNs) {
   787	        await ctx.isCallSettled(id: waitingID)
   788	    }
   789	    await ctx.setHasStopWaitingForTerminal(false)
   790	}
   791	
   792	// MARK: - 单个 timeline op 的分发
   793	
   794	func executeOp(_ op: TimelineOp, ctx: RunnerContext) async throws {
   795	    switch op.op {
   796	    case .clientCall:
   797	        try await performClientCall(op, ctx: ctx)
   798	    case .expectOutbound:
   799	        try await checkExpectOutbound(op, ctx: ctx)
   800	    case .mockResponse:
   801	        try await applyMockResponse(op, ctx: ctx)
   802	        try? await Task.sleep(nanoseconds: 50_000_000)
   803	    case .mockEvent:
   804	        try await applyMockEvent(op, ctx: ctx)
   805	        try? await Task.sleep(nanoseconds: 50_000_000)
   806	    case .disconnect:
   807	        await ctx.client.testSupportSimulateTransportClosed()
   808	        // 同 `applyAdvanceClock`（T-048 REWORK #5）：`testSupportSimulateTransportClosed()` 唤醒的
   809	        // stop() 等待者需要经过『throw -> 本 runner 的 client_call 包装 Task 捕获 -> onStopThrew
   810	        // 自身的 settleForEventDrain 结算』整条链路才会把 pendingOperations 写定——改轮询
   811	        // `ctx.isCallSettled(id:)` 直到真正写定，不再固定 sleep 猜这条链路要跑多久。
   812	        if await ctx.hasStopWaitingForTerminalValue, let waitingID = await ctx.waitingStopCallIDValue {
   813	            await pollUntilSettled(maxWaitNs: syncSafetyMarginNs) {
   814	                await ctx.isCallSettled(id: waitingID)
   815	            }
   816	            await ctx.setHasStopWaitingForTerminal(false)
   817	        } else {
   818	            // 没有 stop() 在等待终态——本轮 fixture 均未覆盖这条分支，保留一个保守的结算窗口而不是
   819	            // 干脆不等，避免引入新的未覆盖竞态（如实标注：这不是『猜调度』，只是没有可轮询的具体目标
   820	            // 时的兜底）。
   821	            try? await Task.sleep(nanoseconds: 250_000_000)
   822	        }
   823	    case .reconnect:
   824	        // 本轮三组 fixture 均不依赖 reconnect 语义；SG-5 本身也没有『断线后重新变为可用』的能力
   825	        // （transport 关闭后所有 session 的派生状态都会被清理，见 handleTransportClosed），如实
   826	        // 标注为本轮 no-op，不假装支持。
   827	        break
   828	    case .advanceClock:
   829	        try await applyAdvanceClock(op, ctx: ctx)
   830	    case .assertState:
   831	        let snapshot = await ctx.snapshotWithLock()
   832	        let diff = partialMatch(actual: snapshot, expected: op.expected?.value, path: "assert_state@t=\(op.t)")
   833	        for d in diff { await ctx.appendMismatch(d) }
   834	    }
   835	}
