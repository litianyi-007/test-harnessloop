   245	    var declaredSessionIDValue: String? { declaredSessionID }
   246	    var waitingStopCallIDValue: String? { waitingStopCallID }
   247	
   248	    /// T-048 REWORK #5：`advance_clock`/`disconnect` 用来判定『这次 stop() 的最终结果是否已经
   249	    /// 结算』的同步目标——`onStopResolved`/`onStopThrew` 写完 `pendingOperations`/`callOutcomes`
   250	    /// 才算数，这正是随后 `assert_state` 要读的同一份状态，比轮询 SG-5 内部 `terminalEmitted`
   250	    /// 才算数，这正是随后 `assert_state` 要读的同一份状态，比轮询 SG-5 内部 `terminalEmitted`
   251	    /// 更贴近真正需要同步的时刻（后者只代表 `waitForPendingStopTerminal` 已返回，`stop()` 自己还要
   252	    /// 再走 `sessions.delete` + `emitStopSessionEndAndFinish`，`onStopResolved` 还有自己的
   253	    /// `settleForEventDrain` 才会真正落笔）。
   254	    func isCallSettled(id: String) -> Bool {
   255	        pendingOperations[id] != nil || callOutcomes[id] != nil
   256	    }
   257	
   258	    func appendMismatch(_ m: Mismatch) { accumulatedMismatches.append(m) }
   259	    func addPendingTask(_ task: Task<Void, Never>) { pendingTasks.append(task) }
   260	
   261	    func onCreateSessionResolved(id: String, handle: SessionHandle) {
   262	        currentSessionHandle = handle
   263	        currentSessionID = handle.sessionID
   264	        callOutcomes[id] = ["status": "resolved"]
   265	    }
   266	
   267	    func onSendResolved(id: String, result: SendResultPayload) {
   268	        currentRunID = result.runID
   269	        callOutcomes[id] = ["status": "resolved"]
   270	    }
   271	
   272	    func onCallThrew(id: String, error: Error) {
   273	        callOutcomes[id] = ["status": "rejected", "failure": failureDict(for: error)]
   274	    }
   275	
   276	    /// `emitOperationCompletedMirror` 在真实 `stop()` 内部是同步调用（`continuation.yield(...)`），
   277	    /// 但 yield 唤醒本 runner 的事件排空 Task（`startDraining` 里 `iterator.next()`）、再由它
   278	    /// `await self.appendEvent(...)` 写回 `drainedEvents`，这一步经过 Swift 并发调度器，不与
   279	    /// `stop()` 的 throw/return 同步——`onStopResolved`/`onStopThrew` 是从另一个 Task（`client_call`
   280	    /// 的包装 Task）在 `stop()` 刚返回/刚抛错的瞬间调用，如果不等待，可能在排空 Task 真正把镜像事件
   281	    /// 写进 `drainedEvents`之前就已经读完（真实复现：stop-rejected-rpc-failure fixture 最初跑出
   282	    /// 『pendingOperations.stop1 期望 rejected，实际 nil』的 flaky 结果）。这里短暂 sleep 一下
   283	    /// ——因为是 actor-isolated 方法内部的 await，会释放 actor，让排空 Task 有机会先把
   284	    /// `appendEvent` 处理完，再回来继续读 `drainedEvents`。
   285	    private func settleForEventDrain() async {
   286	        try? await Task.sleep(nanoseconds: 80_000_000)
   287	    }
   288	
   289	    func onStopResolved(id: String, result: StopResultPayload, eventsCountAtStart: Int) async {
   290	        hasStopWaitingForTerminal = false
   291	        await settleForEventDrain()
   292	        if let outcome = firstOperationCompletedOutcome(after: eventsCountAtStart) {
   293	            pendingOperations[id] = outcome
   294	        } else {
   295	            pendingOperations[id] = result.outcome.rawValue
   296	        }
   297	    }
   298	
   299	    func onStopThrew(id: String, error: Error, eventsCountAtStart: Int) async {
   300	        hasStopWaitingForTerminal = false
   301	        // `session_locked` 是 stop() 顶部 `currentLock == .idle` 前置 guard 直接抛出的——发生在
   302	        // `operationID` 铸造之前，真实 client **绝不会**为这次调用产出任何 operation_completed
   303	        // 镜像事件（见 onStopThrew 下方分支的文档注释）。这个分支不用等，等了也白等，还会不必要地
   304	        // 拖慢『并发 stop 被拒绝』这类断言的可观察时刻——因此只对『可能真的有镜像事件在路上』的其它
   305	        // 错误类型才 settle。
   306	        if case KernelClientError.rpcRejected(let code, _) = error, code == "session_locked" {
   307	            callOutcomes[id] = ["status": "rejected", "failure": failureDict(for: error)]
   308	            return
   309	        }
   310	        await settleForEventDrain()
   311	        if let outcome = firstOperationCompletedOutcome(after: eventsCountAtStart) {
   312	            // operationId 已铸造、RPC 中途失败（M3 catch 分支）——OperationOutcome 层面的终态，
   313	            // 走 pendingOperations（D1 v3.1 §9.1：这是『已经开始执行的 operation 的终态』通道）。
   314	            pendingOperations[id] = outcome
   315	        } else {
   316	            // 没有 operation_completed 镜像——说明这次 stop() 在铸造 operationId 之前就被同步拒绝
   317	            // （D1 v3.1 §9.1 `KernelPortRejectionCode` 层面的前置条件拒绝，例如 session_locked：
   318	            // stop() 顶部的 `currentLock == .idle` guard 在 `let operationID = ...` 之前就 throw），
   319	            // 根本没有进入 OperationOutcome 通道——不写 pendingOperations（那是 operationId 铸造
   320	            // 之后才有意义的字段），改记 callOutcomes，与其它不产生 operationId 的失败调用同一处理
   321	            // 方式一致。
   322	            callOutcomes[id] = ["status": "rejected", "failure": failureDict(for: error)]
   323	        }
   324	    }
   325	
   326	    private func firstOperationCompletedOutcome(after index: Int) -> String? {
   327	        guard index <= drainedEvents.count else { return nil }
   328	        for i in index..<drainedEvents.count {
   329	            let entry = drainedEvents[i]
   330	            if entry["type"] as? String == "evt.operation_completed",
   331	               let payload = entry["payload"] as? [String: Any],
   332	               let outcome = payload["outcome"] as? String {
   333	                return outcome
   334	            }
   335	        }
   336	        return nil
   337	    }
   338	
   339	    func appendEvent(_ entry: [String: Any]) {
   340	        drainedEvents.append(entry)
   341	        if entry["type"] as? String == "evt.approval_request",
   342	           let payload = entry["payload"] as? [String: Any],
   343	           let reqID = payload["reqId"] as? String {
   344	            approvalState[reqID] = "pending"
   345	        }
   346	    }
   347	
   348	    func startDraining(_ stream: AsyncThrowingStream<EventMessageUnion, Error>) {
   349	        let task = Task {
   350	            var iterator = stream.makeAsyncIterator()
   351	            while true {
   352	                let next: EventMessageUnion?
   353	                do {
   354	                    next = try await iterator.next()
   355	                } catch {
   356	                    break
   357	                }
   358	                guard let event = next else { break }
   359	                let entry = eventToObservedEntry(event)
   360	                await self.appendEvent(entry)
   361	            }
   362	        }
   363	        pendingTasks.append(task)
   364	    }
   365	
   366	    func snapshot() -> [String: Any] {
   367	        var out: [String: Any] = [:]
   368	        out["pendingOperations"] = pendingOperations
   369	        out["callOutcomes"] = callOutcomes
   370	        out["approvalState"] = approvalState
   371	        out["observedEvents"] = drainedEvents
   372	        return out
   373	    }
   374	
   375	    func snapshotWithLock() async -> [String: Any] {
   376	        var out = snapshot()
   377	        if let sid = currentSessionID {
   378	            out["sessionLock"] = await client.testSupportLockState(sessionID: sid)
   379	        }
   380	        return out
   381	    }
   382	
   383	    func drainedEventsCount() -> Int { drainedEvents.count }
   384	}
