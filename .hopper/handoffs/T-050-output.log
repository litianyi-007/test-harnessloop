   636	// MARK: - mock_event
   637	
   638	func applyMockEvent(_ op: TimelineOp, ctx: RunnerContext) async throws {
   639	    let messageAny = (op.message?.value as? [String: Any]) ?? [:]
   640	    guard let type = messageAny["type"] as? String else {
   641	        throw RunnerError.malformed("mock_event 缺少 message.type（t=\(op.t)）")
   642	    }
   643	    let kernelKey = await ctx.currentKernelKeyValue ?? ""
   644	    let client = ctx.client
   645	
   646	    switch type {
   647	    case "evt.message.delta":
   648	        let payload = (messageAny["payload"] as? [String: Any]) ?? [:]
   649	        let delta = (payload["delta"] as? String) ?? ""
   650	        let frame: JSONObject = [
   651	            "type": "event", "event": "session.message",
   652	            "payload": [
   653	                "sessionKey": kernelKey,
   654	                "message": [
   655	                    "role": "assistant",
   656	                    "content": [["type": "text", "text": delta]],
   657	                    "timestamp": Int(Date().timeIntervalSince1970 * 1000),
   658	                ] as JSONObject,
   659	            ] as JSONObject,
   660	        ]
   661	        await client.testSupportFeedFrame(frame)
   662	
   663	    case "evt.turn_complete":
   664	        // T-048 REWORK #1（删除非法 `_openclawLifecycle`）：Stage A 范围内，本 runner 只把这个类型
   665	        // 用作『合成 stop() 等待中的 aborted lifecycle 终态信号』（见文件头「设计钢印」一节）——不是
   666	        // 通用的正常回合结束映射（那需要 evt.message.delta 之外的更多上下文，本轮 3 组 fixture 不
   667	        // 需要），Stage A 唯一的用途就只有这一种，因此直接硬编码 `phase:"end"`/`aborted:true`——
   668	        // 真实 SG-5 mapper（`mapOpenclawAgentLifecycleToAbortTerminalEvents`）本身也是照 `phase`
   669	        // 是否为 "end" 判定 outcome=succeeded、`stopReason` 硬编码为 `.cancelled`（不读原生帧的
   670	        // stopReason 字段），fixture 声明的 `message.payload.stopReason`（如 "cancelled"）已经是
   671	        // 两端都需要的、唯一有意义的取值来源，不需要另一个只有本 runner 认得的私有提示字段重复表达
   672	        // 同一件事。
   673	        let contextRunID = await ctx.currentRunIDValue
   674	        let runID = (messageAny["runId"] as? String) ?? contextRunID ?? ""
   675	        let frame: JSONObject = [
   676	            "type": "event", "event": "agent",
   677	            "payload": [
   678	                "runId": runID, "sessionKey": kernelKey, "stream": "lifecycle",
   679	                "data": [
   680	                    "phase": "end",
   681	                    "aborted": true,
   682	                ] as JSONObject,
   683	                "ts": Int(Date().timeIntervalSince1970 * 1000),
   684	            ] as JSONObject,
   685	        ]
   686	        await client.testSupportFeedFrame(frame)
   687	        await ctx.setHasStopWaitingForTerminal(false)
   688	
   689	    case "evt.approval_request":
   690	        let payload = (messageAny["payload"] as? [String: Any]) ?? [:]
   691	        guard let reqID = payload["reqId"] as? String, let toolCallID = payload["toolCallId"] as? String else {
   692	            throw RunnerError.malformed("mock_event(evt.approval_request) 缺少 payload.reqId/toolCallId")
   693	        }
   694	        let contextRunID = await ctx.currentRunIDValue
   695	        let runID = (messageAny["runId"] as? String) ?? contextRunID ?? "run-approval-1"
   696	        let timeoutMS = (payload["timeoutMs"] as? Int) ?? 1_800_000
   697	        let nowMs = Int(Date().timeIntervalSince1970 * 1000)
   698	        // T-048 REWORK #1/#2（删除非法 `_openclawJoinOrder`）：原生双帧到达顺序改读
   699	        // `TimelineOp.driverHint`（../dsl.ts 的 `MockEventDriverHint.approvalJoinOrder`）——DSL 层面
   700	        // 显式声明的翻译层驱动量，不在封闭的 D2 `message` 联合里，语义不变。
   701	        let driverHintAny = (op.driverHint?.value as? [String: Any]) ?? [:]
   702	        let order = (driverHintAny["approvalJoinOrder"] as? String) ?? "agent_first"
   703	
   704	        let agentFrame: JSONObject = [
   705	            "type": "event", "event": "agent",
   706	            "payload": [
   707	                "runId": runID, "sessionKey": kernelKey, "stream": "approval",
   708	                "data": ["phase": "requested", "toolCallId": toolCallID, "approvalId": reqID] as JSONObject,
   709	                "ts": nowMs,
   710	            ] as JSONObject,
   711	        ]
   712	        let sessionApprovalFrame: JSONObject = [
   713	            "type": "event", "event": "session.approval",
   714	            "payload": [
   715	                "sessionKey": kernelKey, "updatedAtMs": nowMs, "phase": "pending",
   716	                "approval": [
   717	                    "id": reqID, "status": "pending",
   718	                    "presentation": ["kind": "exec", "commandText": "echo \(reqID)"] as JSONObject,
   719	                    "createdAtMs": nowMs, "expiresAtMs": nowMs + timeoutMS,
   720	                ] as JSONObject,
   721	            ] as JSONObject,
   722	        ]
   723	
   724	        if order == "session_first" {
   725	            await client.testSupportFeedFrame(sessionApprovalFrame)
   726	            try? await Task.sleep(nanoseconds: 30_000_000)
   727	            await client.testSupportFeedFrame(agentFrame)
   728	        } else {
   729	            await client.testSupportFeedFrame(agentFrame)
   730	            try? await Task.sleep(nanoseconds: 30_000_000)
   731	            await client.testSupportFeedFrame(sessionApprovalFrame)
   732	        }
   733	
   734	    default:
   735	        throw RunnerError.malformed(
   736	            "mock_event: swift-runner Stage A 未实现『\(type)』的 openclaw wire 翻译" +
   737	            "（超出本轮三组 fixture 需要的范围，未静默忽略）"
   738	        )
   739	    }
   740	}
