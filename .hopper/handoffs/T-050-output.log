   837	// MARK: - DEGRADED 检测
   838	
   839	func degradeReason(for fixture: ParityFixture) -> String? {
   840	    for op in fixture.timeline where op.op == .clientCall {
   841	        if let call = op.call, ["interrupt", "respondApproval", "capabilities"].contains(call) {
   842	            return "timeline 包含 client_call『\(call)』——SG-5 OpenclawGatewayKernelClient 该方法本轮" +
   843	                "仍是 TODO 桩（KernelClient.swift 头注释 + OpenclawGatewayKernelClient.swift 对应方法体" +
   844	                "均为 `throw .notImplemented`），没有任何 RPC/wire 交互可翻译，无法驱动真实 client 产生" +
   845	                "有意义的状态转移。本 fixture 对 swift-runner 诚实降级为 DEGRADED（跳过，不计入 PASS/FAIL），" +
   846	                "不伪造一个假内核让它'通过'。"
   847	        }
   848	    }
   849	    return nil
   850	}
