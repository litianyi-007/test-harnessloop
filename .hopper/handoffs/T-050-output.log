    82	  /** 执行一次 client_call：构造对应的 req.* outbound 消息（供 expect_outbound 断言），
    83	   *  同步应用极简的 sessionLock 转移规则。返回本次调用的 outbound 记录——**若这次调用在锁互斥矩阵
    84	   *  下被同步拒绝（D1 v3.1 §9.1 KernelPortRejectionCode 层面，未铸造 operationId），返回 undefined
    85	   *  且不注册任何 outbound**，对齐真实 client『锁不满足前置条件时在任何 RPC 发出之前就 throw』的
    86	   *  行为（swift-runner 侧同理：`session_locked` 由 stop()/send() 顶部 guard 直接抛出，从不到达
    87	   *  `request()`）。 */
    88	  call(id: string, method: KernelClientMethod, args: unknown): OutboundRecord | undefined {
    89	    const payload = (args ?? {}) as Record<string, unknown>;
    90	    const sessionId = this.currentSessionId;
    91	
    92	    // D1 v3.1 §9.3 规则 1：send()/stop() 在锁不是 idle（且不是 interrupt_in_progress 的『排队』
    93	    // 特例）时一律同步 reject(session_locked)——发生在 operationId 铸造之前，不发起任何 RPC。
    94	    if (method === 'send' && this.sessionLock !== 'idle') {
    95	      this.callOutcomes[id] = { status: 'rejected', failure: { code: 'session_locked' } };
    96	      return undefined;
    97	    }
    98	    if (method === 'stop' && this.sessionLock !== 'idle' && this.sessionLock !== 'interrupt_in_progress') {
    99	      this.callOutcomes[id] = { status: 'rejected', failure: { code: 'session_locked' } };
   100	      return undefined;
   101	    }
   102	
   103	    let type: string;
   104	    const message: Record<string, unknown> = {};
   105	
   106	    switch (method) {
   107	      case 'createSession':
   108	        type = 'req.createSession';
   109	        message.payload = payload;
   110	        break;
   111	      case 'send':
   112	        type = 'req.send';
   113	        message.payload = payload;
   114	        message.sessionId = sessionId;
   115	        this.sessionLock = 'send_pending';
   116	        break;
   117	      case 'subscribe':
   118	        type = 'req.subscribe';
   119	        message.payload = {};
   120	        message.sessionId = sessionId;
   121	        break;
   122	      case 'interrupt':
   123	        type = 'req.interrupt';
   124	        message.payload = payload;
   125	        message.sessionId = sessionId;
   126	        // 极简锁转移：idle -> interrupt_in_progress（本轮只需覆盖这一条起始转移）。
   127	        if (this.sessionLock === 'idle') {
   128	          this.sessionLock = 'interrupt_in_progress';
   129	        }
   130	        this.pendingOperations[id] = 'in_flight';
   131	        break;
   132	      case 'stop':
   133	        type = 'req.stop';
   134	        message.payload = {};
   135	        message.sessionId = sessionId;
   136	        if (this.sessionLock === 'interrupt_in_progress') {
   137	          // D1 §9.3：soft steer 在途时 stop() 到达——排队等待，不改变当前锁状态，不得抢占。
   138	          this.queuedStopWhileInterrupt = id;
   139	        } else if (this.sessionLock === 'idle') {
   140	          this.sessionLock = 'stop_in_progress';
   141	        }
   142	        this.pendingOperations[id] = 'in_flight';
   143	        break;
   144	      case 'respondApproval':
   145	        type = 'req.respondApproval';
   146	        message.payload = payload;
   147	        message.sessionId = sessionId;
   148	        break;
   149	      case 'capabilities':
   150	        type = 'req.capabilities';
   151	        message.payload = payload;
   152	        break;
   153	      case 'queryBilling':
   154	        type = 'req.queryBilling';
   155	        message.payload = payload;
   156	        message.sessionId = sessionId;
   157	        break;
   158	      default:
   159	        throw new Error(`MockKernelClient: 未知方法 '${method}'（TODO：本轮只实现 8 个方法的极简路径）`);
   160	    }
   161	    message.type = type;
   162	    message.id = id;
   163	
   164	    const record: OutboundRecord = { id, method, message };
   165	    this.outbound.set(id, record);
   166	    return record;
   167	  }
   168	
   169	  getOutbound(id: string): OutboundRecord | undefined {
   170	    return this.outbound.get(id);
   171	  }
   172	
   173	  /** 应用一条（已由 runner 补全 shorthand 的）response 消息。 */
   174	  applyResponse(replyTo: string, expanded: Record<string, unknown>): void {
   175	    const record = this.outbound.get(replyTo);
   176	    if (!record) {
   177	      throw new Error(`applyResponse: 找不到 replyTo='${replyTo}' 对应的 outbound 记录`);
   178	    }
   179	
   180	    if (record.method === 'stop') {
   181	      this.applyStopResponse(replyTo, expanded);
   182	      return;
   183	    }
   184	
   185	    if ('result' in expanded) {
   186	      this.callOutcomes[replyTo] = { status: 'resolved', value: expanded.result };
   187	      if (record.method === 'createSession') {
   188	        const result = expanded.result as { sessionHandle?: { sessionId?: string } };
   189	        this.currentSessionId = result.sessionHandle?.sessionId;
   190	      }
   191	      if (record.method === 'send') {
   192	        const result = expanded.result as { runId?: string };
   193	        this.currentRunId = result?.runId;
   194	        if (this.sessionLock === 'send_pending') this.sessionLock = 'idle';
   195	      }
   196	      if (record.method === 'interrupt') {
   197	        const result = expanded.result as { outcome?: OperationOutcome };
   198	        if (result?.outcome) this.pendingOperations[replyTo] = result.outcome;
   199	      }
   200	    } else if ('failure' in expanded) {
   201	      this.callOutcomes[replyTo] = { status: 'rejected', failure: expanded.failure };
   202	      if (record.method === 'send' && this.sessionLock === 'send_pending') this.sessionLock = 'idle';
   203	    }
   204	
   205	    // interrupt resolve 后，若有排队中的 stop，锁才真正转为 stop_in_progress
   206	    // （D1 §9.3「等待，不抢占」规则的后半段：steer 按二态收敛后锁转 stop_in_progress）。
   207	    if (record.method === 'interrupt' && this.queuedStopWhileInterrupt) {
   208	      this.sessionLock = 'stop_in_progress';
   209	      this.queuedStopWhileInterrupt = undefined;
   210	    }
   211	  }
   212	
   213	  /** D1 v3 §9.3 stop() 的核心因果——从 spec 写出，不从 `expanded.result.outcome` 直接抄值
   214	   *  （T-048 REWORK #3 核心，见文件头注释）：
   215	   *  - `failure`：底层 RPC 本身失败（M3 catch 分支）——operationId 已铸造，直接产出
   216	   *    operation_completed(rejected) 镜像，**不**产出 session_end（真实 stop() 的 catch 分支只清理
   217	   *    状态+补镜像+重新抛错，不会走到 `emitStopSessionEndAndFinish`），锁释放回 idle。
   218	   *  - `result` 且没有 active run（`this.currentRunId` undefined）：sessions.abort 诚实回报『没有
   219	   *    可等待的终态』，立即产出 succeeded + session_end(stopped)。
   220	   *  - `result` 且有 active run：**不**立即结算——记录 `pendingStopWait`，真正的 OperationOutcome
   221	   *    由随后到达的 `evt.turn_complete`（terminal-observed）/`advance_clock`（timed-out）/
   222	   *    `disconnect`（transport-closed）三条互斥路径之一决定，见 `resolveStopWait`。 */
   223	  private applyStopResponse(replyTo: string, expanded: Record<string, unknown>): void {
   224	    if ('failure' in expanded) {
   225	      this.emit('evt.operation_completed', { outcome: 'rejected', operationKind: 'stop' });
   226	      this.pendingOperations[replyTo] = 'rejected';
   227	      this.sessionLock = 'idle';
   228	      this.callOutcomes[replyTo] = { status: 'rejected', failure: expanded.failure };
   229	      return;
   230	    }
   231	
   232	    if (this.currentRunId === undefined) {
   233	      this.emit('evt.operation_completed', { outcome: 'succeeded', operationKind: 'stop' });
   234	      this.emit('evt.session_end', { reason: 'stopped' });
   235	      this.pendingOperations[replyTo] = 'succeeded';
   236	      this.sessionLock = 'idle';
   237	      return;
   238	    }
   239	
   240	    this.pendingStopWait = { id: replyTo, affectedRunId: this.currentRunId };
   241	  }
   242	
   243	  private resolveStopWait(outcome: 'succeeded' | 'timed_out' | 'aborted_effect_unknown', sessionEndReason: string): void {
   244	    const wait = this.pendingStopWait;
   245	    if (!wait) return;
   246	    this.emit('evt.operation_completed', { outcome, operationKind: 'stop', affectedRunId: wait.affectedRunId });
   247	    this.pendingOperations[wait.id] = outcome;
   248	    this.sessionLock = 'idle';
   249	    this.pendingStopWait = undefined;
   250	    this.currentRunId = undefined;
   251	    // session_end 在 turn_complete 分支（succeeded 经 terminal-observed）里由调用方
   252	    // （`applyEvent` 的 evt.turn_complete 分支）在转发完 turn_complete 本身之后再补——保持
   253	    // operation_completed -> turn_complete -> session_end 这个 D1 v3 §9.3 规定的顺序；
   254	    // timed_out/aborted_effect_unknown 两条路径没有 turn_complete，直接在这里补。
   255	    if (outcome !== 'succeeded') {
   256	      this.emit('evt.session_end', { reason: sessionEndReason });
   257	    }
   258	  }
   259	
   260	  /** 应用一条（已由 runner 补全 shorthand 的）event 消息——简化版：不做订阅者过滤/多订阅者广播，
   261	   *  只要 subscribe() 已被调用过就记录（TODO：完整实现需要按 D1 §9.2 F-13 处理订阅生命周期）。 */
   262	  applyEvent(expanded: Record<string, unknown>): void {
   263	    this.eventSeq += 1;
   264	    const type = expanded.type as string;
   265	    const payload = expanded.payload as Record<string, unknown> | undefined;
   266	
   267	    if (type === 'evt.approval_request' && payload?.reqId) {
   268	      this.approvalState[payload.reqId as string] = 'pending';
   269	    }
   270	
   271	    if (type === 'evt.turn_complete' && this.pendingStopWait) {
   272	      // D1 v3 §9.3：terminal-observed 路径——先补 operation_completed(succeeded) 镜像，再转发
   273	      // fixture 自己声明的 turn_complete（forceResolvedApprovals 等字段原样透传，不是本文件计算
   274	      // 出来的——T-048 新增能力 stop-force-denies-pending-approval.json 靠这条路径把
   275	      // forceResolvedApprovals 传递到 observedEvents），最后补 session_end(stopped)。
   276	      const wait = this.pendingStopWait;
   277	      this.emit('evt.operation_completed', { outcome: 'succeeded', operationKind: 'stop', affectedRunId: wait.affectedRunId });
   278	      this.pendingOperations[wait.id] = 'succeeded';
   279	      this.sessionLock = 'idle';
   280	      this.pendingStopWait = undefined;
   281	      this.currentRunId = undefined;
   282	      this.observedEvents.push({ type, payload });
   283	      this.emit('evt.session_end', { reason: 'stopped' });
   284	      return;
   285	    }
   286	
   287	    this.observedEvents.push({ type, payload });
   288	  }
   289	
   290	  /** T-048 REWORK #3：虚拟时钟推进——只在『有一个 stop() 正在等待 active run 终态确认』时才有意义
   291	   *  （对齐 swift-runner `applyAdvanceClock` 的同一窄范围声明），`ms` 跨越 `TEST_STOP_TIMEOUT_MS`
   292	   *  阈值时判定为超时，产出 operation_completed(timed_out) + session_end(stopped)。 */
   293	  advanceClock(ms: number): void {
   294	    if (!this.pendingStopWait) return;
   295	    if (ms < TEST_STOP_TIMEOUT_MS) return;
   296	    this.resolveStopWait('timed_out', 'stopped');
   297	  }
   298	
   299	  /** T-048 REWORK #3：断线——只在『有一个 stop() 正在等待 active run 终态确认』时才有意义（其余
   300	   *  断线重连语义本轮未实现，TODO，对齐 swift-runner 同样窄的范围声明）。真实 D1 §9.2/NOTE-1
   301	   *  因果：transport 断开时若仍有 stop() 在等待，适配器必须补发一条 aborted_effect_unknown 镜像
   302	   *  （效果未知，不是失败也不是成功）后再产出 session_end(transport_closed)，不能让等待者永久悬挂。 */
   303	  disconnect(): void {
   304	    if (!this.pendingStopWait) return;
   305	    this.resolveStopWait('aborted_effect_unknown', 'transport_closed');
   306	  }
   307	}
     1	// SG-8.7 Stage A：Swift 金标 parity runner——驱动 SG-5 交付的真实 `OpenclawGatewayKernelClient`
     2	// （app/kernel-client/swift/OpenclawGatewayKernelClient.swift），不是另写一个假内核。
     3	//
     4	// ============================================================================================
     5	// 设计钢印：为什么『翻译层』是必须的，而不是『直接喂 D2 形状』
     6	// ============================================================================================
     7	// fixture 的 `mock_response`/`mock_event` 用 D4 §4.3 `WireResponseShorthand`/`WireEventShorthand`
     8	// 书写——这两个类型直接等于 D2 契约的 `ResponseMessage`/`EventMessage`（见 ../dsl.ts 头注释）。
     9	// ../ts-runner/mock-kernel-client.ts 之所以能直接消费这种形状，是因为它是一个『D1 KernelPort 的
    10	// 极简假内核』：wire 协议本身就是 D2。
    11	//
    12	// 但 `OpenclawGatewayKernelClient` 不是这样的假内核——它是 SG-4/SG-5 交付的**真实适配器**，一侧对
    13	// D1 KernelPort（createSession/send/subscribe/stop 等方法签名，用 D2 codegen 类型 Config/Input/
    14	// SessionHandle 做参数），另一侧对 openclaw Gateway **原生** wire 协议（`{type:"req/res/event",
    15	// method, event, payload}`，字段名/形状与 D2 完全不同，见 OpenclawWire.swift/EventMapping.swift）。
    16	// D2 事件是 EventMapping.swift 的映射产物，不是 wire 上直接出现的东西。
    17	//
    18	// 所以『驱动真实 client』意味着：在 openclaw 原生 wire 这一层喂帧/接 RPC，而不是在 D2 这一层。
    19	// 本文件的翻译层职责就是：把 fixture 里 D2 形状的 `mock_response`/`mock_event`，转换成会让真实
    20	// `OpenclawGatewayKernelClient` 的**生产代码路径**（`request()`/`handleIncoming()`/
    21	// `EventMapping.swift` 的各个 mapper）产出对应可观察状态的 openclaw 原生 RPC 响应/wire 事件帧，
    22	// 复用 FrameReplayTests.swift 已经验证过的两个钩子：`testSupportStubRPC`（按 openclaw RPC 方法名
    23	// 注册响应）、`testSupportFeedFrame`（喂一帧合成的 openclaw wire JSON 进 `handleIncoming`）。
    24	// 这不是「另写一个假内核」——琴弦另一头永远是真实 actor 的方法体/dispatch 分支，翻译层只解决『用什么
    25	// 输入才能让真实代码产出 fixture 想要的可观察后果』，输出永远来自真实映射代码，不是手工构造 D2 事件
    26	// 短路过去。
    27	//
    28	// ============================================================================================
    29	// 已知的『无法翻译』边界（诚实降级，不伪造）
    30	// ============================================================================================
    31	// - `interrupt()`/`respondApproval()`/`capabilities()` 在 SG-5 里仍是 TODO 桩（见
    32	//   KernelClient.swift 头注释、OpenclawGatewayKernelClient.swift 对应方法体），调用即
    33	//   `throw .notImplemented`，没有任何 RPC/wire 交互可翻译。任何 timeline 用到这三个方法的 fixture，
    34	//   本 runner 在执行前就静态扫描发现并标记 DEGRADED（跳过，不计入 PASS/FAIL），见
    35	//   `degradeReason(for:)`。
    36	// - `expect_outbound`（T-048 REWORK #4 收残）：先校验『真实 client 是否调用了这个 D2 方法对应的
    37	//   正确 openclaw RPC 方法名』（`expectOutboundMethodTable`，真实 client 的 outbound wire 从来
    38	//   就不是 D2 req.* 形状，这一步是翻译诚实能保证的最基础粒度），方法名匹配后再对一个『规范化请求』
    39	//   （`type` + 可选 `sessionId` + `payload`）做与 `ts-runner/runner.ts` 的 `partialMatch` 等价的
    40	//   完整子集深度匹配——不再像上一轮那样只查方法名、把 pattern 里其余字段全部丢弃。规范化请求的
    41	//   `payload` 直接是这次 `client_call` 的原始 `args`（真实传给了 KernelPort 方法本身，如实反映）；
    42	//   `sessionId` 用 `declaredSessionID`（下面这条单独说明），不是真实 client 内部铸造的随机
    43	//   `SessionHandle.sessionID`。
    44	// - `sessionId`/`operationId` 是真实 client 内部铸造的随机 UUID（`createSession()`/`stop()`
    45	//   各自 `UUID().uuidString`），fixture 无法预先声明字面值——本 runner 因此不断言真实 client 内部
    46	//   状态查询（`testSupportLockState` 等）之外场景下这两个字段的具体取值。`pendingOperations` 改用
    47	//   dsl.ts 注释里明确允许的『client_call 的 id』做键（不是内部 operationId）。`expect_outbound` 的
    48	//   规范化请求改用 `declaredSessionID`——即 fixture 自己在 `res.createSession` mock_response 里
    49	//   声明过的 `sessionHandle.sessionId`（如 "session-1"），不是真实随机 UUID：这是 runner 自己的
    50	//   记账值，只用于校验『同一 fixture 内前后请求引用的是同一个已声明会话』这条内部一致性，不代表
    51	//   真实 client 内部真的用这个字符串做寻址（它用的是 kernelKey，见 `kernelKeyBySessionID`）。
    52	//   `runId` 例外：它是 openclaw RPC 响应里的纯透传字段，翻译层完全掌控其内容，因此 fixture 可以
    53	//   放心声明字面 runId 并让它真实流过整条链路，`ctx.currentRunIDValue` 也因此可以直接拿来判定
    54	//   『stop() 发起时是否存在 active run』（见下一条）。
    55	// - `mock_response(stop)`/`mock_event(evt.turn_complete)` 不再依赖 fixture 里任何非 D2 私有提示
    56	//   字段（T-048 REWORK #1 收残：删除了 `_openclawAbortAck`/`_openclawLifecycle`）——sessions.abort
    57	//   原生 ack 该携带的 `abortedRunId`/`status`，从『此前是否有一个 send() 已经真实 resolve 出一个
    58	//   runId』（`ctx.currentRunIDValue`）无歧义派生，不需要 fixture 作者另外声明只有本 runner 认得的
    59	//   字段；`evt.turn_complete` 在 Stage A 唯一的用途就是合成 stop() 等待中的 aborted lifecycle
    60	//   终态信号，直接硬编码 `phase:"end", aborted:true`（Stage A 范围内没有第二种用途需要区分）。
    61	//   `evt.approval_request` 的原生双帧到达顺序改读 `TimelineOp.driverHint`（../dsl.ts 的
    62	//   `MockEventDriverHint`，DSL 层面显式声明的翻译层驱动量，不在 `message` 里，见该文件文档注释）。
    63	// - `mock_event`/`mock_response` 只实现了 Stage A 三组 fixture（approval/operation-outcome/
    64	//   session-lock）需要的类型（evt.message.delta、evt.turn_complete 用作 stop() 等待终态的合成
    65	//   信号、evt.approval_request、以及 stop 类 client_call 的响应翻译）；遇到未登记的类型直接抛错，
    66	//   不静默忽略，逼真实缺口暴露而不是假装通过。
    67	
    68	import Foundation
    69	
    70	// MARK: - 小工具
    71	
    72	enum RunnerError: Error, CustomStringConvertible {
    73	    case malformed(String)
    74	    var description: String {
    75	        switch self {
    76	        case .malformed(let m): return "swift-runner 内部错误（fixture 或翻译层不匹配）：\(m)"
    77	        }
    78	    }
    79	}
