   852	// MARK: - 顶层：跑一个 fixture 文件
   853	
   854	public enum FixtureRunOutcome {
   855	    case passed
   856	    case failed([Mismatch])
   857	    case degraded(String)
   858	}
   859	
   860	public struct FixtureRunResult {
   861	    public let name: String
   862	    public let path: String
   863	    public let outcome: FixtureRunOutcome
   864	}
   865	
   866	public func runFixtureFile(at path: String) async -> FixtureRunResult {
   867	    let fileName = (path as NSString).lastPathComponent
   868	    guard let data = FileManager.default.contents(atPath: path) else {
   869	        return FixtureRunResult(name: fileName, path: path, outcome: .failed(["无法读取文件：\(path)"]))
   870	    }
   871	    let fixture: ParityFixture
   872	    do {
   873	        fixture = try JSONDecoder().decode(ParityFixture.self, from: data)
   874	    } catch {
   875	        return FixtureRunResult(name: fileName, path: path, outcome: .failed(["无法解析 fixture JSON：\(error)"]))
   876	    }
   877	
   878	    if let reason = degradeReason(for: fixture) {
   879	        return FixtureRunResult(name: fixture.name, path: path, outcome: .degraded(reason))
   880	    }
   881	
   882	    if let initial = fixture.initialState?.value as? [String: Any], !initial.isEmpty {
   883	        // 本轮三组 fixture 均不需要 `initialState`（都从 idle/干净状态起步），SG-5 也没有暴露
   884	        // 『直接摆一个初始锁状态』的测试钩子（不同于 ts-runner 的 MockKernelClient 可以直接赋值
   885	        // `client.sessionLock`）——诚实拒绝，而不是静默忽略 fixture 作者可能依赖的初始状态。
   886	        return FixtureRunResult(
   887	            name: fixture.name, path: path,
   888	            outcome: .failed(["fixture 声明了 initialState \(initial)，但 swift-runner 本轮未实现" +
   889	                              "『驱动真实 client 进入某个非默认初始状态』的能力（SG-5 未提供对应测试钩子），" +
   890	                              "如实拒绝而非静默忽略"])
   891	        )
   892	    }
   893	
   894	    let client = OpenclawGatewayKernelClient(
   895	        endpoint: URL(string: "ws://127.0.0.1:1")!, token: "swift-runner-fixture-token"
   896	    )
   897	    await client.testSupportSetStopTimeoutSeconds(RunnerContext.stopTimeoutSeconds)
   898	    let ctx = RunnerContext(client: client)
   899	
   900	    do {
   901	        for op in fixture.timeline {
   902	            try await executeOp(op, ctx: ctx)
   903	        }
   904	    } catch {
   905	        return FixtureRunResult(name: fixture.name, path: path, outcome: .failed(["执行 timeline 时抛出异常：\(error)"]))
   906	    }
   907	
   908	    // 收尾：给所有 spawn 的 client_call/事件排空 Task 一点真实时间稳定下来，再做最终快照。
   909	    try? await Task.sleep(nanoseconds: 150_000_000)
   910	
   911	    var mismatches = await ctx.accumulatedMismatches
   912	    let finalState = await ctx.snapshotWithLock()
   913	    mismatches += partialMatch(actual: finalState, expected: fixture.expected?.value, path: "expected")
   914	
   915	    return FixtureRunResult(
   916	        name: fixture.name, path: path,
   917	        outcome: mismatches.isEmpty ? .passed : .failed(mismatches)
   918	    )
   919	}

