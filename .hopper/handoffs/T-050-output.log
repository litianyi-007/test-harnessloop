   175	// MARK: - RunnerContext：一次 fixture 执行期间的全部可变状态（actor 隔离，天然并发安全）
   176	
   177	actor RunnerContext {
   178	    let client: OpenclawGatewayKernelClient
   179	
   180	    /// 真实收窄后的 stop() 等待超时（秒）——见文件头「虚拟时钟」一节的说明。
   181	    static let stopTimeoutSeconds = 1
   182	    static let stopTimeoutMs: UInt64 = 1000
   183	
   184	    var currentSessionHandle: SessionHandle?
   185	    var currentSessionID: String?
   186	    var currentKernelKey: String?
   187	    var currentRunID: String?
   188	
   189	    /// fixture 自己在 `res.createSession` mock_response 里声明过的 `sessionHandle.sessionId`
   190	    /// （如 "session-1"）——**不是**真实 client 内部铸造的随机 `SessionHandle.sessionID`（那个是
   191	    /// `currentSessionID`，真实状态查询如 `testSupportLockState` 必须用它）。只用于
   192	    /// `expect_outbound` 规范化请求里的 `sessionId` 字段，校验『同一 fixture 内前后请求引用同一个
   193	    /// 已声明会话』这条内部一致性（T-048 REWORK #4）。
   194	    var declaredSessionID: String?
   195	
   196	    /// 当前是否有一个 `stop()` client_call 正在等待 SG-5 内部终态确认（`hasStopWaitingForTerminal`
   197	    /// 为 true 期间）——记录是*哪一个* client_call id，供 `advance_clock`/`disconnect` 轮询
   198	    /// `isCallSettled(id:)` 时知道该盯哪个 id（T-048 REWORK #5）。
   199	    var waitingStopCallID: String?
   200	
   201	    var callKindByID: [String: String] = [:]
   202	    var replyGates: [String: ReplyGate] = [:]
   203	    /// `normalizedRequest`：T-048 REWORK #4 新增——`expect_outbound` 用于完整 pattern 匹配的规范化
   204	    /// 请求（`type` + 可选 `sessionId` + `payload`），在 stub 闭包捕获真实 outbound 的同一时刻构造，
   205	    /// 见 `performClientCall`。
   206	    var capturedOutbound: [String: (method: String, params: JSONObject, normalizedRequest: [String: Any])] = [:]
   207	
   208	    /// `client_call` 的 id → OperationOutcome（interrupt/stop 铸造的 operation 通道）——dsl.ts 明确
   209	    /// 允许键是『operationId 或 client_call 的 id』，本 runner 一律用后者（真实 operationId 是运行时
   210	    /// 随机 UUID，fixture 无法预先声明，见文件头说明）。
   211	    var pendingOperations: [String: Any] = [:]
   212	    var callOutcomes: [String: Any] = [:]
   213	    var approvalState: [String: Any] = [:]
   214	    var drainedEvents: [[String: Any]] = []
   215	
   216	    var pendingTasks: [Task<Void, Never>] = []
   217	    var accumulatedMismatches: [Mismatch] = []
   218	    var hasStopWaitingForTerminal = false
   219	
   220	    init(client: OpenclawGatewayKernelClient) {
   221	        self.client = client
   222	    }
   223	
   224	    func recordOutbound(id: String, method: String, params: JSONObject, normalizedRequest: [String: Any]) {
