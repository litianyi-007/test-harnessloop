    72	enum RunnerError: Error, CustomStringConvertible {
    73	    case malformed(String)
    74	    var description: String {
    75	        switch self {
    76	        case .malformed(let m): return "swift-runner 内部错误（fixture 或翻译层不匹配）：\(m)"
    77	        }
