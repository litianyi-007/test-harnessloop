   425	    /// F6 只解决了"operationId 不共享"和"delete 前不等终态"两个问题，但重写本身引入/遗留了三类新
   426	    /// 缺陷（codex 独立复现）：
   427	    ///   ① `abortedRunId==nil`（无 active run）与"等待超时"两条路径只让 Promise 知道结果，从不给
   428	    ///      `subscribe()` 事件流补一条 `operation_completed` 镜像——只订阅事件流、不等 Promise 的
   429	    ///      观察者完全看不到这次 stop 操作本身的终态。
   430	    ///   ② active-run 路径把"这次 stop 操作成功与否"和"sessions.delete 这一步资源回收是否成功"
   430	    ///   ② active-run 路径把"这次 stop 操作成功与否"和"sessions.delete 这一步资源回收是否成功"
   431	    ///      两件事混为一谈：`handleAgentEvent` 在 delete **之前**就已经用 `succeeded` 发出了
   432	    ///      operation_completed（这个时机是对的，D1 §9.3 要求先有终态再有 session_end），但 Promise
   433	    ///      的 outcome 却在 delete **之后**重新按 `deleted` 布尔值计算——如果 delete 恰好返回
   434	    ///      `deleted:false`，Promise 报 `.rejected`，与已经发出的 Event `.succeeded` 直接矛盾。
   435	    ///      修法：outcome 只由"等没等到终态确认"（timedOut）决定，不再看 `deleted`——delete 是这次
   436	    ///      stop 操作的收尾资源回收步骤，和"abort 本身有没有成功"是两件事，不应该互相污染判定，这样
   437	    ///      Promise 和已经发出的 Event 天然保持一致（因为它们不再有两个独立的信息来源）。
   438	    ///   ③ `sessions.abort`/`sessions.delete` 抛错时整个函数直接向上抛出，`stopInProgress` 锁、
   439	    ///      `pendingStops` 条目都不会被释放——真实复现：第一次 stop() 因传输错误抛出后，锁永久卡在
   440	    ///      `stop_in_progress`，第二次 stop() 会被误判成"另一个 stop 正在进行"而拒绝
   441	    ///      （`session_locked`），即使第一次调用早就已经失败结束。修法：`do/catch` 包裹两次 RPC，
   442	    ///      catch 里统一释放锁 + 清理 pendingStop + 发一条 `operation_completed(outcome:.rejected)`
   443	    ///      镜像，然后把原始错误重新抛给调用方（stop() 这次调用确实失败了，调用方需要知道）。
   444	    ///
   445	    /// `PendingStop.affectedRunID` 在 abort 之后立刻用 `abortResult.abortedRunId`（权威值）覆盖——
   446	    /// 不能一直沿用发起 abort 前的本地缓存 `lastRunIDBySessionID`，那个值可能陈旧，会让
   447	    /// `handleAgentEvent` 里 `pendingForRun.affectedRunID == runID` 的相等判断永远不成立、白等到
   448	    /// 超时（codex 复现的具体机制）。
   449	    public func stop(session: SessionHandle) async throws -> StopResultPayload {
   450	        guard let kernelKey = kernelKeyBySessionID[session.sessionID] else {
   451	            throw KernelClientError.protocolMismatch("unknown session \(session.sessionID)")
   452	        }
   453	
   454	        let currentLock = lockStateBySessionID[session.sessionID] ?? .idle
   455	        guard currentLock == .idle else {
   456	            throw KernelClientError.rpcRejected(
   457	                code: "session_locked",
   458	                message: "stop() rejected: session \(session.sessionID) lock state is \(currentLock), expected idle (D1 v3.1 §9.3)"
   459	            )
   460	        }
   461	        lockStateBySessionID[session.sessionID] = .stopInProgress
   462	
   463	        let operationID = "op-stop-\(UUID().uuidString)"
   464	        let affectedRunIDBeforeAbort = lastRunIDBySessionID[session.sessionID]
   465	        pendingStops[session.sessionID] = PendingStop(operationID: operationID, affectedRunID: affectedRunIDBeforeAbort)
   466	
   467	        do {
   468	            // D1 §6.2 M3（强制定序，rework）：取消当前 run 之前，若该 session 名下存在 pending
   469	            // 审批，必须先把它们强制 deny 掉、确认内核已接受，才能发起 sessions.abort——见
   470	            // `forceDenyPendingApprovalsBeforeStop` 文档注释。这一步必须在 `sessions.abort` 之前
   471	            // 完成，且失败时（RPC 抛错/内核未确认 denied）不能继续往下发 abort——直接落进下面的
   472	            // catch 统一收尾（锁释放+pendingStop 清理+operation_completed(rejected) 镜像），不能
   473	            // 假装"反正等会儿再看"。
   474	            let forceResolvedApprovalReqIDs = try await forceDenyPendingApprovalsBeforeStop(sessionID: session.sessionID)
   475	            pendingStops[session.sessionID]?.forceResolvedApprovalReqIDs = forceResolvedApprovalReqIDs
   476	
   477	            let abortResult = try await request(method: "sessions.abort", params: ["key": kernelKey])
   478	            prettyPrint("RECV sessions.abort result", abortResult)
   479	
   480	            // D1 v3 §9.3："stop() 调用时存在 active run，适配器必须先完成该 run 的强制取消并产出
   481	            // TurnCompleteEvent(cancelled)...确认该事件已经进入 subscribe() 流之后，才能产出
   482	            // SessionEndEvent(reason:'stopped')"。有界等待（不是无限悬挂），交由 handleAgentEvent 在
   483	            // 观察到对应 aborted lifecycle 帧时唤醒；超时则诚实继续（不让调用方永久悬挂），并把
   484	            // outcome 记成 .timedOut。
   485	            //
   486	            // **是否需要等待，由 `sessions.abort` 自己的返回值判断，不是本地缓存的 `affectedRunID`**
   487	            // ——现场实测（scratchpad/openclaw-iso3 隔离环境）坐实：`lastRunIDBySessionID` 只在收到
   488	            // 新 run 时刷新，一个 run 正常 turnComplete 之后这个缓存不会被清空；如果 stop() 在该 run
   489	            // 早已自然结束之后才被调用，`sessions.abort` 会诚实回报 `{"abortedRunId":null,
   490	            // "status":"no-active-run"}`——这种情况下压根不会有任何 aborted lifecycle 帧到达。改为
   491	            // 直接读 `abortResult.abortedRunId`——非空才说明这次 abort 真的中止了一个活跃 run，才需要
   492	            // 等待其终态；为 nil 就没有等待的意义。
   493	            let actuallyAbortedRunID = abortResult["abortedRunId"] as? String
   494	            var timedOut = false
   495	            if let actuallyAbortedRunID = actuallyAbortedRunID {
   496	                // M3：用权威值覆盖，不再信任 abort 前的本地缓存（见函数文档注释）。
   497	                pendingStops[session.sessionID]?.affectedRunID = actuallyAbortedRunID
   498	                let timeoutSeconds = testSupportStopTimeoutSecondsOverride ?? 5
   499	                let waitOutcome = await waitForPendingStopTerminal(sessionID: session.sessionID, timeoutSeconds: timeoutSeconds)
   500	                switch waitOutcome {
   501	                case .transportClosed:
   502	                    // NOTE-1（T-047 grok 复核，真挂起 bug 修复）：等待过程中 transport 已经关闭——
   503	                    // `resolvePendingStopForTransportClose`（见 `handleTransportClosed`）已经代发
   504	                    // `operation_completed(aborted_effect_unknown)` 镜像、标记 `terminalEmitted`，
   505	                    // 且 `clearSessionDerivedCaches` 已经清理了包括本函数 `stopInProgress` 锁在内的
   506	                    // 全部派生状态。这里绝不能假装 succeeded/timed_out 继续往下走——`sessions.delete`
   507	                    // 在 transport 已断的情况下多半也会失败，即使侥幸命中测试桩"成功"了，也会跟已经
   508	                    // 发出的镜像终态矛盾（M3 修的正是 Promise/Event 矛盾这类问题）。如实抛错，交给
   509	                    // 下面的 catch 统一收尾——此时 pendingStop/lock 已经是空的，catch 里的清理调用
   510	                    // 都是安全的 no-op。
   511	                    throw KernelClientError.transport("stop() aborted: transport closed while waiting for aborted-run terminal confirmation")
   512	                case .timedOut:
   513	                    // M3：等待超时也必须给事件流补一条 operation_completed 镜像——上一轮只有 Promise
   514	                    // 知道超时了，只订阅事件流的观察者永远看不到这个 run 的终态。
   515	                    emitOperationCompletedMirror(
   516	                        sessionID: session.sessionID, operationID: operationID,
   517	                        affectedRunID: actuallyAbortedRunID, outcome: .timedOut
   518	                    )
   519	                    // NOTE-2：超时路径也要标记 terminalEmitted——否则迟到的 aborted lifecycle 帧仍
   520	                    // 可能在 clearSessionDerivedCaches 清缓存前，被 handleAgentEvent 的
   521	                    // `!pendingForRun.terminalEmitted` 判断当成"还没发过 terminal"又发一组。
   522	                    pendingStops[session.sessionID]?.terminalEmitted = true
   523	                    timedOut = true
   524	                case .terminalObserved:
   525	                    timedOut = false
   526	                }
   527	            } else {
   528	                // M3：这次 stop() 生效时该 run 早已自然结束（sessions.abort 诚实回报
   529	                // abortedRunId:null）——没有可等待的终态，但 Promise 即将报 succeeded，必须同时给
   530	                // 事件流补一条 operation_completed 镜像（上一轮这条路径只发 session_end，事件流
   531	                // 观察者完全看不到这次 stop 操作本身的终态）。
   532	                pendingStops.removeValue(forKey: session.sessionID)
   533	                emitOperationCompletedMirror(
   534	                    sessionID: session.sessionID, operationID: operationID,
   535	                    affectedRunID: nil, outcome: .succeeded
   536	                )
   537	            }
   538	
   539	            let deleteResult = try await request(method: "sessions.delete", params: ["key": kernelKey])
   540	            prettyPrint("RECV sessions.delete result", deleteResult)
   541	            let deleted = (deleteResult["deleted"] as? Bool) ?? false
   542	            if !deleted {
   543	                // 诚实记录：delete 未确认成功，但不据此把已经发出/即将返回的 succeeded 倒转成
   544	                // rejected——delete 是会话资源回收的收尾步骤，和"这次 stop 操作本身有没有成功中止
   545	                // run"是两件事，不应该互相污染判定（M3 修的正是这个矛盾）。
   546	                prettyPrint("WARN sessions.delete reported deleted:false after stop() otherwise succeeded", deleteResult)
   547	            }
   548	
   549	            emitStopSessionEndAndFinish(session: session)
   550	
   551	            // D1 §2.5：stop() 可达的 outcome 子集是 succeeded/timed_out/rejected 三态——本函数只有
   552	            // 走到这里（两次 RPC 都没有抛错）才可能是 succeeded/timed_out，`.rejected` 专属于下面
   553	            // catch 分支代表的"RPC 本身失败"。
   554	            let outcome: StopResultPayloadOutcome = timedOut ? .timedOut : .succeeded
   555	            return StopResultPayload(operationID: operationID, outcome: outcome)
   556	        } catch {
   557	            // M3：sessions.abort/sessions.delete 抛错——释放锁 + 清理 pendingStop + 发一条
   558	            // operation_completed(outcome:.rejected) 镜像，再把原始错误重新抛出。不清理这三样状态
   559	            // 会让该 session 永久卡在 stop_in_progress（复现：第一次 stop 抛错后锁不释放，第二次
   560	            // stop 被 session_locked 拒绝，即使第一次调用早已结束）。
   561	            //
   562	            // NOTE-1 订正（写 NOTE-1 回归测试时坐实的竞态）：只有当"这次 stop() 还没有为任何其它
   563	            // 路径发过终态镜像"时才在这里补发 rejected——否则会跟已经发出的镜像互相矛盾。两个具体
   564	            // 场景都会走到这里却已经发过别的镜像：① NOTE-1 的 transport-closed 路径
   565	            // （resolvePendingStopForTransportClose 已经标记 terminalEmitted=true 并发出
   566	            // aborted_effect_unknown，stop() 随后如实 throw，落进这个 catch）；②"无 active
   567	            // run"分支已经移除 pendingStop 并发出 succeeded，之后 sessions.delete 才抛错。两种情况
   568	            // 都不该再补一条 rejected——那会让同一次 stop() 在事件流里出现两条互相打架的终态。
   569	            let alreadyTerminalEmitted = pendingStops[session.sessionID]?.terminalEmitted ?? true
   570	            let affectedRunID = pendingStops[session.sessionID]?.affectedRunID ?? affectedRunIDBeforeAbort
   571	            if !alreadyTerminalEmitted {
   572	                emitOperationCompletedMirror(
   573	                    sessionID: session.sessionID, operationID: operationID,
   574	                    affectedRunID: affectedRunID, outcome: .rejected
   575	                )
   576	            }
   577	            pendingStops.removeValue(forKey: session.sessionID)
   578	            lockStateBySessionID.removeValue(forKey: session.sessionID)
   579	            throw error
   580	        }
   581	    }
