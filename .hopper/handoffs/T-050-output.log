    79	}
    80	
    81	/// 单次 RPC 响应的『延迟解锁』——responder 闭包 `await gate.wait()`，runner 处理到对应
    82	/// `mock_response` timeline op 时才 `resolve(...)`，让真实 client 的 `request()` 真的悬挂到那一刻
    83	/// 才返回，从而让『client_call 在途 / 锁在途』这类中途 assert_state 断言的是真实状态而非摆拍。
    84	///
    85	/// **T-048 REWORK #7**：上一轮用 `NSLock.lock()/unlock()` 手工加锁保护 `resolution`/`waiter`
    86	/// ——在 `wait()`（`async` 函数）里直接调用 `NSLock.lock/unlock` 在 Apple Swift 6.3.3 默认
    87	/// language mode 下即会警告『不可在异步上下文调用，Swift 6 language mode 下将是编译错误』
    88	/// （`swiftc` 实测复现）。改成 `actor`：与 SG-5 `OpenclawGatewayKernelClient`/本文件
    89	/// `RunnerContext` 同款做法，用 actor 隔离取代手工锁，消除警告的同时不改变可观察行为——
    90	/// `resolve`/`wait` 都改成 actor-isolated 方法，`wait()` 内部在 `withCheckedThrowingContinuation`
    91	/// 闭包里同步写 `self.waiter`（在挂起点之前执行，仍处于该 actor 的隔离期内），与 SG-5
    92	/// `waitForPendingStopTerminal` 已经在用的同一手法一致。
    93	actor ReplyGate {
    94	    private var resolution: Result<JSONObject, Error>?
    95	    private var waiter: CheckedContinuation<JSONObject, Error>?
    96	
    97	    func resolve(_ result: Result<JSONObject, Error>) {
    98	        guard resolution == nil else { return }
    99	        resolution = result
   100	        guard let w = waiter else { return }
   101	        waiter = nil
   102	        switch result {
   103	        case .success(let v): w.resume(returning: v)
   104	        case .failure(let e): w.resume(throwing: e)
   105	        }
   106	    }
   107	
   108	    func wait() async throws -> JSONObject {
   109	        if let r = resolution {
   110	            switch r {
   111	            case .success(let v): return v
   112	            case .failure(let e): throw e
   113	            }
   114	        }
   115	        return try await withCheckedThrowingContinuation { (cont: CheckedContinuation<JSONObject, Error>) in
   116	            self.waiter = cont
   117	        }
   118	    }
   119	}
   120	
   121	/// 把一个 D2 事件（真实 EventMapping.swift 产出的 `EventMessageUnion`）转成 fixture DSL
   122	/// `observedEvents` 期望的 `{type, payload}` 形状——`payload` 用 JSONEncoder 编码具体 payload 结构体
   123	/// 再转回 `[String: Any]`，不是手写字段搬运，保证跟真实事件字段完全一致。
   124	func encodeToJSONObject<T: Encodable>(_ value: T) -> [String: Any] {
   125	    guard let data = try? JSONEncoder().encode(value),
   126	          let obj = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
   127	        return [:]
   128	    }
   129	    return obj
   130	}
   131	
   132	func eventToObservedEntry(_ event: EventMessageUnion) -> [String: Any] {
   133	    let type = event.wireType
   134	    let payload: [String: Any]
   135	    switch event {
   136	    case .messageDelta(let e): payload = encodeToJSONObject(e.payload)
   137	    case .thinking(let e): payload = encodeToJSONObject(e.payload)
   138	    case .toolCall(let e): payload = encodeToJSONObject(e.payload)
   139	    case .toolResult(let e): payload = encodeToJSONObject(e.payload)
   140	    case .approvalRequest(let e): payload = encodeToJSONObject(e.payload)
   141	    case .error(let e): payload = encodeToJSONObject(e.payload)
   142	    case .turnComplete(let e): payload = encodeToJSONObject(e.payload)
   143	    case .sessionEnd(let e): payload = encodeToJSONObject(e.payload)
   144	    case .capabilityChanged(let e): payload = encodeToJSONObject(e.payload)
   145	    case .operationCompleted(let e): payload = encodeToJSONObject(e.payload)
   146	    case .approvalBufferResolved(let e): payload = encodeToJSONObject(e.payload)
   147	    }
   148	    return ["type": type, "payload": payload]
   149	}
   150	
   151	func failureDict(for error: Error) -> [String: Any] {
   152	    if let e = error as? KernelClientError {
   153	        switch e {
   154	        case .rpcRejected(let code, let message):
   155	            return ["code": code, "detail": message ?? "" as Any]
   156	        case .notImplemented(let m): return ["code": "not_implemented", "detail": m]
   157	        case .transport(let m): return ["code": "transport", "detail": m]
   158	        case .protocolMismatch(let m): return ["code": "protocol_mismatch", "detail": m]
   159	        case .notConnected: return ["code": "not_connected"]
   160	        }
   161	    }
   162	    return ["code": "unknown", "detail": "\(error)"]
   163	}
   164	
   165	func decodeConfig(from json: [String: Any]) throws -> Config {
   166	    let data = try JSONSerialization.data(withJSONObject: json, options: [])
   167	    return try JSONDecoder().decode(Config.self, from: data)
   168	}
   169	
   170	func decodeInput(from json: [String: Any]) throws -> Input {
   171	    let data = try JSONSerialization.data(withJSONObject: json, options: [])
   172	    return try JSONDecoder().decode(Input.self, from: data)
   173	}
