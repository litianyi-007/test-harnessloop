   208	async function loadTaskSpec(hopperDir, taskId) {
   209	  // Try .hopper/handoffs/leader-tasklist.md and extract the relevant section
   210	  const path = join(hopperDir, 'handoffs', 'leader-tasklist.md');
   211	  try {
   212	    const content = await readFile(path, 'utf-8');
   213	    // Find a section starting with **<task-id>** or ## <task-id> or ### <task-id>
   214	    const escapedId = taskId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
   215	    const sectionStart = content.search(new RegExp(
   216	      `(\\*\\*${escapedId}\\*\\*|^##+\\s+${escapedId}\\b|^\\|\\s*${escapedId}\\s*\\|)`,
   217	      'm'
   218	    ));
   219	    if (sectionStart === -1) {
   220	      return `(no detailed spec found for ${taskId} in leader-tasklist.md; using queue.md brief only)`;
   221	    }
   222	    // Take the next ~80 lines as the task spec (or until next H2 heading)
   223	    const rest = content.slice(sectionStart);
   224	    const nextH2 = rest.slice(50).search(/^##\s+/m);
   225	    const end = nextH2 === -1 ? Math.min(rest.length, 8000) : 50 + nextH2;
   226	    return rest.slice(0, end).trim();
   227	  } catch (err) {
   228	    if (err.code === 'ENOENT') {
   229	      return `(no leader-tasklist.md found at ${path}; using queue.md brief only)`;
   230	    }
   231	    throw err;
   232	  }
   233	}
