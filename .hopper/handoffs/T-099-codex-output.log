   169	/**
   170	 * Plan a multi-vendor SWARM (panel) — fan the SAME qualitative brief out to N vendors,
   171	 * each as its own ad-hoc dispatch (one single-spawn per panelist; N tasks, not N retries).
   172	 * PURE: validates + returns the per-panelist plan; the caller dispatches each via the
   173	 * normal ad-hoc path. Restricted to READ-ONLY/qualitative task-types — swarming a write
   174	 * task would have N vendors edit the same files. The vendor *selection* + per-vendor config
   175	 * is a host-side confirmation gate; this only executes the confirmed list.
   176	 *
   177	 * @param {object} args
   178	 * @param {string} args.taskType   a read-only/qualitative task-type (review/research/audit)
   179	 * @param {string} args.brief
   180	 * @param {string[]|string} args.vendors   panelists (array or comma-separated)
   181	 * @param {string} [args.idBase]
   182	 * @returns {Array<{ vendor: string, id: string, taskType: string, brief: string }>}
   183	 */
   184	export function planSwarm({ taskType, brief, vendors, idBase, now = Date.now() }) {
   185	  if (typeof taskType !== 'string' || !TASK_TYPE_PATTERN.test(taskType)) {
   186	    throw new Error(`Invalid --task-type "${taskType}".`);
   187	  }
   188	  if (!READ_ONLY_DEFAULT_TASK_TYPES.includes(taskType)) {
   189	    throw new Error(`--swarm only supports read-only/qualitative task-types (${READ_ONLY_DEFAULT_TASK_TYPES.join(', ')}); got "${taskType}". Swarming a write task would have N vendors edit the same files.`);
   190	  }
   191	  if (typeof brief !== 'string' || brief.trim().length === 0) {
   192	    throw new Error('--swarm requires a non-empty --brief.');
   193	  }
   194	  const list = (Array.isArray(vendors) ? vendors : String(vendors || '').split(','))
   195	    .map((v) => v.trim()).filter(Boolean);
   196	  const uniq = [...new Set(list)];
   197	  if (uniq.length < 2) {
   198	    throw new Error('--swarm needs at least 2 vendors (--vendors v1,v2,...). Use --adhoc for a single vendor.');
   199	  }
   200	  for (const v of uniq) {
   201	    if (!VENDOR_PATTERN.test(v)) throw new Error(`Invalid vendor name "${v}" in --vendors.`);
   202	  }
   203	  const base = idBase || `swarm-${taskType}-${now.toString(36)}`;
   204	  validateTaskId(base);
   205	  return uniq.map((vendor) => ({ vendor, id: `${base}-${vendor}`, taskType, brief }));
   206	}
