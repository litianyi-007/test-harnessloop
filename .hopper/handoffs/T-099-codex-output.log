   143	export async function resolveAdhocDispatch({ hopperDir, taskType, brief, id, vendorOverride = null }) {
   144	  validateTaskId(id);
   145	  if (typeof taskType !== 'string' || !TASK_TYPE_PATTERN.test(taskType)) {
   146	    throw new Error(`Invalid --task-type "${taskType}" (expected lowercase like prd-research / code-review-acceptance).`);
   147	  }
   148	  if (typeof brief !== 'string' || brief.trim().length === 0) {
   149	    throw new Error('Ad-hoc dispatch requires a non-empty --brief.');
   150	  }
   151	  // Frame must exist for the task-type (same loader as the queued path).
   152	  const frame = await loadTaskFrame(hopperDir, taskType);
   153	  const task = { id, taskType, brief, status: 'pending', depends: [] };  // shape parity with queue TaskRow
   154	  const agentsData = await parseAgentsFile(join(hopperDir, 'AGENTS.md'));
   155	  const vendor = vendorOverride || resolveVendor(task, agentsData);
   156	  if (!vendor) {
   157	    throw new Error(`No vendor resolved for ad-hoc task-type "${taskType}". Pass --vendor <name> (no AGENTS.md preference found).`);
   158	  }
   159	  // Approved Vendors whitelist — same enforcement as resolveDispatch's queue path,
   160	  // covering the ad-hoc path (/hopper:review|research|market, swarm panelists).
   161	  assertVendorApproved(agentsData, vendor);
   162	  const taskSpec = brief;
   163	  const governance = await resolveGovernance({ hopperDir, vendor, task });
   164	  const composedPrompt = composePrompt(frame, taskSpec, { governance });
   165	  const policy = policyForTaskType(agentsData, taskType);
   166	  return { task, frame, vendor, composedPrompt, taskSpec, policy, vendorDefaultModel: vendorDefaultModel(agentsData, vendor) };
   167	}
