-    cited: list[str] = []
-    lines = markdown_text.splitlines()
-    for i, line in enumerate(lines):
-        if IGNORE_MARKER in line or (i > 0 and IGNORE_MARKER in lines[i - 1]):
-            continue
-        for span in CODE_SPAN.findall(line):
