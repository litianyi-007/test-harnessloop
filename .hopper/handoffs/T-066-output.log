   495	def pathish_citations(markdown_text: str) -> tuple[list[str], int]:
   496	    """Extract citation spans that look like file paths.
   497	
   498	    Beyond the protocol prefixes, any slash-containing span with a file
   499	    extension, a trailing slash, or a `..` segment is treated as a path so
   500	    that citations of source/test files (e.g. `src/app.py`) are verified too.
   501	    Spans with spaces, URLs, flags, and variables are ignored, as are
   502	    regex/glob patterns (`_looks_like_pattern`), bare-domain URLs
   503	    (`_looks_like_bare_domain`), templated paths containing an
