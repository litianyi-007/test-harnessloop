   473	def strip_locator_suffix(cleaned: str) -> str:
   474	    """Strip a trailing `::<anchor>`, `:<line>`, or `:<start>-<end>` locator.
   475	
   476	    Reviewers commonly cite a position *within* a file rather than just the
   477	    file itself: `plugins/foo/scripts/check_setup.py:123` (a line number),
   478	    `docs/x.md:10-20` (a line range), or `.hopper/tasks/foo.md::root` (a
   479	    named anchor). The locator is not part of the path — checking the
   480	    literal locator-suffixed string against the filesystem always fails
   481	    even when the file plainly exists. The `::anchor` form is tried first
   482	    since it is the more specific shape (and would otherwise be partially
   483	    consumed by the line-number pattern if the anchor itself looked
   484	    numeric). Returns `cleaned` unchanged if neither suffix is present.
   485	    """
   486	    match = ANCHOR_SUFFIX_RE.search(cleaned)
   487	    if match:
   488	        return cleaned[: match.start()]
   489	    match = LINE_SUFFIX_RE.search(cleaned)
   490	    if match:
   491	        return cleaned[: match.start()]
   492	    return cleaned
