  2662	        {
  2663	            "round": str(project),
  2664	            "kind": "external-root-unavailable",
  2665	            "detail": (
  2666	                f"reference root '{alias}' is unavailable "
  2667	                f"({root.unavailable_reason}); every citation using this alias "
  2668	                "will be reported external-citation-unverifiable"
  2669	            ),
