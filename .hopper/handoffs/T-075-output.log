  2683	        # what this project is configured to reach, and would let a
  2684	        # declaration land (or be swapped) unseen for as long as no round
  2685	        # exists. Load it and report it; its G1-G6 violations are equally
  2686	        # real without a single round on disk.
  2687	        roots, root_violations = load_reference_roots(project)
  2688	        coverage["external_roots_declared"] = len(roots)
  2689	        coverage["external_roots_available"] = sum(1 for r in roots.values() if r.available)
