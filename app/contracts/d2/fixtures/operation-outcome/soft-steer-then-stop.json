{
  "name": "soft-steer-then-stop-waits-not-preempts",
  "description": "interrupt(mode:'steer') 在途时 stop() 到达——适配器必须等待 steer RPC 返回，不得截断；steer 按二态收敛后锁转 stop_in_progress。逐字转录自 D4 跨平台架构 v2.2 §4.3 的既定金标示例（该 fixture 已在 D4 定稿评审中通过，是 D1 §9.3 session 锁互斥矩阵 + D2 v3 §3.4 interrupt 二态判定的代表性并发场景），展示 DSL 的并发表达方式：两个 client_call 落在同一条『在途窗口』内、assert_state 中途断言。",
  "timeline": [
    { "t": 0, "op": "client_call", "id": "steer1", "call": "interrupt", "args": { "mode": "steer", "input": "..." } },
    { "t": 0, "op": "expect_outbound", "matches": "steer1", "pattern": { "type": "req.interrupt", "payload": { "mode": "steer" } } },
    { "t": 10, "op": "client_call", "id": "stop1", "call": "stop", "args": {} },
    { "t": 10, "op": "assert_state", "expected": { "sessionLock": "interrupt_in_progress" } },
    { "t": 50, "op": "mock_response", "replyTo": "steer1", "message": { "type": "res.interrupt", "result": { "operationId": "op-steer-1", "outcome": "submitted" } } },
    { "t": 51, "op": "assert_state", "expected": { "sessionLock": "stop_in_progress" } }
  ],
  "expected": { "pendingOperations": { "steer1": "submitted" } }
}
