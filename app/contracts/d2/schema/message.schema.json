{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "message.schema.json",
  "title": "Message = RequestMessage | ResponseMessage | EventMessage（本轮 SG-1 深化：全覆盖）",
  "$comment": "对应 D2 v3 §3.9/§4.1 的封闭判别联合顶层类型 `type Message = RequestMessage | ResponseMessage | EventMessage`。PRE-②/SG-1 首轮只转录『骨架 + 最关键的几类』（3/8 方法 + 5/11 事件）；本轮（SG-1 深化）按 D4 §3.5『完整类型闭包要求』补齐剩余 5 个方法（send/subscribe/stop/capabilities/queryBilling）+ res.unknown + 6 个事件（thinking/tool_result/error/turn_complete/session_end/approval_buffer_resolved），达到 D2 v3 §3.9（7+1 方法 req/resp）与 §4.1（11 类 KernelEvent）的全量覆盖。逐个新增类型均以 D2 v3 对应章节（见各 schema 文件 $comment）为唯一转录来源，未臆造字段；stop() 的三态子集、queryBilling 的独立 BillingQueryFailure、capabilities/createSession 的 sessionId 双例外、res.unknown 的 id 可选单例外，均在各自 schema 文件内联忠实表达。",
  "$defs": {
    "RequestMessage": {
      "description": "全覆盖（8/8）：createSession（§3.1）、send（§3.2）、subscribe（§3.3）、interrupt（§3.4）、stop（§3.5）、respondApproval（§3.6）、capabilities（§3.7）、queryBilling（§3.8，\"+1\"）。",
      "oneOf": [
        { "$ref": "methods/create-session.schema.json#/$defs/CreateSessionRequestMessage" },
        { "$ref": "methods/send.schema.json#/$defs/SendRequestMessage" },
        { "$ref": "methods/subscribe.schema.json#/$defs/SubscribeRequestMessage" },
        { "$ref": "methods/interrupt.schema.json#/$defs/InterruptRequestMessage" },
        { "$ref": "methods/stop.schema.json#/$defs/StopRequestMessage" },
        { "$ref": "methods/respond-approval.schema.json#/$defs/RespondApprovalRequestMessage" },
        { "$ref": "methods/capabilities.schema.json#/$defs/CapabilitiesRequestMessage" },
        { "$ref": "methods/query-billing.schema.json#/$defs/QueryBillingRequestMessage" }
      ]
    },
    "ResponseMessage": {
      "description": "全覆盖（8/8 + res.unknown）：8 个具体方法 response + UnknownResponseMessage（§3.9，唯一 id 可选的 response 类型，failure 恒为 ProtocolFailure）。",
      "oneOf": [
        { "$ref": "methods/create-session.schema.json#/$defs/CreateSessionResponseMessage" },
        { "$ref": "methods/send.schema.json#/$defs/SendResponseMessage" },
        { "$ref": "methods/subscribe.schema.json#/$defs/SubscribeResponseMessage" },
        { "$ref": "methods/interrupt.schema.json#/$defs/InterruptResponseMessage" },
        { "$ref": "methods/stop.schema.json#/$defs/StopResponseMessage" },
        { "$ref": "methods/respond-approval.schema.json#/$defs/RespondApprovalResponseMessage" },
        { "$ref": "methods/capabilities.schema.json#/$defs/CapabilitiesResponseMessage" },
        { "$ref": "methods/query-billing.schema.json#/$defs/QueryBillingResponseMessage" },
        { "$ref": "methods/unknown-response.schema.json#/$defs/UnknownResponseMessage" }
      ]
    },
    "EventMessage": {
      "description": "全覆盖（11/11）：message.delta（#1）、thinking（#2）、tool_call（#3）、tool_result（#4）、approval_request（#5）、error（#6）、turn_complete（#7）、session_end（#8）、capability_changed（#9）、operation_completed（#10）、approval_buffer_resolved（#11）。",
      "oneOf": [
        { "$ref": "events/message-delta.schema.json#/$defs/MessageDeltaEventMessage" },
        { "$ref": "events/thinking.schema.json#/$defs/ThinkingEventMessage" },
        { "$ref": "events/tool-call.schema.json#/$defs/ToolCallEventMessage" },
        { "$ref": "events/tool-result.schema.json#/$defs/ToolResultEventMessage" },
        { "$ref": "events/approval-request.schema.json#/$defs/ApprovalRequestEventMessage" },
        { "$ref": "events/error.schema.json#/$defs/ErrorEventMessage" },
        { "$ref": "events/turn-complete.schema.json#/$defs/TurnCompleteEventMessage" },
        { "$ref": "events/session-end.schema.json#/$defs/SessionEndEventMessage" },
        { "$ref": "events/capability-changed.schema.json#/$defs/CapabilityChangedEventMessage" },
        { "$ref": "events/operation-completed.schema.json#/$defs/OperationCompletedEventMessage" },
        { "$ref": "events/approval-buffer-resolved.schema.json#/$defs/ApprovalBufferResolvedEventMessage" }
      ]
    },
    "Message": {
      "description": "整条连线上出现的任何一条消息都属于且仅属于这三个封闭判别联合之一（D2 v3 §4.1）——本文件是其全量转录。",
      "oneOf": [
        { "$ref": "#/$defs/RequestMessage" },
        { "$ref": "#/$defs/ResponseMessage" },
        { "$ref": "#/$defs/EventMessage" }
      ]
    }
  }
}
