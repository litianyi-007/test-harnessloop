{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/message-delta.schema.json",
  "title": "evt.message.delta (MessageDeltaEvent)",
  "$comment": "D2 v3 §4 #1，payload 字段来源 D1 v3 正文（未受 v3.1-v3.5 修订影响）。runId 沿用 EventEnvelope 默认可选。",
  "$defs": {
    "MessageDeltaPayload": {
      "type": "object",
      "properties": {
        "role": { "const": "assistant" },
        "delta": { "type": "string" },
        "index": { "type": "integer" }
      },
      "required": ["role", "delta", "index"],
      "additionalProperties": false
    },
    "MessageDeltaEventMessage": {
      "description": "SG-1 深化：直接内联 sentAt/direction/seq/sessionId/runId/ts，不用 allOf——规避 quicktype 对『allOf 引用外部 $ref 片段』的已知缺陷（allOf 成员被直接忽略、字段静默丢失，见 methods/create-session.schema.json 同处注释 + CODEGEN-FINDINGS.md），语义与 allOf 版本等价。",
      "type": "object",
      "properties": {
        "sentAt": { "$ref": "../common/envelope.schema.json#/$defs/sentAt" },
        "direction": { "const": "event" },
        "seq": { "type": "integer" },
        "sessionId": { "type": "string" },
        "runId": { "type": "string" },
        "ts": { "$ref": "../common/envelope.schema.json#/$defs/ts" },
        "type": { "const": "evt.message.delta" },
        "payload": { "$ref": "#/$defs/MessageDeltaPayload" }
      },
      "required": ["sentAt", "direction", "seq", "sessionId", "ts", "type", "payload"],
      "additionalProperties": false
    }
  }
}
