{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/session-end.schema.json",
  "title": "evt.session_end (SessionEndEvent)",
  "$comment": "D2 v3 §4 #8，payload 字段来源 D1 v3 正文。runId 沿用 EventEnvelope 默认可选。",
  "$defs": {
    "SessionEndPayload": {
      "type": "object",
      "properties": {
        "reason": { "type": "string", "enum": ["stopped", "kernel_exited", "transport_closed", "error"] }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "SessionEndEventMessage": {
      "description": "SG-1 深化：直接内联 sentAt/direction/seq/sessionId/runId/ts，不用 allOf——规避 quicktype 对『allOf 引用外部 $ref 片段』的已知缺陷（见 methods/create-session.schema.json 同处注释 + CODEGEN-FINDINGS.md），语义与 allOf 版本等价。",
      "type": "object",
      "properties": {
        "sentAt": { "$ref": "../common/envelope.schema.json#/$defs/sentAt" },
        "direction": { "const": "event" },
        "seq": { "type": "integer" },
        "sessionId": { "type": "string" },
        "runId": { "type": "string" },
        "ts": { "$ref": "../common/envelope.schema.json#/$defs/ts" },
        "type": { "const": "evt.session_end" },
        "payload": { "$ref": "#/$defs/SessionEndPayload" }
      },
      "required": ["sentAt", "direction", "seq", "sessionId", "ts", "type", "payload"],
      "additionalProperties": false
    }
  }
}
