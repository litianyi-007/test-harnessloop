{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "methods/create-session.schema.json",
  "title": "req.createSession / res.createSession",
  "$comment": "D2 v3 §3.1（正文标注『同 v1，未受本次修订影响』，字段定义回溯 D2 v1 §3.1）。createSession 尚无 session 可寻址，sessionId 不适用——是 §3.9 判别联合里 sessionId 非必填的两个例外之一（另一个是 capabilities），故本 schema 的 request/response 均把 sessionId 声明为可选而非必填。",
  "$defs": {
    "CreateSessionRequestPayload": {
      "type": "object",
      "description": "逐字段对应 D1 CreateSessionConfig（D1 v3.5 §2.1），无新增/无精简。",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "cwd": { "type": "string" },
            "model": { "type": "string" },
            "newapiEndpoint": {
              "type": "object",
              "properties": {
                "baseUrl": { "type": "string" },
                "deploymentTokenRef": {
                  "type": "string",
                  "description": "条件必填——billingAttribution 为 user_tenant_aggregate 时缺失将触发 createSession 同步拒绝 aggregate_billing_requires_deployment_token（D1 v3.5 §2.1 步骤 0）。JSON Schema 层面不表达跨字段条件必填，忠实标注为可选，业务前置校验在实现层完成（呼应 D2 v3 §3.6 respondApproval 段落同类边界说明）。"
                }
              },
              "required": ["baseUrl"],
              "additionalProperties": false
            },
            "toolset": {
              "type": "object",
              "properties": {
                "allow": { "type": "array", "items": { "type": "string" } },
                "deny": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            },
            "sandbox": { "type": "string", "enum": ["read-only", "workspace-write", "full-access"] },
            "approvalProfile": { "type": "string", "enum": ["auto", "manual", "plan"] },
            "resume": {
              "type": "object",
              "properties": { "sessionId": { "type": "string" } },
              "required": ["sessionId"],
              "additionalProperties": false
            }
          },
          "required": ["cwd", "newapiEndpoint"],
          "additionalProperties": false
        }
      },
      "required": ["config"],
      "additionalProperties": false
    },
    "CreateSessionResultPayload": {
      "type": "object",
      "description": "逐字段对应 D1 SessionHandle（D1 v3.5 §2）。kernel 字段的已知张力见 D2 v3 §9.2 第 1 条（S-08 回指，D1 INV-1 未裁决）。",
      "properties": {
        "sessionHandle": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "kernelSessionId": { "type": "string" },
            "kernel": { "type": "string", "enum": ["openclaw", "hermes"] },
            "createdAt": { "type": "string", "format": "date-time" },
            "billing": {
              "type": "object",
              "properties": { "tokenRef": { "type": "string" } },
              "required": ["tokenRef"],
              "additionalProperties": false
            }
          },
          "required": ["sessionId", "kernel", "createdAt", "billing"],
          "additionalProperties": false
        }
      },
      "required": ["sessionHandle"],
      "additionalProperties": false
    },
    "CreateSessionRequestMessage": {
      "allOf": [{ "$ref": "../common/envelope.schema.json#/$defs/requestEnvelopeBase" }],
      "type": "object",
      "properties": {
        "type": { "const": "req.createSession" },
        "id": { "type": "string" },
        "sessionId": { "type": "string", "description": "不适用——createSession 尚无 session 可寻址，见上方说明。" },
        "payload": { "$ref": "#/$defs/CreateSessionRequestPayload" }
      },
      "required": ["type", "id", "payload"],
      "unevaluatedProperties": false
    },
    "CreateSessionResponseMessage": {
      "description": "success/failure 互斥判别联合（D2 v3 §2/§3.9）。失败：RejectionFailure | ProtocolFailure，可命中 session_not_found（resume 指向不可续目标）、aggregate_billing_requires_deployment_token。两个分支各自直接内联 sentAt/direction（不用 allOf 复用 common/envelope.schema.json#/$defs/responseEnvelopeBase）——codegen 工具 json-schema-to-typescript 对『oneOf 分支内部再用 allOf 组合』存在已验证的已知缺陷（会把分支特有字段丢失、坍缩成公共基类），改为分支内直接声明是本轮验证后采用的规避写法，语义与 allOf 版本等价，Ajv 校验结果不变。",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sentAt": { "$ref": "../common/envelope.schema.json#/$defs/sentAt" },
            "direction": { "const": "response" },
            "type": { "const": "res.createSession" },
            "id": { "type": "string" },
            "sessionId": { "type": "string" },
            "result": { "$ref": "#/$defs/CreateSessionResultPayload" }
          },
          "required": ["sentAt", "direction", "type", "id", "result"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sentAt": { "$ref": "../common/envelope.schema.json#/$defs/sentAt" },
            "direction": { "const": "response" },
            "type": { "const": "res.createSession" },
            "id": { "type": "string" },
            "sessionId": { "type": "string" },
            "failure": {
              "oneOf": [
                { "$ref": "../common/errors.schema.json#/$defs/RejectionFailure" },
                { "$ref": "../common/errors.schema.json#/$defs/ProtocolFailure" }
              ]
            }
          },
          "required": ["sentAt", "direction", "type", "id", "failure"],
          "additionalProperties": false
        }
      ]
    }
  }
}
