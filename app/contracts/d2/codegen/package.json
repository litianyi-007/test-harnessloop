{
  "name": "@test-harnessloop/d2-codegen",
  "version": "0.1.0",
  "private": true,
  "description": "D2 JSON Schema -> 各语言类型 codegen 管线（SG-1 深化：TS/Swift/C# 三端打通 + 判别联合存活验证，见 ../CODEGEN-FINDINGS.md）。",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-schemas.mjs",
    "gen:ts": "node scripts/generate-ts.mjs",
    "typecheck:ts": "tsc --noEmit --strict --target es2020 --typeRoots ./nonexistent-typeroots ../../../generated/ts/d2.d.ts",
    "gen:swift": "node scripts/generate-swift.mjs",
    "typecheck:swift": "swiftc -typecheck ../../../generated/swift/D2.swift ../../../generated/swift/DiscriminatedUnions.swift",
    "verify:swift": "swiftc ../../../generated/swift/D2.swift ../../../generated/swift/DiscriminatedUnions.swift verify/swift/main.swift -o /tmp/d2-swift-verify && /tmp/d2-swift-verify",
    "gen:csharp": "node scripts/generate-csharp.mjs",
    "typecheck:csharp": "node scripts/typecheck-csharp.mjs",
    "verify:csharp": "node scripts/verify-csharp.mjs",
    "typecheck:fixtures-runner": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions --types node ../fixtures/ts-runner/runner.ts ../fixtures/ts-runner/mock-kernel-client.ts ../fixtures/dsl.ts",
    "run:fixtures": "node ../fixtures/ts-runner/runner.ts",
    "gen": "npm run validate && npm run gen:ts && npm run typecheck:ts && npm run gen:swift && npm run typecheck:swift && npm run verify:swift && npm run gen:csharp && npm run typecheck:csharp && npm run verify:csharp && npm run typecheck:fixtures-runner && npm run run:fixtures"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "quicktype-core": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
