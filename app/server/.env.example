# D3 server 环境变量样例——对应 src/config/env.validation.ts EnvironmentVariables。
# 数值大多是"可运行的默认值"，不是已在 D3/D5/D6 confirmed 文档裁定的产品参数，
# 具体 x-todo 见 env.validation.ts 类注释逐条标注，不在此重复。

NODE_ENV=development
PORT=3000

# PostgreSQL（server-stack-selection.md 方案 A：共享 schema + tenant_id）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=d3_control_plane

# 认证 JWT（access/refresh，"我是谁"）——x-todo：具体有效期数值未定，下方仅为可运行默认值
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# License JWT（Ed25519，"有权用什么"）——x-todo：分发/轮换格式（PEM/JWKS）未定，此处用 PEM 字符串占位
# 生成示例：openssl genpkey -algorithm ed25519 -out license-private.pem
#          openssl pkey -in license-private.pem -pubout -out license-public.pem
# LICENSE_JWT_PUBLIC_KEY=
# LICENSE_JWT_PRIVATE_KEY=
# LICENSE_JWT_KEY_ID=

# newapi Management API（D6 安全默认方案 B：D3 全程代理，持 admin/租户级凭证）
# x-todo：admin 凭证形态未经实现前 API 冒烟确认
# NEWAPI_BASE_URL=
# NEWAPI_ADMIN_TOKEN=

# 浏览器登录回流 IdP（x-todo：IdP 主体未选定）
# AUTH_IDP_AUTHORIZATION_ENDPOINT=
